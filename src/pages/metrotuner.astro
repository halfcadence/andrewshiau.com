---
import Layout from '../layouts/Layout.astro';

// THE INSTRUMENT SCREEN. This URL is the thing itself now, and the writeup lives at
// /work/metrotuner/ (chooser: metrotuner-two-pages, Q1/02 "instrument first" — the
// index row opens the instrument; the case study moved in with the other eight,
// reachable from the one word at the foot of this screen).
//
// THE SHAPE IS A SCREEN, NOT THE DOCUMENT. Q2/01 "equal halves": on a wide viewport
// the tuner and the metronome each centre in half the screen, both running — two
// instruments, one practice, the same argument .duo makes on /method/. Q3/02 "swipe":
// under 900px the halves become two snap-scroll pages, and the indicator is the
// site's own pair — ring and disc, the disc marking where you are. 900 because that
// is the width where .duo stacks; this page's halves give at the same width the
// site's one other side-by-side does.
//
// The one deviation this page is allowed: it escapes .wrap's 1120px measure (the
// `:has(#mt-app)` rule below, global but shipped only in this page's chunk). A screen
// split into viewport halves cannot live inside a document measure. Everything else —
// tokens, type, the link idiom, the control styles — is the site's, unchanged.
//
// The engine is unchanged from the one-page version: pure modules in
// src/lib/metrotuner/ (unit-tested to half a cent), this file is the glue. The ?e2e
// hook and every data-testid survive, so the fake-mic suite runs against this screen
// exactly as it ran against the document page.
---

<Layout
  title="Metrotuner — Andrew Shiau"
  description="A chromatic tuner and a metronome in the browser. Pitch detection runs on-device; the microphone signal never leaves the page."
>
  <div id="mt-app">
    <h1 class="visually-hidden">Metrotuner</h1>

    <div class="mt-pages" id="mt-pages">
      <!-- ── TUNER, the left case / first page ─────────────────────────────── -->
      <!-- THE CASE (chooser: metrotuner-pendulum, Q2/01): a square hairline case per
           instrument, its name on the frame like an engraved plate — the site's box
           rule holds by the embed-frame argument: inside is a machine, the border
           says where it starts. On the phone NO case is drawn: the viewport's own
           edges are the frame. THE FOOT LINE (Q3/01): every control in one line
           along the case's bottom edge; the hero owns the middle. -->
      <section class="mt-half" aria-label="Tuner">
        <span class="mt-plate" aria-hidden="true">tuner</span>
        <!-- CALIBRATION IS A TOP CONTROL now (user nit 6, 2026-08-04): it sets what
             the whole instrument means by "in tune", so it reads like a spec plate —
             top line, opposite the engraved name — rather than a control you play. -->
        <div class="mt-ctop">
          <span class="mt-fr">
            <span class="f mt-a4">
              <label for="mt-a4" class="mt-lb">A4</label>
              <input id="mt-a4" data-testid="a4" type="number" inputmode="decimal"
                     min="400" max="480" step="1" value="440" aria-label="A4 calibration in hertz" />
              <span class="mt-lb">Hz</span>
            </span>
          </span>
        </div>
        <div class="mt-mid">
          <figure class="mt-gauge" aria-hidden="true">
            <!-- THE ARM AND BOB (chooser: metrotuner-pendulum, Q1/02) — the Wittner
                 silhouette: pivot, hairline arm, the disc as the bob. This REVERSES
                 round-1's dot-only pick, deliberately: the arm is the pendulum's,
                 not the meter's, and both instruments carry it so deflection and
                 swing read as one mechanic. The invert (Q2/02) is unchanged. -->
            <svg viewBox="0 0 320 184" id="mt-dial">
              <path d="M 34 160 A 126 126 0 0 1 286 160" fill="none" stroke="var(--faint)" stroke-width="1.5"/>
              <line id="mt-tick" x1="160" y1="26" x2="160" y2="42" stroke="var(--ink)" stroke-width="1.5"/>
              <g id="mt-needle" class="rest">
                <line x1="160" y1="160" x2="160" y2="44" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="160" cy="44" r="6" fill="currentColor"/>
              </g>
              <circle cx="160" cy="160" r="2.5" fill="var(--ink)"/>
            </svg>
          </figure>

          <div class="mt-read">
            <span class="mrn" id="mt-note" data-testid="note">—</span>
            <span class="ends"></span>
            <span class="mrc" id="mt-cents" data-testid="cents">–</span>
            <span class="mrh" id="mt-hz" data-testid="hz"></span>
          </div>
          <div id="mt-sr" class="visually-hidden" role="status" aria-live="polite"></div>
        </div>

        <div class="mt-cfoot">
          <span class="mt-fl">
            <button type="button" class="tbtn fixw" id="mt-mic" data-testid="mic-toggle" aria-pressed="false" style="--w:15ch">start the tuner</button>
            <span class="mt-hint" id="mt-hint">uses the microphone, on this device only</span>
          </span>
          <span class="mt-fr">
            <button type="button" class="tbtn fixw" id="mt-tone" data-testid="tone-toggle" aria-pressed="false" style="--w:9ch">play tone</button>
            <span class="mt-seg" role="group" aria-label="Reference note">
              <button type="button" class="tbtn gly" id="mt-note-down" aria-label="Reference note down">‹</button>
              <span class="mt-refnote" id="mt-refnote" data-testid="refnote">A4</span>
              <button type="button" class="tbtn gly" id="mt-note-up" aria-label="Reference note up">›</button>
            </span>
          </span>
        </div>
      </section>

      <!-- ── METRONOME, the right case / second page ───────────────────────── -->
      <!-- THE PENDULUM (chooser: metrotuner-pendulum, Q1/02 "arm and bob"): the
           metronome's figure is the TUNER'S DRAWING IN MOTION — same arc, same arm,
           same bob, sweeping end to end once per beat with the end tick filling on
           the strike. Still vs moving is the whole distinction between the two
           instruments. The beat-ring row this replaces carried bar position; the
           strike now carries it — the downbeat's tick strikes heavier. -->
      <section class="mt-half" aria-label="Metronome">
        <span class="mt-plate" aria-hidden="true">metronome</span>
        <!-- METER ON TOP, TRANSPORT ON THE BOTTOM (user nit 2, 2026-08-04): the
             set-per-piece controls (beats, subdivision) read as spec lines at the
             top; the played controls (start, tap, tempo) stay in hand's reach at
             the foot. Both meters are THE STRING — circles joined by trimmed rules,
             the mark's own o-o-o. Click the Nth circle: filled up to N. Beats and
             subdivision share the device, and the string is 7 long for both — yes,
             septuplets; the engine never cared. -->
        <!-- THE RULED MEASURE (chooser: metrotuner-meter-final, Q1/02; judge 9.2).
             Digits 1–7 are the scale, one hairline under them is the quantity —
             stated once, differently per meaning: the BEATS rule grows with the bar
             (its left tick is the accented downbeat), the SUBDIVIDE rule is FIXED at
             one beat's length and gets cut into n dashes. Extent vs granularity.
             The digits are the buttons (20×44 targets); the rules are drawn by
             drawRules() because stroke-dasharray with round gaps can't guarantee n
             visually equal dashes at every width. -->
        <div class="mt-ctop">
          <span class="mt-fl">
            <span class="mt-lb">beats</span>
            <span class="mt-rm" id="mt-beats-seg" role="group" aria-label="Beats per bar">
              <span class="rm-digits">
                {[1, 2, 3, 4, 5, 6, 7].map((n) => (
                  <button type="button" class="rbtn" data-beats={n} aria-pressed={n === 4 ? 'true' : 'false'} aria-label={`${n} beats per bar`}>{n}</button>
                ))}
              </span>
              <svg class="rm-rule" width="140" height="8" viewBox="0 0 140 8" aria-hidden="true" data-rule="grow"></svg>
            </span>
          </span>
          <span class="mt-fr">
            <span class="mt-lb">subdivide</span>
            <span class="mt-rm" id="mt-sub-seg" role="group" aria-label="Subdivision">
              <span class="rm-digits">
                {[1, 2, 3, 4, 5, 6, 7].map((n) => (
                  <button type="button" class="rbtn" data-sub={n} aria-pressed={n === 1 ? 'true' : 'false'} aria-label={`${n} per beat`}>{n}</button>
                ))}
              </span>
              <svg class="rm-rule" width="140" height="8" viewBox="0 0 140 8" aria-hidden="true" data-rule="cut"></svg>
            </span>
          </span>
        </div>

        <div class="mt-mid">
          <figure class="mt-gauge" aria-hidden="true">
            <svg viewBox="0 0 320 184" id="mt-metro-fig">
              <path d="M 34 160 A 126 126 0 0 1 286 160" fill="none" stroke="var(--faint)" stroke-width="1.5"/>
              <!-- The end ticks are STRIKE FLASHES, not rail furniture (user nit 3,
                   2026-08-04): invisible at rest, they appear only in the strike
                   window. The rail is a clean arc otherwise. -->
              <line id="mt-tickL" x1="34" y1="146" x2="34" y2="160" stroke="var(--ink)" stroke-width="0"/>
              <line id="mt-tickR" x1="286" y1="146" x2="286" y2="160" stroke="var(--ink)" stroke-width="0"/>
              <g id="mt-pend" class="rest">
                <line x1="160" y1="160" x2="160" y2="44" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="160" cy="44" r="6" fill="currentColor"/>
              </g>
              <circle cx="160" cy="160" r="2.5" fill="var(--ink)"/>
            </svg>
          </figure>
        </div>

        <div class="mt-cfoot">
          <span class="mt-fl">
            <button type="button" class="tbtn fixw" id="mt-run" data-testid="metro-toggle" aria-pressed="false" style="--w:19ch">start the metronome</button>
            <button type="button" class="tbtn" id="mt-tap" data-testid="tap">tap</button>
          </span>
          <span class="mt-fr">
            <span class="f mt-bpm">
              <button type="button" class="tbtn gly" id="mt-bpm-down" aria-label="Slower">−</button>
              <input id="mt-bpm" data-testid="bpm" type="number" inputmode="numeric"
                     min="20" max="320" step="1" value="96" aria-label="Beats per minute" />
              <button type="button" class="tbtn gly" id="mt-bpm-up" aria-label="Faster">+</button>
              <span class="mt-lb">bpm</span>
            </span>
          </span>
        </div>
      </section>
    </div>

    <!-- The foot: the page indicator (phone only) and the one word out. The dots are
         the mark's vocabulary — disc = the page on screen, ring = the other — and
         they are buttons: a swipe needs a click-shaped fallback for keyboards and
         for anyone who doesn't guess the gesture. -->
    <div class="mt-foot">
      <!-- WORDS, NOT DOTS (user nit, 2026-08-04: "the two dots are not clear").
           The pages are NAMED now — tuner · metronome — current page ink, the other
           faint+underlined (the segment idiom). The swipe still works; these are its
           click-shaped fallback, and with the pages named at the foot the engraved
           plate labels became redundant on the phone (they were already hidden). -->
      <div class="mt-dots" id="mt-dots">
        <button type="button" data-goto="0" data-testid="dot-tuner" class="pgword">tuner</button>
        <span class="mt-lb" aria-hidden="true">·</span>
        <button type="button" data-goto="1" data-testid="dot-metro" class="pgword">metronome</button>
      </div>
      <!-- THE MARK IS GONE (user call, 2026-08-04: "just delete the mark, it's not
           really part of this tool"). The instrument carries no site chrome at all;
           the way home is the browser and the index that linked here. The foot now
           exists ONLY on the phone, for the page dots — on desktop there is nothing
           left to hold and it collapses. -->
    </div>
  </div>
</Layout>

<style is:global>
  /* THE ONE ESCAPE. This page is a screen, and a screen split into viewport halves
     cannot sit inside the document's 1120px measure. `:has(#mt-app)` scopes the
     override to exactly this page — the rule ships in this page's CSS chunk and the
     selector matches nothing anywhere else. */
  .wrap:has(#mt-app){max-width:none;padding:0}
  main:has(#mt-app) > .grid:first-child{margin-top:0}
</style>

<style>
  #mt-app{height:100dvh;display:flex;flex-direction:column;overflow:hidden}

  /* THE CASES (chooser metrotuner-pendulum, Q2/01): each instrument in a square
     hairline case, its name interrupting the top frame like an engraved plate —
     sanctioned by the embed-frame argument: inside is a machine. THE FOOT LINE
     (Q3/01): controls in a line along the case's bottom edge; the figure alone owns
     the middle. */
  .mt-pages{flex:1;min-height:0;display:flex;gap:var(--group);
    padding:var(--group) var(--group) var(--lead)}
  /* THE HAIRLINE (chooser metrotuner-reactive, Q1/02): 1px --line — the embed
     frame's own weight, the weakest mark the system has. The case is not
     interactive, so it must be the quietest line on the screen; at 1.5px ink it was
     tying with the pendulum's own stroke. Near-invisible in dark is the point. */
  .mt-half{flex:1 1 50%;min-width:0;position:relative;
    border:1px solid var(--line);
    display:flex;flex-direction:column;justify-content:flex-end;gap:0;
    padding:var(--lead) var(--gutter)}
  .mt-plate{position:absolute;top:-14px;left:24px;background:var(--paper);
    padding:0 1ch;color:var(--faint)}
  .mt-mid{flex:1;min-height:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:var(--lead)}
  /* A foot line: left group flush left, right group flush right, one baseline.
     The top line is the same device at the case's other edge (user nit 2): spec
     controls up top, played controls at the foot. */
  .mt-cfoot, .mt-ctop{flex:none;display:flex;align-items:baseline;justify-content:space-between;
    gap:var(--lead) 4ch;flex-wrap:wrap}
  .mt-ctop{align-items:center}
  .mt-fl{display:inline-flex;align-items:baseline;gap:2ch;flex-wrap:wrap}
  .mt-fr{display:inline-flex;align-items:baseline;gap:2ch;flex-wrap:wrap}
  .mt-ctop .mt-fl, .mt-ctop .mt-fr{align-items:center}

  /* THE STRING (user nit 2): circles joined by trimmed rules — o-o-o-o-o-o-o, the
     mark's own vocabulary at meter scale. Click the Nth circle and the string fills
     up to it: N filled discs = N beats (or N per beat). One device for both meters.
     Each circle's TARGET is 32×44 (the 12px drawing centred in it) — the mobile
     tapping fix (nit 3) without the string sprawling past a phone's width. */
  /* THE RULED MEASURE. The digits are the scale and the buttons; the hairline
     under them is the value. Digits inside the value read ink (beats) / the value
     digit alone reads ink (subdivide); the rest faint. */
  .mt-rm{display:inline-flex;flex-direction:column;align-items:flex-start}
  .rm-digits{display:inline-flex}
  .rbtn{font:inherit;background:transparent;border:0;padding:8px 0 0;margin:0;
    border-radius:0;cursor:pointer;color:var(--faint);width:20px;min-height:36px;
    text-align:left;transition:color var(--dur-fast) var(--ease)}
  .rbtn.on{color:var(--ink)}
  .rbtn:not(.on):hover{color:var(--accent)}
  .rbtn:focus-visible{outline:1px solid var(--accent);outline-offset:-2px}
  .rm-rule{display:block;margin-top:-2px}

  /* THE SWIPE (metrotuner-two-pages Q3/02). Under 900px the cases become two
     full-width snap pages — and the case VANISHES (metrotuner-pendulum Q2, the
     mobile rule): the viewport's own edges are the frame, so drawing one inside
     them would be a frame in a frame. The plate goes with it; the page dots name
     the pages. */
  @media (max-width: 900px){
    .mt-pages{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;
      gap:0;padding:0}
    .mt-pages::-webkit-scrollbar{display:none}
    .mt-half{flex:0 0 100%;scroll-snap-align:start;scroll-snap-stop:always;
      border:0;padding:var(--lead) var(--gutter)}
    .mt-plate{display:none}
  }

  .mt-gauge{width:min(320px,80vw);margin:0}
  .mt-gauge svg{display:block;width:100%;height:auto;color:var(--ink)}
  #mt-needle{transform-origin:160px 160px;transform-box:view-box;
    transition:transform var(--dur) var(--ease),color var(--dur) var(--ease)}
  #mt-needle.rest{color:var(--line)}
  #mt-needle.live{color:var(--ink)}
  /* The pendulum: same figure, no CSS transition — its motion is the rAF cosine
     (a transition would fight the per-frame transform). Rest = faint, upright. */
  #mt-pend{transform-origin:160px 160px;transform-box:view-box}
  #mt-pend.rest{color:var(--line)}
  #mt-pend.live{color:var(--ink)}
  #mt-tickL, #mt-tickR{transition:stroke-width var(--dur-fast) var(--ease)}

  .mt-read{display:flex;align-items:baseline;gap:2ch;width:min(320px,80vw)}
  .mt-read .ends{flex:1}
  /* IN TUNE is the invert (round-1 pick Q2/02): selection colours on the reading.
     The padding is carved out of the margin so the text never moves. */
  .mrn{color:var(--ink);padding:0 .5ch;margin-left:-.5ch;
    transition:background var(--dur-fast) var(--ease),color var(--dur-fast) var(--ease)}
  .mrn.intune{background:var(--ink);color:var(--paper)}
  .mrc{color:var(--ink)}
  .mrh{color:var(--faint)}

  .mt-row{display:flex;align-items:center;gap:3ch;flex-wrap:wrap}
  .mt-hint{color:var(--faint)}
  .mt-lb{color:var(--faint)}

  .mt-refnote{color:var(--ink);min-width:4ch;text-align:center;display:inline-block}

  .tbtn{font:inherit;color:var(--ink);background:transparent;border:0;padding:0;
    border-radius:0;min-height:44px;cursor:pointer;
    text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:4px;
    transition:color var(--dur-fast) var(--ease),text-decoration-color var(--dur-fast) var(--ease)}
  .tbtn:hover{color:var(--accent);text-decoration-color:var(--ink)}
  .tbtn:focus-visible{outline:0;color:var(--accent);text-decoration-color:var(--ink)}
  .tbtn[aria-pressed="true"]:not(.seg){text-decoration-color:var(--accent)}
  .tbtn.gly{min-width:44px;text-align:center}
  /* THE REFLOW FIX (user nit, 2026-08-04): a transport's label flips between
     start/stop (or play/stop) and the two strings differ in width, so every toggle
     used to reflow the whole foot line. Reserve the LONGER string's width per
     button (--w set inline, in ch — exact in a monospace face) and keep the text
     flush left; nothing moves but the word. */
  .tbtn.fixw{min-width:var(--w);text-align:left}
  .tbtn.seg{color:var(--faint)}
  .tbtn.seg[aria-pressed="true"]{color:var(--ink);text-decoration:none;cursor:default}
  .mt-seg{display:inline-flex;align-items:center;gap:1.5ch;flex-wrap:wrap;justify-content:center}

  .mt-a4, .mt-bpm{display:inline-flex;align-items:center;gap:1ch}
  .mt-a4 input, .mt-bpm input{flex:0 0 auto;width:6ch;text-align:center;
    -moz-appearance:textfield;appearance:textfield}
  .mt-a4 input::-webkit-outer-spin-button, .mt-a4 input::-webkit-inner-spin-button,
  .mt-bpm input::-webkit-outer-spin-button, .mt-bpm input::-webkit-inner-spin-button{
    -webkit-appearance:none;margin:0}

  /* The foot: dots centre (phone only — on the wide screen both pages are already
     on screen and an indicator would point at nothing), the word out under them. */
  /* The foot holds only the page dots now, which are a phone device — on desktop
     the whole band collapses and the cases keep the height. */
  .mt-foot{display:none;flex:none;flex-direction:column;align-items:center;
    gap:4px;padding:0 var(--gutter) var(--lead)}
  .mt-dots{display:flex;gap:1.5ch;align-items:baseline}
  @media (max-width: 900px){ .mt-foot{display:flex} }
  /* The page words (user nit 2026-08-04, the dots were unclear): current = ink, no
     underline (a fact); the other = faint, underlined (an offer) — the segment
     idiom. 44px targets via padding. */
  .pgword{font:inherit;background:transparent;border:0;padding:10px 0;margin:-10px 0;
    border-radius:0;cursor:pointer;color:var(--faint);
    text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:4px;
    transition:color var(--dur-fast) var(--ease)}
  .pgword.cur{color:var(--ink);text-decoration:none;cursor:default}
  .pgword:not(.cur):hover{color:var(--accent)}
  .pgword:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;
    clip:rect(0 0 0 0);white-space:nowrap}

  @media (prefers-reduced-motion: reduce){
    #mt-needle{transition:none}
    .mrn{transition:none}
  }
</style>

<script>
  import { detectPitch } from '../lib/metrotuner/pitch';
  import { freqToReading, midiToFreq, NOTE_NAMES, A4_DEFAULT, A4_MIN, A4_MAX } from '../lib/metrotuner/notes';
  import { Scheduler, clampBpm, type Tick } from '../lib/metrotuner/metronome';
  import { createTapTempo } from '../lib/metrotuner/tap';

  // ONE AudioContext for tuner, tone and metronome, created on the first gesture —
  // browsers refuse both getUserMedia and audio playback without one.
  let ctx: AudioContext | null = null;
  const audio = (): AudioContext => {
    if (!ctx) ctx = new AudioContext();
    if (ctx.state === 'suspended') ctx.resume();
    return ctx;
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  // E2E HOOK, inert in normal use: `?e2e` makes the page record what it did.
  const E2E = new URLSearchParams(location.search).has('e2e');
  const hook: { ticks: Tick[]; reading: unknown; toneHz: number | null } =
    { ticks: [], reading: null, toneHz: null };
  if (E2E) (window as any).__mt = hook;

  const store = {
    get(k: string): string | null { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
  };

  let a4 = Number(store.get('mt:a4')) || A4_DEFAULT;
  a4 = Math.min(A4_MAX, Math.max(A4_MIN, a4));
  const a4Input = $('mt-a4') as unknown as HTMLInputElement;
  a4Input.value = String(a4);

  const setA4 = (v: number) => {
    if (!Number.isFinite(v)) return;
    a4 = Math.min(A4_MAX, Math.max(A4_MIN, v));
    store.set('mt:a4', String(a4));
    if (toneOsc) retune();
  };
  a4Input.addEventListener('change', () => {
    setA4(Number(a4Input.value));
    a4Input.value = String(a4);
  });

  // ── tuner ─────────────────────────────────────────────────────────────────
  const noteEl = $('mt-note');
  const centsEl = $('mt-cents');
  const hzEl = $('mt-hz');
  const srEl = $('mt-sr');
  const needle = document.getElementById('mt-needle')!;
  const micBtn = $('mt-mic') as unknown as HTMLButtonElement;
  const hintEl = $('mt-hint');

  let micStream: MediaStream | null = null;
  let analyser: AnalyserNode | null = null;
  let tunerTimer: number | null = null;
  const buf = new Float32Array(2048);
  // Median-of-5 smoothing: one bad window (a chair scrape) can't kick the reading.
  const recent: number[] = [];
  let quietFrames = 0;

  const IN_TUNE_CENTS = 3;

  function renderReading(freq: number) {
    const r = freqToReading(freq, a4);
    if (!r) return renderSilence();
    quietFrames = 0;
    noteEl.textContent = `${r.name}${r.octave}`;
    const c = r.cents;
    centsEl.textContent = `${c >= 0 ? '+' : '−'}${Math.abs(c).toFixed(1)}`;
    hzEl.textContent = `${freq.toFixed(1)} Hz`;
    const deg = Math.max(-50, Math.min(50, c)) * (60 / 50);
    needle.style.transform = `rotate(${deg}deg)`;
    const tuned = Math.abs(c) <= IN_TUNE_CENTS;
    needle.classList.remove('rest');
    needle.classList.add('live');
    noteEl.classList.toggle('intune', tuned);
    if (E2E) hook.reading = { ...r };
  }

  function renderSilence() {
    // A couple of empty windows is a breath between notes; hold briefly.
    if (++quietFrames < 6) return;
    noteEl.textContent = '—';
    noteEl.classList.remove('intune');
    centsEl.textContent = '–';
    hzEl.textContent = '';
    needle.style.transform = 'rotate(0deg)';
    needle.classList.add('rest');
    needle.classList.remove('live');
    if (E2E) hook.reading = null;
  }

  // The spoken copy of the reading, at most once a second.
  setInterval(() => {
    const t = noteEl.textContent;
    srEl.textContent = t === '—' ? '' : `${t}, ${centsEl.textContent} cents`;
  }, 1000);

  // THE PERMISSION RACE: a stop click during a pending prompt must not leave the
  // resolved stream's tracks live. Request ids invalidate a stale resolution; a
  // stream that arrives for a dead request is stopped on sight.
  let micRequest = 0;

  async function startTuner() {
    const req = ++micRequest;
    const ac = audio();
    let stream: MediaStream;
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false,
        },
      });
    } catch (err) {
      // THE MOBILE MIC BUG (user report, 2026-08-04: "not sure how to accept the
      // listening on mobile"). Two real causes were hiding in this catch:
      // (1) the old hint said "allow it in the address bar" — desktop-Chrome
      //     guidance; iOS has no address-bar permission UI at all, so the message
      //     described a control that does not exist on the phone;
      // (2) iOS Safari NEVER re-prompts after a denial — getUserMedia rejects
      //     NotAllowedError instantly with no dialog, so tapping again looks like
      //     the button silently failing. The way back is the aA menu → Website
      //     Settings → Microphone (or Settings → Safari).
      // So the message is now derived from the error NAME and the platform.
      if (req === micRequest) {
        const touch = matchMedia('(hover: none)').matches;
        const name = (err as DOMException)?.name ?? '';
        hintEl.textContent =
          name === 'NotFoundError' ? 'no microphone found on this device'
          : name === 'NotReadableError' ? 'the microphone is busy in another app — close it and try again'
          : touch ? 'microphone blocked — open the aA (or ⋯) menu → website settings → allow microphone, then reload'
          : 'microphone refused — allow it in the address bar and try again';
      }
      return;
    }
    if (req !== micRequest || micStream) {
      stream.getTracks().forEach((t) => t.stop());
      return;
    }
    micStream = stream;
    store.set('mt:tuneron', '1');
    const src = ac.createMediaStreamSource(micStream);
    analyser = ac.createAnalyser();
    analyser.fftSize = 2048;
    src.connect(analyser);
    micBtn.textContent = 'stop the tuner';
    micBtn.setAttribute('aria-pressed', 'true');
    hintEl.textContent = 'listening';
    tunerTimer = window.setInterval(() => {
      analyser!.getFloatTimeDomainData(buf);
      const f = detectPitch(buf, ac.sampleRate);
      if (f > 0) {
        recent.push(f);
        if (recent.length > 5) recent.shift();
        const sorted = [...recent].sort((a, b) => a - b);
        renderReading(sorted[Math.floor(sorted.length / 2)]);
      } else {
        recent.length = 0;
        renderSilence();
      }
    }, 66);
  }

  // `remember=false` is the pagehide path: the mic must stop, but the reader did
  // not choose to stop — so the flag survives and the tuner resumes on return.
  function stopTuner(remember = true) {
    micRequest++; // invalidate any getUserMedia still waiting on the prompt
    if (remember) store.set('mt:tuneron', '0');
    if (tunerTimer !== null) { clearInterval(tunerTimer); tunerTimer = null; }
    micStream?.getTracks().forEach((t) => t.stop());
    micStream = null;
    analyser = null;
    recent.length = 0;
    quietFrames = 99;
    renderSilence();
    micBtn.textContent = 'start the tuner';
    micBtn.setAttribute('aria-pressed', 'false');
    hintEl.textContent = 'uses the microphone, on this device only';
  }

  micBtn.addEventListener('click', () => (micStream ? stopTuner() : startTuner()));

  // OPEN STARTED (user ask, 2026-08-03). Two conditions, both required: the tuner
  // was running when the reader left, AND the browser will grant the mic silently.
  // Never auto-start into a permission prompt — a dialog nobody asked for is the
  // hostile version of convenient. Chrome allows the AudioContext to run when
  // audio capture is active, so no gesture is needed once the stream is granted.
  // The metronome stays off on arrival: sound on load without a gesture is blocked
  // by autoplay policy, and would be wrong anyway.
  try {
    if (store.get('mt:tuneron') === '1' && navigator.permissions?.query) {
      navigator.permissions
        .query({ name: 'microphone' as PermissionName })
        .then((p) => { if (p.state === 'granted' && !micStream) startTuner(); })
        .catch(() => {});
    }
  } catch {}

  // ── reference tone ────────────────────────────────────────────────────────
  const toneBtn = $('mt-tone') as unknown as HTMLButtonElement;
  const refNoteEl = $('mt-refnote');
  let refMidi = Number(store.get('mt:ref')) || 69; // A4
  if (!Number.isInteger(refMidi) || refMidi < 36 || refMidi > 96) refMidi = 69;
  let toneOsc: OscillatorNode | null = null;
  let toneGain: GainNode | null = null;

  function refLabel() {
    const name = NOTE_NAMES[((refMidi % 12) + 12) % 12];
    refNoteEl.textContent = `${name}${Math.floor(refMidi / 12) - 1}`;
  }
  refLabel();

  // ONE function owns the oscillator's frequency AND the hook's copy of it.
  function retune() {
    const f = midiToFreq(refMidi, a4);
    if (toneOsc) toneOsc.frequency.setValueAtTime(f, audio().currentTime);
    if (E2E) hook.toneHz = toneOsc ? f : null;
  }

  function startTone() {
    const ac = audio();
    toneOsc = ac.createOscillator();
    toneGain = ac.createGain();
    toneOsc.type = 'sine';
    toneOsc.frequency.value = midiToFreq(refMidi, a4);
    // Soft attack — a sine that starts at full gain clicks.
    toneGain.gain.setValueAtTime(0.0001, ac.currentTime);
    toneGain.gain.exponentialRampToValueAtTime(0.12, ac.currentTime + 0.06);
    toneOsc.connect(toneGain).connect(ac.destination);
    toneOsc.start();
    toneBtn.textContent = 'stop tone';
    toneBtn.setAttribute('aria-pressed', 'true');
    if (E2E) hook.toneHz = toneOsc.frequency.value;
  }

  function stopTone() {
    if (!toneOsc || !toneGain) return;
    const ac = audio();
    toneGain.gain.setTargetAtTime(0.0001, ac.currentTime, 0.03);
    toneOsc.stop(ac.currentTime + 0.2);
    toneOsc = null;
    toneGain = null;
    toneBtn.textContent = 'play tone';
    toneBtn.setAttribute('aria-pressed', 'false');
    if (E2E) hook.toneHz = null;
  }

  toneBtn.addEventListener('click', () => (toneOsc ? stopTone() : startTone()));

  const stepRef = (d: number) => {
    refMidi = Math.min(96, Math.max(36, refMidi + d)); // C2..C7
    store.set('mt:ref', String(refMidi));
    refLabel();
    if (toneOsc) retune();
  };
  $('mt-note-down').addEventListener('click', () => stepRef(-1));
  $('mt-note-up').addEventListener('click', () => stepRef(1));

  // ── metronome ─────────────────────────────────────────────────────────────
  const runBtn = $('mt-run') as unknown as HTMLButtonElement;
  const bpmInput = $('mt-bpm') as unknown as HTMLInputElement;
  const pend = document.getElementById('mt-pend')!;
  const tickL = document.getElementById('mt-tickL')!;
  const tickR = document.getElementById('mt-tickR')!;

  // Persisted values are VALIDATED, not trusted: localStorage outlives the code
  // that wrote it.
  let bpm = clampBpm(Number(store.get('mt:bpm')) || 96);
  let beatsPerBar = Number(store.get('mt:beats'));
  if (!Number.isInteger(beatsPerBar) || beatsPerBar < 1 || beatsPerBar > 7) beatsPerBar = 4;
  // Subdivision runs 1–7 now (the string device made septuplets free — the engine's
  // tickAt never had a ceiling; only the old four-glyph selector did).
  let subdivision = Number(store.get('mt:sub'));
  if (!Number.isInteger(subdivision) || subdivision < 1 || subdivision > 7) subdivision = 1;
  bpmInput.value = String(bpm);

  // THE VOICES. Three sine pings — G6 opens the bar, C6 marks the beat, G5 sits
  // under the subdivisions at half the level.
  const VOICES = {
    down: { freq: 1568.0, gain: 0.5, dur: 0.09 },
    beat: { freq: 1046.5, gain: 0.4, dur: 0.07 },
    sub:  { freq: 784.0,  gain: 0.18, dur: 0.05 },
  } as const;

  const pending: Tick[] = [];

  function click(t: Tick) {
    const ac = audio();
    const v = VOICES[t.voice];
    const osc = ac.createOscillator();
    const g = ac.createGain();
    osc.type = 'sine';
    osc.frequency.value = v.freq;
    g.gain.setValueAtTime(v.gain, t.time);
    g.gain.exponentialRampToValueAtTime(0.0001, t.time + v.dur);
    osc.connect(g).connect(ac.destination);
    osc.start(t.time);
    osc.stop(t.time + v.dur + 0.02);
    pending.push(t);
    if (E2E) { hook.ticks.push(t); if (hook.ticks.length > 512) hook.ticks.shift(); }
  }

  const scheduler = new Scheduler(
    { bpm, beatsPerBar, subdivision },
    { now: () => audio().currentTime, play: click },
  );

  // THE SWING (chooser metrotuner-pendulum, Q1/02). The pendulum sweeps the arc
  // once per BEAT, synchronized to the scheduler's own tick times: the animation
  // reads the last played beat's audio-clock time and phase-locks a cosine to it,
  // so the bob strikes an end exactly when the click sounds — the sound and the
  // drawing share one clock, not two approximations of one.
  // Odd/even beats alternate direction; the end tick fattens on the strike, and
  // the DOWNBEAT's strike fattens more — bar position lives in the strike now that
  // the ring row is gone.
  // THE REST IS AN END, NOT THE CENTRE (user nit 1, 2026-08-04): a real pendulum
  // parks against its stop. Idle = leaning at the LEFT end; the first beat sweeps
  // away from it, and stopping lets the current sweep FINISH into whichever end it
  // was headed for, then rests there. No snap at start, no mid-air freeze at stop.
  const SWEEP_DEG = 54;
  const PARK_LEFT = -SWEEP_DEG;
  let lastBeat: Tick | null = null;   // the beat tick most recently PLAYED (clock-passed)
  let firstBeatIndex = -1;            // parity anchor: the FIRST sweep leaves the left park
  let raf = 0;

  function sweepAt(now: number): { deg: number; dir: number; phase: number } | null {
    if (!lastBeat) return null;
    const secPerBeat = 60 / bpm;
    const phase = Math.min(1, Math.max(0, (now - lastBeat.time) / secPerBeat));
    // Parity is anchored to the run's first beat, not to absolute time: the bob
    // rests at the LEFT end, so sweep 0 must go left→right whatever the clock says.
    const beatIndex = Math.round(lastBeat.time / secPerBeat);
    if (firstBeatIndex === -1) firstBeatIndex = beatIndex;
    const dir = (beatIndex - firstBeatIndex) % 2 === 0 ? 1 : -1;
    const deg = -dir * Math.cos(phase * Math.PI) * SWEEP_DEG;
    return { deg, dir, phase };
  }

  function swing() {
    if (!scheduler.running) return;
    const now = audio().currentTime;
    while (pending.length && pending[0].time <= now) {
      const t = pending.shift()!;
      if (t.voice !== 'sub') lastBeat = t;
    }
    const s = sweepAt(now);
    if (s) {
      pend.style.transform = `rotate(${s.deg}deg)`;
      // The strike: fatten the tick at the end the bob just left/reached.
      const nearEnd = s.phase < 0.12 ? -s.dir : s.phase > 0.88 ? s.dir : 0;
      const heavy = lastBeat!.voice === 'down' ? '5' : '3.5';
      tickL.setAttribute('stroke-width', nearEnd === -1 ? heavy : '0');
      tickR.setAttribute('stroke-width', nearEnd === 1 ? heavy : '0');
    }
    raf = requestAnimationFrame(swing);
  }

  // Stop: finish the sweep under way (wall-clock continuation of the same cosine —
  // the AudioContext keeps ticking after scheduler.stop(), so the phase math holds),
  // land on the end it was headed for, rest there.
  function finishSweep() {
    const s = sweepAt(audio().currentTime);
    if (!s || s.phase >= 1) { restPendulum(s ? s.dir * SWEEP_DEG : PARK_LEFT); return; }
    const settle = () => {
      const cur = sweepAt(audio().currentTime);
      if (!cur || cur.phase >= 1) { restPendulum((s.dir) * SWEEP_DEG); return; }
      pend.style.transform = `rotate(${cur.deg}deg)`;
      raf = requestAnimationFrame(settle);
    };
    raf = requestAnimationFrame(settle);
  }

  function restPendulum(deg: number) {
    cancelAnimationFrame(raf);
    pend.style.transform = `rotate(${deg}deg)`;
    pend.classList.add('rest');
    pend.classList.remove('live');
    tickL.setAttribute('stroke-width', '0');
    tickR.setAttribute('stroke-width', '0');
  }
  restPendulum(PARK_LEFT);

  // Reduced motion: the pendulum parks and the end ticks alone carry the beat —
  // a stroke-width change is a state, not a motion.
  const stillPend = window.matchMedia('(prefers-reduced-motion: reduce)');

  function startMetro() {
    audio();
    pending.length = 0;
    lastBeat = null;
    firstBeatIndex = -1;
    scheduler.start();
    runBtn.textContent = 'stop the metronome';
    runBtn.setAttribute('aria-pressed', 'true');
    pend.classList.remove('rest');
    pend.classList.add('live');
    if (stillPend.matches) {
      // ticks only: poll the queue on a coarse interval, no sweep
      const tickOnly = () => {
        if (!scheduler.running) return;
        const now = audio().currentTime;
        while (pending.length && pending[0].time <= now) {
          const t = pending.shift()!;
          if (t.voice !== 'sub') {
            const beatIndex = Math.round(t.time / (60 / bpm));
            const heavy = t.voice === 'down' ? '5' : '3.5';
            const left = beatIndex % 2 === 0;
            tickL.setAttribute('stroke-width', left ? heavy : '0');
            tickR.setAttribute('stroke-width', left ? '0' : heavy);
          }
        }
        raf = requestAnimationFrame(tickOnly);
      };
      raf = requestAnimationFrame(tickOnly);
    } else {
      raf = requestAnimationFrame(swing);
    }
  }

  function stopMetro() {
    scheduler.stop();
    pending.length = 0;
    cancelAnimationFrame(raf);
    if (stillPend.matches) {
      restPendulum(PARK_LEFT);
    } else {
      // nit 1: the sweep under way completes into its end. lastBeat is NOT nulled
      // here — finishSweep's frames read it after this returns; startMetro resets it.
      finishSweep();
    }
    runBtn.textContent = 'start the metronome';
    runBtn.setAttribute('aria-pressed', 'false');
  }

  runBtn.addEventListener('click', () => (scheduler.running ? stopMetro() : startMetro()));

  function applySpec() {
    scheduler.setSpec({ bpm, beatsPerBar, subdivision });
    store.set('mt:bpm', String(bpm));
    store.set('mt:beats', String(beatsPerBar));
    store.set('mt:sub', String(subdivision));
  }

  const setBpm = (v: number) => {
    bpm = clampBpm(v);
    bpmInput.value = String(bpm);
    applySpec();
  };
  bpmInput.addEventListener('change', () => setBpm(Number(bpmInput.value)));
  $('mt-bpm-down').addEventListener('click', () => setBpm(bpm - 4));
  $('mt-bpm-up').addEventListener('click', () => setBpm(bpm + 4));

  const tap = createTapTempo();
  $('mt-tap').addEventListener('click', () => {
    const t = tap.tap(performance.now());
    if (t !== null) setBpm(t);
  });

  // THE RULED MEASURE (metrotuner-meter-final Q1/02). The digits are the buttons;
  // one hairline under them is the value — GROW for beats (the rule extends to
  // digit N, a 2.5px tick at its left terminus = the downbeat), CUT for subdivide
  // (the rule spans one fixed beat and is cut into n equal dashes). Digits paint
  // ink inside the value (grow) / the value digit alone (cut).
  const PITCH = 20; // one digit cell, px — matches .rbtn width
  const wireRuled = (segId: string, attr: string, kind: 'grow' | 'cut', apply: (v: number) => void) => {
    const seg = document.getElementById(segId)!;
    const rule = seg.querySelector('.rm-rule')!;
    const paint = (v: number) => {
      seg.querySelectorAll('button').forEach((x) => {
        const n = Number(x.getAttribute(attr));
        x.setAttribute('aria-pressed', n === v ? 'true' : 'false');
        x.classList.toggle('on', kind === 'grow' ? n <= v : n === v);
      });
      let h = '';
      if (kind === 'grow') {
        const x2 = (v - 1) * PITCH + 10;
        h = `<line x1="1.5" y1="1" x2="1.5" y2="8" stroke="var(--ink)" stroke-width="2.5"/>`
          + `<line x1="1" y1="4" x2="${x2}" y2="4" stroke="var(--ink)" stroke-width="1.5"/>`;
      } else {
        const W = 6 * PITCH + 10; // one beat = the full scale width, fixed
        const gap = 3;
        const segw = (W - (v - 1) * gap) / v;
        for (let k = 0; k < v; k++) {
          const x = 1 + k * (segw + gap);
          h += `<line x1="${x}" y1="4" x2="${x + segw}" y2="4" stroke="var(--ink)" stroke-width="1.5"/>`;
        }
      }
      rule.innerHTML = h;
    };
    seg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b || !seg.contains(b)) return;
      const v = Number(b.getAttribute(attr));
      if (!v) return;
      paint(v);
      apply(v);
    });
    return paint;
  };
  const restoreBeats = wireRuled('mt-beats-seg', 'data-beats', 'grow', (v) => { beatsPerBar = v; applySpec(); });
  const restoreSub = wireRuled('mt-sub-seg', 'data-sub', 'cut', (v) => { subdivision = v; applySpec(); });
  restoreBeats(beatsPerBar);
  restoreSub(subdivision);

  // ── the swipe indicator (chooser Q3/02) ──────────────────────────────────
  // The pages are a CSS snap-scroller; JS only keeps the dots honest and gives the
  // gesture a click-shaped fallback. The disc is the page on screen, the ring is
  // the other one — the same outline-vs-fill signal the site's mark carries.
  const pages = document.getElementById('mt-pages')!;
  const dotBtns = Array.from(document.querySelectorAll('#mt-dots button'));
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The page WORDS (nit, 2026-08-04): current page ink, the other faint+underlined.
  function drawPageDots() {
    const idx = pages.clientWidth ? Math.round(pages.scrollLeft / pages.clientWidth) : 0;
    dotBtns.forEach((b, i) => b.classList.toggle('cur', i === idx));
  }

  let scrollRaf = 0;
  pages.addEventListener('scroll', () => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => { scrollRaf = 0; drawPageDots(); });
  }, { passive: true });

  dotBtns.forEach((b) => {
    b.addEventListener('click', () => {
      const i = Number(b.getAttribute('data-goto'));
      pages.scrollTo({
        left: i * pages.clientWidth,
        behavior: still.matches ? 'auto' : 'smooth',
      });
    });
  });
  drawPageDots();

  // Leaving the page: stop everything. A tab that keeps a mic open after
  // navigation shows a recording indicator for a page that no longer exists.
  // `stopTuner(false)`: the mic stops, the resume flag survives — see OPEN STARTED.
  addEventListener('pagehide', () => { stopTuner(false); stopMetro(); stopTone(); });
</script>
