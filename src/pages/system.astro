---
// /system/ — THE DESIGN SYSTEM, RENDERED.
//
// Task #7's visualizer. It is a Storybook in the only form that suits this site: every specimen
// below is the REAL device, drawn by the real class, so the page cannot claim a token or a rule
// the stylesheet doesn't actually implement. There is no isolated component sandbox and no second
// copy of any CSS — a specimen that renders correctly here renders correctly on a case study,
// because it IS the case study's markup.
//
// It ships publicly because for someone who builds design systems, the system is the evidence.
// The three artifacts now reinforce each other: /method/ says how a decision gets made, /style/
// is the steering file that records the decisions, and /system/ shows the decisions rendered.
//
// WHAT THIS PAGE MUST NEVER BECOME: a gallery of components the site doesn't use. Basecoat ships
// 38; four are imported (see system.css) and only two are on any page. If a specimen here has no
// call site, delete the specimen — a design system documenting things nobody uses is a catalogue,
// and the reason this site has no dialog, dropdown or toast is that it needs none.
//
// The swatch/scale data below is written out rather than parsed from the CSS. A build-time parse
// was the first instinct and it is worse: `--group: 56px` is trivially greppable, but the REASON
// (two leadings, so a group break is unmistakably larger than the gap inside a group) is the part
// worth publishing, and that only exists in prose. So the values are duplicated here and asserted
// against the stylesheet at the bottom of this frontmatter — if a token moves and this page isn't
// updated, the build fails.
import Layout from '../layouts/Layout.astro';
import MarkFigure from '../components/MarkFigure.astro';
import css from '../styles/global.css?raw';

const COLOUR = [
  { t: '--paper',  v: '#f4f3ef', d: '#141413', job: 'The ground. Warm off-white, near-black in dark.' },
  { t: '--ink',    v: '#141412', d: '#f0efe8', job: 'The fact. Titles, values, emphasis.' },
  { t: '--dim',    v: '#5f5e57', d: '#a09f96', job: 'Support. Body copy, blurbs, ledger values.' },
  { t: '--faint',  v: '#6e6d64', d: '#8f8e85', job: 'Annotation. Labels, meta, hung heads.' },
  { t: '--line',   v: '#d5d4cd', d: '#2b2b27', job: 'The one hairline. Link underlines, the field.' },
  { t: '--accent', v: '#14306b', d: '#6ea8ff', job: 'Interaction, and nothing else. 11.36:1 on paper.' },
];

const SPACE = [
  { t: '--tight', v: 14,  n: '0.5 lead', job: 'A label to its own value. The pair is one object.' },
  { t: '--lead',  v: 28,  n: '1 lead',   job: 'Between lines, and between peer rows.' },
  { t: '--group', v: 56,  n: '2 leads',  job: 'Between groups inside a section.' },
  { t: '--sect',  v: 112, n: '4 leads',  job: 'Between sections. The largest interval.' },
];

// ── the assertions. A token that moves in global.css must move here too.
const must: [string, string][] = [
  ['--step:15px', 'the one size'],
  ['--lead:28px', 'the leading'],
  ['--tight:14px', 'the tight pair'],
  ['--group:56px', 'the group interval'],
  ['--sect:112px', 'the section interval'],
  ['--ink:#141412', 'ink'],
  ['--dim:#5f5e57', 'dim'],
  ['--faint:#6e6d64', 'faint'],
  ['--design:#14306b', 'the hue'],
  // THE DERIVED LABEL COLUMN (chooser: andrewshiau-grid-options, Q4/02). Asserted as the whole
  // expression rather than as a value, because the POINT of it is that it is derived: a future
  // edit that quietly puts `--label:154px` back would keep this page's prose true at 1120 and
  // wrong at every other width, which is the exact defect the token replaced.
  ['--track:calc((min(100vw,var(--measure))-var(--gutter)*13)/12)', 'the derived track'],
  ['--label:calc(var(--track)*2+var(--gutter))', 'the label column, two tracks + a gutter'],
  // THE DOCUMENT'S WIDTH (Q1/02). Eight of twelve. If this goes back to `1 / 8`, the bleed
  // arithmetic this page describes stops adding up.
  ['.pin,.feed{grid-column:1 / 9}', 'the document — 8 of 12'],
];

// AND ONE NEGATIVE ASSERTION, which the nine above could not have caught. "Nothing breaks out"
// (Q2/03) is a claim about what ISN'T in the stylesheet, so it needs a check that fails when
// something comes back: no `--bleed` token, and no block growing itself past its column with a
// `width:calc(100% + …)`. Every phantom-measure bug in this redesign lived in one of those.
const mustNot: [string, string][] = [
  ['--bleed', 'the media bleed'],
  ['width:calc(100%+var(--label)', 'a hung block bleeding right'],
];
// Comments are stripped before the check. Without this, every `mustNot` below matches its own
// explanation in global.css's prose — `--bleed` is named in the paragraph that records why it was
// deleted, so the negative assertion would fail on the comment that documents the fix.
const flat = css.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, '');
for (const [decl, name] of must) {
  if (!flat.includes(decl.replace(/\s+/g, ''))) {
    throw new Error(
      `/system/ documents "${decl}" (${name}) and global.css no longer declares it. ` +
      'Update the specimen on /system/ or restore the token — a visualizer that lies is worse ' +
      'than no visualizer.'
    );
  }
}
for (const [decl, name] of mustNot) {
  if (flat.includes(decl.replace(/\s+/g, ''))) {
    throw new Error(
      `/system/ states that nothing breaks out of the document, and global.css declares ` +
      `"${decl}" (${name}). Either the bleed came back — in which case the page's arithmetic ` +
      'and the "one width" claim are both wrong — or this assertion needs to go with a ' +
      'deliberate decision to reverse chooser Q2/03.'
    );
  }
}
---

<Layout
  title="System — Andrew Shiau"
  description="The design system for andrewshiau.com, rendered: tokens, the space scale, the two axes, and every device on the site with its rule."
>
  <div class="grid">
    <!-- Panel written out, not PanelHead: `metaOf()` throws for an href that isn't an artifact in
         experiments.ts, and /system/ must not be one — it would appear as a tenth project in the
         Work matrix. Same reasoning as /style/. -->
    <div class="pin">
      <p class="smark">System</p>
      <h1>The system</h1>
      <div class="facts">
        <div class="frow">
          <div class="fm">What</div>
          <div class="ftx">Every token and every device on this site, drawn by the real class.
            Nothing here is a mock-up.</div>
        </div>
        <div class="frow">
          <div class="fm">Base</div>
          <div class="ftx"><a href="https://basecoatui.com" target="_blank" rel="noopener">Basecoat</a>
            — <b>shadcn/ui's components without React</b>. Its 149 tokens are bound to the ones
            below, so a Basecoat component inherits this system instead of overriding it.</div>
        </div>
        <!-- Paths, both of them (chooser: andrewshiau-index-artifacts, Q2/02). This row already
             mixed the two conventions in one sentence — `STYLE.md` beside `/method/` — which is
             the inconsistency the pick resolves: an internal page is named by its path, and
             STYLE.md the FILE is named as a file only where the file itself is meant (see
             /style/'s own ledger, which links the repo). -->
        <div class="frow">
          <div class="fm">Written down</div>
          <!-- `{' '}` is load-bearing, not decoration. Astro collapses the newline between a
               text node and an inline tag to nothing, so this rendered as "rendered./method/" —
               one token to find-in-page and to a screen reader. The same class of defect was on
               the index h1 and on /style/'s word count; an explicit space is the only fix that
               survives someone re-wrapping the line later. -->
          <div class="ftx"><a href="/style/">/style/</a> is the steering file, rendered.{' '}
            <a href="/method/">/method/</a> is how a decision gets made.</div>
        </div>
      </div>
      <!-- No Contact row, the same as the case studies (annotation: "remove from every page
           (execpt home obv)"). This page hand-rolls its panel rather than using PanelHead, so
           the deletion had to happen here too. -->
    </div>

    <div class="splitrule" aria-hidden="true"></div>

    <div class="feed">
      <div class="grid">
        <p class="dek c1-12">One typeface, one size, no rules. Hierarchy comes from colour value
          and space — so those are the two things this page has to show.</p>
      </div>

      <!-- ── COLOUR ─────────────────────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>Colour</h2>
          <div class="sbody">
            <p>Six tokens. Three are greys doing three jobs, and the split between them is the
              site's primary hierarchy mechanism now that there is no type ramp. One is a hue, and
              it means <b>you can act on this</b> — a link, or the hovered row. A coloured mark
              that isn't interactive is a defect.</p>
          </div>
        </div>
      </div>
      <!-- The specimen list is OUT of `.sbody` on purpose. Inside it, the 62ch prose cap left the
           job column 11ch for a 26-character sentence and every row wrapped to six lines —
           measured, and visible immediately. A specimen list is a TABLE, not prose: it wants the
           full document column, and `62ch` is a rule about reading a paragraph. -->
      <div class="grid">
        <div class="sysrows">
          {COLOUR.map((c) => (
            <div class="sysrow">
              <span class="sw" style={`--sw:${c.v}`} aria-hidden="true"></span>
              <code>{c.t}</code>
              <span class="sysv">{c.v} / {c.d}</span>
              <span class="sysj">{c.job}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- ── THE SPACE SCALE ───────────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>Space</h2>
          <div class="sbody">
            <p>Four steps, each a multiple of the 28px leading, so every element on every page
              sits on one baseline. The ratio is <b>2× at every step</b>: a reader can't measure 14
              against 20, but 28 against 56 is unmistakable, and 56 against 112 is unmistakable
              again. Hierarchy by doubling — the trick a type ramp uses, on the axis that still had
              room in it.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="sysrows">
          {SPACE.map((s) => (
            <div class="sysrow sysrow-bar">
              <span class="bar" style={`--h:${s.v}px`} aria-hidden="true"></span>
              <code>{s.t}</code>
              <span class="sysv">{s.v}px · {s.n}</span>
              <span class="sysj">{s.job}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- ── THE TWO AXES ─────────────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>The two axes</h2>
          <div class="sbody">
            <p>One token sets both: <code>--label</code>, which is <b>two columns of the page's
              own grid plus the gutter</b> — 154px at the measure, so the content axis is 182px,
              exactly where column 3 begins. Everything that annotates starts at column 1;
              everything annotated starts on that axis. The specimen below is a real <code>.facts</code> ledger — the same markup a case study uses, so its label sits on
              the same vertical as this section's own head.</p>
            <p>It was <code>16ch</code> — a flat 144px, measured against the longest label on the
              site. Right about typography, <b>wrong about the grid</b>: the axis landed at 172px
              while column 3 starts at 182, so every ledger, head and panel put its value 10px
              inside the gutter. Two grids were running at once and the typographic one was
              quietly winning. Press <code>⌥G</code> and it is the only thing you can see; without
              the overlay, four passes missed it.</p>
            <p>Derived, the two grids agree at every width. The formula also sets the one
              breakpoint that matters: <code>--label</code> falls to 144px — the width of that
              16-character label — at exactly <b>1060px</b>, which is where the hung layout stops
              and every label stacks.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="facts">
          <div class="frow">
            <div class="fm">Annotation</div>
            <div class="ftx">Column 1. The marker, the <code>h1</code>, every field label, every
              section head.</div>
          </div>
          <div class="frow">
            <div class="fm">Content</div>
            <div class="ftx"><code>--label</code> + gutter — <b>182px, column 3's left edge</b>.
              Every value, every paragraph, the dek, and media.</div>
          </div>
          <!-- The measure is its own row now. It used to be a clause on the row above ("capped at
               62 characters"), which was the same mistake the colophon made: a fact about width
               riding along on a fact about position. It also needed a qualifier — a plain
               paragraph is 62ch, but a hung block's prose is 57, because the label column takes
               182 of the document's 700. Stated as its own row, both numbers fit and neither
               needs an apology. -->
          <div class="frow">
            <div class="fm">Measure</div>
            <div class="ftx">A paragraph caps at <b>62 characters</b>, the band a reader tracks.
              Inside a hung block it is 57 — the label column spends the difference, and the
              column binds before the cap does.</div>
          </div>
        </div>
      </div>

      <!-- ── THE GRID ─────────────────────────────────────────────────────────────────
           NEW SECTION. The page documented tokens, space, the axes, the marker, states and the
           field — and never the grid, which is the largest decision in the system and the one the
           whole proof-sheet round was about. A visualizer that omits the page's own column
           structure is describing the paint and not the frame. -->
      <div class="grid sect">
        <div class="shead">
          <h2>The grid</h2>
          <div class="sbody">
            <p>Twelve columns, a 28px gutter, capped at a 1120px measure — so a track is 63px and
              the document is 1064px wide on any screen bigger than that. Press <code>⌥G</code> to
              see it on any page.</p>
            <p>The page places <b>one column, eight of the twelve</b>. The four to its right are
              margin and stay empty: putting type in them would make the margin a column, and the
              document would be two columns again. That left weight is the most recognisable thing
              about the site, and it is a single declaration.</p>
            <p><b>Nothing breaks out of it.</b> A figure spans the document, the same as a
              paragraph. There used to be three widths on one page — 609 for prose, 781 for heads
              and ledgers, 1064 for media, each derived by its own formula and none of them named —
              and a reader could see all three at once. It also removed a whole class of defect:
              every phantom-measure bug in this redesign, four of them, was inside a bleed formula.
              A block that just spans the document cannot be measured against the wrong grid.</p>
            <p>What it costs: media is 700px rather than 1064. A screenshot that needs 1064px to
              read should be its own page, not a reason for fifteen other pages to carry a second
              measure.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="sysrows">
          <div class="sysrow">
            <code>--measure</code>
            <span class="sysv">1120px</span>
            <span class="sysj">The page's cap. Above it, every screen gets the same document.</span>
          </div>
          <div class="sysrow">
            <code>--gutter</code>
            <span class="sysv">28px</span>
            <span class="sysj">One leading. The gutter is a space-scale value, not its own number.</span>
          </div>
          <div class="sysrow">
            <code>--track</code>
            <span class="sysv">63px at the measure</span>
            <span class="sysj">Derived: (min(100vw, measure) − 13 gutters) / 12.</span>
          </div>
          <div class="sysrow">
            <code>--label</code>
            <span class="sysv">154px at the measure</span>
            <span class="sysj">Two tracks + a gutter. The annotation column, on a grid line.</span>
          </div>
          <div class="sysrow">
            <code>1 / 9</code>
            <span class="sysv">700px at the measure</span>
            <span class="sysj">The document. Eight of twelve, on every page.</span>
          </div>
          <div class="sysrow">
            <code>1060px</code>
            <span class="sysv">the one breakpoint</span>
            <span class="sysj">Where --label falls to 144px and every hung label stacks.</span>
          </div>
        </div>
      </div>

      <!-- ── ONE MECHANISM PER JOB ────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>One mechanism per job</h2>
          <div class="sbody">
            <p>The rule that governs every hierarchy decision, and the one that catches the
              defects: a label earns its hierarchy from <b>position</b> if it has a position,
              otherwise from <b>value</b>. Never both. That is why the ledger label above is faint
              — it has a column, so it doesn't also need a colour change — and why the colophon's
              stacked labels are ink.</p>
            <p>Both specimens below are live. The left is hung, the right is stacked, and the only
              difference in the CSS is which one gets <code>--ink</code>.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="syspair">
          <div>
            <div class="frow">
              <div class="fm">Hung</div>
              <div class="ftx">Faint label. The column is the hierarchy.</div>
            </div>
          </div>
          <div>
            <span class="ck">Stacked</span>
            <span class="sysstack">Ink label. There is no column, so value is.</span>
          </div>
        </div>
      </div>

      <!-- ── THE MARKER ──────────────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>The marker</h2>
          <div class="sbody">
            <p>The site's only mark, and its only job is to carry a fact: which half of the
              practice a row belongs to. <b>Outline vs. fill</b> is the signal, not colour — the two
              old duality hues were 2.14:1 apart in greyscale, so a screenshot or a colourblind
              reader saw two identical dots. Both circles are <code>r="5"</code> with the same 1.8
              stroke, so the ring and the disc are the same 11.8 units across — and the two
              one-sided marks are the same 16.2 as each other.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="sysmarks">
          <div><span class="side"><MarkFigure side="both" /></span><code>both</code>
            <span class="sysj">design + build</span></div>
          <div><span class="side"><MarkFigure side="design" /></span><code>design</code>
            <span class="sysj">the ring alone</span></div>
          <div><span class="side"><MarkFigure side="build" /></span><code>build</code>
            <span class="sysj">the disc alone</span></div>
        </div>
      </div>

      <!-- ── STATES ─────────────────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>States</h2>
          <div class="sbody">
            <p>Hover the row. The title steps right by exactly <code>1ch</code> — one character
              cell of the monospace grid — its underline goes to ink, and the numeral darkens.
              Nothing fades, nothing scales, nothing tints. It is mirrored on <code>:focus-visible</code>, because a shift only a mouse can trigger is a
              mouse-only affordance.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="matrix">
          <a class="entry" href="/system/">
            <span class="en">01</span>
            <span class="eh">Hover this row</span>
            <span class="ends"></span>
            <span class="em">
              <span class="side"><MarkFigure side="both" /></span>
              <span class="smeta">the 1ch shift</span>
            </span>
          </a>
          <a class="entry" href="/system/">
            <span class="en">02</span>
            <span class="eh">Or tab to it</span>
            <span class="ends"></span>
            <span class="em">
              <span class="side"><MarkFigure side="design" /></span>
              <span class="smeta">focus-visible</span>
            </span>
          </a>
        </div>
      </div>

      <!-- ── THE FIELD ─────────────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>The field</h2>
          <div class="sbody">
            <p>The site's only form control, and the only Basecoat component on a real page. It is
              a <b>line you type on</b>, not a box: every other border came out with the document
              direction, which makes this one unambiguous — a horizontal rule under text means
              "type here" and means nothing else. 16px is the one deliberate size exception,
              because below it iOS Safari zooms the page on focus.</p>
            <p>There is no button anywhere on this site. The gate checks as you type.</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <div class="sysfield">
          <div class="f">
            <input type="text" class="gi" placeholder="Type here" aria-label="Specimen field" />
          </div>
        </div>
      </div>

      <!-- ── WHAT IS NOT HERE ─────────────────────────────────────────────────── -->
      <div class="grid sect">
        <div class="shead">
          <h2>What isn't here</h2>
          <div class="sbody">
            <p>Basecoat ships 38 components. Four are imported and two are used. There is no
              dialog, dropdown, menu, tabs, table of data, toast, popover, sidebar, chart, or
              command palette — not because they'd be hard, but because nothing on this site needs
              one, and a system that documents unused components is a catalogue.</p>
            <!-- THIS SENTENCE USED TO END "…and a single line of JavaScript in the bundle," and
                 it was false on the page that opens "Nothing here is a mock-up." Two script
                 blocks ship on /system/ itself, /gate/ says out loud that the password box needs
                 JavaScript, and four lines above this the page says "The gate checks as you
                 type." The one claim a reader could falsify from the next tab was the one closing
                 the page.
                 It was also a six-item list where the pattern is five, which is how it got
                 written: the rhythm wanted one more clause and the clause wasn't true. Stating
                 what the JS actually is costs a sentence and can be checked. -->
            <p>Also absent: a type ramp, a second typeface, a filled surface, a rounded corner,
              and a second hue.</p>
            <p>The JavaScript is three things: the <code>⌥G</code> toggle, a reduced-motion pass
              that pauses the clips, and the quiz engine on three pages. Nothing else ships.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
