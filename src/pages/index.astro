---
import Layout from '../layouts/Layout.astro';
import { work, experiments } from '../data/experiments';
import SideDot from '../components/SideDot.astro';
---

<Layout title="Andrew Shiau">
  <!-- Masthead + thesis as ONE typographic sentence (chooser pick 04), set as a single
       element. An h1 + a p can't share a line, so that version always broke before the
       thesis and read as two stacked statements; inline spans let the sentence run on
       and wrap only where the measure ends, so the colour changes mid-line. The two
       clauses carry the two hues — the only place in body copy where colour is allowed,
       because here the two halves of the practice ARE the subject. The wordmark in the
       nav already says the name, so this isn't a repeat. -->
  <div class="grid" style="margin-top:calc(var(--unit)*1.5)">
    <h1 class="statement c1-10">Andrew Shiau is a frontend engineer who designs and builds,
      chasing simplicity. <span class="t-design">Taste finds the simplest form</span>,
      <span class="t-build">engineering proves the simplest solution</span>.</h1>
  </div>

  <!-- Work + Experiments — ONE reference list, the same ruled table twice: number ·
       title · blurb · marker. This replaced a calendar scatter in both sections. The
       scatter composed better in isolation and indexed worse: both sections used it, so
       only the heading distinguished them, and the page ran ~2.5 screens with neither
       list ever whole in view. An index's job is to show what's there.
       The two sections are now separated by air alone (.grid.sect), same as a case-study
       section break — one device, used everywhere. -->
  <div class="grid sect">
    <div style="grid-column:1 / 5"><h2>Work</h2></div>
  </div>

  <div class="matrix">
    {work.map((x) => (
      <a class:list={['entry', { accent: x.accent }]} href={x.href}
         target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
        <span class="en">{x.n}</span>
        <p class="eh">{x.title} <span class="arrowc">{x.external ? '↗' : '→'}</span></p>
        <p class="ed">{x.blurb}</p>
        <span class="em">
          <SideDot side={x.side} />
          <span class="smeta">{x.meta}</span>
        </span>
      </a>
    ))}
  </div>

  <div class="grid sect">
    <div style="grid-column:1 / 5"><h2>Experiments</h2></div>
  </div>

  <div class="matrix">
    {experiments.map((x) => (
      <a class:list={['entry', { accent: x.accent }]} href={x.href}
         target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
        <span class="en">{x.n}</span>
        <p class="eh">{x.title} <span class="arrowc">{x.external ? '↗' : '→'}</span></p>
        <p class="ed">{x.blurb}</p>
        <span class="em">
          <SideDot side={x.side} />
          <span class="smeta">{x.meta}</span>
        </span>
      </a>
    ))}
  </div>

  <!-- Colophon — placed on the grid, not stacked full-width. Label column at the
       left, three facts as aligned satellites; the right columns stay empty. -->
  <div class="grid" style="margin-top:calc(var(--unit)*3)">
    <div class="colo-rule"></div>
    <div class="colo-lab">Colophon</div>
    <div class="colo c1">
      <span class="ck">Contact</span>
      <a href="mailto:hi@andrewshiau.com">hi@andrewshiau.com</a>
    </div>
    <div class="colo c2">
      <span class="ck">Elsewhere</span>
      <a href="https://github.com/halfcadence" target="_blank" rel="noopener">github</a><br />
      <a href="https://www.instagram.com/half_cadence" target="_blank" rel="noopener">instagram</a>
    </div>
    <div class="colo c3">
      <span class="ck">Before AI</span>
      <a href="https://2018.andrewshiau.com" target="_blank" rel="noopener">portfolio2018</a>
    </div>
  </div>
</Layout>
