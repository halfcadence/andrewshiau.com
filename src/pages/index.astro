---
import Layout from '../layouts/Layout.astro';
import { work, experiments, SIDE_LABEL } from '../data/experiments';
---

<Layout title="Andrew Shiau">
  <!-- Masthead + thesis as ONE typographic block (chooser pick 04). The h1 and the
       thesis are set identically — same ramp step, same weight, no gap between them —
       so they read as one four-clause statement rather than headline + dek. The h1
       carries the ink; the thesis carries the two hues. The wordmark in the nav already
       says the name, so the h1 doesn't repeat it as a standalone line. -->
  <!-- One .grid, not two, so no `.grid + .grid` unit lands between the two lines —
       the whole point of the block is that they touch. The two clauses carry the two
       hues: the only place in body copy where colour is allowed, because here the two
       halves of the practice ARE the subject. Each entry below is marked with its side. -->
  <div class="grid" style="margin-top:calc(var(--unit)*1.5)">
    <h1 class="statement c1-10">Andrew Shiau is a frontend engineer who designs and builds, chasing simplicity.</h1>
    <p class="statement thesis c1-10">
      <span class="t-design">Taste finds the simplest form</span>,
      <span class="t-build">engineering proves the simplest solution</span>.
    </p>
  </div>

  <!-- Work — professional projects. Same calendar-scatter matrix as Experiments. -->
  <div class="grid" style="margin-top:calc(var(--unit)*2)">
    <div class="rule"></div>
    <div style="grid-column:1 / 5"><h2>Work</h2></div>
  </div>

  <div class="matrix matrix-compact">
    {work.map((x) => (
      <a class={`entry ${x.pos} ${x.accent ? 'accent' : ''}`} href={x.href}
         target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
        <span class="en">{x.n}</span>
        <p class="eh">{x.title} <span class="arrowc">{x.external ? '↗' : '→'}</span></p>
        <p class="ed">{x.blurb}</p>
        <span class="em">
          <span class={`side side-${x.side}`}>{SIDE_LABEL[x.side]}</span>
          <span class="smeta">{x.meta}</span>
        </span>
      </a>
    ))}
  </div>

  <!-- Experiments — the AI-forward work. Calendar-scatter matrix (Layout A);
       the empty modules between cells are the composition. -->
  <div class="grid" style="margin-top:calc(var(--unit)*3)">
    <div class="rule"></div>
    <div style="grid-column:1 / 5"><h2>Experiments</h2></div>
  </div>

  <div class="matrix">
    {experiments.map((x) => (
      <a class={`entry ${x.pos} ${x.accent ? 'accent' : ''}`} href={x.href}
         target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
        <span class="en">{x.n}</span>
        <p class="eh">{x.title} <span class="arrowc">{x.external ? '↗' : '→'}</span></p>
        <p class="ed">{x.blurb}</p>
        <span class="em">
          <span class={`side side-${x.side}`}>{SIDE_LABEL[x.side]}</span>
          <span class="smeta">{x.meta}</span>
        </span>
      </a>
    ))}
  </div>

  <!-- Colophon — placed on the grid, not stacked full-width. Label column at the
       left, three facts as aligned satellites; the right columns stay empty. -->
  <div class="grid" style="margin-top:calc(var(--unit)*3)">
    <div class="colo-rule"></div>
    <div class="colo-lab">Colophon</div>
    <div class="colo c1">
      <span class="ck">Contact</span>
      <a href="mailto:hi@andrewshiau.com">hi@andrewshiau.com</a>
    </div>
    <div class="colo c2">
      <span class="ck">Elsewhere</span>
      <a href="https://github.com/halfcadence" target="_blank" rel="noopener">github</a><br />
      <a href="https://www.instagram.com/half_cadence" target="_blank" rel="noopener">instagram</a>
    </div>
    <div class="colo c3">
      <span class="ck">Before AI</span>
      <a href="https://2018.andrewshiau.com" target="_blank" rel="noopener">portfolio2018</a>
    </div>
  </div>
</Layout>
