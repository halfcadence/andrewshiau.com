---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Andrew Shiau">
  <div class="grid">
    <div class="pin">
      <h1 class="statement">I'm Andrew Shiau, frontend engineer who designs and builds. I&nbsp;value
        simplicity, curiosity and kindness.</h1>

      <div class="pled">
        <div class="prow">
          <span class="pk">Currently</span>
          <span class="pv">Designing the Amazon store with AI.</span>
        </div>
        <div class="prow">
          <span class="pk">Also</span>
          <!-- `&#32;` not a newline: compressHTML drops the space. Not `&nbsp;`: welded to the
               band name it overflows 320px. -->
          <span class="pv">Playing in two Seattle bands
            (<a href="https://www.instagram.com/panavallenato/" target="_blank" rel="noopener">Vallenato&nbsp;Panamericano</a>,&#32;<a
              href="https://www.instagram.com/_baobella/" target="_blank" rel="noopener">Baobella</a>) and baking canelés.</span>
        </div>
      </div>

      <div class="pfeet">
        <p class="pfoot">Contact
          <a href="mailto:hi@andrewshiau.com">hi@andrewshiau.com</a>
        </p>
        <p class="pfoot">Resume
          <a href="/resume/">/resume</a>
        </p>
        <p class="pfoot">Elsewhere
          <a href="https://www.linkedin.com/in/halfcadence/" target="_blank" rel="noopener">linkedin</a>
          <a href="https://github.com/halfcadence" target="_blank" rel="noopener">github</a>
          <a href="https://www.instagram.com/half_cadence" target="_blank" rel="noopener">instagram</a>
          <a href="https://halfcadence.github.io/recipes/" target="_blank" rel="noopener">recipes</a>
          <a href="https://2018.andrewshiau.com" target="_blank" rel="noopener">portfolio2018</a>
        </p>
      </div>
    </div>
  </div>
</Layout>
