---
import Layout from '../layouts/Layout.astro';
import { THINGS, ROUTE_CASES, glyphSvg } from '../lib/practice-room/room';

// ══ ONE COMPONENT, FOUR ROUTES (2026-08-12, the owner's second correction) ══════════════════
// "i want to remove the scroll concept entirely (except on mobile console), each thing in the
// room is a standalone page with its own routing like practice.andrewshiau/console and you need
// to go back to room to get the other things."
//
// So the scroller is gone as a NAVIGATION device. Each route renders only its own cases:
//   /            the room — three boxes, each a link. Static: no script does anything here.
//   /console/    tuner + drone + metronome. The one place a scroll survives, and only on a phone.
//   /changes/    the chord dealer alone.
//   /loop/       the loop alone.
//
// WHY ONE COMPONENT AND NOT FOUR PAGES. The markup, the 2,700-line stylesheet and the script are
// one interdependent unit: the cases subgrid onto a row ladder declared once, the styles are
// scoped to THIS file's `data-astro-cid`, and splitting the style from the markup would silently
// unscope every selector. Four routes that each import this pay for the whole stylesheet and the
// whole script — the honest cost, and the reason the room page runs a script that does nothing.
// Per-route bundles need the script broken into modules first; that is a separate change.
//
// WHAT THE ROUTES DELETED, which is the point: `order:` juggling on the cases (the queue's way of
// re-sequencing without moving nodes), `data-snap`, the plan's `goTo`/`drawPlan`/`layoutRoom`, the
// `#console` hash deep links, the hash-follows-scroll sync, the room's own dot, and the explicit
// `scrollLeft = 0` that existed because a snap container follows the element it snapped to. A
// route IS the navigation, so none of that has anything left to do.
export interface Props {
  page: 'room' | 'console' | 'changes' | 'loop';
}
const { page } = Astro.props;

// WHICH CASES THIS ROUTE HOLDS, in the order they sit: room.ts's ROUTE_CASES, one route per
// thing plus the empty room. Source order IS the layout order — nothing re-sequences.
const cases = ROUTE_CASES[page];
const has = (k: string) => cases.includes(k);

// THE ROOM'S BOXES ARE BUILT AT BUILD TIME. `drawPlan()` used to write them from `THINGS` on
// every layout because the plan was a page of a scroller whose widths changed; a static index of
// three fixed things needs no script at all, and the marks are the same generated SVG the module
// exports. One fewer runtime path, and the room renders with JS off.
// ONE HEAD PER ROUTE. Four addresses that all said "Practice room — Andrew Shiau" would be four
// identical tabs and four identical shares; the description is what the page actually holds.
// `installable` stays on the ROOM alone: that is the app you pin, and its manifest's start_url is
// `/`. A thing's page is inside the same scope, so opening one from the installed app stays in it.
const META: Record<Props['page'], { title: string; description: string; h1: string }> = {
  room: {
    title: 'Practice room — Andrew Shiau',
    description:
      'A chromatic tuner, a metronome, a drone, a chord dealer and a transcription loop in the browser. Pitch detection runs on-device; the microphone signal never leaves the page.',
    h1: 'Practice room',
  },
  console: {
    title: 'Console — practice room',
    description:
      'A chromatic tuner, a drone and a metronome side by side: the three you use while playing. Pitch detection runs on-device; the microphone signal never leaves the page.',
    h1: 'Console — tuner, drone, metronome',
  },
  changes: {
    title: 'Changes — practice room',
    description:
      'A chord dealer: it deals a symbol, you name it or play it, and it sounds the answer. Triads, sevenths and altered chords.',
    h1: 'Changes — a chord dealer',
  },
  loop: {
    title: 'Loop — practice room',
    description:
      'Loop a span of any YouTube video at a quarter, a half or three-quarter speed, for transcribing by ear.',
    h1: 'Loop — a transcription looper',
  },
};

// THE HREFS ARE RELATIVE, and this is not a style preference — it is the only form that works on
// both hosts. The room is `/` on practice.andrewshiau.com and `/practice-room/` on the apex (and on
// `astro preview`), because the files live in that directory and nginx maps the pretty URL to them.
// So `/console/` is correct on one host and a 404 on the other, while `console/` resolves against
// whichever directory the room is being served from and is right on both. The way back is `../` for
// the same reason: `/` would leave the app for the site homepage on the apex.
const rooms = THINGS.map((t) => ({
  id: t.id, name: t.name, marks: t.keys.map((k) => glyphSvg(k)).join(''), href: `${t.id}/`,
}));

// THE INSTRUMENT SCREEN. This URL is the thing itself now, and the writeup lives at
// /work/practice-room/ (chooser: metrotuner-two-pages, Q1/02 "instrument first" — the
// index row opens the instrument; the case study moved in with the other eight,
// reachable from the one word at the foot of this screen).
//
// THE SHAPE IS A SCREEN, NOT THE DOCUMENT. Q2/01 "equal halves": on a wide viewport
// the tuner and the metronome each centre in half the screen, both running — two
// instruments, one practice, the same argument .duo makes on /method/. Q3/02 "swipe":
// under 1477px the cases become snap-scroll pages, and the indicator is the
// site's own pair — ring and disc, the disc marking where you are. 900 because that
// is the width where .duo stacks; this page's halves give at the same width the
// site's one other side-by-side does.
//
// The one deviation this page is allowed: it escapes .wrap's 1120px measure (the
// `:has(#mt-app)` rule below, global but shipped only in this page's chunk). A screen
// split into viewport halves cannot live inside a document measure. Everything else —
// tokens, type, the link idiom, the control styles — is the site's, unchanged.
//
// The engine is unchanged from the one-page version: pure modules in
// src/lib/practice-room/ (unit-tested to half a cent), this file is the glue. The ?e2e
// hook and every data-testid survive, so the fake-mic suite runs against this screen
// exactly as it ran against the document page.
---

<Layout
  title={META[page].title}
  description={META[page].description}
  installable={page === 'room'}
  practicePath={page === 'room' ? undefined : `/${page}/`}
>
  <div id="mt-app" data-page={page}>
    <h1 class="visually-hidden">{META[page].h1}</h1>

    <!-- THE CHROME ROW IS GONE (2026-08-12). It was one lead holding `← the room`, and the
         /proofs sheet's second question was exactly what that lead buys: 28px of every screen,
         for the whole session, to serve one press at the end of it. The mark moved onto the
         case's top rule beside the plate, which is a line the page already draws — so the row
         had nothing left to hold and the instrument is a lead taller at both widths. -->
    <div class="mt-pages" id="mt-pages">
      <!-- ── TUNER, the left case / first page ─────────────────────────────── -->
      <!-- THE CASE (chooser: metrotuner-pendulum, Q2/01): a square hairline case per
           instrument, its name on the frame like an engraved plate — the site's box
           rule holds by the embed-frame argument: inside is a machine, the border
           says where it starts. On the phone NO case is drawn: the viewport's own
           edges are the frame. THE FOOT LINE (Q3/01): every control in one line
           along the case's bottom edge; the hero owns the middle. -->
    {has('tuner') && (
      <section class="mt-half" aria-label="Tuner" data-mt-key="tuner">
        <!-- THE WAY BACK IS AN ARROW BESIDE THE NAME (his pick, 2026-08-12): "just putting a
             back arrow ← next to case name works for mobile and desktop very minimal". The
             chrome row is DELETED with it, so the instrument gets that lead back at both
             widths — the cost the /proofs sheet drew for every option that moved this mark.
             ONE GROUP, so nothing has to be positioned relative to a name whose width
             changes: the arrow and the plate are one absolutely-placed flex row straddling
             the case's top rule, and the ARROW is what lands on the case's 3ch datum. -->
        <span class="mt-np">
          <a class="mt-back" href="../" data-testid="plan-word" aria-label="Back to the practice room">←</a>
          <span class="mt-plate" aria-hidden="true">tuner</span>
        </span>
        <!-- CALIBRATION IS A TOP CONTROL now (user nit 6, 2026-08-04): it sets what
             the whole instrument means by "in tune", so it reads like a spec plate —
             top line, opposite the engraved name — rather than a control you play. -->
        <div class="mt-ctop">
          <span class="mt-fr">
            <!-- BARE NUMERAL (chooser metrotuner-round15, Q2/06): the value rails
                 are gone — the number is display and control.
                 THE DRAG IS ON THE UNIT NOW, not the whole control (chooser
                 metrotuner-scrub-target, pick 03 "unit only, with a padded target").
                 Figma's model: the label beside a field is the scrubber and the field
                 only types. One surface, one verb — the numeral no longer both accepts
                 a drag and opens a keyboard, which is what read as confusing. The
                 handles are `.mt-hd`; they carry invisible padding to a 44px target,
                 the same device `.pgword` uses on the page words. -->
            <!-- LOWERCASE LABELS (chooser metrotuner-meter-tap, pick Q3/02). Every
                 other word on the instrument is lowercase — beats, subdivide, tap,
                 play tone, start the metronome — and these two were the only capitals.
                 One rule, no exception to remember.
                 The cost, stated because it is real and was on the sheet: `hz` is not
                 the SI symbol (a unit named after a person is capitalised) and `a4` is
                 not how a note is written. Accepted on the grounds that these two are
                 LABELS ON A CONTROL, not values in a reading — and the values do keep
                 their case: the tuner's readout still says A4, and so does the
                 reference-tone button. The aria-labels spell it out properly, so
                 nothing announced to a screen reader is wrong. -->
            <span class="f mt-a4 mt-grp" id="mt-a4-scrub">
              <span class="mt-gl" aria-hidden="true">calibration</span>
              <label for="mt-a4" class="mt-lb mt-hd" title="drag ↔ to change the calibration">a4</label>
              <input id="mt-a4" data-testid="a4" type="number" inputmode="decimal"
                     min="400" max="480" step="1" value="440" title="type a value"
                     aria-label="A4 calibration in hertz — type a value, or drag the a4 or hz label horizontally" />
              <span class="mt-lb mt-hd" title="drag ↔ to change the calibration">hz</span>
            </span>
          </span>
        </div>
        <div class="mt-mid">
          <figure class="mt-gauge" aria-hidden="true">
            <!-- THE ARM AND BOB (chooser: metrotuner-pendulum, Q1/02) — the Wittner
                 silhouette: pivot, hairline arm, the disc as the bob. This REVERSES
                 round-1's dot-only pick, deliberately: the arm is the pendulum's,
                 not the meter's, and both instruments carry it so deflection and
                 swing read as one mechanic. The invert (Q2/02) is unchanged. -->
            <svg viewBox="0 0 320 184" id="mt-dial">
              <path d="M 34 160 A 126 126 0 0 1 286 160" fill="none" stroke="var(--faint)" stroke-width="1.5"/>
              <line id="mt-tick" x1="160" y1="26" x2="160" y2="42" stroke="var(--ink)" stroke-width="1.5"/>
              <!-- THE POINTER STOPS AT THE SCALE (radii chooser 02, 2026-08-06). The arm and
                   bob end at y=48, not 44, so the bob's OUTER edge (160−48+6 = r 118) lands
                   exactly on the tick's inner end (160−42 = r 118). Before, the bob reached
                   r 122 — four units PAST the scale — so at exact tune the disc covered the
                   lower 25% of the in-tune mark: the one reading the tick exists for was the
                   one where the mark was most obscured.
                   MIL-STD-1472G §5.2.2.5.3b(5)(a): the pointer "shall extend to, but not
                   overlap, the shortest scale graduation marks", and Figure 30's note has
                   pointers "ride against the inner scale annulus just short of the markings".
                   Rejected on the sheet: lifting the tick's inner end instead (the scale would
                   yield to the pointer, which inverts which one is the reference), and
                   shrinking the bob to r=2 (it stops reading as the pendulum's weight — the
                   Wittner silhouette is why this drawing was chosen).
                   The cost, stated: the needle is 4 units = 3.44px shorter against a 108px
                   radius. The pendulum below carries the identical change, because both
                   instruments share this drawing on purpose. -->
              <g id="mt-needle" class="rest">
                <line x1="160" y1="160" x2="160" y2="48" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="160" cy="48" r="6" fill="currentColor"/>
              </g>
              <circle cx="160" cy="160" r="2.5" fill="var(--ink)"/>
            </svg>
          </figure>

          <!-- ── THE VERB IS IN THE READING'S LINE, ON THE AXIS ────────────────────────
               (chooser practice-room-transport, Q1/02 "in line with the reading" + the user's
               correction: "inline with reading means in the middle lol")
               The transport used to be the figure's caption on its own `transport` row, one
               lead below this one. Two rows for one instrument group, and the row it sat on
               was where the 17.50px misalignment lived.
               WHY A 3-COLUMN GRID AND NOT THE OLD FLEX SPREAD. The row was
               `display:flex` + one `.ends{flex:1}` spacer, which is a FLUSH SPREAD: note
               against the left inset, cents/Hz against the right. There is no middle in
               that — dropping the verb in gives it a slot in the spread, off the axis, and
               the axis is the whole point (it is the datum the dial's pivot is on). So the
               row becomes three explicit columns, `1fr auto 1fr`: the verb is the centre
               column and lands on the axis BY CONSTRUCTION, and the two 1fr columns are
               equal by definition rather than by a spacer that happens to balance.
               The `.ends` spacer is deleted — its job was to push, and the grid's own
               columns do that now. The reading keeps its flush edges: `mrn` is start-aligned
               in the left column, the cents/Hz group end-aligned in the right.
               THE READING IS STILL THE FIGURE'S WIDTH, so the note stays under the dial's
               left end and the Hz under its right — see `.mt-read`'s width, unchanged. -->
          <div class="mt-read">
            <span class="mrn" id="mt-note" data-testid="note">—</span>
            <!-- The latch stops propagation because it sits inside .mt-mid, which is itself
                 a start/stop click target — without it every press would toggle twice and
                 net to nothing. The full name lives on aria-label: with treatment 05 there
                 is no word, so the accessible name carries the whole verb. -->
            <div class="mt-cap">
              <button type="button" class="tbtn latch" id="mt-mic" data-testid="mic-toggle"
                aria-pressed="false" aria-label="start the tuner">
                <svg class="rd" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true">
                  <rect class="fld" x="0.75" y="0.75" width="30.5" height="14.5"/>
                  <circle class="dt" cx="8" cy="8" r="3.2"/>
                </svg>
              </button>
            </div>
            <span class="mt-rr">
              <span class="mrc" id="mt-cents" data-testid="cents">–</span>
              <span class="mrh" id="mt-hz" data-testid="hz"></span>
            </span>
          </div>
          <div id="mt-sr" class="visually-hidden" role="status" aria-live="polite"></div>
        </div>

        <!-- THE TUNER'S FOOT IS EMPTY NOW (chooser metrotuner-drone-box, Q4/01 "nothing
             sounds"). `play tone` and the reference note moved out with the sustained tone
             they belonged to — this case listens, the drone case sounds, and one instrument
             owns one verb. The `foot` ROW stays on the ladder and stays empty, which is the
             mechanism that keeps all three cases' rows in phase (the metronome's `read` and
             `hint` rows are empty for the same reason): the empty modules are what hold the
             alignment. No div, because there is nothing left to put in one. -->
        <!-- The hint holds ITS OWN reserved line (annotation 2026-08-04: "hate how
             the layout changes when starting/stopping"): swapping between the
             28-char idle text and 9-char 'listening' used to reflow the whole foot
             row. One block line of fixed height; only the words change. -->
        <!-- The hint line is ERRORS ONLY now (user: the idle privacy line was
             ugly). The privacy fact lives on the case study; denial guidance
             still lands here because it must appear where the tap happened. -->
        <div class="mt-hintline"><span class="mt-hint" id="mt-hint"></span></div>
      </section>
    )}


      <!-- ── DRONE, the third case / third page ────────────────────────────── -->
      <!-- ITS OWN CASE (chooser metrotuner-drone-box, Q1/02). The sustained tone was the
           tuner's second job — one case that both listened and sounded — and a drone is
           not a reference pip you check against: it is a note you play against for
           minutes, the daily string and wind intonation ritual. So it gets a square, and
           the tuner goes back to one verb.
           THE FIGURE IS THE NOTE LETTER, not a third copy of the arc-and-bob. The tuner
           and metronome share that drawing on purpose (still vs moving is their whole
           distinction) and a drone is neither — nothing deflects and nothing sweeps. What
           it has to say is WHICH NOTE, from across the room, so the letter at 72px IS the
           figure: the largest type on the screen, and the only place this page breaks its
           one-size rule, because a figure is a drawing and not a line of copy.
           NARROW (Q2/05, "the narrow third"): the case takes 210px rather than an equal
           third, because a note and a verb do not fill a third of a screen — and the two
           worked instruments keep the width they had. Widths state importance. -->
    {has('drone') && (
      <section class="mt-half mt-drone" aria-label="Drone" data-mt-key="drone">
        <!-- THE WAY BACK IS AN ARROW BESIDE THE NAME (his pick, 2026-08-12): "just putting a
             back arrow ← next to case name works for mobile and desktop very minimal". The
             chrome row is DELETED with it, so the instrument gets that lead back at both
             widths — the cost the /proofs sheet drew for every option that moved this mark.
             ONE GROUP, so nothing has to be positioned relative to a name whose width
             changes: the arrow and the plate are one absolutely-placed flex row straddling
             the case's top rule, and the ARROW is what lands on the case's 3ch datum. -->
        <span class="mt-np">
          <a class="mt-back" href="../" data-testid="plan-word" aria-label="Back to the practice room">←</a>
          <span class="mt-plate" aria-hidden="true">drone</span>
        </span>
        <!-- THE WAY OUT OF THE SETTINGS, in the rail, and only while they are open. It is a second
             `←` on a screen that already has one — and the two never show at once, because the
             practice-room arrow is on the leftmost case and this one is on the case you are inside.
             The rule they share: an arrow in a rail goes back to whatever encloses you. From an
             instrument that is the practice room; from an instrument's settings it is the
             instrument. -->
        <button type="button" class="mt-back mt-setback" id="mt-set-back" data-testid="set-close"
          aria-label="Back to the drone" hidden>←</button>
        <!-- `set` IS IN THE TOP RAIL WITH THE NAME (his nit, 2026-08-12: "can set be in the top rail
             with name"), at the OPPOSITE END of it — which is the construction the /proofs sheet
             drew as Q2/02, "on the plate line, opposite the plate".
             NOT 1ch AFTER THE NAME, which is where it went first: the plate and a `.vbtn` are both
             `--faint` 15px at rest, so `drone set` rendered as one two-word label. The house rule is
             that hierarchy comes from position rather than colour, so the two ends of the rule do the
             separating and the rule itself shows between them. It is its own absolutely-placed
             element for that reason — the nameplate group is shrink-to-fit around the name, so
             nothing inside it can reach the far end.
             It spent an hour on the hint row before this, where it took three rules to stop
             colliding with the voice group. All three are gone. -->
        <button type="button" class="vbtn mt-setbtn" id="mt-set" data-testid="set-toggle"
          aria-expanded="false" aria-controls="mt-tune">set</button>
        <!-- A4 IS ON BOTH CASES, ONE VALUE (the user's refinement on Q4: "it makes sense
             for both to have a pitch calibration but they're synced?"). The alternative on
             the sheet was one owner — either the tuner keeps it or it follows the sound —
             and both are wrong for the same reason: calibration is what the whole ROOM
             means by a note, so a case that reads pitch and a case that sounds pitch each
             need it in reach, and there must be exactly one number. Two fields, one
             binding: `setA4()` writes every field on the screen (see `a4Fields`). -->
        <div class="mt-ctop">
          <span class="mt-fr">
            <span class="f mt-a4 mt-grp" id="mt-a4-scrub-drone">
              <span class="mt-gl" aria-hidden="true">calibration</span>
              <label for="mt-a4-drone" class="mt-lb mt-hd" title="drag ↔ to change the calibration">a4</label>
              <input id="mt-a4-drone" data-testid="a4-drone" type="number" inputmode="decimal"
                     min="400" max="480" step="1" value="440" title="type a value"
                     aria-label="A4 calibration in hertz — type a value, or drag the a4 or hz label horizontally" />
              <span class="mt-lb mt-hd" title="drag ↔ to change the calibration">hz</span>
            </span>
          </span>
        </div>
        <div class="mt-mid">
          <!-- ── THE FIGURE IS THE PITCH CONTROL (user, 2026-08-07: "use the big one in center
               to change pitch too like left to right sliding") ──────────────────────────
               It was a `<figure aria-hidden>` — a drawing, inert, with the note set from a
               small control on the foot line. Now the drawing IS the control: drag it left or
               right to scrub the pitch, click to step up, shift-click down, arrows when
               focused. Same gesture as every other value on this screen (round16: one drag
               axis for all values, right = higher), on the largest target the page has.
               AND IT NAMES THE OCTAVE NOW — `A3`, not `A`. Three copies of one note is what
               the earlier build was criticised for and the answer then was to delete the
               reading between them; the user's call here goes further and better: the FIGURE
               carries the full value and the two small copies go. One statement of the note,
               at the size you can read from a stand, and it is the thing you operate.
               STILL A `<figure>` semantically — it is the case's drawing — but a real
               `<button>` so it is focusable, announced, and keyboard-operable. The
               `aria-hidden` had to go with the promotion: a control cannot be hidden from the
               accessibility tree. -->
          <figure class="mt-gauge mt-dfig">
            <button type="button" class="mt-dnote" id="mt-dnote" data-testid="refnote"
              aria-label="Drone pitch — drag horizontally to scrub, click to raise, shift-click to lower"
              title="drag ↔ · click +1 · shift-click −1">A3</button>
          </figure>
          <!-- THE READ ROW HOLDS THE VERB, like the other two. It briefly held `A4` — the
               sounding pitch with its octave, under the letter that names it without one —
               and looking at the render killed it: the case then stated its note THREE
               times (the 72px letter, that reading, and the foot's scrub control) inside
               210px. The letter is the figure and the foot control is the value; a third
               copy between them is the same fact drawn again. That reading is still gone.
               What the row carries NOW is the transport, one row up from where it was, so
               this case's verb stays on the same line as the tuner's and the metronome's.
               The row was always the thing holding the three in phase; it does it by
               holding the verb rather than by being empty. -->
          <div class="mt-read mt-read-bare">
            <div class="mt-cap">
            <button type="button" class="tbtn latch" id="mt-drone" data-testid="drone-toggle"
              aria-pressed="false" aria-label="start the drone">
              <svg class="rd" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true">
                <rect class="fld" x="0.75" y="0.75" width="30.5" height="14.5"/>
                <circle class="dt" cx="8" cy="8" r="3.2"/>
              </svg>
            </button>
            </div>
          </div>
        </div>

        <div class="mt-cfoot">
          <!-- THE FOOT'S NOTE CONTROL IS GONE (user, 2026-08-07: "can you not repeat a3 3
               times, maybe the big one in center can say a3 and delete the other two").
               It was `#mt-refnote`, the tuner's old reference-note scrub, moved here when the
               drone got its own case. With the figure carrying the value AND the gesture,
               this was the same fact drawn a second time with a smaller target — so it goes,
               and the foot line holds only the voice.
               The `refnote` TESTID moves to the figure rather than being retired, because the
               contract "the thing that names and sets the drone's note" is unchanged; only
               which element carries it moved. Three e2e specs drive it by that id. -->
          <span class="mt-fr">
            <!-- THE VOICE IS A SETTING (user, 2026-08-07: "i like 05 the section. but also the
                 organ pair maybe it can be a setting?"). Three voices, one selector, and it is
                 a SELECTOR rather than three latches because they are mutually exclusive — the
                 Track grammar's rule is that form announces operation, and a row of latches
                 would promise you could hold two at once.
                 The words, not glyphs: `organ · cello · section` is what these differ by, and
                 no drawing distinguishes a sampled section from an additive cello. Lowercase,
                 the page's own register. -->
            <span class="mt-voice mt-grp" id="mt-voice" role="group" aria-label="Drone voice">
              <span class="mt-gl" aria-hidden="true">voice</span>
              <button type="button" class="vbtn" data-voice="organ" data-testid="voice-organ"
                aria-pressed="false">organ</button>
              <button type="button" class="vbtn" data-voice="cello" data-testid="voice-cello"
                aria-pressed="false">cello</button>
              <button type="button" class="vbtn" data-voice="section" data-testid="voice-section"
                aria-pressed="true">section</button>
            </span>
            <!-- MOVED OUT OF THIS ROW, see below. -->
            <!-- ── `set` — THE COMPLICATED SETTINGS, BEHIND ONE WORD (his pick, 2026-08-12:
                 "maybe we can hid erly complicated settings like drone intonation behidn a set type
                 control"). He chose 01 for all three questions of the controls chooser — the readout,
                 the transport and the spec row all stay as they are — so this is the one addition,
                 and it is scoped to the one control that earns it: the intonation comparer, five
                 tuning systems and a beat rate, which is the only group on this screen a player sets
                 once a month and reads an essay about.
                 IT IS A WORD, not an icon or a triangle: `set` is the same `.vbtn` vocabulary as
                 `organ cello section` above it, so the case gains a member rather than a new kind of
                 thing. `aria-expanded` is what says it is a disclosure.
                 AND IT IS ON THE `hint` ROW, not beside the voice group where it started. At 760 —
                 the narrowest desktop console, where the drone's case is 170px — the voice group
                 plus one more word wrapped, overflowed the 28px foot row and put `set` BELOW its own
                 case, unhittable. `room.spec`'s "no control is clipped and none is unhittable" check
                 said so at exactly that width; at 1512 it looked fine. The hint row is empty on this
                 case (it is where the comparer used to be assigned) and one word cannot wrap in it
                 at any width, so the control has one position rather than a per-width one. -->
          </span>
        </div>




        <!-- ── THE TUNING COMPARER, HIDDEN (2026-08-07: "make easy to switch and like a
             secret page to compare") ─────────────────────────────────────────────────────
             Not a page but a row, revealed on ⌥T, and it is hidden for a stated reason
             rather than to be clever: a drone has ONE right tuning for the practice it
             serves, and putting five in the visible controls invites a player to fiddle
             with temperament instead of playing. The comparer exists to SETTLE the choice,
             which is a thing you do once, so it lives where the ⌥G grid overlay lives —
             off, until someone who knows it is there asks.
             Every button is a real switch, so this is the comparison instrument, not a
             legend: pick a system while the drone sounds and the pitches move under the
             note you are holding. The beat rate printed beside each is COMPUTED from the
             sounding stack's coinciding partials, not looked up.

             IT IS ITS OWN ROW, not part of `.mt-ctop`, and that is a bug fix rather than a
             preference. Inside the spec row its five buttons wrapped to 44px targets that ran
             UNDERNEATH the calibration sub-case beside them — measured, the drone's a4 input
             overlapped the first tuning button by 41px vertically and intercepted every click
             on it. Playwright said so precisely ("...intercepts pointer events") where a
             screenshot showed a row that looked fine. `.mt-ctop` is sized for one line; a
             control group that wraps cannot live in it. -->
        <div class="mt-tune" id="mt-tune" hidden aria-label="Tuning system">
          <span class="mt-lb">tuning</span>
          <span class="mt-tune-btns" id="mt-tune-btns" role="group"
                aria-label="Tuning system"></span>
          <span class="mt-lb mt-tune-beat" id="mt-tune-beat" data-testid="tuning-beat"></span>
        </div>

        <!-- ── THE STACK — the chromatic strip (chooser practice-room-drone-stack Q1/06) ──
             The `fifth` latch is GONE, and the strip is what replaces it: sixteen semitone
             cells, the root at the left, each cell a toggle. Its claim is that DISTANCE IS
             THE INTERVAL, so "major or minor" stops being a mode you set and becomes a
             position you point at — and a 5th is where a 5th is, seven cells along.
             SIXTEEN CELLS, NOT THE NINE NAMED DEGREES (the user picked Q2/02, fifteen with
             both qualities, and the strip is how fifteen fit). A strip with holes where the
             unnamed intervals go would be a degree set wearing a strip's clothes. The NAMES
             the user asked for live in each cell's `aria-label` and in the readout below, so
             nothing has to be counted: the label says `5 — E3`, not "seven cells".
             IT SITS IN THE `hint` ROW, WHICH THIS CASE ALREADY HAD AND LEFT EMPTY — so the
             stack costs the ladder NO new row, which is better than the chooser's own stated
             cost for this option. That row exists on all three cases to hold the tuner's
             error line; the drone's copy was reserved air, and this is what it was reserving.
             The readout is the strip's own caption: which intervals are on, by NAME, as a
             chord — `A2 · C♯3 · E3`. It replaces the exact reading that was deleted from the
             read row for stating the note a third time; this states something the letter
             cannot, which is the rest of the chord. -->
        <div class="mt-stackline">
          <span class="mt-strip" id="mt-strip" role="group"
            aria-label="Intervals above the root, in semitones"></span>
          <span class="mt-chord" id="mt-chord" data-testid="chord" aria-live="off"></span>
        </div>
      </section>
    )}

      <!-- ── METRONOME, the right case / second page ───────────────────────── -->
      <!-- THE PENDULUM (chooser: metrotuner-pendulum, Q1/02 "arm and bob"): the
           metronome's figure is the TUNER'S DRAWING IN MOTION — same arc, same arm,
           same bob, sweeping end to end once per beat with the end tick filling on
           the strike. Still vs moving is the whole distinction between the two
           instruments. The beat-ring row this replaces carried bar position; the
           strike now carries it — the downbeat's tick strikes heavier. -->
    {has('metronome') && (
      <section class="mt-half" aria-label="Metronome" data-mt-key="metronome">
        <!-- THE WAY BACK IS AN ARROW BESIDE THE NAME (his pick, 2026-08-12): "just putting a
             back arrow ← next to case name works for mobile and desktop very minimal". The
             chrome row is DELETED with it, so the instrument gets that lead back at both
             widths — the cost the /proofs sheet drew for every option that moved this mark.
             ONE GROUP, so nothing has to be positioned relative to a name whose width
             changes: the arrow and the plate are one absolutely-placed flex row straddling
             the case's top rule, and the ARROW is what lands on the case's 3ch datum. -->
        <span class="mt-np">
          <a class="mt-back" href="../" data-testid="plan-word" aria-label="Back to the practice room">←</a>
          <span class="mt-plate" aria-hidden="true">metronome</span>
        </span>
        <!-- METER ON TOP, TRANSPORT ON THE BOTTOM (user nit 2, 2026-08-04): the
             set-per-piece controls (beats, subdivision) read as spec lines at the
             top; the played controls (start, tap, tempo) stay in hand's reach at
             the foot. Both meters are THE STRING — circles joined by trimmed rules,
             the mark's own o-o-o. Click the Nth circle: filled up to N. Beats and
             subdivision share the device, and the string is 7 long for both — yes,
             septuplets; the engine never cared. -->
        <!-- THE RULED MEASURE (chooser: metrotuner-meter-final, Q1/02; judge 9.2).
             Digits 1–7 are the scale, one hairline under them is the quantity —
             stated once, differently per meaning: the BEATS rule grows with the bar
             (its left tick is the accented downbeat), the SUBDIVIDE rule is FIXED at
             one beat's length and gets cut into n dashes. Extent vs granularity.
             The digits are the buttons (20×44 targets); the rules are drawn by
             drawRules() because stroke-dasharray with round gaps can't guarantee n
             visually equal dashes at every width. -->
        <div class="mt-ctop">
          <span class="mt-fl mt-grp">
            <span class="mt-gl" aria-hidden="true">beats</span>
            <span class="mt-lb">beats</span>
            <!-- THE RULE IS THE SWITCH (chooser metrotuner-round15, Q1/06): the
                 "accent 1" latch is DELETED — the beats rule itself is the accent
                 toggle. Tap the rule (a 140px-wide target): accented = the downbeat
                 tick stands full-height in ink AND the digit "1" carries weight 500;
                 equal = a flush faint stub and a plain 1. State lives in the marks
                 the meter already draws; the only copy on the row is "beats". -->
            <span class="mt-rm" id="mt-beats-seg" role="group" aria-label="Beats per bar">
              <!-- THE ACCENT MARK IS THE MUSIC ACCENT (chooser metrotuner-meter-tap,
                   pick 01/03 + the user's refinement: "what if we used the music
                   accent sign >"). Better than the acute the sheet offered — `>` over
                   a note IS the notation for "accent this one", so it needs no
                   explaining to anyone who reads music. Faint when off, ink when on.
                   POSITIONED, NOT STACKED: `.mt-rm` is a column flex and baselines on
                   its FIRST item, so a mark row above the digits would become the
                   row's baseline and the beats meter would sit lower than
                   `subdivide`. This rides in the 8px the digits already carry as
                   top padding, absolutely placed, so it adds no layout at all.
                   AND THE MARK IS A BUTTON ("i want to control the accent by clicking
                   it"). It shipped as a bare <svg> — the state was drawn where the eye
                   goes and the CONTROL was still the 140px rule below, so the one thing
                   that looks like the accent was the one thing that didn't toggle it.
                   Now both work: this button and the rule are two targets on one state.
                   `aria-hidden` is gone with the promotion — a control cannot be hidden
                   from the accessibility tree — and the label lives here, so the rule
                   below drops its own (two buttons announcing "Accent the first beat"
                   would read as two separate settings). -->
              <button type="button" class="rm-accbtn" id="mt-acc" data-testid="accent-mark"
                      aria-pressed="true" aria-label="Accent the first beat">
                <!-- A CLOSED POLYGON, not an open polyline (chooser
                     metrotuner-accent-clarity, pick Q1/03 "filled vs hollow"). The two
                     states were too close: "the strong vs weak accent mark are unfort
                     rly similar". They differed only by colour value — measured 3.54:1
                     between --ink and --faint — plus 0.4px of stroke, on a 9x8px glyph,
                     and value is the weakest channel at that size. Now the accented
                     mark is a SOLID wedge and the unaccented one is the same wedge
                     outlined: the filled/hollow pair the site already uses for the page
                     dots and the toggle berths, so it borrows a distinction the reader
                     has met rather than inventing one. A polyline cannot be filled
                     convincingly, hence the polygon. -->
                <svg class="rm-acc" id="mt-acc-mark" width="9" height="8" viewBox="0 0 9 8"
                     aria-hidden="true"><polygon points="1,0.5 8,4 1,7.5" /></svg>
              </button>
              <span class="rm-digits">
                {[1, 2, 3, 4, 5, 6, 7].map((n) => (
                  <button type="button" class="rbtn" data-beats={n} aria-pressed={n === 4 ? 'true' : 'false'} aria-label={`${n} beats per bar`}>{n}</button>
                ))}
              </span>
              <!-- The rule stays a target for the same state (a 140px one, which is
                   what makes it findable on a phone), but it is no longer the only one
                   and no longer the announced one: `aria-labelledby` points at the mark
                   button so a screen reader hears ONE "Accent the first beat" control
                   rather than two settings that happen to agree. -->
              <button type="button" class="rm-rulebtn" id="mt-accent" data-testid="accent-toggle"
                aria-pressed="true" aria-labelledby="mt-acc">
                <svg class="rm-rule" width="140" height="9" viewBox="0 0 140 9" aria-hidden="true" data-rule="grow"></svg>
              </button>
            </span>
          </span>
          <span class="mt-fr mt-grp">
            <span class="mt-gl" aria-hidden="true">subdivide</span>
            <span class="mt-lb">subdivide</span>
            <!-- THE DASHED EXTENT (chooser metrotuner-round15, Q3/04): the subdivide
                 rule now GROWS to the selected digit exactly as beats' does — one
                 lesson, learned once — and is cut into n dashes, one under each
                 counted digit. Solid = positions in the bar, dashed = divisions of
                 the beat; the texture is the difference, the extent says which digit
                 is selected. This retires the fixed one-beat-length argument. -->
            <span class="mt-rm" id="mt-sub-seg" role="group" aria-label="Subdivision">
              <span class="rm-digits">
                {[1, 2, 3, 4, 5, 6, 7].map((n) => (
                  <button type="button" class="rbtn" data-sub={n} aria-pressed={n === 1 ? 'true' : 'false'} aria-label={`${n} per beat`}>{n}</button>
                ))}
              </span>
              <svg class="rm-rule" width="140" height="9" viewBox="0 0 140 9" aria-hidden="true" data-rule="dashext"></svg>
            </span>
          </span>
        </div>

        <div class="mt-mid">
          <figure class="mt-gauge" aria-hidden="true">
            <svg viewBox="0 0 320 184" id="mt-metro-fig">
              <path d="M 34 160 A 126 126 0 0 1 286 160" fill="none" stroke="var(--faint)" stroke-width="1.5"/>
              <!-- THE END TICKS ARE GONE (user, 2026-08-05: "the little accent on the
                   side of the arc that happens on beats — I think it's actually
                   useless"). They were right, and the reason is that the bob already
                   says it: the strike IS the bob reaching the end of its sweep, so a
                   mark that lights up at the same instant in the same place is the
                   same fact drawn twice. It only carried information in the
                   reduced-motion case, where the bob was parked — and that case now
                   steps the bob between the ends instead, so one figure states the
                   beat in both modes. Three elements down to one. -->
              <!-- Same 48, same reason as the tuner's needle — see the note there. The two
                   instruments are one drawing in two states (still vs moving), so a geometry
                   fix that landed on only one of them would break the thing that makes the
                   pair read as one mechanic. -->
              <g id="mt-pend" class="rest">
                <line x1="160" y1="160" x2="160" y2="48" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="160" cy="48" r="6" fill="currentColor"/>
              </g>
              <circle cx="160" cy="160" r="2.5" fill="var(--ink)"/>
            </svg>
          </figure>
          <!-- THE VERB IN THE READ ROW, same as the tuner's — and THIS is what keeps the
               three cases one drawing. The tuner's verb moved up a row into its reading;
               if this one stayed on the `transport` row the two would sit a lead apart,
               which is the misalignment the user reported in the first place. So the
               metronome's `read` row — empty until now, and empty BECAUSE the tuner had a
               reading — carries the verb instead. The row's emptiness was never the point;
               holding the two cases in phase was. It still does that, by holding the verb. -->
          <div class="mt-read mt-read-bare">
            <div class="mt-cap">
            <button type="button" class="tbtn latch" id="mt-run" data-testid="metro-toggle"
              aria-pressed="false" aria-label="start the metronome">
              <svg class="rd" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true">
                <rect class="fld" x="0.75" y="0.75" width="30.5" height="14.5"/>
                <circle class="dt" cx="8" cy="8" r="3.2"/>
              </svg>
            </button>
            </div>
          </div>
        </div>

        <div class="mt-cfoot">
          <!-- THE SCRUB VALUE (steppers chooser Q2/02): the −/+ are gone — the
               number is the control. Drag HORIZONTALLY to scrub (1 bpm per 4px;
               the DAW gesture, and the primary one on touch), type in the field,
               arrow keys fine-step. THE DRAG IS ON THE UNIT (chooser
               metrotuner-scrub-target, pick 03): "bpm" is the handle, the numeral is
               the field. touch-action:none on the handle — the horizontal drag would
               otherwise fight the page's horizontal snap-scroller directly. TAP stays
               beside it (it sets the tempo too). -->
          <span class="mt-fr">
            <!-- Bare numeral here too (Q2/06) — the value is the whole control. -->
            <span class="f mt-bpm" id="mt-bpm-scrub">
              <input id="mt-bpm" data-testid="bpm" type="number" inputmode="numeric"
                     min="20" max="320" step="1" value="96" title="type a value"
                     aria-label="Beats per minute — type a value, or drag the bpm label horizontally" />
              <span class="mt-lb mt-hd" data-testid="bpm-handle"
                    title="drag ↔ to change the tempo">bpm</span>
            </span>
            <!-- TRACK GRAMMAR: the MOMENTARY is a lone ring — a disc with NO track
                 has nowhere to travel; the only verb left is press. Each strike
                 fills it and it drains, so it visibly cannot hold. -->
            <button type="button" class="tbtn mom" id="mt-tap" data-testid="tap">
              <svg class="tk" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <circle id="mt-tap-ring" cx="7" cy="7" r="4.6"/>
              </svg><span class="w">tap</span>
            </button>
          </span>
        </div>
      </section>
    )}

      <!-- ── THE CHANGES, the fourth case ──────────────────────────────────────
           Chooser practice-room-apps Q1/02: a chord dealer for the EAR. It sounds a
           voicing; you name it; you press to reveal. The symbol is the figure, and it is
           the ANSWER — so it reads `?` until you ask for it, which is the whole mechanic.
           WHY THE SYMBOL AND NOT A STAFF: the room has no notation vocabulary and adding
           one for a single case would be a second visual language. A chord symbol is what a
           jazz player reads anyway, and it is type — which this page already sets at 72px
           for the drone's letter. That exception is REUSED here, not extended: same size,
           same optical nudge, same reason (a figure is a drawing, not a line of copy).
           GRADING IS ARPEGGIATION (chooser Q3/02), and the reason is measured rather than
           chosen: the shipped detector is the McLeod Pitch Method, which finds ONE period.
           A strummed four-note voicing reads as NO PITCH and a bare fifth reads an octave
           low — so a trainer that graded a strum would need a detector the room does not
           have. Played one note at a time it is the detector's home ground (0.35 cents,
           C2–C7, asserted). The foot line says so in one word: `arpeggiate`. -->
    {has('changes') && (
      <section class="mt-half mt-changes" aria-label="Chord dealer" data-mt-key="changes">
        <!-- THE WAY BACK IS AN ARROW BESIDE THE NAME (his pick, 2026-08-12): "just putting a
             back arrow ← next to case name works for mobile and desktop very minimal". The
             chrome row is DELETED with it, so the instrument gets that lead back at both
             widths — the cost the /proofs sheet drew for every option that moved this mark.
             ONE GROUP, so nothing has to be positioned relative to a name whose width
             changes: the arrow and the plate are one absolutely-placed flex row straddling
             the case's top rule, and the ARROW is what lands on the case's 3ch datum. -->
        <span class="mt-np">
          <a class="mt-back" href="../" data-testid="plan-word" aria-label="Back to the practice room">←</a>
          <span class="mt-plate" aria-hidden="true">changes</span>
        </span>
        <!-- THE DECK IS THE SPEC CONTROL, like calibration on the other cases: it says what
             the instrument MEANS by a chord, and you set it per session rather than per rep.
             A selector, not latches — the decks are mutually exclusive, and the Track
             grammar's rule is that form announces operation. -->
        <div class="mt-ctop">
          <span class="mt-fr">
            <span class="mt-deck mt-grp" id="mt-deck" role="group" aria-label="Chord deck">
              <span class="mt-gl" aria-hidden="true">deck</span>
              <button type="button" class="vbtn" data-deck="triads" data-testid="deck-triads"
                aria-pressed="false">triads</button>
              <button type="button" class="vbtn" data-deck="sevenths" data-testid="deck-sevenths"
                aria-pressed="true">sevenths</button>
              <button type="button" class="vbtn" data-deck="altered" data-testid="deck-altered"
                aria-pressed="false">altered</button>
            </span>
          </span>
        </div>
        <div class="mt-mid">
          <!-- THE SYMBOL IS THE FIGURE AND THE CONTROL, exactly as the drone's letter is:
               press it to hear the chord, press again to reveal what it was. One surface,
               and the gesture is the same one the drone taught. -->
          <figure class="mt-gauge mt-symfig">
            <button type="button" class="mt-sym" id="mt-sym" data-testid="chord-symbol"
              aria-label="Chord — press to hear it, press again to reveal what it is"
              title="press to hear · again to reveal">?</button>
          </figure>
          <!-- The read row holds the verb, on the same line as the other four cases. -->
          <div class="mt-read mt-read-bare">
            <div class="mt-cap">
              <button type="button" class="tbtn latch" id="mt-chordrun" data-testid="chord-toggle"
                aria-pressed="false" aria-label="sound the chord">
                <svg class="rd" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true">
                  <rect class="fld" x="0.75" y="0.75" width="30.5" height="14.5"/>
                  <circle class="dt" cx="8" cy="8" r="3.2"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="mt-cfoot">
          <span class="mt-fl">
            <!-- THE MOMENTARY: deal the next chord. A disc with no track can only be
                 pressed, which is exactly what dealing is. -->
            <button type="button" class="tbtn mom" id="mt-deal" data-testid="deal">
              <svg class="tk" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <circle cx="7" cy="7" r="4.6"/>
              </svg><span class="w">deal</span>
            </button>
          </span>
          <span class="mt-fr">
            <!-- THE MIC LATCH. Arpeggiate the voicing and it checks the notes as they
                 arrive. Off by default: this case is useful with no microphone at all
                 (sound it, name it in your head, reveal), so the permission prompt is
                 something you opt into rather than the price of opening the room. -->
            <button type="button" class="tbtn latch" id="mt-arp" data-testid="arp-toggle"
              aria-pressed="false" aria-label="listen — arpeggiate the chord one note at a time">
              <svg class="rd" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true">
                <rect class="fld" x="0.75" y="0.75" width="30.5" height="14.5"/>
                <circle class="dt" cx="8" cy="8" r="3.2"/>
              </svg><span class="w">arpeggiate</span>
            </button>
          </span>
        </div>

        <!-- THE ANSWER LINE, in the `hint` row — the row the tuner uses for its error line
             and the metronome leaves empty. It prints the spelled notes once revealed, and
             the notes you have actually landed while arpeggiating. It is RESERVED whether
             or not there is anything to say, so nothing reflows when a verdict appears. -->
        <div class="mt-answerline">
          <span class="mt-answer" id="mt-answer" data-testid="chord-answer" aria-live="polite"></span>
        </div>
      </section>
    )}

      <!-- ── THE LOOP, the fifth case ──────────────────────────────────────────
           Chooser practice-room-apps Q1/03: the transcriber's part selector. Two carets cut
           the span you are fighting; four words set the speed; it loops that forever.
           NO WAVEFORM, and that is a decision rather than an omission: the room has no
           waveform vocabulary, and a hairline with two marks says everything a part selector
           has to say. The ticks are sixteenths, so a nudge has something to land on.
           THE SOURCE IS A YOUTUBE EMBED (chooser Q4/02) — where the material actually is.
           TWO COSTS, both real and both stated on the sheet: it breaks the room's
           no-network rule (this is the first case that talks to another origin), and the
           speeds are the iframe API's fixed menu, so ¼ is the floor and there is no ⅓.
           THE IFRAME IS NOT LOADED UNTIL YOU ASK. Nothing is requested, and no cookie is
           set, until you paste a URL — so opening the practice room still talks to nobody.
           That is the same promise the tuner makes about the microphone, kept the same way:
           by not starting the thing until it is needed. -->
    {has('loop') && (
      <section class="mt-half mt-loop" aria-label="Loop" data-mt-key="loop">
        <!-- THE WAY BACK IS AN ARROW BESIDE THE NAME (his pick, 2026-08-12): "just putting a
             back arrow ← next to case name works for mobile and desktop very minimal". The
             chrome row is DELETED with it, so the instrument gets that lead back at both
             widths — the cost the /proofs sheet drew for every option that moved this mark.
             ONE GROUP, so nothing has to be positioned relative to a name whose width
             changes: the arrow and the plate are one absolutely-placed flex row straddling
             the case's top rule, and the ARROW is what lands on the case's 3ch datum. -->
        <span class="mt-np">
          <a class="mt-back" href="../" data-testid="plan-word" aria-label="Back to the practice room">←</a>
          <span class="mt-plate" aria-hidden="true">loop</span>
        </span>
        <div class="mt-ctop">
          <span class="mt-fr">
            <!-- THE SOURCE IS THE SPEC CONTROL: what the instrument is pointed at. -->
            <!-- THE PLACEHOLDER IS SHORT BECAUSE THE FIELD IS 180px. Measured on the live
                 page: `paste a youtube url` sets ~171px at the field's 16px and rendered
                 clipped — "paste a youtube ur" — because the case is 236px and that width is
                 its own measured minimum, so the field cannot grow. The notch above already
                 says `source`, and the full sentence lives in the aria-label, so shortening
                 the placeholder loses nothing a reader needed. -->
            <span class="f mt-src mt-grp" id="mt-src-grp">
              <span class="mt-gl" aria-hidden="true">source</span>
              <label for="mt-src" class="mt-lb visually-hidden">youtube url</label>
              <input id="mt-src" data-testid="loop-src" type="text" inputmode="url"
                     placeholder="paste a url"
                     aria-label="YouTube URL — paste a link to load it" />
            </span>
          </span>
        </div>
        <div class="mt-mid">
          <!-- THE FIGURE IS THE TIMELINE, and it is the control: drag either caret, arrows
               nudge by a sixteenth. `figure` semantically, a real focusable group for the
               keyboard — the same promotion the drone's letter took. -->
          <figure class="mt-gauge mt-tlfig">
            <div class="mt-tl" id="mt-tl" data-testid="timeline" tabindex="0" role="group"
              aria-label="Loop span — drag either caret, arrow keys nudge by a sixteenth">
              <span class="mt-tl-axis" aria-hidden="true"></span>
              <span class="mt-tl-span" id="mt-tl-span" aria-hidden="true"></span>
              <span class="mt-tl-caret" id="mt-tl-a" data-caret="a" aria-hidden="true"></span>
              <span class="mt-tl-caret" id="mt-tl-b" data-caret="b" aria-hidden="true"></span>
              <span class="mt-tl-head" id="mt-tl-head" aria-hidden="true"></span>
            </div>
          </figure>
          <div class="mt-read">
            <span class="mrn mt-tl-read" id="mt-tl-read" data-testid="loop-span">—</span>
            <div class="mt-cap">
              <button type="button" class="tbtn latch" id="mt-loop-run" data-testid="loop-toggle"
                aria-pressed="false" aria-label="loop the span">
                <svg class="rd" width="32" height="16" viewBox="0 0 32 16" aria-hidden="true">
                  <rect class="fld" x="0.75" y="0.75" width="30.5" height="14.5"/>
                  <circle class="dt" cx="8" cy="8" r="3.2"/>
                </svg>
              </button>
            </div>
            <span class="mt-rr"><span class="mrh" id="mt-tl-len"></span></span>
          </div>
        </div>

        <div class="mt-cfoot">
          <span class="mt-fr">
            <!-- SPEED AS WORDS, the drone's voice-row idiom: mutually exclusive, so a
                 selector and not four latches. `1` is first because that is where a
                 transcription starts — you listen at speed, then slow the part down. -->
            <span class="mt-rate mt-grp" id="mt-rate" role="group" aria-label="Playback speed">
              <span class="mt-gl" aria-hidden="true">speed</span>
              <button type="button" class="vbtn" data-rate="1" data-testid="rate-1"
                aria-pressed="true">1</button>
              <button type="button" class="vbtn" data-rate="0.75" data-testid="rate-075"
                aria-pressed="false">¾</button>
              <button type="button" class="vbtn" data-rate="0.5" data-testid="rate-05"
                aria-pressed="false">½</button>
              <button type="button" class="vbtn" data-rate="0.25" data-testid="rate-025"
                aria-pressed="false">¼</button>
            </span>
          </span>
        </div>

        <!-- The player itself, and the state line. The iframe is 1×1 and visually hidden
             until a URL is pasted — the case's figure is the timeline, not a video. -->
        <div class="mt-loopline">
          <span class="mt-loopstate" id="mt-loopstate" data-testid="loop-state" aria-live="polite"
            >paste a url to begin</span>
        </div>
        <div class="mt-yt" id="mt-yt" aria-hidden="true"></div>
      </section>
    )}

      <!-- ══ THE ROOM: THE INDEX (choosers `practice-room-box` Q1/04 Q2/04 Q3/02 Q4/04,
           `practice-room-plan` Q5/01 — 2026-08-12) ══════════════════════════════════════════
           ONE BOX WITH THE THINGS AS ROOMS INSIDE IT, per the owner's correction: "you should
           draw a big box for the outer homepage. and then all the instruments are in little boxes
           inside?" — the attempt before that drew a grid of separate bays, which is five
           enclosures and no room.
           AND THE CASE'S OWN FRAME IS THE BOX (his annotation, 2026-08-12: "dont need this
           container if the room has one"). There WAS a second bordered div inside the case — two
           nested boxes drawing one room. The case frame carries it instead, at 2px on this route
           only, which keeps the one thing the doubled box was buying: walls heavier than the
           fittings standing against them, which is how a plan says containment.
           THE ROOMS ARE THE SCREEN'S THIRDS (Q2/04) and they FILL the floor — a plan's rooms are
           the extent of the plan. On a phone they stack, because a plan of a narrow room draws its
           rooms down the floor.
           EACH ROOM IS A FIGURE AND A NAME UNDER IT (Q3/02), the figure at 32px: the same
           generated mark the console's dot row draws at 16, at the same 1.8 stroke.
           THEY ARE ANCHORS, not buttons. Each thing is its own URL now, so a link is the honest
           element: it works with JS off, it middle-clicks into a new tab, and the browser's own
           Back comes here. NOTHING ON THIS PAGE NEEDS SCRIPT — the marks are generated at build
           time from the same module the dots read.
           NO HINT LINE. `press a box` (and the `3 things` counter under it) told you what three
           labelled boxes already say — his annotation: "dont need this hint". The rows they sat on
           stay empty, because the ladder is what every other case aligns to.
           THE LIFT (Q5/01) IS ON HOVER, not on a drag: the pick was "drag it, and it casts a
           shadow while lifted", and with nothing to rearrange what is left of that delight is a
           box that rises as you reach for it. It is the only shadow on the screen. -->
      {page === 'room' && (
        <section class="mt-half mt-order" aria-label="The room" data-testid="plan-room">
          <!-- IN THE GROUP TOO, even with no arrow beside it. When `.mt-np` took over the absolute
               positioning the plate used to carry, this one was left bare — so it fell INSIDE the
               case as a static, 1344px-wide, 0px-tall line box sitting on no rule at all. Live for
               an hour, and the reason hovering it highlighted a full-width strip instead of the
               words. One rule for every plate is what stops that recurring. -->
          <span class="mt-np"><span class="mt-plate" aria-hidden="true">practice room</span></span>
          <div class="mt-ctop"></div>
          <div class="mt-mid">
            <div class="mt-pfloor">
              {rooms.map((r) => (
                <div class="mt-pslot">
                  <a class="mt-pbox" href={r.href} data-pthing={r.id} data-testid={`plan-${r.id}`}>
                    <span class="mt-pmarks" set:html={r.marks} />
                    <span class="mt-pnm">{r.name}</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
          <div class="mt-cfoot mt-ofoot"></div>
        </section>
      )}


    </div>

    <!-- The foot: the page indicator (phone only) and the one word out. The dots are
         the mark's vocabulary — disc = the page on screen, ring = the other — and
         they are buttons: a swipe needs a click-shaped fallback for keyboards and
         for anyone who doesn't guess the gesture. -->
    <!-- ══ THE DOT ROW IS THE CONSOLE'S, ON A PHONE, AND NOWHERE ELSE (2026-08-12) ═════════
         His annotation on the desktop room: "this bar is no longer needd dleete form desktop,
         maybe leave for cnosle mobile where we need app switching". It was a page indicator for a
         scroller, and the scroller is gone everywhere except one place: the console's three
         instruments on a phone, where they cannot fit side by side. So the row exists on exactly
         that page at exactly that width, indicating exactly the three pages that are really there.
         WHAT WENT WITH IT: the room's own mark (the room is a URL, reached by the link in the top
         lead), and the row on /changes and /loop, where it pointed at one page — an indicator with
         nothing to indicate.
         EACH GLYPH IS GENERATED FROM WHAT ITS APP COUNTS — n bars at 0° if the pitches sound, 45°
         if they are measured (the `practice-room-encoding` chain). Not invented icons and not
         hand-drawn, which is what lets a fifteen-app suite have marks at all.
         THE COST, stated: a glyph does not NAME its page, where a word did. Two things carry that
         instead — `aria-label` for assistive tech, and the engraved plate on each case.
         IT IS FILLED BY JS from the same GLYPHS map the room's boxes read, so the two cannot
         disagree about what an instrument's mark is. -->
    {page === 'console' && (
      <div class="mt-foot">
        <div class="mt-dots" id="mt-dots"></div>
      </div>
    )}
  </div>
</Layout>

<style is:global>
  /* THE ONE ESCAPE. This page is a screen, and a screen split into viewport halves
     cannot sit inside the document's 1120px measure. `:has(#mt-app)` scopes the
     override to exactly this page — the rule ships in this page's CSS chunk and the
     selector matches nothing anywhere else. */
  .wrap:has(#mt-app){max-width:none;padding:0}
  main:has(#mt-app) > .grid:first-child{margin-top:0}
  /* ⌥G on THIS page draws the instrument's grids (main 12 over .mt-pages +
     12 per case), not the document guide — the guide's bands are the 1120px
     measure's columns, which this screen explicitly escapes. These selectors
     live in the is:global chunk because Astro scoping would pin the html/body
     part to a scope class those elements never carry (found: overlay never
     painted from the scoped block). */
  body:has(#mt-app) .guide{display:none !important}

  /* ══════════════════════════════════════════════════════════════════════════════════
     THE STACK'S RULES ARE GLOBAL, AND THAT IS NOT A STYLE CHOICE — IT IS REQUIRED.
     Astro scopes a component's `<style>` by appending an attribute selector, so
     `.mt-cell` compiles to `.mt-cell[data-astro-cid-3jerlmmv]`. The strip's cells are
     BUILT BY buildStrip() at runtime and carry no such attribute, so every rule silently
     matched nothing: the cells rendered 8×0 px, the e2e reported `semi-7` as "hidden", and
     the page looked like it had no strip at all.
     This is the same trap this file already records for the ⌥G overlay (`:is(html,body)
     .showgrid` had to move here for the same reason). THE RULE: markup this page creates in
     JS needs its CSS in the `is:global` chunk. The selectors are prefixed `mt-` and
     `#mt-app`-adjacent, so they match nothing anywhere else on the site.
     ══════════════════════════════════════════════════════════════════════════════════ */
  /* ══ THE STACK — the chromatic strip (chooser practice-room-drone-stack, Q1/06) ══════
     IT COSTS THE LADDER NO NEW ROW. It sits in `hint`, the row every case already declares
     and this one left empty (the tuner uses it for errors). That row was reserved air; this
     is what it was reserving. `align-self:center` comes from `.mt-hintline` above, and the
     strip is deliberately SHORTER than the 28px row so the row's height does not change —
     which is what keeps three cases' feet in phase.
     WHY A STRIP OF CELLS AND NOT A ROW OF DIGITS: the alternative on the sheet was the
     metronome's ruled measure with each digit independently lit. At nine intervals its cells
     measure 17px — under the 24px floor — and at fifteen they are 10px. A cell has no glyph
     to be legible, so the strip spends its 156px on TARGETS instead of on type, and the
     names move to the labels and the readout below. */
  /* ── THE CELLS DIVIDE THE ROW; NOTHING COMPUTES A WIDTH. ────────────────────────
     First attempt derived the cell width in CSS —
       `round(down, (210px − 2×3ch − 2px − 16×1px) / 17, 1px)`
     — and every cell rendered 0×0. `round()` is not in the Chrome the harness drives (nor in
     Safari before 15.4), and an unsupported math function does not fall back to the `var()`
     default: the declaration is invalid at computed-value time, so `width` became 0 and the
     whole strip was 16px of gaps. The e2e caught it as "resolved to <button …> — hidden",
     which is what a 0×0 button is.
     A GRID NEEDS NO ARITHMETIC. `repeat(17, 1fr)` divides whatever the case gives it, exactly,
     at any width and in any browser — the same reason the drone-box sheet's rooms are grids
     and not flex rows (a track's width does not consult its contents). It also means the
     strip cannot overflow a narrower case: the cells shrink, the count stays 17. */
  /* ── THE STRIP MUST NOT SWALLOW ITS NEIGHBOURS' CLICKS ──────────────────────────
     The cells are 40px targets holding 20px of ink, so 10px of each hangs above and below
     into the slack — and that overhang sits OVER the foot line. Playwright found it exactly:
     87 retries of a click on `refnote`, each reporting `<button data-semi="2">… intercepts
     pointer events`. A human would have read that as a dead note control.
     `pointer-events` on the ROW is `none` and each CELL turns it back on, so the row's own
     box (which is what overlaps the foot) is transparent to a pointer while every cell stays
     a full 40px target. The alternative — shrinking the cells to their 20px of ink — would
     have fixed the overlap by putting every target under WCAG 2.5.8's floor.
     `position:relative` + `z-index:1` on the cells keeps them ABOVE the row's background but
     the row itself out of the hit-test. */
  .mt-strip{display:grid;grid-template-columns:repeat(17, 1fr);align-items:stretch;
    gap:1px;width:100%;pointer-events:none;
    /* the row is 28px; the cells are 20px and the padding makes the TARGET 40px tall,
       overhanging into the slack above and below, where it is air. Same idiom as `.mt-hd`
       and the meter digits: pad out to a target, pull the padding back, don't grow the row. */
    margin:0 auto}
  .mt-cell{-webkit-appearance:none;appearance:none;font:inherit;background:transparent;
    border:0;border-radius:0;margin:0;cursor:pointer;
    /* THE INK IS 20px AND THE TARGET IS 40, and the mechanism is NOT the page's usual
       pad-then-negative-margin: inside a grid item `align-items:stretch` resolves the height
       from the track, and a `height:20px` + `padding:10px 0` box measured 8×0 — the padding
       and the negative margins cancelled to nothing. Measured, not guessed (the harness read
       `rect: 8.125x0`, and a zero-height button is a control nobody can press).
       So the box states its own 40px height and the INK is drawn with a background inset by
       `background-clip:content-box` over 10px of vertical padding. Same result, one box: a
       20px mark inside a 40px target, and the row keeps its 28px lead because the strip is
       `align-self:center` in it and the overhang falls into the slack. */
    height:40px;padding:10px 0;
    min-width:0;                      /* a grid item's default min-width:auto refuses to shrink */
    pointer-events:auto;              /* the row is transparent; the cells are not (see above) */
    /* THE HAIRLINE IS A BACKGROUND, not a box-shadow: `inset` shadows ignore
       `background-clip`, so a shadow would outline the 40px TARGET while the fill sat in the
       20px ink box — a cell whose border and whose fill were different sizes. Two layers on
       the content box instead: the 1px frame is a gradient, the fill sits over it. */
    background-image:linear-gradient(var(--line),var(--line));
    background-clip:content-box;background-repeat:no-repeat;
    background-size:100% 100%;background-position:center;
    box-shadow:none;
    transition:background-image var(--dur-fast) var(--ease)}
  /* ON is a FILLED cell — the hollow/filled pair this page already uses for the accent mark
     and the page dots, borrowed rather than invented. Value alone would not do it: --ink
     against --faint measures 3.54:1, which the accent-clarity chooser already rejected at
     small sizes. */
  .mt-cell.on{background-image:linear-gradient(var(--ink),var(--ink))}
  /* THE ROOT CELL is filled and inert: it always sounds, so it must not look switchable.
     It is the datum the rest of the strip is measured from. */
  .mt-cell-root{background-image:linear-gradient(var(--ink),var(--ink));
    cursor:default;pointer-events:none}
  /* SOUNDING IS ACCENT — INCLUDING THE ROOT. The root cell stayed --ink while the switched
     cells went --accent, so the strip drew the always-sounding note as though it were the one
     thing NOT sounding. Caught by looking at the render: one black cell in a row of navy. On
     this screen the accent means "this is happening", and the root is happening. */
  .mt-drone[data-sounding="true"] .mt-cell.on,
  .mt-drone[data-sounding="true"] .mt-cell-root{
    background-image:linear-gradient(var(--accent),var(--accent))}
  .mt-cell:hover:not(.on){background-image:linear-gradient(
    color-mix(in srgb,var(--accent) 34%,transparent),
    color-mix(in srgb,var(--accent) 34%,transparent))}
  .mt-cell:focus-visible{outline:1px solid var(--accent);outline-offset:1px}
  /* THE SCALE: a tick under every fifth cell. Sixteen printed numbers under a 156px strip
     would be illegible, and an unscaled strip cannot be counted at all — so the marks are
     the same compromise the metronome's ruled measure makes. */
  /* the scale rides the SAME grid, so a tick is always under the cell it counts */
  /* `pointer-events` is back ON for the marks so their titles can be read on hover — the row
     is 6px tall and sits below the cells, so it cannot steal a cell's click (verified: the
     cells' own 40px targets end above this row). It was `none` when the marks were mute. */
  .mt-scale{display:grid;grid-template-columns:repeat(17, 1fr);gap:1px;width:100%}
  /* THE MARKS SIT UNDER THE CELL THEY NAME, so the stroke is a border on the LEFT edge of the
     cell's own track — a mark centred between two cells would name neither.
     Two lengths, one hierarchy: the octave halves the strip and gets 6px, the other perfect
     intervals get 4px. Both --faint, because a landmark is furniture and must not compete with
     the cells, which are the content. */
  .mt-scale i{height:6px;display:block;min-width:0}
  .mt-scale i.tk-perfect{border-left:1px solid var(--faint);height:4px}
  .mt-scale i.tk-octave{border-left:1px solid var(--faint);height:6px}
  /* THE CHORD READOUT — the strip's caption, and the only place the stack is stated in the
     names a player thinks in. It says what the 72px letter cannot: the rest of the notes. */
  /* ── THE CHORD WRAPS; IT MUST NOT TRUNCATE. First build had `nowrap` + ellipsis, which
     read fine at two notes and printed `A4 · C5 · E5 · C…` at four — an ellipsis on a chord
     hides the very note the user just added, which is worse than saying nothing. My own
     phone check missed it because it measured the DEFAULT stack (two notes); the render at
     four is what showed it.
     Wrapping is free here: this sits in `slack-b`, placed air with height to give, so a
     second line costs nothing structural. `text-wrap:balance` keeps two lines even rather
     than one long and one orphan. */
  .mt-chord{color:var(--faint);text-align:center;max-width:100%;
    text-wrap:balance;overflow-wrap:break-word}
  /* The stack line is two stacked rows of marks plus a caption, so it needs to be a column
     rather than inheriting the hint line's single baseline. It stays `align-self:center` in
     the `hint` row, so it grows symmetrically into the slack above and below. */
  /* ── IT LIVES IN `slack-b`, THE PLACED AIR BELOW THE INSTRUMENT — not in `hint`.
     In `hint` (one lead, 28px) this 75px group was `align-self:center` and therefore hung
     23px INTO THE FOOT ROW above it, where the note scrub sits, and its 40px cells
     intercepted every click aimed at that control. Playwright reported it precisely: 87
     retries, each `<button data-semi="2"> … intercepts pointer events`. A person would have
     called the note control broken.
     `slack-b` is `minmax(0,1fr)` — it is where this screen puts placed air, so it has real
     height to give and the ladder absorbs whatever is taken. The other two cases leave it
     empty, which is unchanged; the drone's copy now holds the stack. `hint` goes back to
     being the tuner's error line only. */
  /* ── PROXIMITY IS WHY THE MARKS READ AS NOISE ────────────────────────────────────
     Measured, and it explains the user's question ("what do the lil vertical lines under notes
     mean?") better than the marks' POSITIONS did: the gap from a cell's ink to a mark was 12px
     while the gap from the mark to the chord text was 2px. Gestalt does the rest — the marks
     grouped with the words below them instead of the strip above them, so they looked like
     decoration under the note names rather than a scale for the cells.
     The cells' 40px targets overhang their 20px of ink by 10px each way, which is what opened
     that gap: the row box ends 10px below the ink a reader sees. So the scale is pulled up by
     that overhang and the chord pushed down, making the marks 2px from their cells and 12px
     from the text — the reverse of what shipped, and the same total height.
     `gap:0` because both children now carry their own offsets; a flex gap would add to them. */
  .mt-stackline{grid-row:slack-b;align-self:center;
    display:flex;flex-direction:column;align-items:stretch;gap:0;min-height:0}
  .mt-stackline .mt-scale{margin-top:-10px}
  .mt-stackline .mt-chord{margin-top:10px}

  /* ══ THE VOICE SELECTOR ════════════════════════════════════════════════════════════
     A SELECTOR, NOT THREE LATCHES, and the form has to say so: the voices are mutually
     exclusive, and a row of two-pocket tracks would promise you could hold two at once.
     The Track grammar's rule is that form announces operation — so this is the selector
     idiom the meters use (the members are the marks, the selected one is ink) rather than
     the toggle idiom.
     WORDS AND NOT GLYPHS: no drawing distinguishes a sampled section from an additive
     cello, and these differ by exactly the thing the words name. */
  /* ── SUB-CASES: A BOX PER CONTROL GROUP, NAMED IN ITS OWN TOP EDGE ────────────────
     Chooser practice-room-panels pick 03, held against a seven-option riff
     (practice-room-subcases, pick 01 — "as picked"), so this survived being argued with.

     THE PREMISE, and it is the owner's: "practice is diff tool than website so the rule
     about no lines and stuff doesnt rly work". STYLE.md's "structure is rules, not boxes"
     was written for a DOCUMENT you read. This is an INSTRUMENT you operate while holding a
     violin, glanced at from a stand — and boxes that group controls are the native idiom of
     hardware. The rule was borrowed from the wrong context.

     WHY IT INVENTS NOTHING: the notch is the case's OWN engraved plate at a smaller scale —
     same -14px offset, same --faint, same paper knock-out as `.mt-plate`. And it DELETES a
     mark rather than adding one: `subdivide` stops being a loose word beside a row and
     becomes the row's name, so the label moves instead of multiplying. The precedent for a
     box at all is already here: each case is a 1px hairline box, justified in its own
     comment as "inside is a machine".

     THE COST, stated because the sheet measured it: a notched name means "this is an
     instrument", once per case. Five more per screen and it means "this is a group", and the
     case's own plate stops being special. The riff's seven alternatives each tried to fix
     that and each cost more — the filled tab spends four filled forms where the site allows
     one; naming the value makes the labels longer; halving the boxes made it HEAVIEST
     (two full-width boxes beat four that stop at their own content).

     20px of top padding, not 12: the notch sits at -14px and needs room to clear the box's
     own top rule. 14px of side inset, not 12, because `.mt-hd`'s `margin:-8px -14px` puts
     the a4 handles' padded targets OUTSIDE the group's content edge — at 12 the border ran
     through a live control, invisibly (scrollWidth 140 against clientWidth 138). */
  /* THE CONTROLS STAY ON THE 27px DATUM, and the box hangs outside it. The harness caught
     the naive version at 32/32 red: case padding 27 + border 1 + box padding 14 puts every
     control at 42px, against a page whose horizontal datum is one --mt-inset. Two insets on
     one screen is the defect that harness exists to name.
     The fix is this page's OWN idiom, the one `.mt-hd` and the meter digits already use: pad
     out to the box, then pull the padding back with a matching negative margin. The ink then
     sits where the datum wants it and the box overhangs into the case's air, which is
     nothing. 15px = the 14px pad + the 1px border. */
  /* THE BOX'S CHROME IS A WHOLE LEAD, and that is arithmetic rather than taste. The sheet
     used 20px top and 10px bottom, which with two 1px borders is 32px — and 32 is not a
     multiple of the 28px lead, so a boxed row could not land on the baseline grid. The
     harness said so in the one place it shows: below 1240 the meters stack, and the second
     row sat 88px below the first where a whole number of leads was required (88 = 28 content
     + 32 chrome + 28 row).
     18 + 8 + 2 = 28 does land. The notch still clears the top rule: it sits at -14px against
     18px of padding, so there is 4px more room above the content than the notch needs. */
  /* ── THE SIDE PADDING IS 17px, NOT 14, AND THE BORDER IS WHY (box-guide pass, pick 02).
     The guide now draws a datum ON the box's side rule, so that rule has to land on the 9px
     character cell — and the ink inside it has to STAY on 3ch, which is the datum the whole
     inset was derived for. Both are possible, and the arithmetic is exact:
         rule = case inset − pull        ink = rule + border + padding
     For both to be whole cells, `border + padding` must be a multiple of 9. With the box's 1px
     border that means padding 8, 17 or 26 — NOT 18. At 18 the rule lands on 1ch and the ink
     drifts to 3.111ch, which is the finding half-applied. I reported 18 as the answer and it was
     wrong by the border: measured, 17/18 gives rule 1ch AND ink 3ch, at every width.
     `--mt-box-pull` is a token because the ⌥G overlay derives the datum's position from it — a
     hand-typed 9px in the gradient would drift the moment this padding changed. */
  .mt-grp{position:relative;border:1px solid var(--line);
    --mt-box-pad:17px;
    padding:18px var(--mt-box-pad) 8px;
    margin-left:calc(var(--mt-box-pull) * -1);margin-right:calc(var(--mt-box-pull) * -1)}
  /* The notch travels with the box, so it is 14px from the BOX's edge and therefore 29px
     from the case's — which is where the case's own plate sits at --unit. The two plates
     line up by construction rather than by a second number. */
  /* The notch travels with the box's padding, so its glyph stays on 4ch exactly as before:
     9 (rule) + 1 (border) + 17 (pad) = 27, and its own 1ch of knock-out puts the glyph at 36px.
     The old 12 + 1 + 14 came to the same 27 — the notch does not move in this pass. */
  .mt-gl{position:absolute;top:-14px;left:var(--mt-box-pad);background:var(--paper);
    padding:0 1ch;color:var(--faint);line-height:var(--lead)}
  /* The label the group already carried is redundant once the notch names it — this is the
     deletion that makes the treatment cost nothing in reading. `aria-hidden` on the notch
     and the real label merely hidden keeps the accessible name exactly as it was. */
  .mt-grp>.mt-lb:not(.mt-hd){display:none}

  /* THE DRONE'S CASE IS 210px WIDE ON PURPOSE, and the sheet never met it — every option
     was mocked in the metronome. Measured on the real page: the three voice WORDS total
     153px against 156px of inner case, so they fit with 3px to spare, but the box's own
     14px of side padding cannot — the box came out 201px in a 156px case and hung 46px
     past the frame.
     So this one group wraps its words rather than shrinking the case or the type. The
     alternative was widening the case, which would undo chooser metrotuner-drone-box Q2/05
     ("the narrow third") — a decision with its own measured reason: an equal third of the
     room made both worked instruments narrower to buy mostly empty case.
     The padding is the same 14px; only the flow changes. */
  .mt-drone .mt-voice.mt-grp{flex-wrap:wrap;gap:0 1ch}

  .mt-voice{display:inline-flex;align-items:baseline;gap:1ch}
  /* The comparer: the voice row's own vocabulary, one row down. `[hidden]` needs the
     explicit display:none — an authored `display` beats the attribute, a trap this page
     already recorded once for its swipe panes. */
  /* THE ROW IS NAMED, not `auto`. The case is a subgrid with a named row ladder, so a child
     without a `grid-row` lands in the next available track — which put the comparer's five
     wrapping 44px buttons on top of the spec row, UNDERNEATH the calibration sub-case beside
     them. Measured: the drone's a4 input overlapped the first tuning button by 41px and
     intercepted every click on it. Playwright named the culprit exactly ("...intercepts
     pointer events") where the screenshot looked fine, and moving the element in the DOM
     changed nothing — because the grid, not the source order, decides where a child sits.
     `hint` is the tuner's error line, empty on this case, and the right home for a row that
     is only sometimes there. */
  /* ── THE COMPARER IS THE WHOLE INSTRUMENT WHILE IT IS OPEN (his nit, 2026-08-12: "can the set
     page be full scren and have a back in top rail when its active. i mean full instrument lol").
     So `inset:0` on the case rather than a strip in its slack: press `set` and the drone's own screen
     becomes its settings, with a way back in the rail. What that buys over the strip is room to lay
     five wide systems out as LINES instead of as a wrapping paragraph; what it costs is that the
     letter and the strip are not visible while you are in here, which is the right trade for a screen
     you are IN rather than glancing at.
     HOW IT GOT HERE, because every step was a measurement rather than a preference. It began as a row
     assigned to `hint`: 176px of panel in a 28px row, three of five systems unclickable at 1512 and
     all five at 390. Then an overlay over the slack, which took four placements to stop covering the
     word that opened it, the stack strip, the calibration box and the voice group. A full-case panel
     has no neighbours to collide with — which is the argument for it that those four placements made.
     `overflow-y:auto` because five systems and a beat readout are 205px against a 812px case today,
     and a sixth system or a short landscape phone must scroll rather than spill. */
  .mt-tune{position:absolute;inset:0;z-index:2;background:var(--paper);
    padding:calc(var(--lead) * 2) var(--mt-inset) var(--lead);
    overflow-y:auto;
    display:flex;flex-direction:column;align-items:flex-start;gap:var(--tight)}
  /* the systems become a column of lines here, not a wrapping row — the whole point of the space */
  .mt-tune .mt-tune-btns{display:flex;flex-direction:column;align-items:flex-start;gap:0}
  .mt-tune[hidden]{display:none}
  /* the spec row is TWO leads on a phone and FOUR on the desktop (two stacked meters), so the band
     below it starts in two different places — the same reason the row ladder is declared twice.
     DESKTOP: one lead of case-top plus a four-lead spec = 5.
     PHONE: two leads of case-top plus a two-lead spec is 4 — and 4 was wrong, because the drone's
     calibration box does not fit the row it is in. Measured at 390: the box runs 56→129 inside a
     56→112 spec row, a 17px overflow that predates this drawer, so a drawer starting at 112 sat on
     its bottom edge. FIVE at both widths clears it by 11px, and the ladder's two sums happening to
     meet there is luck rather than derivation — stated, so the next person does not read it as one.
     (The box overflowing its row is a separate defect and is now the first line of the follow-ups.) */
  /* the word carries the open state, and the accent is this site's one job for colour: you can act
     on it, and it is acting */
  /* the row the comparer used to be assigned to, holding the word that opens it instead — one
     28px line, flush to the case's own 3ch inset like every other label on this screen */
  /* `position:relative;z-index:1` BECAUSE THE ROW ABOVE REACHES INTO THIS ONE. Every control on
     this screen pads out to a 44px target with matching negative margins, and the voice box adds
     its own `.mt-grp` padding on top of that — so the band directly under it belongs, invisibly, to
     the `section` button. Measured: `elementsFromPoint` on the word's own centre returned the voice
     button first and `set` third, and Playwright's click timed out for 45 seconds on a control that
     looked perfectly placed. The stack order is what settles who owns a pixel; nothing moves. */
  /* THE ROW IS TRANSPARENT TO CLICKS; ONLY THE WORD IS NOT. Lifting the whole row with a z-index
     fixed the word and broke six voice tests — a full-width 28px row above the voice group ate the
     clicks that had been eating the word, which is the same defect pointed the other way. So the
     row passes pointer events through and the 27px word takes its own pixels back. */
  /* `set` IS A MEMBER OF THE TOP RAIL NOW (his nit). What this deletes is a whole row and three
     failed placements: on the hint row it collided with the voice group's own 44px targets, then
     with the drawer, then with the voice box's invisible padding — the fixes were a z-index, a
     `pointer-events` pair and a right-alignment, and all three are gone with the row. A control that
     needs three rules to avoid its neighbours is in the wrong place.
     `margin-left:1ch` is the group's own separator: the plate already pads by 1ch, so this is the
     second half of one character's air between the name and the word. */
  /* THE MIRROR OF THE PLATE: same rail, same knock-out, same 24px inset, other end. The 44px
     target comes from the padding-and-pull idiom every control on this screen uses, so the word
     keeps a thumb-sized hit area without the rail growing. */
  /* `.vbtn.mt-setbtn`, TWO CLASSES, because `.vbtn` is declared further down and a one-class rule
     loses to it on source order — the same trap that computed the room's 2px walls as a hairline
     this morning. It showed up here as a 9px asymmetry: `padding:8px 1ch` silently became
     `.vbtn`'s `8px 0`, so the word's ink sat 25px from the case's right while the name's sat 34px
     from its left. One 1ch, invisible, and only the ink measurement saw it. */
  /* the settings' own back mark sits where the practice-room arrow sits on the leftmost case: the
     rail's left end, before the name. `border:0;cursor:pointer` because it is a BUTTON wearing the
     link's clothes — it closes a panel rather than going anywhere. */
  /* `#mt-set-back`, THE ID, and not `.mt-back.mt-setback` — which is what this rule said until the
     computed padding disagreed with the source. Astro scopes `.mt-back` to
     `.mt-back[data-astro-cid-…]` (0-2-0) but left my two-class selector UNSCOPED at 0-2-0, so the two
     tied and the base won on source order: `margin:-8px 0` applied from my block and `padding:8px 1ch`
     did not, which is not a thing specificity can do to one declaration block and is exactly the
     tell. The id is 1-0-0 and cannot tie with anything here. Same trap as the room's walls and the
     `set` padding, third variant: two selectors, equal weight, order decides. */
  #mt-set-back{position:absolute;top:-14px;left:24px;background:var(--paper);
    padding:8px 1ch;margin:-8px 0;line-height:var(--lead);z-index:3;border:0;cursor:pointer}
  #mt-set-back[hidden]{display:none}
  /* and the name steps aside for it — 3ch is the arrow's own cell (1ch of padding either side of one
     character), the same arithmetic the plate's 24px offset uses */
  .mt-half:has(#mt-set-back:not([hidden])) .mt-np{left:calc(24px + 3ch)}
  .vbtn.mt-setbtn{position:absolute;top:-14px;right:24px;background:var(--paper);
    padding:8px 1ch;margin:-8px 0;line-height:var(--lead);z-index:1}
  .mt-setbtn[aria-expanded=true]{color:var(--ink)}
  .mt-drone[data-sounding=true] .mt-setbtn[aria-expanded=true]{color:var(--accent)}
  .mt-tune-btns{display:inline-flex;align-items:baseline;gap:1ch;flex-wrap:wrap}
  .mt-tune-beat{font-variant-numeric:tabular-nums}
  .vbtn{font:inherit;background:transparent;border:0;border-radius:0;margin:0;
    padding:8px 0;margin-top:-8px;margin-bottom:-8px;   /* 44px target, row keeps its lead */
    cursor:pointer;color:var(--faint);
    transition:color var(--dur-fast) var(--ease)}
  .vbtn.on{color:var(--ink)}
  .vbtn:hover:not(.on){color:var(--accent)}
  .vbtn:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
  .mt-drone[data-sounding="true"] .vbtn.on{color:var(--accent)}


  /* ══ THE CHANGES — the chord dealer's own marks ═══════════════════════════════════
     THE SYMBOL IS THE DRONE'S 72px EXCEPTION, REUSED. Not a new size: same declaration, same
     optical nudge, same justification (a figure is a drawing, not a line of copy). Reusing it
     is what keeps "one typeface, one size" true with a fourth case on the screen — the page
     still has exactly one above-ramp size, now used by two figures.
     THE NUDGE IS THE DRONE'S NUMBER because it is the same face at the same size: a cap-height
     glyph's line box carries its descender space, so the ink centre sits 0.104em below the box
     centre and would miss the axis every other mark on the screen sits on.
     `white-space:nowrap` because a symbol is one token — `F♯m7♭5` breaking after the ♯ would
     read as two chords. The case is sized so it never has to (see `--mt-changes-w`). */
  .mt-sym{-webkit-appearance:none;appearance:none;background:transparent;border:0;
    border-radius:0;padding:0;margin:0;font-family:inherit;
    font-size:72px;line-height:1;font-weight:400;color:var(--ink);white-space:nowrap;
    cursor:pointer;transform:translateY(-0.104em);
    transition:color var(--dur-fast) var(--ease)}
  /* SOUNDING is the accent, exactly as the drone's letter does it — the one state this case
     has while it is making noise. */
  .mt-changes[data-sounding="true"] .mt-sym{color:var(--accent)}
  .mt-sym:hover{color:var(--accent)}
  .mt-sym:focus-visible{outline:1px solid var(--accent);outline-offset:4px}
  /* THE UNREVEALED STATE IS FAINT, and that is the mechanic drawn rather than explained: a
     `?` in full ink would read as the answer. Faint says "not yet". */
  .mt-sym[data-revealed="false"]{color:var(--faint)}
  .mt-changes .mt-deck.mt-grp{flex-wrap:wrap;gap:0 1ch}
  .mt-deck{display:inline-flex;align-items:baseline;gap:1ch}
  /* THE ANSWER LINE lives in the `hint` row — the tuner's error-line row, empty on this case
     until something is revealed. RESERVED by the row existing, so a verdict appearing cannot
     reflow the case: the same fix the tuner's hint line already records. */
  /* THE ANSWER LINE STAYS IN `hint`, and that is checked rather than assumed: this case's foot
     holds `deal` and `arpeggiate`, which are bare words with no sub-case box, so nothing
     overhangs into this row. (The loop's speed row IS boxed, which is why its state line had to
     move to `slack-b` — see the note there.) Measured on the live page: no overlap. */
  .mt-answerline{grid-row:hint;align-self:center;min-width:0}
  .mt-answer{color:var(--faint);display:block;text-align:center;max-width:100%;
    text-wrap:balance;overflow-wrap:break-word}
  /* A note you have LANDED while arpeggiating reads ink — the detector agreeing with the
     chord is the one thing in this case worth full weight. */
  .mt-answer b{color:var(--ink);font-weight:400}
  .mt-answer i{color:var(--accent);font-style:normal}

  /* ══ THE LOOP — a hairline, two carets, and no waveform ════════════════════════════
     THE TIMELINE IS THE FIGURE, so it sits in the `figure` row and takes the figure's own
     width rule (`.mt-gauge`). It is 40px tall rather than the arc's 184: a part selector has
     one axis, and reserving a square for it would be reserving air the drawing does not use.
     THE CARETS ARE INK, THE SPAN IS ACCENT. That split is the page's colour rule doing its
     job: the marks you move are ink like every other value on the screen, and the accent is
     "this is happening" — here, the stretch that will actually play. */
  .mt-tlfig{--mt-cols:6;height:40px;position:relative}
  .mt-tl{position:relative;width:100%;height:40px;cursor:pointer;touch-action:none}
  .mt-tl:focus-visible{outline:1px solid var(--accent);outline-offset:3px}
  .mt-tl-axis{position:absolute;left:0;right:0;top:19px;height:1px;background:var(--line)}
  .mt-tl-span{position:absolute;top:18px;height:3px;background:var(--accent)}
  /* The sixteenth ticks, drawn as a repeating gradient rather than 17 elements: the marks are
     furniture, and 17 spans would be 17 nodes to keep in sync with a count that never changes. */
  .mt-tl::before{content:"";position:absolute;left:0;right:0;top:24px;height:5px;
    background-image:repeating-linear-gradient(to right,
      var(--faint) 0 1px, transparent 1px calc(100% / 16));
    background-size:calc(100% - 1px) 100%;background-repeat:no-repeat}
  /* THE CARET'S TARGET IS 19px OF PADDING EITHER SIDE, and the ink is 1px. Same idiom as
     `.mt-hd` and the strip's cells: pad out to a real target, keep the mark hairline. A 1px
     drag handle is unusable on a phone and a 40px visible bar would not be a caret. */
  .mt-tl-caret{position:absolute;top:6px;width:1px;height:28px;background:var(--ink);z-index:2}
  .mt-tl-caret::after{content:"";position:absolute;left:-19px;top:-6px;width:39px;height:40px}
  .mt-tl-caret.hot{background:var(--accent)}
  /* The playhead: accent, and only while the loop is running. */
  .mt-tl-head{position:absolute;top:10px;width:1px;height:20px;background:var(--accent);
    opacity:0;z-index:1}
  .mt-loop[data-sounding="true"] .mt-tl-head{opacity:1}
  /* The span readout takes the tuner's own reading marks, so a time reads like a value and
     not like a caption. */
  .mt-tl-read{font-variant-numeric:tabular-nums}
  .mt-loop .mt-src.mt-grp{flex-wrap:wrap}
  /* The url field: the room's field, narrowed to the case. `field-sizing` is deliberately NOT
     used — a url is long and the box must not grow with it. */
  .mt-src input{width:100%;min-width:0;flex:1 1 auto;font-size:16px}
  .mt-rate{display:inline-flex;align-items:baseline;gap:1ch}
  .mt-loop .mt-rate.mt-grp{flex-wrap:wrap;gap:0 1ch}
  /* A ONE-GLYPH WORD CANNOT CARRY ITS OWN TARGET. The speed row is `1 ¾ ½ ¼` — measured, each
     button is 9px wide, under WCAG 2.5.8's 24px floor on the horizontal axis while clearing 44
     vertically. 8px each side takes it to 25px; the negative margin keeps the printed line
     exactly where it was. Same fix the proof sheet's own rate row needed. */
  .mt-rate .vbtn{padding-left:8px;padding-right:8px;margin-left:-8px;margin-right:-8px}
  /* ── THE STATE LINE LIVES IN `slack-b`, NOT `hint` ────────────────────────────────
     MEASURED ON THE LIVE PAGE, and it is the drone's own bug repeated: the speed sub-case sits
     in `foot`, but a boxed control group is 56px tall in a 28px track, so it overhangs DOWN
     into `hint` — the state line's row — and the two drew on top of each other (rate bottom
     840, state top 812: 28px of collision, in both colourways, invisible to every assertion
     I had). `.mt-stackline` hit exactly this and the fix is the same: `slack-b` is where this
     screen puts placed air, so it has real height to give and the ladder absorbs it.
     Two things had to move together, which is why this is one comment: the state line goes to
     `slack-b`, and the loop's own `hint` row goes back to being empty like the metronome's. */
  .mt-loopline{grid-row:slack-b;align-self:end;min-width:0;padding-bottom:var(--tight)}
  .mt-loopstate{color:var(--faint);display:block;text-align:center;max-width:100%;
    text-wrap:balance;overflow-wrap:break-word}
  /* THE IFRAME IS 1×1 AND OFF THE COMPOSITION. The case's figure is the timeline; the video
     is a sound source, so it gets no visual room at all. `position:absolute` keeps it out of
     the ladder entirely — a 0×0 iframe is not reliably allowed to play, but a 1px one is.
     NOT `display:none`: that suspends playback in some engines, which would break the one
     thing the element is here to do. */
  .mt-yt{position:absolute;width:1px;height:1px;overflow:hidden;opacity:0;
    pointer-events:none;bottom:0;left:0}

  /* ⌥G RAISES TWO OVERLAYS: the per-case one (axis + the box-rule pair) and the room's own
     TOP datum on the box's top rule. The CENTRE line (`.mt-mid::after`) and the BOTTOM datum
     stay deleted — see the notes on each rule. A raise list naming a pseudo-element with no
     `background` is not harmless: it reads as a line the guide draws, so the next person looks
     for it and doesn't find it. */
  :is(html,body).showgrid .mt-half::after{opacity:1}
  :is(html,body).showgrid .mt-pages::before{opacity:1}
</style>

<style>
  /* THE HEIGHT IS SNAPPED TO THE LEADING (grid pass, 2026-08-05). `100dvh` is whatever
     the window happens to be, and a screen whose height is not a multiple of --lead
     cannot put its rows on a 28px ladder — the remainder has to go somewhere, and
     wherever it goes is off-grid. So the screen takes the largest whole number of leads
     that fits and leaves the <=27px remainder as paper at the foot, where it is paper on
     paper and reads as nothing.
     This is what makes the rest exact: the ladder below is stated in leads and the
     padding is 2+1 leads, so once the HEIGHT is a whole number of leads the flexible
     figure row is one too, by subtraction. Measured at 1440x900: 900 -> 896 = 32 leads.
     The bare `100dvh` first is the fallback for anything without `round()` (Chrome 125,
     Safari 15.4, Firefox 118) — those get today's unsnapped screen rather than no
     height at all. */
  /* ── THE INSET IS A CHARACTER COUNT, NOT A SPACING TOKEN (2026-08-06) ────────
     `--mt-inset` is the ONE horizontal datum on this screen: the clearance between a case's
     frame and any ink inside it, and the origin every flush mark is measured from. It was
     `--gutter` (28px) — the site's vertical spacing token, borrowed sideways — and that is
     3.111 characters in this face, so the frame sat a third of a cell off the ladder every
     glyph on the page is set on. The instrument-standards research is what named it: legend
     clearance is conventionally stated in the width of the font's own capital (MIL-STD-1472G
     §5.2.3.14.12, "not less than the width of the letter H"), and in IBM Plex Mono at
     `--step` that width is exactly 1ch = 9.000px.
     At 3ch the clearance is 27px and the frame IS a cell boundary — the frame and the type
     become one ladder instead of two that never meet. Same correction STYLE.md records for
     `--label`: a number that was right about spacing and wrong about the grid it sits in.
     Stated as a TOKEN and not typed at each site because there are four of them (the case's
     padding, the phone's, the plate's offset, and the overlay's inset) and they have to agree
     by construction — four hand-typed 3chs is four chances to drift. */
  #mt-app{--mt-inset:3ch;
    /* THE `case-top` ROW'S HEIGHT, AS A TOKEN — because the ⌥G overlay derives its top datum
       from it and the two must not drift. It is one lead on desktop and TWO on the phone (the
       plate had to clear the accent mark there), and the overlay used to hardcode two leads for
       the line, which was a whole lead wrong at phone width. Every ladder that states this row
       restates the token beside it. */
    --mt-case-top:var(--lead);
    /* HOW FAR THE GROUP BOX HANGS OUTSIDE THE INK IT CONTAINS. The box pads out and is pulled
       back by this, so the ink lands on `--mt-inset` and the box's RULE lands one character
       inside the frame — which is the datum ⌥G draws. Both the box and the overlay read it, so
       they cannot disagree. See the note on `.mt-grp` for why 18 pairs with 17px of padding. */
    --mt-box-pull:18px;
    /* the drone case's width — see the note on `.mt-pages`' columns for the derivation */
    --mt-drone-w:210px;
    /* THE CHORD DEALER'S WIDTH, MEASURED FROM ITS FIGURE. The symbol is the figure and it
       takes the drone letter's own 72px (that exception is reused, not extended — see
       `.mt-sym`). The widest symbol in the decks, `F♯m7♭5`, sets 259px of ink at 72px in this
       face; plus the two 3ch insets and the hairlines that is 315px. Not rounded up: the case
       is exactly what its figure needs, and every px here comes off the tuner's dial. */
    --mt-changes-w:315px;
    /* THE LOOP'S WIDTH, MEASURED FROM ITS RULER. Sixteen sixteenth ticks need one character
       cell each to be countable — 16 × 9px = 144px — and the top line (`source take-five.mp3`)
       is the widest ink at 180px. 180 + 54 + 2 = 236px. The timeline would happily take more;
       236 is the floor, and at five cases the floor is what the room can pay. */
    --mt-loop-w:236px;
    height:100dvh;height:round(down, 100dvh, var(--lead));
    display:flex;flex-direction:column;overflow:hidden}

  /* THE CASES (chooser metrotuner-pendulum, Q2/01): each instrument in a square
     hairline case, its name interrupting the top frame like an engraved plate —
     sanctioned by the embed-frame argument: inside is a machine. THE FOOT LINE
     (Q3/01): controls in a line along the case's bottom edge; the figure alone owns
     the middle. */
  /* == ONE LADDER FOR BOTH CASES (grid pass, 2026-08-05) =====================
     THE DEFECT, measured on the built page at 1440x900 before this change: the two
     `start` buttons sat 7.50px apart vertically (user: "the start uui on metronome and
     tuner are not veritcally aligned"), the two figures' pivots 48.50px apart, the two
     foot lines 29.00px apart. At 1024x700 the same three were 28.00, 84.00 and 29.00.
     THE MECHANISM, which is why a nudge was not the fix: each `.mt-half` was an
     INDEPENDENT column flex whose `.mt-mid{flex:1}` absorbed whatever height that case's
     other rows left over. The tuner's non-mid rows total 125px (45 spec + 52 foot + 28
     hint) and the metronome's 110px (57 + 53), so the two middles were different heights
     and each centred its own contents in its own leftover. Every alignment between the
     two instruments was an accident of how tall the other rows happened to be — nothing
     in the CSS related the tuner's transport to the metronome's, so nothing held them
     together when either side's content changed. Which is what happens at 1024, where
     the metronome's meters wrap and the gap trebles.
     THE FIX: this element is the grid, with a NAMED ROW LADDER stated in leads, and both
     cases are `grid-template-rows:subgrid` on it — a row is one row across the whole
     screen, so the two instruments cannot disagree about where it is. `.mt-mid` is a
     nested subgrid for the same reason: figure, readout and transport are rows on the
     same ladder rather than three items centred in a leftover.
     THE HEIGHTS ARE DERIVED. `spec` is 2 leads because the metronome's beats meter
     measures 43px of ink (2 leads); `read`, `transport`, `foot` and `hint` are 1 lead
     each (19px of ink apiece); `figure` takes the rest, and with the screen snapped to a
     whole number of leads above it resolves to one too.
     BOTH CASES DECLARE EVERY ROW, including the ones they don't fill: the metronome has
     no readout and no hint line, and those rows stay empty on its side. That is the
     point — the empty modules are what hold the alignment (designer.md: "the empty
     modules are the composition"). It also retires the tuner's reserved-line hack. */
  /* ── THREE CASES, AND THE THIRD IS NARROW (chooser metrotuner-drone-box, Q2/05) ──
     The room was `repeat(2, minmax(0,1fr))`. The drone gets `--mt-drone-w` rather than an
     equal third, and the reason is the one the sheet was built to show: the case holds a
     letter, a verb, a note and a latch, so an equal third buys mostly empty case while
     making both worked instruments narrower to pay for it. Widths state importance.
     210px IS MEASURED, not chosen: the widest ink the case must hold is its foot line,
     `A4` beside `fifth` — 2ch + 5ch of glyphs plus the fifth's 26px track, its 1ch gap and
     the two 3ch insets. That comes to 9ch (81px) of type + 26px + 9px + 54px = 170px, and
     210 leaves the pair a comfortable 40px of air rather than setting them touching. Below
     1240 the meters stack (see that block) and this stays: the drone's contents do not
     change with width. The token is declared with `--mt-inset` on `#mt-app`, with the
     screen's other measures, rather than typed into the template here. */
  /* ── FIVE CASES NOW, AND THE COST IS STATED RATHER THAN DISCOVERED ────────────────
     Chooser `practice-room-apps` (2026-08-09): Q1 picked TWO new instruments — the chord
     dealer and the transcription loop — and Q2/01 put both IN THE ROOM.
     THE SHEET COSTED ONE NEW CASE, not two. Measured by cloning real cases into the live
     room rather than by arithmetic about it:
         3 cases (before)  worked pair 539px · dial 240px
         4 cases           worked pair 406px · dial 240px   ← what Q2/01 was costed at
         5 cases (this)    worked pair 208px · dial 152px
     So the two worked instruments end up NARROWER than either new case (the changes needs
     315px for its 72px symbol, the loop 236px for sixteen readable ticks). Widths state
     importance, and 208px says the tuner matters least, which is not what anyone believes.
     The owner was shown those numbers and chose five anyway; this comment is the record, not
     an argument to reopen.
     WHAT SURVIVES, and it is the part I was wrong about first: the LADDER HOLDS. My initial
     read was that the metronome's meters would break — they do not. Measured at 208px, the
     two cases' verbs stay 0.00px apart, no group spills its case, and nothing overflows
     horizontally. The meters stack (the spec row goes 84→183px) and the row above the figure
     absorbs it, exactly as the 1479px block describes. The cost is the FIGURE: 240→152px.
     THE TWO NEW CASES ARE FIXED-WIDTH for the same reason the drone is — their contents do
     not change with width, and a `1fr` share would take the width out of the drawings that
     do. Both numbers are measured minimums, not preferences; see each token. */
  /* ── ONE ROUTE, ONE THING, NO SCROLLER (2026-08-12) ─────────────────────────────────────
     THE FIVE FIXED COLUMNS ABOVE ARE HISTORY. Everything in the comments above this rule is
     kept because the measurements are still the reason each instrument needs the width it
     needs — but the LAYOUT they describe is gone. Two designs died between them and this one:
     five hardcoded columns (a sixth instrument meant editing CSS, and every viewport under
     1477px got the phone swiper), then a QUEUE that fitted what a width bought — rejected on
     sight of the built page: "the snapping and settling don't work quite right, i also think its
     a bit concerningly busy on desktop."
     NOW EACH THING IS A URL, so a route holds one thing and there is nothing to scroll between.
     THE COLUMNS ARE CSS AGAIN, and this is the whole win: `170fr 170fr 196fr` on the console is
     the members' measured demands as ratios, which is exactly what `splitThing()` computed at
     runtime — `fr` distributes what is left after the gaps, in proportion. So `layoutRoom()`,
     `--mt-cols`, the page log and the snap-point pass all delete. NOT `repeat(3, 1fr)`: equal
     thirds give 178px each at 760 and the metronome needs 196, so it would break the case at the
     exact width the band is bisected for.
     THE ONE SCROLLER LEFT is the console on a phone — three instruments that cannot sit side by
     side — and it is declared in the phone block, not here. */
  .mt-pages{flex:1;min-height:0;position:relative;
    display:grid;
    grid-template-columns:minmax(0, 1fr);
    column-gap:var(--group);
    padding:var(--group) var(--group) var(--lead);
    overflow:hidden;
    grid-template-rows:
      [case-top]  var(--lead)           /* the case's own top air */
      [spec]      calc(var(--lead) * 2) /* a4 | beats + subdivide */
      [slack-a]   minmax(0, 1fr)        /* placed air, above the instrument */
      [figure]    auto                  /* the drawing, at its own height */
      /* THE READING AND THE VERB ARE ONE ROW (transport chooser Q1/02, 2026-08-06).
         There WAS a `[transport]` row here, one lead below this one, holding the bare
         verb on all three cases. The verb moved into the reading's own line, so the row
         had nothing left in it — and a row of the ladder that nothing occupies is 28px
         of dead air pretending to be structure. Deleted rather than left empty: the
         `read` row is empty on two cases BY DESIGN (it holds their verb and no reading),
         which is a different thing from a row no case uses at all.
         What this costs: the instrument group is one row shorter, so the two slack rows
         each absorb 14px more. Measured, not assumed — see the verify harness. */
      [read]      var(--lead)           /* the reading AND the verb; verb only on 2 of 3 */
      [slack-b]   minmax(0, 1fr)        /* placed air, below it */
      [foot]      var(--lead)           /* played controls: tone/ref | bpm/tap */
      [hint]      var(--lead)           /* errors; empty on the metronome */
      [case-bot]  var(--lead)           /* the case's own bottom air */
      [case-end]}
  /* THE CONSOLE'S THREE, IN PROPORTION TO THEIR MEASURED DEMANDS — see the note above. This is
     the only route with more than one case, and the ratios are the reason it needs no script. */
  #mt-app[data-page="console"] .mt-pages{grid-template-columns:170fr 170fr 196fr}

  /* ── A CASE ALONE ON A SCREEN GETS A MEASURE (2026-08-12) ───────────────────────────────────
     Every case was composed as a COLUMN: one of five at 1512, or the whole of a 390px phone. Give
     one of them 1400px and the composition comes apart — rendered and looked at, which is the only
     way this shows up. On /changes/ the deck row sat top-left, `deal` bottom-left and `arpeggiate`
     bottom-RIGHT, 1,100px apart, with the 72px symbol adrift between them; on /loop/ the source
     field and the speed row were pinned to the far left of a centred track.
     THE CASE IS CAPPED AND CENTRED — and the first attempt capped the ROWS instead, which was
     worse and only visible in a render: a 560px column of controls floating inside a 1400px frame,
     the empty box louder than the app. A case is a case. On the console three of them tile the
     screen at 409px each; alone, one takes the width it needs and the page holds it, which is the
     same object at the same scale rather than a new full-bleed idiom.
     THE TWO NUMBERS ARE THE CONTENT'S, not preferences. The dealer's widest symbol is 259px of ink
     at 72px (`F♯m7♭5`) and its deck row sets 225 — 560 gives both air without stranding them. The
     loop is WIDER on purpose — 960 — and the reason is measured: every figure on this screen is six
     of its case's twelve columns, so the timeline is half the case. At 960 the track is 440px where
     the five-case room gave it about 110, and a transcription loop is the one instrument whose job
     is reading a span along a line. Width goes into the drawing, exactly as the queue's share did.
     Below these widths the column is the viewport and the phone rules take over, so nothing is
     ever narrower than its measured demand. */
  #mt-app[data-page="changes"] .mt-pages{grid-template-columns:minmax(0, 560px);justify-content:center}
  #mt-app[data-page="loop"] .mt-pages{grid-template-columns:minmax(0, 960px);justify-content:center}
  /* `data-snap`, `[data-queued]`, `--mt-qw`, `--mt-cols` and `--mt-pcols` are all GONE with the
     mechanisms that wrote them. CSS for a state nothing sets describes a design that is not
     there; `room.spec.ts` asserts none of them appears at any width. */

  /* ── THE ORDER PAGE'S LIST ──────────────────────────────────────────────────────────
     Rules, not boxes: each row is separated by a hairline and the last one draws none, so
     the list is a stack of rules rather than five cards. The row's ink sits on the case's
     own 3ch inset like everything else that does not radiate from an instrument.
     THE NUMERAL IS `--faint` AND THE NAME IS INK: the position is a fact about the list,
     the name is the thing itself. The demand is faint and right-aligned — it is the reason
     a row is where it is, not a control.
     A PICKED-UP ROW takes the accent, which is this site's one job for colour: you can act
     on it. `cursor:grab` says drag; `aria-pressed` says picked up. */
  /* ── EVERY SELECTOR BELOW IS `:global()`, AND THIS PAGE ALREADY KNEW WHY.
     The plan's boxes are written by this file's SCRIPT at runtime, so Astro never stamps them
     with the component's `data-astro-cid-*` — while it DOES add that attribute to every compiled
     selector. A scoped `.mt-pbox{…}` compiles to `.mt-pbox[data-astro-cid-*]{…}`, which a
     JS-created element can never satisfy, and the whole block is inert. That cost a session
     once already: the order rows rendered at their intrinsic height inside a 28px track and
     OVERLAPPED, which Playwright reported as "the loop intercepts pointer events" on four
     unrelated tests. One dead stylesheet, four symptoms. */

  /* `.mt-chrome` AND `.mt-planword` ARE DELETED, not left unused: a rule for markup nothing
     renders describes a design that is not there. What they held — one lead, one word, flush to the
     room's 3ch inset — is an arrow on the case's own top rule now (see `.mt-np` above). The one
     thing worth carrying forward is why the padding read `calc(var(--group) + var(--mt-inset))`:
     `--inset` does not exist, and both places that wrote it had their whole padding declaration
     dropped as invalid at computed-value time — CSS's silent failure mode, no warning, `0px` where
     83px was intended, visible only in the computed value. */

  /* ── THE ROOM'S WALLS ARE THE CASE'S OWN FRAME (his annotation, 2026-08-12) ──────────────
     "dont need this container if the room has one". There WAS a second bordered div inside the
     case — `#mt-planroom` — so two nested boxes drew one room, and on a route where the room is
     the only thing on screen the outer one was already doing the job.
     AND THE WALLS ARE THE SITE'S HAIRLINE (his next annotation, same evening: "cna this use light
     line weight"). They shipped 2px INK for two hours, on the argument that a plan draws a wall
     heavier than the thing standing against it — the weight difference IS the containment, and it
     is why box chooser Q1/04 rejected a plain hairline box: it draws the room and the rooms
     identically, so nothing says which contains which.
     HE LOOKED AT THE RENDER AND PREFERRED LIGHT, which settles it: 2px of ink is the heaviest mark
     on a screen whose whole vocabulary is one hairline and one type size, and it read as a border
     around the page rather than as a plan. What carries the containment instead is NESTING and the
     doorway — a box inside a box, with a threshold drawn on one wall. The cost, stated, is exactly
     the one Q1/04 named: the two weights no longer say which is the room. Every other case on the
     site says it the same way, so this is the page conforming rather than a new idiom.
     THE DOORWAY is a gap in the left wall: the border-left is transparent and two background
     gradients paint the wall segments above and below the opening. A drawn threshold rather
     than a fourth wall. Its cost, stated on the sheet and accepted: nothing goes in or out
     through it — it is a drawing of a way in, on a plan where every room is already inside.
     `#mt-app[data-page="room"]` AND NOT `.mt-order` ALONE, still: `.mt-half` declares its border
     200 lines further down and two single-class selectors are decided by source order, so a bare
     `.mt-order{…}` here silently lost. The route attribute also says what is true — these are the
     walls of the ROOM PAGE, not of any case carrying this class. */
  #mt-app[data-page="room"] .mt-order{
    border-color:var(--line);border-left-color:transparent;
    background-image:linear-gradient(var(--line),var(--line)),
                     linear-gradient(var(--line),var(--line));
    background-repeat:no-repeat;
    /* 1px NOW, matching the border it continues. At 2px the segments were the wall and the border
       was a hairline — two weights on one rectangle, which is the defect the annotation names. */
    background-size:1px 25%, 1px 45%;
    background-position:left top, left bottom;
    /* THE FLOOR IS INSET FROM THE WALLS by the room's own 3ch datum — `--mt-inset`, not the
       misspelled `--inset` this rule shipped with, which made it `padding:0` and stood the first
       and last room hard against the walls. */
    padding:var(--lead) var(--mt-inset)}

  /* THE FLOOR IS THE SCREEN'S THIRDS (Q2/04): a box sits where its case will, so the plan is a
     map of the room rather than a shelf of options. Its cost, accepted: the real room shares
     width by measured demand, so a box drawn at a third is a picture of something that renders
     at 648px beside a 315px neighbour.

     AND THE ROOMS FILL THE FLOOR (2026-08-12). The first build drew them 62px tall in a 742px
     room, so the plan read as one thin strip of chips floating in a large empty box — the
     containment the 2px walls exist to state was undone by the thing inside them being a
     rounding error. A room on a plan occupies its share of the plan. `min-height` was the tell:
     a number I picked rather than derived, which is the same defect the sheet's empty floor had.
     The gap is `--group`, the width the real room puts between two cases, so the drawn gap and
     the rendered gap are the same measurement. */
  /* NO `height:100%` HERE. It was in the first version and it does NOTHING: the floor is a grid
     item in a `minmax(0,1fr)` row, so it already stretches. Red-arming caught it — deleting the
     declaration left every assertion green, which is the definition of a line that is not load-
     bearing. What actually fills the floor is the ROOM's single 1fr row (below), the slot's
     `place-items:stretch`, and the box's own `height:100%`. */
  /* THE FLOOR FILLS THE ROOM. `#mt-planroom` used to be a one-row `minmax(0,1fr)` grid and the
     floor stretched inside it; with that container gone the floor became an ordinary item in
     `.mt-mid`'s subgrid and landed in the `figure` row — 280px of rooms in an 812px case, the
     strip-of-chips defect again, from the other direction. `grid-row:1/-1` spans the whole band
     `.mt-order .mt-mid` claims (slack-a → foot), which is the air an instrument's figure centres
     in. */
  .mt-order .mt-pfloor{display:grid;grid-row:1 / -1;
    grid-template-columns:repeat(3, minmax(0, 1fr));gap:var(--group)}

  /* A SLOT, drawn as four corner ticks (plan chooser Q3/01) — the plan convention for a
     fitting. An empty slot reads as available floor rather than as an empty card. */
  .mt-order .mt-pslot{position:relative;display:grid;
    place-items:stretch;padding:2px}
  .mt-order .mt-pslot::before,.mt-order .mt-pslot::after{
    content:"";position:absolute;width:9px;height:9px;border:1px solid var(--line);
    pointer-events:none}
  .mt-order .mt-pslot::before{top:0;left:0;border-right:0;border-bottom:0}
  .mt-order .mt-pslot::after{bottom:0;right:0;border-left:0;border-top:0}

  /* A LITTLE BOX: a figure and a name under it (Q3/02). The figure is the instrument's own
     generated mark; the console shows all three of its members' marks in a row, which is how
     "these three are one thing" is drawn rather than labelled. */
  /* AND IT IS A LINK, so the site's link idiom has to be turned off HERE: global.css gives every
     `a` the accent colour and an underline, which is correct for a word in a sentence and wrong for
     a room on a plan — the box IS the affordance. `color:var(--ink)` also matters because the marks
     are drawn in `currentColor`: as a link they came out accent-blue. */
  .mt-order .mt-pbox{display:grid;gap:2px;justify-items:center;align-content:center;
    width:100%;height:100%;text-decoration:none;
    background:var(--paper);border:1px solid var(--line);color:var(--ink);
    font:inherit;font-size:var(--step);padding:var(--lead) var(--tight);cursor:pointer;
    transition:box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease)}
  .mt-order .mt-pbox:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
  /* THE ONE SKEUOMORPHIC DEVICE (Q5/01), NOW ON HOVER RATHER THAN ON A DRAG. The pick was "drag
     it, and it casts a shadow while lifted"; positions are fixed, so there is no drag left to
     lift — but the delight it bought is the box behaving like an object, and a box that rises
     as you reach for it says "pick me up" in the same vocabulary. Nothing else on this screen
     has a shadow. `:active` presses it back down, so the gesture completes. */
  .mt-order .mt-pbox:hover,.mt-order .mt-pbox:focus-visible{
    box-shadow:0 6px 14px rgba(0,0,0,.18);transform:translateY(-2px);border-color:var(--accent)}
  .mt-order .mt-pbox:active{box-shadow:none;transform:translateY(0)}
  /* THE MARKS ARE DRAWN AT 32px HERE, AND THE STROKE STAYS 1.8 (2026-08-12). A 16px figure
     centred in a 512px room is a speck — the pick was "a figure and a name under it", and at
     that ratio the figure reads as dust on the paper. Scaling the same generated output is not a
     second drawing: the viewBox is 16 and the formula is untouched, so this is the identical mark
     at 2×. `vector-effect:non-scaling-stroke` is what keeps it honest — without it the 1.8 weight
     doubles to 3.6 and the mark becomes a different, fatter object than the one in the dot row.
     One weight on the whole site, at every size. */
  .mt-order .mt-pmarks{display:inline-flex;gap:var(--tight);align-items:center;
    justify-content:center;min-height:32px}
  .mt-order .mt-pmarks :global(svg){display:block;width:32px;height:32px}
  .mt-order .mt-pmarks :global(path){vector-effect:non-scaling-stroke}
  /* NO SIZE. This screen has ONE type size and says everything else with colour and position —
     `.mt-gl`'s notch labels are 15px `--faint`, not small type. My first version set 12px here
     and `practice-room-css.test.ts` caught it: "only 72px may be set". The names are `--dim`
     against the box's ink, which is the distinction the site actually uses. */
  /* AND THE NAME WRAPS RATHER THAN TRUNCATES. `white-space:nowrap` + ellipsis rendered
     `the chang…` in the middle box at 390px — a name clipped on the one screen whose whole job
     is naming the things. A room is tall enough to give a word a second line. */
  .mt-order .mt-pnm{line-height:var(--lead);color:var(--dim);
    max-width:100%;text-align:center}

  /* ── THE PHONE STACKS THE ROOMS (2026-08-12). Three across 390px truncated the middle name to
     `the chang…`, and a plan of a narrow room draws its rooms down the floor rather than across
     it. It also matches what the phone then does: one app per page, top to bottom. */
  @media (max-width: 759px){
    .mt-order .mt-pfloor{grid-template-columns:minmax(0, 1fr);
      grid-auto-rows:minmax(0, 1fr);gap:var(--lead)}
  }

  /* the index page's two labels: ordinary rows on the ladder, `--faint` like every other
     supporting mark on this screen. NOT `.mt-gl` — see the markup note. */
  .mt-ol{color:var(--faint);line-height:var(--lead);display:block;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* THE SLACK IS TWO ROWS, AND THAT IS THE POINT (found by looking at the render, not at
     the numbers). The first version gave the FIGURE row all the leftover — `figure:
     minmax(0,1fr)` — and centred the drawing inside it. The alignment was correct and the
     composition was wrong: the figure row was 588px tall for a 158px drawing, so the
     tuner's readout — its own row, below — sat 215px UNDER the dial it describes, and
     `start` another 28px under that. Three rows that are one figure group read as three
     unrelated things.
     Now the slack is placed as air ABOVE and BELOW the group, in equal `1fr` rows, and the
     group's three rows sit against each other: dial, reading, verb. Measured after:
     dial→readout gap 0px, and both instruments' transports still land on one row (Δ0.00).
     `figure: auto` rather than a lead count so the drawing sets its own height — it is an
     svg with a fixed aspect ratio whose width comes from the column span, so pinning its
     row to n leads would either crop it or open a gap inside the group. The air that is on
     the ladder is the slack rows; the figure is a figure. */
  /* THE ROWS ARE DRAWN HERE, from the origin the ladder actually starts at, so the
     overlay describes the ladder that exists. This is the honesty fix: the rows used to
     be drawn per case from each case's own content-box top, and NOTHING landed on them
     (measured: the tuner's rows missed by 1.00, 10.00, 9.50, 2.50, 2.50, 5.00, 3.00px,
     and the two cases' ladders were 12px out of phase with each other). The instrument
     by which the grid was judged was itself off-grid.
     THE 12 SCREEN COLUMNS ARE DELETED (datum pass). They were the second half of the
     "25 columns" the reader saw, and they described nothing: the two cases are placed by
     `repeat(2, minmax(0,1fr))` and one `--group`, not by spans of a twelve-track screen
     grid, so the bands never marked an edge any content used. What remains is the ROW
     LADDER, and the 32 lines it drew are DELETED TOO (vertical datum pass, 2026-08-05).
     The named row ladder stays — it is what places the content and what keeps the two cases
     0.00px apart — but drawing all 32 of its lines was the same mistake as the columns, and
     for a reason worth writing down: THE LADDER CANNOT BE HONOURED BELOW THE INSTRUMENT.
     Measured, walking the resolved tracks: `case-top` and `spec` land at 0.00 off a lead, then
     the first `1fr` slack row resolves to 214.938px and every line after it is 9.06px off. The
     middle of this screen is elastic by design (the figure takes the leftover), so no
     arrangement of `1fr` puts the lower rows on the same 28px ladder as the upper ones. A
     guide that draws 32 lines when 20 of them cannot be met is a guide that makes the page
     look broken.
     WHAT IS ACTUALLY TRUE is three datums, and they were nearly true already:
       · TOP    — the spec line. a4, beats and subdivide all share it (measured: one line).
       · CENTRE — the instrument's own pair: the reading, and the verb one lead below it.
       · BOTTOM — the played controls. play tone, refnote, bpm and tap all share it.
     TOP and BOTTOM are drawn here because they are grid-derivable: two leads down from the
     ladder's origin, and two leads up from its end. The CENTRE pair cannot be — it floats with
     the slack — so it is drawn on `.mt-mid`, which is the box that holds it. Verified: all four
     drawn lines coincide with the baselines they claim, 0.0px each. */
  /* ── THE HORIZONTAL DATUMS ARE DELETED. THE BOXES DRAW THEM (chooser
     practice-room-box-guide, pick 05: "the axis only — the boxes ARE the guide").
     THE OWNER'S CORRECTION, and it reframed the whole question: "i like the boxes. i just
     mean the datums might have to drawn against the boxes right? rather than text?" The first
     sheet had offered five ways to move the BOX so its text would meet a line placed for
     text — backwards, because since the sub-cases treatment shipped the box IS the mark the
     eye reads.
     Asked the right way round, the answer was to draw less. A box already draws its own top
     rule and its own side rules, in ink, permanently, for every reader — not just while ⌥G is
     held. A guide line beside them draws the box twice.
     WHAT THE MEASUREMENTS SAID, and this is why deleting is safe rather than merely simpler:
       · Every box's top rule ALREADY lands on a whole lead — 1, 2, 4, 26, 27, exact, both
         colourways, desktop and phone. The boxes were never off the ladder. The old line was
         drawing one lead BELOW them, in the middle of the box's own top padding, naming the
         box's air. That was the "not aligned" report.
       · Every box's side rule already agrees with every other — all five at 1.333ch.
       · So nothing on this page had to move to make the guide honest. The guide had to stop
         describing the composition the boxes replaced.
     AND A LINE ON THE BOX'S RULE CANNOT WORK ANYWAY, which is what killed the four options
     that drew one: the notch straddles that rule by construction (it is the case's engraved
     plate one scale down, knocked out of the rule), so its glyph band spans it — measured 9px
     above and 10px below. Every candidate line at the box's top rule ran straight through the
     middle of the word `calibration`. Rendered, looked at, measured.
     WHAT IS LEFT IS THE AXIS, on `.mt-half::after` below: the case's centre line, the one
     datum no ink of its own marks and the one the figure, the reading and the verb are all
     centred on. One line per case.
     WHAT THIS COSTS, stated because it is real: ⌥G can no longer answer "is this row on the
     ladder" — a box shows you where its edge IS, not whether that edge is on a lead. That
     question moves to `tools/verify-practice-room-datums.mjs` and to
     `tools/probe-box-as-datum.mjs`, which assert it at 16 widths in both colourways, which is
     a better instrument for it than a line a human squints at. And the guide now says nothing
     about the unboxed half of the screen (the foot controls, the reading, the hint line) —
     those keep their datums in the harness, not on the glass.
     `--mt-case-top` STAYS, and is not dead: it states the `case-top` row's height, which the
     phone re-declares, and the unit test that pairs every ladder with it stays too. It just
     no longer feeds a gradient. */

  /* THE HAIRLINE (chooser metrotuner-reactive, Q1/02): 1px --line — the embed
     frame's own weight, the weakest mark the system has. The case is not
     interactive, so it must be the quietest line on the screen; at 1.5px ink it was
     tying with the pendulum's own stroke. Near-invisible in dark is the point. */
  /* THE CASE SPANS THE WHOLE LADDER and inherits it, so its rows ARE the screen's rows.
     The flex column and `justify-content:flex-end` are gone with it — a row's position is
     stated once, on the parent, instead of falling out of how tall its siblings are.
     THE VERTICAL PADDING IS GONE, and that is the substantive part: padding on a subgrid
     item does NOT move the inherited row lines (verified by probe — with and without
     vertical padding every interior row's y is identical to 0.00px), so keeping it would
     have pushed content off the very ladder it inherited. The air is now the `case-top`
     and `case-bot` ROWS — the same 28px, held by the grid where the composition can see
     it. Horizontal padding stays: it insets content from the hairline on the axis the
     ladder says nothing about.
     THE COLUMN AXIS IS DECLARED, one column, and that is a fix not a formality: with rows
     named and columns left to `auto`, grid auto-placement is free to INVENT an implicit
     second column, and it did — measured, the case computed `grid-template-columns:
     414px 164px` and the metronome's foot line was placed in the second one, 414px to the
     right of everything else, which forced its spec row to wrap. One explicit column
     means every row spans the case's whole content width and nothing can be placed
     beside anything. (The twelve columns are what content aligns to INSIDE a row — the
     figure's six — not tracks these rows sit in.) */
  .mt-half{min-width:0;position:relative;
    border:1px solid var(--line);
    grid-row:case-top / case-end;
    display:grid;grid-template-rows:subgrid;
    grid-template-columns:minmax(0, 1fr);
    padding:0 var(--mt-inset)}
  /* ── THE NAMEPLATE GROUP. The plate used to carry the absolute position itself; the group
     carries it now and the plate is an ordinary child, because the arrow has to sit beside a name
     whose width is `tuner` on one case and `the changes` on another — a second absolute element
     would need that width as a number. `baseline` and not `center`: the arrow is type, and the two
     sit on the line the rule notches.
     THE ARROW IS ON THE DATUM, not the name. The group's `left:24px` is the plate's own historic
     offset (one 3ch inset less its 1ch knock-out padding), so whatever is FIRST in the group lands
     where the plate's ink used to. That is the arrow, and the name follows it — the leftmost ink on
     the case's top rule is still on the case's datum. */
  /* `z-index:3` PUTS THE RAIL ABOVE THE FULL-CASE PANEL. The plate straddles the case's top rule, so
     its lower half is inside the case — and the settings panel is `inset:0` with its own paper
     background at `z-index:2`, which painted over exactly that half: `drone` rendered as a name cut
     off along the rule. The rail is chrome and the panel is content, so the rail wins. */
  .mt-np{position:absolute;top:-14px;left:24px;display:flex;align-items:baseline;
    background:var(--paper);z-index:3}
  .mt-plate{background:var(--paper);padding:0 1ch;color:var(--faint)}
  /* AN ANCHOR, with the site's link idiom turned off: global.css underlines every `a`, which is
     right for prose and wrong for a mark on a rule. `--dim` at rest, accent on hover — the same
     two states the deleted chrome word had. */
  .mt-back{font:inherit;color:var(--dim);text-decoration:none;padding:0 0 0 1ch;
    line-height:var(--lead);transition:color var(--dur-fast) var(--ease)}
  .mt-back:hover,.mt-back:focus-visible{color:var(--accent)}
  /* ONE ARROW PER SCREEN ON THE DESKTOP. The console shows three cases at once and three copies
     of one control is three ways to say the same thing; the first case owns it, which is also the
     top-left corner of the screen. On a phone every case is its own page, so every case keeps its
     own — swiping to the metronome must not leave you with no way out. */
  @media (min-width: 760px){
    /* `a.mt-back`, THE LINK, not every `.mt-back`. The settings' own back mark wears the same class
       and is a BUTTON, and this rule was hiding it on the very case it belongs to — Playwright spent
       30s on a control whose `hidden` attribute had been removed and whose CSS still said no. One
       rule, two controls, one of them wrong. */
    #mt-app[data-page="console"] .mt-half:not([data-mt-key="tuner"]) a.mt-back{display:none}
  }
  /* THE MIDDLE IS THREE ROWS, not a centred leftover. It spans figure -> read ->
     transport and passes the ladder through, so the tuner's readout and BOTH transports
     sit on rows the other case also has. The figure centres itself INSIDE its own row,
     which is the one place centring is still right: a 184px drawing in a taller row is a
     figure in a module, not a row whose height nobody stated.
     `cursor:pointer` stays — the middle is the start/stop click target — and it now
     covers exactly the three rows the instrument occupies rather than all the slack.
     THE SPAN ENDS AT `foot`, NOT `hint` — an off-by-one that mattered: `figure / hint`
     includes the `foot` track, so `.mt-mid` and `.mt-cfoot` both claimed it, and grid
     resolved the collision by inventing an implicit column for the foot line. Ending the
     span at the `foot` LINE gives it exactly figure + read + transport, the three rows it
     draws. Found by reading the placement off the built page, not from the source. */
  .mt-mid{grid-row:figure / slack-b;display:grid;grid-template-rows:subgrid;
    grid-template-columns:minmax(0, 1fr);
    /* `relative` IS DELETED with the centre datum it existed for (`.mt-mid::after`, gone in the
       box-guide pass). It was a containing block for one overlay and nothing else — no other
       descendant here is absolutely positioned — so keeping it would be a positioning context
       held open for a rule that no longer exists. Verified after removing it: the figure, the
       reading and the verb hold identical positions, and the datums harness passes 32/32. */
    min-height:0;cursor:pointer}
  /* ── THE PLAN'S BAND IS THE WHOLE BODY, not the figure row (2026-08-12). An instrument's
     `.mt-mid` holds a drawing at its own height with placed air above and below it; the plan
     holds a ROOM, and a room is the extent of the page it maps. Spanning `figure / slack-b` gave
     it 166px inside a 740px case, so the 2px walls enclosed a strip floating in the middle of a
     much larger faint box — the case's own border read as the room and the room read as a shelf.
     `slack-a / foot` takes both slack bands as well, which is exactly the air an instrument's
     figure is centred in. The plate, the hint row and the foot row keep their ladder positions,
     so nothing else on the page moves. And no pointer on the floor: only the boxes act. */
  .mt-order .mt-mid{grid-row:slack-a / foot;cursor:default}
  /* THE CAPTION (transport-placement Q1/05): the transport under the figure it
     drives, centred — the figure supplies the noun, the caption is the verb. */
  /* IT IS THE `transport` ROW, on both cases — the one the user's report named. The
     44px button is taller than the 28px row, so it overhangs; the tap target keeps its full
     44px while the WORD, which is what the eye aligns, sits on the row. No height is shrunk
     anywhere — WCAG 2.5.5 is untouched.
     `start`, NOT `center` (vertical datum pass, 2026-08-05). Centring a 44px box in a 28px
     track hangs it 8px ABOVE the track line, so the verb's baseline landed 24.50px below the
     reading's instead of one lead — measured, and visible as the two lines of the instrument
     group reading tight. `start` puts the box's top on the track line and its baseline exactly
     one lead below the reading's: 28.00, at every width. The overhang moves to the BOTTOM,
     into the slack row below, where it is air.
     The reading takes the same treatment for the same reason (see `.mt-read`) — and it has to
     be BOTH: with only one of the two changed the interval reads 32.50 or 24.50. That pair is
     why an earlier single-rule test looked like it did nothing. */
  /* NO `grid-row` ANY MORE: `.mt-cap` is not a row of the ladder, it is a cell INSIDE
     `.mt-read` (see the three-column note there). It kept `grid-row:transport` through one
     draft of this change and the effect was silent and total — the verb was still placed on
     the old row by the subgrid, so the reading row looked untouched and nothing appeared to
     have moved. Stated because a stale `grid-row` on a re-parented element does not error;
     it just quietly wins.
     `align-self:start` is what survives, and for the reason the long note above gives: the
     44px tap target is taller than the 28px row, so `center` would hang it 8px above the
     row line. `start` puts its top on the line and lets the overhang fall into the slack
     below, where it is air. No target shrinks — 2.5.5 untouched. */
  .mt-cap{display:flex;justify-content:center;align-self:start;align-items:center;
    min-height:var(--lead)}
  /* A foot line: left group flush left, right group flush right, one baseline.
     The top line is the same device at the case's other edge (user nit 2): spec
     controls up top, played controls at the foot. */
  /* ONE BASELINE PER ROW (round16 nit: "text doesn't align — the numbers on
     beats/subdivide, bpm and tap"). Both control lines align on the TYPE
     baseline, and every composite control is built so its first-baseline IS its
     text's: the meters put the digits first (a column flex baselines on its
     first item), the latches align their track to the baseline (below). */
  /* Each control line is a ROW of the ladder. `flex-wrap` stays — a narrow case must
     still wrap rather than overflow — but a wrap no longer moves anything in the OTHER
     case, which is what made 1024px three times worse than 1440 (the metronome's meters
     wrapped, its middle shrank, and the two instruments slid 84px apart). A wrapped row
     overflows its own row box into the figure's slack instead. */
  .mt-ctop{grid-row:spec}
  .mt-cfoot{grid-row:foot}
  .mt-cfoot, .mt-ctop{display:flex;align-items:baseline;justify-content:space-between;
    align-self:start;gap:var(--lead) 4ch;flex-wrap:wrap}
  /* WHY `start` AND NOT `center`. Both control rows are taller than their lead (45px and
     57px of 44px targets), so how they sit in the row decides whether the two cases' TEXT
     agrees. Centring two boxes of different heights in the same row puts their type in
     different places by half the height difference — measured, that was the residual
     6.50px between `a4` and the beats digits after the ladder landed. Aligned to the row's
     start, and with each composite control's first baseline made its text's (the three
     rules below), the two rows' first baselines are identical: measured 0.00 at 1440,
     1240 and 1024. The rows keep their full height and overhang downward into the
     figure's slack, so no tap target shrinks — all four are still 44px. */
  .mt-fl{display:inline-flex;align-items:baseline;gap:2ch;flex-wrap:wrap}
  .mt-fr{display:inline-flex;align-items:baseline;gap:2ch;flex-wrap:wrap}

  /* ── THE SPEC ROW'S OWN BREAKPOINT, DERIVED (grid pass, 2026-08-05) ─────────
     The metronome's spec row holds two meters — `beats 1-7` and `subdivide 1-7` — flush to
     opposite ends of the case. Measured: they need 203px and 239px of ink plus the row's
     4ch (36px) gap = 478px, and the case's content box is exactly 478px when the viewport
     is 1240. Below that the row wraps, the second meter drops a line, and the case's spec
     content becomes 128px tall inside a 56px row.
     That wrap is not a defect on its own — a row too narrow for its contents SHOULD wrap
     rather than overflow — but under the old layout it also dragged the whole instrument
     with it, which is how the 7.50px transport gap at 1440 became 28.00px at 1024. On the
     ladder the wrap is contained: the row overhangs into the figure's slack and the rows
     below it do not move (verified: START stays 0.00 at 1100, 1024, 940 and 901). So what
     is left to fix is only the row's own height, and it is fixed by STATING the width the
     row cannot hold both meters at, instead of leaving it to be discovered.
     1240 IS MEASURED, NOT CHOSEN — it is the width at which 478px of meters meets a 478px
     case, the same way STYLE.md's 1060 is the width at which `--label` meets its longest
     label. Above it, one line; below it, the spec row is two leads taller and the meters
     stack flush left, which is what they do at phone width anyway. The ladder's `spec` row
     grows with them so the figure's slack is not silently eaten. */
  /* 1479 IS BISECTED, and it took three attempts to get right — worth recording, because
     every wrong answer came from computing instead of measuring.
     1240 was the TWO-case threshold. Adding the drone takes `--mt-drone-w` plus a `--group`
     out of the row, so the metronome's case is narrow enough to wrap at a WIDER screen.
       · 1506 (= 1240 + 210 + 56) — wrong by ~96px. It scaled a number whose own premise was
         false: the old comment said the meters need 478px, and they measure 280px.
       · 1410 — wrong by 69px, and worse than it looks. It came from sampling widths 20px
         apart (1420 fits, 1400 wraps) and picking between the samples; the real boundary was
         never in that interval. It left a BAND, 1410–1479, where the meters wrapped with no
         taller row to wrap into — which is precisely the defect this block exists to
         prevent, and it showed up as the accent-baseline test failing at Playwright's
         default 1280… no, at 1411: measured Δy −84 there against −56 when stacked.
       · 1479 — bisected one pixel at a time with the stacking rule suppressed, so the wrap
         is the browser's own decision: the row holds both meters on one line down to 1480
         and wraps at 1479.
     THE LESSON, stated because the same mistake is easy to repeat here: a threshold is a
     boundary, so it has to be found by bisection, not by sampling a range and interpolating.
     If `--mt-drone-w` changes, re-bisect — do not re-derive. */
  /* ── RE-BISECTED FOR FIVE CASES: 1479 → 1511 (2026-08-09) ────────────────────────
     The block's own lesson, obeyed: a threshold is a boundary, so it is found by BISECTION
     and never re-derived. Two new fixed columns (315 + 236 + two more 56px gaps = 663px) come
     out of the worked pair, so the metronome's case is narrow enough to wrap at a much wider
     screen than before. Bisected one pixel at a time against the built page: the spec row
     holds both meters on one line at 1512 and stacks at 1511.
     AND THE BAND THIS CLOSES IS THE DEFECT THE OLD NUMBER LEFT BEHIND. At 1479 the query no
     longer matched where the wrap actually happened, so between 1480 and 1511 the meters
     wrapped with no taller `spec` row to wrap INTO — the row's overflow pushed the foot line
     past the case's bottom edge, where `overflow:hidden` on `#mt-app` CLIPPED IT. Measured at
     1280×720: the tap button's box sat at y 710 in a 700px document, so `tap` was not merely
     ugly, it was unclickable — `elementsFromPoint` at its centre returned only <html>. The
     e2e suite found it as "the ring overshoots on press: expected > 1.5, received 1", which
     is what a control outside the page looks like from a test. */
  /* ── THE BAND HAS NO UPPER BOUND ANY MORE (re-measured, 2026-08-09) ────────────────
     I re-bisected this to 1511 on the wrong signal — the meter groups' `top`, which reports a
     difference whether the row STACKS (the rule below) or merely WRAPS (the flex default). At
     1512 the band did not apply and the meters wrapped anyway: a 183px spec row against the
     56px the ladder reserves, so the figure's slack absorbed 127px and the drawing shrank.
     MEASURED on the built page, bisected on the meters' own y: the two meters need a viewport
     of 1819px to sit on one line in the five-case room. No screen this instrument runs on is
     that wide, so "both meters on one line" is not a layout that exists any more — the spec
     row is TWO STACKED METERS at every desktop width, and the band that states it must run
     from the swiper's edge all the way up rather than stopping at a number I guessed.
     `min-width` only, therefore. If a future change takes cases back out of the room, re-bisect
     this — do not reinstate a number from the three-case era. */
  @media (min-width: 760px){
    .mt-pages{grid-template-rows:
      [case-top]  var(--lead)
      [spec]      calc(var(--lead) * 4)  /* two stacked meters, two leads each */
      [slack-a]   minmax(0, 1fr)
      [figure]    auto
      [read]      var(--lead)            /* reading + verb, one row (see the 1480+ ladder) */
      [slack-b]   minmax(0, 1fr)
      [foot]      var(--lead)
      [hint]      var(--lead)
      [case-bot]  var(--lead)
      [case-end]}
    /* Stacked, both meter GROUPS read from the same left edge — `space-between` on a wrapped
       row would push the second one right, off the inset datum entirely.
       PRECISELY WHAT ALIGNS, because the earlier wording ("the two scales would not line
       up") over-claimed and a test written from it failed on a correct page: the two GROUPS
       are flush at the inset (measured 563.0 and 563.0 at 1280, 0.00px apart), and the two
       SCALES are 36px apart — `beats` sets 45px wide and `subdivide` 81px, so a scale that
       follows its own label cannot share an edge with the other. That offset is not new; it
       predates the drone. Aligning the scales would need a label column, which is a
       composition decision and not this rule's business. */
    .mt-ctop{justify-content:flex-start;flex-direction:column;gap:0}
  }

  /* ── THREE CASES DO NOT FIT ABOVE THE PHONE BREAKPOINT, so the room becomes the swiper
     69px earlier (901 → 970). This is the one place the drone forced a real trade, and the
     numbers are why:
       · A label+scale group needs 230px of ink for `subdivide` (81 + 9 + 140).
       · The spec row holds two of them stacked, so the case needs 230px of CONTENT — 284px
         of case with the 3ch insets.
       · Three cases plus two `--group`s means the screen needs 3×284 + 112 = 964px before
         the metronome has that. Below it `subdivide` wraps UNDER ITS OWN SCALE: four lines
         where the design has two, a spec row of 191px against 99px, and the datums harness
         reading "stacked subdivide sits 102.00px below beats, not a whole lead" at 901 and
         940 in both colourways (the pre-change page passed all 28 configurations, so the
         defect was mine and new).
     1002 WAS BISECTED for the THREE-case room, and it is superseded: with five cases the
     threshold is 1477. The history is kept because the method is the point — the arithmetic
     predicted 964 and the browser said 1002, a 38px miss, because a label+scale group's wrap
     depends on the flex container's own rounding and not only on the ink it holds. Compute to
     know WHY a threshold exists; bisect to know WHERE it is.
     ── 1477, AND THIS TIME THE TWO AGREE (2026-08-09, five cases) ─────────────────────
     What binds now is not the meters but the METRONOME'S FOOT, and it is a HARD floor because
     its ink does not shrink with the case: `bpm` (66px) + one 2ch gap (18px) + `tap` (50px) =
     134px, which needs a 190px case once the two 3ch insets and the hairlines are counted.
     Two of those plus the three narrow cases (210 + 315 + 236), four 56px gaps and the page's
     112px of padding comes to exactly 1477 — and the bisection landed on 1476/1477, so for
     once the arithmetic and the browser name the same pixel. Below it the foot row wrapped to
     two lines inside a one-lead track and pushed the tap button PAST the case's bottom edge,
     where `overflow:hidden` on `#mt-app` clipped it: measured at 1280x720 the button's box sat
     at y 710 in a 700px document, and `elementsFromPoint` at its centre returned only <html>.
     A control nobody can press, on the two instruments that matter most.
     THE COST, stated plainly because it is the largest thing this change spends: every
     viewport between 1002 and 1476 that used to show the room side by side now SWIPES. That is
     most laptops — a 1440x900 and a 1366x768 both swipe now, where before they showed three
     cases at once. The five-case room simply does not fit a laptop; the owner chose five
     knowing the worked pair drops to 208px, and this is the same trade one step further out.
     The alternative was a clipped control, which is not a trade.
     WHAT I TRIED FIRST AND MEASURED WRONG: releasing the narrow third below 1001 so the
     drone shrank with the room. It made the case NARROWER, not wider — 183px of content
     against the 197px the fixed 210px column left it — because an equal third of 940 is
     less than what remains after a fixed 210. The instinct ("let the small case give") was
     backwards: the narrow third is what PROTECTS the other two.
     So the honest fix is the phone layout starting sooner. 970 is the round number above the
     964 the arithmetic gives — superseded by the bisection below. One case per snap page has
     the whole viewport, which is more than 284px at any phone width. The cost, stated: a
     window between 901 and 1001 that used to show two cases side by side now swipes. That
     band is a narrow desktop window, and the alternative was a case whose own meter does not
     fit inside it.
     THE BREAKPOINT MOVED, rather than a columns-only override being layered on top: the
     phone layout is one decision (snap scroller + page words + drawn frame + its own row
     ladder), so 970 is written into every `@media` that keys on it. Two numbers governing
     one switch is how a layout ends up half-transformed at some width nobody tried. */

  /* THE STRING (user nit 2): circles joined by trimmed rules — o-o-o-o-o-o-o, the
     mark's own vocabulary at meter scale. Click the Nth circle and the string fills
     up to it: N filled discs = N beats (or N per beat). One device for both meters.
     Each circle's TARGET is 32×44 (the 12px drawing centred in it) — the mobile
     tapping fix (nit 3) without the string sprawling past a phone's width. */
  /* THE RULED MEASURE. The digits are the scale and the buttons; the hairline
     under them is the value. Digits inside the value read ink (beats) / the value
     digit alone reads ink (subdivide); the rest faint. */
  .mt-rm{display:inline-flex;flex-direction:column;align-items:flex-start;position:relative}
  /* ── THE RIGHT-HAND METER MEETS THE RIGHT DATUM (user nit, 2026-08-05: "subdivide doesnt
     seem to be right aligned to its datum / padding").
     THE MECHANISM: a digit cell (`.rbtn`) is 20px wide and `text-align:left`, while a numeral
     in this face is 1ch = 9px. So every cell carries 11px of dead tail to the RIGHT of its
     glyph. Flush LEFT that is invisible — the first glyph starts at the cell's edge, which is
     the datum, which is why `beats` always looked right. Flush RIGHT the dead tail lands
     between the last glyph and the datum: measured, the `7` ended 11.00px short while the
     group's BOX ended at exactly 28px. My earlier harness measured the box, so it read 28 and
     passed — the eye read the glyph, and the eye was right.
     WHY THIS AND NOT `text-align:right` ON THE CELLS, which was tried first and rejected on a
     measurement: the rule under the digits is drawn by drawRules() against the CELL grid at a
     20px pitch, so right-aligning the glyphs inside their cells moved the numerals 11px and
     left the rule behind — measured 10px out of register, i.e. it fixed the datum and broke the
     measure the meter exists to draw. Shifting the whole segment moves cells, glyphs and rule
     together: last glyph on the datum (0.00), rule still under its digits (1px, unchanged).
     `1ch - 20px` and not `-11px`: the number is the dead tail, so it is stated as what it is —
     a cell less a numeral. If either ever changes this follows. */
  .mt-ctop > .mt-fr > .mt-rm{margin-right:calc(1ch - 20px)}
  /* THE MUSIC ACCENT `>` over the 1. `position:absolute` is doing real work here, not
     avoiding a layout problem: `.mt-rm` baselines on its first flex item (see ONE
     BASELINE PER ROW above), so an in-flow mark would take over the row's baseline and
     drop the beats meter below `subdivide`. Out of flow, the digits stay first and the
     mark rides in the 8px of top padding `.rbtn` already has.
     GEOMETRY, MEASURED rather than eyeballed — both numbers were wrong on the first
     pass and both were found by reading rects off the built page:
     · `left:0` and not 5px. The digit 1's INK spans x 840–849 in a 20px cell that
       starts at 840, so its optical centre is 844.5. The 9px svg at left:5 centred on
       849.5 — 5px right of the digit, which read as "over the gap between 1 and 2".
       At left:0 the svg's own 4px midpoint lands on 844, within half a pixel.
     · `top:0`, not -1px. At -1 the mark's box started 1px ABOVE `.mt-rm`'s top edge
       and the glyph's apex was clipped by the row above. The 8px mark fits inside the
       8px of top padding `.rbtn` already carries, so 0 both clears the clip and keeps
       the mark out of the digits.
     `overflow:visible` on the segment is what makes this safe; if that ever changes,
     the mark needs its own room instead. */
  /* THE MARK IS THE BUTTON. The absolute positioning moves to the BUTTON — the svg
     inside it goes back to static, or the two would both be out of flow and the button
     would collapse to a 0x0 box that cannot be clicked.
     The target: the mark is 9x8px, far under any tap floor, so the button carries
     padding out to 24px — WCAG 2.5.8's minimum — with matching negative margins so
     the ink stays exactly where the measured geometry put it. NOT 44px here, and that
     is deliberate: a 44px box centred on the digit 1 would overlap the digit 2 button
     beside it and swallow clicks meant for the meter. The 140px rule below is the
     large target for touch; this one is the precise one for a pointer, and between
     them the state has both. Verified by hit-testing both, and the digits.
     `top:-8px`, NOT 0 (grid pass, 2026-08-05). The mark used to ride inside 8px of top
     padding on `.rbtn`, and that padding was the last thing holding the beats meter off
     the ladder: it pushed the DIGITS 8px down in flow, so the metronome's type sat below
     the tuner's while both rows started on the same row line. The padding is gone from
     `.rbtn` (see below) and the reservation moves here instead — the mark is already out
     of flow, so it can hold its own space without costing the digits any. The ink lands
     where the measured geometry above put it: verified, the mark still clears the digits'
     top edge by 0px (touching, not overlapping) and sits 20px inside the case. */
  .rm-accbtn{position:absolute;left:0;top:-8px;z-index:1;
    background:transparent;border:0;border-radius:0;cursor:pointer;
    padding:8px;margin:-8px;display:block;line-height:0}
  .rm-accbtn:focus-visible{outline:1px solid var(--accent);outline-offset:1px}
  /* HOVER IS THE ACCENT HUE, and it must recolour BOTH channels now. It used to set
     `stroke` alone, which was right when stroke carried the state; with the filled/hollow
     pair the solid state's colour lives in `fill`, so a stroke-only hover left the
     accented mark's interior ink while its outline went navy — a two-tone glyph, and no
     hover feedback at all on the state that is mostly fill.
     Why the hue rather than a value change: hover is interaction, which is what this
     site's one accent hue means everywhere else. It is also ORTHOGONAL to the fill/no-fill
     axis the state lives on, so both read at once. (Earlier this rule was
     `stroke:var(--ink)` and made the OFF mark render exactly the ON mark's colour —
     measured, both computed rgb(20,20,18) — so you could not see what you had just
     clicked without moving the mouse away.) */
  .rm-accbtn:hover .rm-acc{stroke:var(--accent)}
  .rm-accbtn:hover .rm-acc.on{fill:var(--accent)}
  /* FILLED vs HOLLOW (pick Q1/03). Both states are INK — the difference is fill, not
     value, which is the point: the old pair leaned on --ink against --faint and that is
     3.54:1 on a 9px glyph, too little to read without comparing. Off is the wedge in
     outline; on is the wedge solid.
     Both stay ink deliberately. Dimming the hollow state as well would put the two
     differences on top of each other and re-import the contrast problem into the state
     that is supposed to be clearly "not accented, but here".
     `stroke-width` drops from 1.4 to 1 when filled: the stroke sits centred on the path,
     so a filled wedge at 1.4 renders visibly fatter than the outline it replaces and the
     mark would appear to grow. At 1 the two states occupy the same optical box.
     `paint-order:stroke fill` so the fill never eats its own outline at this size. */
  .rm-acc{display:block;fill:none;paint-order:stroke fill;
    stroke:var(--ink);stroke-width:1.4;stroke-linejoin:miter;
    transition:fill var(--dur-fast) var(--ease),
               stroke-width var(--dur-fast) var(--ease)}
  .rm-acc.on{fill:var(--ink);stroke-width:1}
  .rm-digits{display:inline-flex}
  /* THE 8px TOP PADDING IS GONE (grid pass): it existed to make room for the accent mark
     above the digits, but the mark is absolutely positioned, so the padding was reserving
     space for something that never occupied it — and it pushed the digits 8px down in
     flow, which is what kept the metronome's type below the tuner's after both rows landed
     on the same ladder. The reservation moved to `.rm-accbtn`'s `top:-8px`.
     `min-height:36px` STAYS. It is the digit's tap target, not its spacing, and dropping
     it would take the meter's buttons under the 44px this page holds everywhere else. */
  .rbtn{font:inherit;background:transparent;border:0;padding:0;margin:0;
    border-radius:0;cursor:pointer;color:var(--faint);width:20px;min-height:36px;
    text-align:left;transition:color var(--dur-fast) var(--ease)}
  .rbtn.on{color:var(--ink)}
  .rbtn:not(.on):hover{color:var(--accent)}
  .rbtn:focus-visible{outline:1px solid var(--accent);outline-offset:-2px}
  .rm-rule{display:block;margin-top:-2px}
  /* THE RULE IS THE SWITCH (round15 Q1/06): the beats rule sits inside a button.
     No drawn chrome of its own — the `>` above the digits carries the state; the
     padding fattens the target to the full scale width x ~26px below the digits. */
  /* THE 13px IS THE ONE ODD NUMBER IN THE STACK, and it is deliberate (vertical datum pass).
     The beats meter is digits 36 + rule 9 + this padding − the rule's 2px tuck. At 14 that
     totals 57 — ONE px over two leads — and when the spec row stacks below 1240 the whole
     subdivide line inherits it: measured 57.00px below the beats line where two leads is 56,
     and 85.00 on the phone where three is 84. One pixel, in the one place that repeats.
     13 lands the meter on 56 exactly. The alternative was deepening the rule's tuck to −3px,
     which measured identically — rejected because the tuck is a visual judgement about how the
     rule sits under the digits, and this is arithmetic; better to bend the number that has no
     opinion. The rule's touch target goes 140x21 to 140x20, still the large target for the
     accent state (the 25x24 mark beside it is the precise one). */
  .rm-rulebtn{font:inherit;background:transparent;border:0;margin:0;cursor:pointer;
    border-radius:0;display:block;padding:0 0 13px}
  .rm-rulebtn:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
  /* Hover paints the RULE, and it needs `:global()` — this one was broken twice over.
     First the selector named `line[data-acc-tick]`, a tick deleted by the straight-line
     change, so it matched nothing. Fixing the selector was not enough: the `<line>` is
     written by drawRules() at RUNTIME, so Astro never stamps it with this component's
     `data-astro-cid-*`, while Astro DOES add that attribute to every compiled selector.
     `.rm-rulebtn:hover .rm-rule line` compiles to `… line[data-astro-cid-zr2vxrvs]`,
     which a JS-created element can never satisfy. Measured: the selector appeared to
     match in `matches()` (which sees the source form) while the computed stroke never
     changed. `:global()` is the escape, and it is scoped tightly by the `.rm-rulebtn`
     ancestor so it leaks nowhere.
     THE RULE OF THUMB THIS EARNS: any CSS aimed at markup this file's script generates
     must be `:global()`. That covers `.rm-rule line` and `.rm-acc`'s children. */
  .rm-rulebtn:hover .rm-rule :global(line){stroke:var(--accent)}

  /* THE SWIPE (metrotuner-two-pages Q3/02). Under 1477px the cases become five
     full-width snap pages — and the case VANISHES (metrotuner-pendulum Q2, the
     mobile rule): the viewport's own edges are the frame, so drawing one inside
     them would be a frame in a frame. The plate goes with it; the page dots name
     the pages. */
  @media (max-width: 759px){
    /* THE SNAP SCROLLER, ON THE SAME LADDER. What changes from the desktop case is only
       the COLUMN axis — each page is a full viewport wide, so the two columns become two
       100%-wide ones and the gap goes. `grid-auto-flow:column` is NOT used: the rows are
       named and inherited, so the cases must be explicit columns or one would flow into
       the row below its neighbour. The ROW ladder is untouched, which is the point — the
       two instruments hold identical row positions on the phone too, so swiping between
       them moves nothing vertically. Measured before: a swipe moved the transport 28px
       and the figure 84px, so the two pages read as two different layouts. */
    /* ── THE ONE SCROLLER LEFT (2026-08-12). Every case is a full-viewport page on a phone —
       there is no neighbour to be narrow beside, so the desktop width tokens (`--mt-drone-w`,
       `--mt-changes-w`, `--mt-loop-w`) are DESKTOP statements only and a phone case gets more
       room than the width it was measured for.
       WHAT CHANGED: a route holds ONE thing, so on /changes and /loop there is a single page and
       nothing to swipe. Only the CONSOLE has three, and only here can they not sit side by side —
       his words, "remove the scroll concept entirely (except on mobile console)". So the snap and
       the dot row are scoped to that page, and the column count is a literal 3 rather than a
       custom property written by a script: three is what the console IS. */
    .mt-pages{padding:0;
      /* the overlay's top datum is derived from this row — restated with it, never apart */
      --mt-case-top:calc(var(--lead) * 2);
      /* THE PHONE'S TOP AIR IS TWO LEADS (user, 2026-08-05: "the accent is too close to
         the text metronome on mobile, vertically"). Measured on the live page at 390,
         360 and 430: the plate's line box ran y 0→28 and the accent mark's ink y 20→28,
         so they did not merely crowd — they overlapped by 8px in the same band, ~2px
         apart horizontally. Desktop clears by 5px and always did.
         THE MECHANISM is that the two moved opposite ways here. The plate drops to
         straddle the inset frame (`--lead/2 - 14px`, i.e. y 0 on the phone) while
         `case-top` stayed one lead, and the accent mark reaches 8px ABOVE its spec row
         by design — it rides in air the row does not own. On desktop the case is inset
         from the page so that band is free; on the phone the case starts at the viewport
         edge and the band is exactly where the plate now sits.
         So the row that is short is `case-top`, and the fix is to state its real height
         rather than nudge the mark: two leads, which is the first row's air plus the one
         lead the mark borrows. The mark keeps its position relative to the digits — the
         thing it annotates — and the plate keeps the frame. Nothing else on the ladder
         moves, because only this row's height changed. */
      grid-template-rows:
        [case-top]  calc(var(--lead) * 2)
        [spec]      calc(var(--lead) * 2)   /* measured: the phone's spec row is 2 leads */
        [slack-a]   minmax(0, 1fr)
        [figure]    auto
        [read]      var(--lead)          /* reading + verb, one row (see the 1480+ ladder) */
        [slack-b]   minmax(0, 1fr)
        [foot]      var(--lead)
        [hint]      var(--lead)
        [case-bot]  var(--lead)
        [case-end]}
    /* THE CONSOLE SWIPES; the other routes hold one page and must not pretend otherwise. A
       scroller with one child still eats a horizontal flick and reports overflow, which is how a
       page that cannot move ends up feeling stuck. `scroll-padding-left:0` because a phone page IS
       the viewport: the desktop's 56px datum made every page rest with a slice of the previous one
       showing (measured, the room opened at scrollLeft 334 on a 390px page). */
    #mt-app[data-page="console"] .mt-pages{
      grid-template-columns:repeat(3, 100%);column-gap:0;
      overflow-x:auto;overflow-y:hidden;scrollbar-width:none;
      scroll-snap-type:x mandatory;scroll-padding-left:0}
    #mt-app[data-page="console"] .mt-pages::-webkit-scrollbar{display:none}
    #mt-app[data-page="console"] .mt-pages > .mt-half{
      scroll-snap-align:start;scroll-snap-stop:always}
    /* THE CASE STAYS ON THE PHONE (round16, reversing the round-7 mobile rule):
       the hairline box reads as the instrument's identity, so each page draws
       its frame INSET via ::before (the snap pages themselves must stay
       full-width and border-free or the scroller's geometry shifts). The plate
       comes back with it, centred on the frame's top edge. */
    /* THE FRAME'S INSET IS HALF A LEAD ON EVERY SIDE. It was `inset:14px 12px` — two
       numbers on no grid and not even equal to each other — against content padding of
       `calc(var(--lead) + 10px) var(--gutter)` (another off-grid 10px), so the content's
       clearance from the frame it sits in was 24px at the top and 16px at the sides: a
       frame whose margins disagreed with themselves.
       ONE LEAD WAS TRIED FIRST AND WAS WRONG, found by looking at the render rather than
       at the number: the ladder's `case-top` row is one lead and the side padding is
       `--gutter`, which is also one lead — so a frame one lead in from the viewport landed
       exactly ON the content's box, and `a4 440 hz` printed across the frame's top edge
       instead of inside it (measured: clearance 0px on the top and both sides). The frame
       cannot use the same interval as the content it contains; it has to be inside it.
       HALF A LEAD is that inset, and it is still derived — `--lead / 2`, the same
       relationship `--tight` has to `--lead` in the site's space scale. Content then clears
       the frame by 14px on all four sides (measured T/L/R 14, B 26), and the frame is the
       one mark on this screen that sits between the viewport edge and the grid. */
    /* NO SNAP DECLARATION HERE ANY MORE — it moved into the console-only block above, because a
       snap alignment on a case whose route has no scroller is a property with no scroller to
       align in. `scroll-snap-stop:always` went with it: it stopped a fling at every page, which is
       what you want across three instruments and meaningless across one. */
    .mt-half{border:0;padding:0 var(--mt-inset)}
    /* THE FRAME'S OWN INSET IS 1ch NOW, not half a lead (14px). On the phone the frame is
       DRAWN rather than being the case's border, so the clearance a reader sees is the
       content padding MINUS this inset. With the padding at 3ch and this at 14px that
       clearance would be 13px = 1.444ch — the finding half-applied, one non-whole number
       swapped for another. At 1ch it is 3ch - 1ch = 2ch exactly.
       1ch and not 2ch: at 2ch the clearance is a single character and the engraved plate ends
       up 1px off the frame's corner — rendered both and looked; the plate needs the room. */
    .mt-half::before{content:"";position:absolute;inset:1ch;
      border:1px solid var(--line);pointer-events:none}
    /* The plate still straddles the frame's top edge: half a lead down, less half its own
       28px line box, and in from the frame by the content's gutter. */
    /* the GROUP straddles the drawn frame here, so the override moves with the position — and so
       does `set`, at the other end of the same rule. Missing that pair left the word 17px above the
       name and 6px off the inset at 390: the phone draws the frame INSET by 1ch via `::before`
       instead of using the case's border, so both ends of the rail move by the same 1ch. */
    .mt-np{top:calc(1ch - 14px);left:calc(var(--mt-inset) - 1ch)}
    .vbtn.mt-setbtn{top:calc(1ch - 14px);right:calc(var(--mt-inset) - 1ch)}
    .mt-plate{display:block}
    /* THE DATUMS ARE DRAWN ON THE PHONE TOO (datum pass). This used to be
       `display:none`, and the reason given was sound for what the rule then contained — a
       second twelve-column grid over one case would have been the two-grids-at-once problem.
       But the rule holds the two DATUMS now, and they are as true here as anywhere: the
       harness verifies axis 5/5 and inset 6/6 at 430, 390 and 360. A guide that goes blank
       exactly where the layout changes most is the wrong instrument.
       THE OVERRIDE THAT WAS HERE DOUBLE-COUNTED THE INSET, and it is deleted. It read
       `inset:0 var(--mt-inset)`, justified by "the inset is measured from the content box on
       the phone" — but an absolutely-positioned ::after already resolves `inset:0` against its
       containing block's PADDING box, and the case's horizontal padding IS `--mt-inset`. So the
       gradient's own `--mt-inset` stop was added to a box that had already been inset by it, and
       the guide drew its line at 54px while every mark sat at 27px. Measured with the box chrome
       neutralised, so this is not the box question: the plate and the first control both read
       −27.00px against the drawn line at 390, 430 and 360.
       The desktop rule needs no phone variant at all — `inset:0` is right on both, because the
       padding the line is measured from is the same token on both. One rule, one datum. */
    /* AND SO THE FIGURE TAKES THE CONTENT WIDTH HERE. With no column grid on the phone,
       a 6-of-12 span is not a smaller version of the desktop rule — it is arithmetic on a
       grid that does not exist (at 360px the track computes NEGATIVE, since 11 gutters of
       28px already exceed the 304px of content). The desktop rule's 240px floor was
       therefore deciding the phone's figure size, and it decided it SMALLER than the page
       shipped with: 240px against mainline's `min(320px,80vw)` = 312px at 390. Measured
       cost of that mistake: the pendulum's arc chord went 246 → 189px, a 23% shorter
       swing, on the viewport where the swing is the whole instrument.
       At 100% the figure is as wide as the case allows — 334px at 390, 304 at 360 — which
       is wider than what shipped and needs no floor, because the content width is already
       the largest honest number. The readout follows it so the note still sits under the
       dial's left end. */
    .mt-gauge, .mt-read{width:100%}
  }

  /* ── THE TOP DATUM, ON THE BOX'S OWN TOP RULE ────────────────────────────────────
     RESTORED after being deleted, and the deletion was my mistake: the owner asked "what about
     the top datum, don't we still want that tool?" and the answer is yes — a guide whose only
     horizontal information is absent cannot answer "is this row where it should be", which is
     what the tool is FOR.
     WHY I DELETED IT, AND WHY THAT REASONING WAS WRONG. Every candidate line at the box's top
     rule appeared to strike through the notch's word (`calibration`), because the notch straddles
     that rule by construction and its glyph band spans it — 9px above, 10px below. That was
     measured on the PROOF SHEET, where the overlay carried `z-index:3` so the sheet's guide would
     sit above its own mock content. On the real page it does not: `.mt-pages::before` belongs to
     an ANCESTOR, and a positioned descendant paints after it in tree order, so the notch's own
     `background:var(--paper)` covers the line exactly the way it already covers the box's rule.
     The knock-out was there the whole time and the sheet's own scaffolding hid it.
     VERIFIED BY SAMPLING PIXELS, not by reasoning: on the rule's y, inside the notch's glyph the
     line is absent (no accent in the band); 40px to the right of the notch it is present. So the
     line interrupts around the word, which is the same figure/ground move the plate makes.
     WHAT IT NAMES: the box's top rule, at `case-top`. Measured on the live page, every box's top
     rule ALREADY lands on a whole lead — 1, 2, 4, 26 and 27, exact, both colourways, desktop and
     phone. It is one lead ABOVE where the old line was drawn: that one sat at `case-top + one
     lead`, inside the box's own top padding, naming the box's air, which was the original "not
     aligned" report.
     ONE LINE, NOT TWO. The old rule also drew a BOTTOM datum two leads up from the ladder's end,
     for the foot controls. That stays deleted — the foot row has no box, so a line there would
     name type again while every other mark on this overlay names a box rule, and mixing the two
     is what made the guide unreadable in the first place. The foot's baseline is asserted in
     `tools/verify-practice-room-datums.mjs` instead.
     Drawn from `--mt-case-top`, the same token the ladder states the row with, so the line and
     the row it names are one number and cannot drift — the failure this page recorded when the
     line was hardcoded at `--lead * 2` and the phone's row was two leads. */
  .mt-pages::before{content:"";position:absolute;inset:var(--group) var(--group) var(--lead);
    pointer-events:none;opacity:0;transition:opacity var(--dur-fast) var(--ease);
    /* NO `z-index`. That is load-bearing: it is what lets every notch's paper knock the line out
       where it crosses a name. Adding one would put the line over the words. */
    background:linear-gradient(to bottom,
      transparent calc(var(--mt-case-top) - 1px),
      color-mix(in srgb, var(--accent) 45%, transparent)
        calc(var(--mt-case-top) - 1px) var(--mt-case-top),
      transparent var(--mt-case-top))}
  /* The phone's `case-top` is two leads, and the token follows it (declared on `.mt-pages` in
     the media query), so this line needs no phone variant of its own. `inset:0` because the
     scroller's padding is 0 there, and an absolutely-positioned ::before inside a scroll
     container lays out against the scrollable padding box — so it travels with the pages instead
     of staying stuck over page 1. */
  @media (max-width: 759px){
    .mt-pages::before{inset:0}
  }

  /* ══ THE GUIDE DRAWS THE BOX, NOT THE TYPE (chooser practice-room-box-guide, pick 02:
     "the guide names the box — its top rule and its side rule") ══════════════════════════

     THE OWNER'S CORRECTION IS THE WHOLE PASS: "i just mean the datums might have to drawn
     against the boxes right? rather than text?" My first sheet had it backwards — it offered
     five ways to move the BOX so its text would meet a line placed for text. Since the
     sub-cases treatment shipped, the box IS the mark the eye reads, so the datum names the
     box's own rules.

     THIS OVERLAY HAS BEEN CUT DOWN THREE TIMES and each cut removed marks describing a system
     the page had stopped using:
       · round16 drew 12 columns + a 28px row grid per case — up to 24 lines inside every case
         plus 12 across the screen. The owner: "i thought we chose just a few datums, i see like
         25 cols." Those columns were the system three proof sheets had already REJECTED.
       · the datum pass (2026-08-05) cut it to the axis + one inset inside each edge, plus two
         horizontal datums on the room and one on `.mt-mid`.
       · this pass keeps the COUNT and moves the marks: the axis, one line on each of the box's
         side rules, and the top datum on the box's top rule. Four lines, as before — but every
         one of them now coincides with ink a reader can see.

     WHAT MOVED AND WHY, all measured on the live page before anything changed:
       · THE VERTICAL PAIR was drawn at `--mt-inset` (3ch), where the CONTROLS' ink starts. That
         is still true of the ink, but the box's rule sits a third of a character outside it —
         so the guide drew a line 3px from a hairline the box already draws, which reads as one
         blurred mark rather than two datums. It is drawn at the box's RULE now, one character
         inside the frame, and the rule is what it coincides with.
       · The box's side padding went 14 → 17px so that rule lands on a whole character cell
         (1ch) while the ink stays on 3ch — see `.mt-grp`, where the border makes up the pixel.
       · THE TOP DATUM MOVED UP ONE LEAD, onto the box's top rule — see the note on
         `.mt-pages::before` above. It used to sit at `case-top + one lead`, inside the box's
         own top padding, naming the box's air; every box's top rule already lands on a whole
         lead (1, 2, 4, 26, 27 — exact), so the row was never the problem, the line's position
         was. (I deleted this line for one commit on the belief that it must strike through the
         notch's word. It does not: the notch's paper knocks it out on the real page. That
         reasoning came from the proof sheet, whose overlay carried a `z-index` the page has
         no reason to.)
       · THE CENTRE LINE (`.mt-mid::after`) AND THE BOTTOM DATUM STAY DELETED. The centre
         described the reading's row, which the reading's own ink already marks; the bottom
         named the foot controls' baseline, and the foot row has no box, so a line there would
         name type while every other mark on this overlay names a box rule. Both are asserted
         in `tools/verify-practice-room-datums.mjs` instead.

     WHAT IS ON THE GLASS AND WHAT IS IN THE HARNESS: the marks the boxes draw are on the
     glass (three sides of every group box); the baselines nothing boxes — the foot controls, the
     reading — are in the harnesses:
     `tools/verify-practice-room-datums.mjs` (16 widths × 2 colourways) and
     `tools/probe-box-as-datum.mjs` (every box's rules in leads and characters) assert the row
     positions and fail by name, which is a better instrument for "is this on the lead" than a
     line a human squints at — and they cover the unboxed half of the screen too.

     ONE STOP PER LINE, NEVER `repeating-` — the guard test counts the marks this file draws and
     forbids a repeat outright, because a repeat is what made this an accidental grid the first
     time. The axis stays stronger than the pair (55% against 34%): it is the datum the eye
     checks the figure against, while the pair only has to be findable beside the rule it names.
     `--mt-case-top` STAYS and is not dead — it states the `case-top` row's height, which the
     phone re-declares, and the unit test pairing every ladder with it stays too. */
  .mt-half::after{content:"";position:absolute;inset:0;
    pointer-events:none;opacity:0;transition:opacity var(--dur-fast) var(--ease);
    /* THE BOX'S SIDE RULE, as the overlay's own measure: the case's inset less the box's
       pull-back. Derived from the same two tokens the box is built from, so the datum cannot
       drift from the rule it names — that drift is exactly what this pass fixed. It resolves
       to 1ch = 9px. */
    --mt-datum:calc(var(--mt-inset) - var(--mt-box-pull));
    background:
      /* THE AXIS — one line on the case's centre */
      linear-gradient(to right, transparent calc(50% - 0.5px),
        color-mix(in srgb, var(--accent) 55%, transparent) calc(50% - 0.5px) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)),
      /* THE BOX RULE — one line on each of the group boxes' side rules */
      linear-gradient(to right,
        transparent calc(var(--mt-datum) - 1px),
        color-mix(in srgb, var(--accent) 34%, transparent) calc(var(--mt-datum) - 1px) var(--mt-datum),
        transparent var(--mt-datum) calc(100% - var(--mt-datum)),
        color-mix(in srgb, var(--accent) 34%, transparent) calc(100% - var(--mt-datum)) calc(100% - var(--mt-datum) + 1px),
        transparent calc(100% - var(--mt-datum) + 1px))}


  /* == THE FIGURE'S WIDTH IS SIX COLUMNS, NOT 320px ==========================
     It was `min(320px,80vw)` — a number measured against nothing on this screen — which
     is the bug class STYLE.md records for `--label` (16ch = 144px against a column-3 edge
     at 182px): a fixed width inside a fluid case lands on a column edge at no width at
     all. Measured before: at 1440 the gauge spanned the case's columns 2.68 -> 9.32, i.e.
     15.50px inside a band edge on each side, and the readout shared the error.
     Now it is stated in the grid it sits in: SIX of the case's twelve columns, centred.
     `--mt-track` is derived exactly as STYLE.md derives the document's `--track` (n
     columns and n-1 gutters share the content width). Six because at the measure it is
     the closest whole span to the 320px the drawing was designed at: 6 columns of a
     636px case = 275px against 320, so the figure is ~14% smaller on a wide screen and
     its edges land on track edges — verified at 1440, cols 3 → 9, 0.00px off.
     WHERE THIS HOLDS, STATED EXACTLY, because the first version of this comment claimed
     "every width" and that was false. A twelve-column grid needs eleven gutters, so
     `12 × 0 + 11 × 28 = 308px` of gutter is the minimum content width at which a track is
     even positive. The case's content is that wide only when the case is ~364px, i.e. on
     a DESKTOP viewport of ~1300 and up (two cases plus three `--group`s). Below that the
     track collapses toward zero and six columns stops being a meaningful width — at 1024
     it is 171px, at 360 the track is NEGATIVE. So:
       · ≥1300px wide — the figure is exactly six columns. This is the claim.
       · 901–1299   — six columns is under the drawing's floor, so the floor wins and the
                      figure is NOT on a track edge. Accepted: at those widths the case is
                      narrow enough that the columns are thinner than the gutters between
                      them, and a 12-column grid inside a 400px box is a fiction whether or
                      not something is aligned to it.
       · ≤1476px    — the phone, which has no column grid at all (the per-case overlay is
                      `display:none` there and the parent draws rows only), so the figure
                      takes the content width. See the mobile rule below.
     THE FLOOR IS THE DRAWING, not a round number: 320px is the width the pendulum was
     drawn at, and its arc chord is 252 of those 320. Below ~240px the swing stops reading
     as a swing. `min(100%, …)` keeps it inside the case at every width. */
  .mt-gauge{--mt-cols:6;
    --mt-track:calc((100% - var(--gutter) * 11) / 12);
    --mt-figw:calc(var(--mt-track) * var(--mt-cols) + var(--gutter) * (var(--mt-cols) - 1));
    width:min(100%, max(var(--mt-figw), 240px));
    margin:0;grid-row:figure;align-self:center;justify-self:center}
  .mt-gauge svg{display:block;width:100%;height:auto;color:var(--ink)}

  /* ── THE DRONE'S FIGURE IS ITS NOTE LETTER ──────────────────────────────────
     Not a third arc-and-bob: the tuner and the metronome share that drawing because still
     vs moving is their entire distinction, and a drone is neither — nothing deflects,
     nothing sweeps. What it must say from a music stand is WHICH NOTE, so the letter is
     the figure.
     72px IS A DELIBERATE BREAK of the site's one-size rule, and the only one on this
     screen. The justification is the same one `.mt-plate` and the meter digits do NOT get:
     this is a FIGURE, a drawing that happens to be made of a glyph, sitting in the row the
     other two cases put a 158px drawing in. Set at 72 rather than filling the row because
     the case is 210px wide and the widest letter pair is `A♯` — measured, `A♯` at 72px sets
     to 129px, which clears the case's 156px of content width; at 96px it would be 172px and
     overflow. `line-height:1` and `font-weight:400`: the site has no display weight and a
     figure needs no leading.
     `font-variant-numeric` is irrelevant here and `letter-spacing` is left alone — in a
     monospace face the advance width IS the cell, and tightening it would take the glyph
     off the character ladder the rest of the screen is set on. */
  .mt-dfig{display:flex;align-items:center;justify-content:center;
    /* the figure's own width, not the six-column measure the arcs use: a glyph has no
       aspect ratio to preserve, so it centres on the axis and takes what it needs */
    width:100%}
  /* IT IS A BUTTON NOW (the pitch control), so it needs the reset — a UA button brings its own
     font, border, background and padding, any of which would stop this being the figure. And it
     needs the scrub affordance the page's other value controls use: `ew-resize` for the axis,
     `touch-action:none` so the phone's snap-scroller does not steal the horizontal drag (the
     same pair every scrub handle here carries). */
  .mt-dnote{-webkit-appearance:none;appearance:none;background:transparent;border:0;
    border-radius:0;padding:0;margin:0;font-family:inherit;
    cursor:ew-resize;touch-action:none;
    font-size:72px;line-height:1;font-weight:400;color:var(--ink);
    /* Optical, and measured: a cap-height glyph's line box carries its descender space, so
       the letter's INK centre sits 7.5px below the box centre in this face at this size —
       which put it 7.5px off the axis the dial and the verb sit on. The nudge is stated as
       a fraction of the size rather than a pixel so it survives a size change. */
    transform:translateY(-0.104em);
    transition:color var(--dur-fast) var(--ease)}
  /* SOUNDING is the accent, and it is the one state this case has. The tuner says "live"
     with its needle going from --line to --ink; the drone's letter is always ink (it names
     the note whether or not it is playing), so the running state cannot be carried by the
     same value change. The accent is what this system uses for "you can act on this", and
     a sounding drone is the one thing on the screen actively doing something. */
  .mt-drone[data-sounding="true"] .mt-dnote{color:var(--accent)}
  /* IN HAND reads accent, like every other value on this screen mid-scrub. It is the same
     colour the sounding state uses, which is not a collision: while you are dragging the
     letter you are looking at the letter, and the two states never need to be told apart at a
     glance — dragging is momentary and holds the pointer. */
  .mt-dnote.scrubbing{color:var(--accent)}
  .mt-dnote:hover{color:var(--accent)}
  .mt-dnote:focus-visible{outline:1px solid var(--accent);outline-offset:4px}
  /* The exact pitch, in the `read` row — the row the tuner uses for its reading and the
     metronome leaves empty. On the axis, like every reading on this screen. */
  /* No `.mt-dread` / `.mt-dfull` rules: the exact reading they styled is deleted (see the
     markup note — the case was stating its note three times in 210px). The OCTAVE, which was
     the one thing that reading added over the letter, lives on the foot control, which prints
     the full `A4`. */
  #mt-needle{transform-origin:160px 160px;transform-box:view-box;
    transition:transform var(--dur) var(--ease),color var(--dur) var(--ease)}
  #mt-needle.rest{color:var(--line)}
  #mt-needle.live{color:var(--ink)}
  /* The pendulum: same figure, no CSS transition — its motion is the rAF cosine
     (a transition would fight the per-frame transform). Rest = faint, upright. */
  #mt-pend{transform-origin:160px 160px;transform-box:view-box}
  #mt-pend.rest{color:var(--line)}
  #mt-pend.live{color:var(--ink)}

  /* The readout is the figure's own width, so the note under the dial's left end and the
     Hz under its right end line up with the drawing above them. It is the `read` row,
     which the METRONOME also has and leaves empty — that empty row is what puts the two
     transports on one line. */
  /* `start` for the same reason as `.mt-cap` — the two are one change. See the note there: the
     pair is what makes the reading and the verb exactly one lead apart (28.00), and changing
     only one of them moves the interval to 24.50 or 32.50. */
  /* ── THREE COLUMNS, BECAUSE THE MIDDLE HAS TO BE THE AXIS ───────────────────
     The verb now shares this row (chooser practice-room-transport Q1/02 + the user's
     correction, "in the middle"). It was `display:flex` with one `.ends{flex:1}` spacer —
     a flush spread, note against the left inset and cents/Hz against the right, with no
     middle to put anything in. A slot in that spread would have put the verb OFF the
     axis, which is the datum this whole screen radiates from.
     `1fr auto 1fr` makes the centre column the axis by construction: the two 1fr columns
     are equal because they are declared equal, so whatever sits in the middle is centred
     no matter how wide the note or the cents get. That is the property the old spacer
     could only approximate — and did get wrong once (the 9px reading offset that
     `.mrh:empty` fixed came from exactly this class of thing: a box centred while its
     ink was not).
     `justify-items` per column keeps the reading's flush edges: the note reads from the
     left inset, the cents/Hz group to the right one, unchanged. */
  .mt-read{grid-row:read;align-self:start;justify-self:center;
    --mt-track:calc((100% - var(--gutter) * 11) / 12);
    width:min(100%, max(calc(var(--mt-track) * 6 + var(--gutter) * 5), 240px));
    display:grid;grid-template-columns:1fr auto 1fr;align-items:baseline;
    column-gap:2ch}
  .mt-read > .mrn{justify-self:start}
  .mt-read > .mt-cap{justify-self:center}
  /* The cents and the Hz stay ONE group on the right — they are one reading at two
     precisions, and the Hz appearing must not move the cents. */
  .mt-rr{justify-self:end;display:inline-flex;align-items:baseline;gap:2ch}
  /* The metronome and the drone have no reading, so their row holds only the verb — but it
     must be the SAME row and the SAME centre, or the three verbs stop agreeing. One column,
     centred: the empty side columns would do nothing here, and declaring them invites a
     future reading to land in one by accident. */
  .mt-read-bare{grid-template-columns:minmax(0, 1fr)}
  /* IN TUNE is the invert (round-1 pick Q2/02): selection colours on the reading.
     The padding is carved out of the margin so the text never moves. */
  .mrn{color:var(--ink);padding:0 .5ch;margin-left:-.5ch;
    transition:background var(--dur-fast) var(--ease),color var(--dur-fast) var(--ease)}
  .mrn.intune{background:var(--ink);color:var(--paper)}
  .mrc{color:var(--ink)}
  .mrh{color:var(--faint)}
  /* ── THE READING SITS ON THE AXIS (datum pass, 2026-08-05) ──────────────────
     THE AXIS is one of this screen's two datums: everything the instrument radiates from —
     the dial, this reading, the verb — sits on the case's centre line. Measured before this
     rule, the reading's INK centre was 9.00px LEFT of the dial's, while the other four axis
     marks were 0.00.
     THE CAUSE, and it is why `display:none` while empty is the fix rather than a nudge: this
     span holds the frequency and is EMPTY while the tuner is silent, but an empty inline box
     still contributes the row's trailing `gap:2ch`. So the row's box stayed centred (its
     midpoint measured exactly on the axis) while its INK ended 18px early, putting the ink's
     midpoint half of that — 9px — to the left. The box was centred; the thing a reader sees
     was not.
     `:empty` and NOT a blanket hide: the moment a pitch is detected the span gets text, this
     rule stops matching, and the Hz reading appears with its gap. That is the whole point —
     the reading is content, not decoration, and hiding it outright would delete a value the
     instrument exists to show. Verified both ways: silent, the reading's ink centre is 0.00
     off the axis; sounding, the Hz text renders and `mt-hz` still carries it. */
  .mrh:empty{display:none}

  .mt-row{display:flex;align-items:center;gap:3ch;flex-wrap:wrap}
  .mt-hint{color:var(--faint)}
  /* THE RESERVED LINE IS A ROW NOW, and the hack it replaces is deleted. It was
     `min-height:28px;margin-top:2px` — the min-height reserved the line so swapping the
     error text couldn't reflow the foot (annotation: "hate how the layout changes when
     starting/stopping"), and the 2px was an off-grid margin of exactly the kind STYLE.md
     forbids ("No off-grid margins like 17px"). A row on the ladder reserves the line by
     existing, in both cases, so neither the declaration nor the 2px is needed. */
  .mt-hintline{grid-row:hint;align-self:center}

  .mt-lb{color:var(--faint)}

  .mt-refnote{color:var(--ink);min-width:4ch;text-align:center;display:inline-block}

  /* ══ TRACK GRAMMAR (chooser metrotuner-control-taxonomy, pick 03) ══════════
     One moving disc everywhere; the TRACK it rides announces the operation:
       continuous rail  = a value    — scrub along it (the disc is the gauge)
       two pockets      = a toggle   — one disc, two resting places; latched =
                          the far pocket, in accent (state reads at a distance)
       no track at all  = momentary  — a lone ring; a disc with nowhere to go
                          can only be pressed; each strike fills it and it
                          drains, so it visibly cannot hold
     The action underline DIED here: buttons no longer borrow the link idiom.
     The user's refinement on the sheet's mock: ONE label that swaps text
     (start/stop), not both words printed — the swap plus the disc's berth. */
  .tbtn{font:inherit;color:var(--ink);background:transparent;border:0;padding:0;
    border-radius:0;min-height:44px;cursor:pointer;
    transition:color var(--dur-fast) var(--ease)}
  .tbtn:hover{color:var(--accent)}
  .tbtn:focus-visible{outline:1px solid var(--accent);outline-offset:2px}

  /* Baseline-aligned so the WORD sets the button's baseline in its row; the
     track (an svg whose baseline is its bottom edge) is nudged 2px down to sit
     optically centred on the x-height. align-items:center made every latch's
     baseline the svg's bottom edge — "bpm" and "tap" drifting apart was this. */
  /* ONE RULE FOR ALL THREE KINDS (grid pass). This was `.tbtn.latch, .tbtn.mom` — the
     latch and the momentary got baseline alignment and `.tbtn.scrubv` (the reference note)
     did not, so the ref note's baseline sat 3.50px off `play tone`'s beside it in the same
     row. Every `.tbtn` is a word, optionally with a track before it, and every one of them
     should report its WORD's baseline; naming two of the three kinds was the bug. The
     `gap:1ch` is harmless on `.scrubv`, which has no track to separate. */
  .tbtn{display:inline-flex;align-items:baseline;gap:1ch}
  /* THE RING'S 2px IS THE SECOND ANSWER TO THE SAME QUESTION, and it is left standing on purpose.
     The berth (`.rd`) now derives its offset from the type it sits beside — `(100% - 1ex)/2`, the
     difference between centring a mark on its own box and centring type on its x-height. The ring
     (`.tk`, on `tap` and `deal`) still carries a hand-typed 2px, so this page has two answers to
     "where does a mark sit beside a word". That is a real inconsistency and the honest reason not
     to fix it here is that the ring's whole vocabulary is question 2 of the controls chooser —
     "use the design lang from the play/pause maybe here" — and a mark that may be replaced next
     week is not worth re-deriving today. If the chooser keeps the ring, derive this the same way. */
  .tbtn .tk{flex:none;display:block;overflow:visible;transform:translateY(2px)}
  /* ── THE VERB SITS ON THE AXIS, NOT THE BUTTON (axis datum, 2026-08-05) ─────
     The transport is the figure's caption, so the WORD is what has to sit on the case's centre
     axis — the same vertical the dial's pivot is on. It did not: measured, the button's ink
     midpoint was 0.00 off the axis while the word "start" was 17.50px RIGHT of it, at every
     width. `.tbtn` is a flex row of [26px track][9px gap][45px word], so centring the BUTTON
     centres that whole block and pushes the word right by half the track-plus-gap. Visible at
     a glance once you look — the word reads noticeably off the needle it captions.
     My own datum harness missed it, and the reason is worth recording: it measured each mark's
     INK EXTENT, and the button's ink includes the track. The extent was centred; the word was
     not. The research pass (instrument-panel standards — 14 CFR 25.1321(b), MIL-STD-1472G
     §5.2.2.5.3c(7), both of which make the POINTER the datum other furniture aligns to, never
     the case edge) is what pointed at it.
     THE FIX: take the track out of flow so the word is the only thing being centred. It stays
     on the LEFT, where it has always been, at the same 1ch gap — `right:100%` plus
     `margin-right:1ch` reproduces exactly the position the flex gap gave it. Measured after:
     the word is 0.00 off the pivot on both instruments.
     WHAT THIS COSTS, checked rather than assumed: the button's box narrows 80px to 45px because
     the track no longer occupies flow. The track is still INSIDE the button's hit area
     (`elementFromPoint` at the disc's centre returns a node the button contains) and both the
     word and the disc still toggle — click-tested on the metronome, which needs no microphone
     permission, `aria-pressed` false → true from each. The 44px height is untouched, so 2.5.5
     still holds on the axis that matters for a thumb.
     `translateY(-50%) translateY(2px)` keeps the 2px optical nudge the flex version had (see
     the note above about the svg's baseline) on top of the centring the absolute position needs.
     ── AND IT IS ALL DELETED NOW (transport chooser, treatment 05) ─────────────
     That whole fix existed to centre a WORD that sat beside a track. Treatment 05 has no
     word: the control is one mark, so the mark is the only thing to centre and the grid
     column above does it. Taking the track out of flow to rescue a word from a two-mark
     button was a fix for a problem this treatment does not have — and it is what left the
     track hanging 17.50px to the left, which is the "not aligned and ugly" that started
     this round. The right repair was to stop having two marks, not to keep re-positioning
     the second one. */
  /* ── THE RAMS SWITCH (transport chooser, treatment 05 "the snow-white dot") ──
     Braun's switch reduced to what changes: a hairline field and a dot that travels to the
     far side and takes the accent. It replaces the two-pocket track for the TRANSPORT only —
     the track grammar above still governs every other latch on the page (the fifth, the
     accent), because those sit in a row of words where a bare mark would have nothing to
     say which value it belongs to.
     THE COST, stated because the site's rule is "structure is rules and whitespace, not
     boxes": the field IS a box, the only one on the screen. It earns the exception by being
     the one control that has to read at a glance from across a room with no word to help —
     and it is a hairline box, `--line`, the same stroke the case frames use.
     STATE IS FORM AND NOT ONLY HUE: hollow-to-filled would be one signal, and colour alone
     fails the ink-vs-accent contrast check (3.54:1) that the accent-mark chooser rejected.
     So the dot BOTH travels 11px and takes the accent — position carries it, colour
     confirms it. */
  /* ── THE TARGET IS PADDING, THE INK IS 22×11 (measured, both directions) ────
     Two defects the harness caught on the first run of this treatment, and neither was
     visible in a screenshot:
     1. THE TARGET WENT TO 22px WIDE. `min-height:44px` only ever guarded the HEIGHT; the old
        button was 45px wide because it contained a word, so nothing needed to guard the width.
        Delete the word and the box collapses to the field's 22px — under the 24px floor, and
        the harness's `Math.min(width, height)` is what surfaced it. WCAG 2.5.8 is a minimum on
        BOTH axes and this page holds 44 everywhere.
     2. THE 44px BOX WAS INFLATING THE ROW. The reading and the verb share one 28px row now, so
        a 44px participant makes the row 44px and shoves the reading's baseline 21.50px below
        the mark — measured at all 16 widths, in both colourways. The row was correct; the
        control in it was not.
     ONE FIX FOR BOTH, and it is the page's own idiom (`.mt-hd` does exactly this, and the
     meter's digits too): pad out to the target and pull the padding back with a matching
     negative margin. The ink then sits where the row wants it and the target overhangs into
     the slack, which is air. `min-height:0` because the padding now carries the height and
     leaving 44 there would re-inflate the row.
     Deliberately NOT shrinking anything to fit: no target gets smaller, the row gets its lead
     back, and the two facts are independent of each other.
     THE PAD IS DERIVED FROM THE INK, so it changed when the ink did (chooser
     practice-room-control-size, pick 02 "the same drawing, 1.45× larger", 2026-08-07). At
     22×11 it was 11px each side and 17px each end. At 32×16 it is 6px and 14px: 32+6+6 = 44
     wide, 16+14+14 = 44 tall. Less of the target overhangs into air than before — that is
     the pick's stated cost, not an oversight — but both axes still clear 44, which is the
     line that matters and is asserted in the e2e suite. */
  .mt-cap .tbtn.latch{min-height:0;padding:14px 6px;margin:-14px -6px}
  /* THE TOGGLE SITS ON THE TEXT'S OPTICAL CENTRE (annotation 2026-08-07, repeated
     2026-08-12: "this needs to be in line with text").
     WHAT WAS WRONG. This was ONE hand number, `translateY(9.5px)`, on all six berths, and
     it was derived for a datum only one of them has. Its comment said "the row is a
     baseline-aligned flex, so the svg's own box bottom lands on the text baseline" — true
     of the arp latch, and NOT true of the five in `.mt-cap`, which took `align-items:center`
     over `min-height:var(--lead)` in the tap-target pass above. Those five get their y from
     the ROW, and the row had already put them where they belong: measured on the built page
     at 1512px, with the transform removed the mark's ink centre is 559.00 and `.mt-read`'s
     centre is 559.00 — equal, by construction, because the padding-and-pull idiom above
     leaves the button a 16px MARGIN box (44 padded, 28 pulled back) inside a 28px line.
     So the 9.5 was pure surplus on five of six marks. Live it put the mic's ink 8.37px below
     the x-height centre of the type in its own row, 4.50px below that type's baseline, 9.50px
     off the centre of its own 44px tap target, and 3.50px OUTSIDE the 28px row — the berth
     read as hanging off the reading rather than sitting on it. Beside `arpeggiate`, where the
     datum really is the baseline, the same number landed 5.37px low. Two datums, one number:
     it could not be right for both, and measured it was right for neither.
     Its own arithmetic was stale too: "4.5 = half the cap height" plus "5 = half the svg's
     height". Half of 16 is 8, not 5; the 5 was left over from the old 22×11 mark.
     WHAT REPLACES IT — one rule per datum, each spelled in a quantity the page already has.
     Here the datum is the WORD's baseline: `.tbtn{align-items:baseline}` synthesizes an
     inline svg's baseline as its bottom margin edge, so an unnudged mark's centre sits half
     its OWN height above the baseline, while type reads as centred on its x-height centre,
     one half-ex above it. Lower it by the difference of those two halves:
       (100% − 1ex) / 2  =  (16px − 7.734px) / 2  =  4.13px
     `100%` on translateY is the element's own height and `1ex` is the font's own x-height, so
     the number re-derives itself if the mark is resized or the type changes — nothing to
     hand-edit. Measured after, on `arpeggiate` at 1512 and 390, light and dark: 0.00px off the
     x-height centre (was 5.37 low).
     Why the x-height and not the cap height, which is what the old comment used: `1ex`
     resolves to 7.734px against a drawn x-ink of 8px (agrees to 0.27), where `1cap` resolves
     to 10.469px against a drawn cap-ink of 9px (off by 1.47). The x-height is the quantity
     this font actually reports honestly, and the two centres are 0.63px apart anyway. */
  .rd{flex:none;display:block;transform:translateY(calc((100% - 1ex) / 2))}
  /* AND WHERE THERE IS NO WORD, NOTHING TO CORRECT. The five latches in `.mt-cap` sit in a
     28px row that centres a 16px margin box on its own centre line, which is 1.13px above the
     type's x-height centre and 0.50px above its cap centre — both under a pixel, and kept as a
     residual rather than removed with a second hand number. The win here is a number deleted,
     not a number improved.
     `transform:none` and not "no rule at all", because `.rd` above is the shared base for all
     six marks; this is the override that says which of them has a baseline to answer to.
     Paired with `.pg-rd` in src/pages/pitchgraph.astro — same construction, same fix, and
     tools/verify-pitchgraph-parity.mjs compares the two pages' computed transforms to each
     other, so a change to one without the other is a FAIL by design. */
  .mt-cap .rd{transform:none}
  .fld{fill:none;stroke:var(--line);stroke-width:1.5}
  .dt{fill:var(--ink);
    transition:transform var(--dur) var(--ease),fill var(--dur) var(--ease)}
  .latch[aria-pressed="true"] .dt{fill:var(--accent);transform:translateX(16px)}
  .latch .tk .run{stroke:var(--line);stroke-width:1}
  .latch .tk .pk{fill:none;stroke:var(--faint);stroke-width:1.2}
  /* The disc: ink at the near pocket (off), ACCENT at the far pocket (latched).
     cx is fixed at the near pocket; the throw is a transform, which animates. */
  .latch .tk .disc{fill:var(--ink);cx:4px;
    transition:transform var(--dur) var(--ease),fill var(--dur) var(--ease)}
  .latch[aria-pressed="true"] .tk .disc{fill:var(--accent);transform:translateX(18px)}
  .latch[aria-pressed="true"] .w{color:var(--ink)}

  /* ── THE MOMENTARY SNAPS (chooser metrotuner-meter-tap, pick 02 "overshoot and
     settle"). The fill-and-drain is deleted: 300ms of accent fading out of a 14px
     circle is a small amount of ink moving slowly, which is what read as flat
     ("the tap feels pretty unsatisfying"). What replaces it is the mechanic a real
     key has — the response OVERSHOOTS the input and then resolves. The ring scales
     to 1.9x in 90ms on press and settles back on the site's own easing.
     NO COLOUR CHANGE, deliberately: the accent hue is the instrument's "active /
     latched" signal (the toggle's disc, the digits mid-scrub), and tap latches
     nothing. Motion says "struck"; hue would have said "on".
     `transform-box:fill-box` + `transform-origin:center` so the scale is about the
     ring's own centre — the SVG default origin is the viewport's top-left corner,
     which would fling the circle down-right instead of growing it in place. */
  .mom .tk{transform-box:fill-box;transform-origin:center;
    transition:transform var(--dur) var(--ease)}
  .mom .tk circle{fill:transparent;stroke:var(--dim);stroke-width:1.4;
    transition:stroke var(--dur-fast) var(--ease)}
  /* The press: bigger, and the outline goes to ink so the bigger ring is also a
     firmer one. `transition:none` on the way IN — the snap is instant and the
     settle is what animates, which is the asymmetry that makes it feel mechanical
     rather than springy. */
  .mom.hit .tk{transform:scale(1.9);transition:none}
  .mom.hit .tk circle{stroke:var(--ink);transition:none}

  /* BARE NUMERAL (round15 Q2/06): the rails are gone — the number is the whole
     control. While a scrub is live the digits read accent; that flash, the
     resize cursor and the title are the affordance. */
  .scrubbing input, .tbtn.scrubv.scrubbing .w{color:var(--accent)}
  .tbtn.scrubv{cursor:ew-resize;touch-action:none;min-width:4ch;text-align:center}

  /* ── THE UNIT IS THE HANDLE (chooser metrotuner-scrub-target, pick 03).
     The drag used to live on the whole `.scrubwrap`, input included, so the same
     pixels took a drag AND opened a keyboard. The user's call: "the slidy control
     should be on the unit like bpm/Hz and maybe also on the A4, but not on the typing
     input bc its confusing that u can type (this is how figma works)". So the unit
     label is the scrubber and the field is only a field.

     44px BY PADDING, and the number is measured not guessed. On the proof sheet
     `bpm` rendered 27×28px bare — over WCAG 2.5.8's 24px floor but well under the
     44px this page holds everywhere else (`.f input{min-height:44px}` exists for
     exactly this reason). The sheet's own option 03 padded to 31×56: tall enough,
     still 13px short across. `bpm` is the WIDEST of the three handles at 3ch;
     `a4` and `hz` are 2ch/18px, so the horizontal pad has to be set for the
     narrowest. 14px each side takes 18px → 46px and 27px → 55px, both clear.
     Negative margins keep the visual line identical — the target grows, the
     composition does not move. */
  .mt-hd{cursor:ew-resize;touch-action:none;
    display:inline-block;padding:8px 14px;margin:-8px -14px}
  /* The handle reads accent while in hand, like the digits it drives. */
  .scrubbing .mt-hd.hot{color:var(--accent)}
  /* Keyboard reachable: the handle is a real control, so it takes focus and the
     arrows step it. Without this the drag would be pointer-only — the reason the
     old wrapper could get away with no focus style is that the INPUT inside it was
     the focusable thing, and the input is no longer the scrubber. */
  .mt-hd:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
  /* The field types. `cursor:text` is stated rather than left to the UA because the
     element it replaced declared `ew-resize` and an inherited cursor here would be a
     lie about what the pixels do. */
  .mt-a4 input, .mt-bpm input{cursor:text}
  /* THE REFLOW FIX (user nit, 2026-08-04), moved onto the WORD: the label swaps
     between two widths, so the .w span reserves the longer one (--w in ch — exact
     in a monospace face); the track and the gap sit outside the reservation. */
  .tbtn.fixw .w{display:inline-block;min-width:var(--w);text-align:left}

  /* BASELINE, NOT CENTRE (grid pass). These groups hold a 15px unit label beside a 16px
     input (`.f input` is 16px, forced by iOS Safari's focus zoom), and `align-items:center`
     made the GROUP's first baseline the taller input's — so the a4 row's type sat 4px
     below the beats meter's even once both rows were on the same ladder. On `baseline` the
     label and the numeral share one baseline and the group reports it as its own, which is
     the rule this file already states for every other composite control ("ONE BASELINE PER
     ROW"). The two were the exceptions to it. */
  .mt-a4, .mt-bpm{display:inline-flex;align-items:baseline;gap:1ch}
  .mt-a4 input, .mt-bpm input{flex:0 0 auto;width:6ch;text-align:center;
    -moz-appearance:textfield;appearance:textfield}
  /* ── A FLUSH MARK READS FROM ITS OWN EDGE (datum pass, 2026-08-05) ───────────
     THE INSET is this screen's other datum: one lead (28px) from the case's box, and every
     mark that is not on the axis sits on it, flush left or flush right. Measured before this
     rule, five of the six flush marks were at exactly 28px and the metronome's foot was at
     48px — the one number on the screen that agreed with nothing.
     THE CAUSE: `text-align:center` above, which is right for the a4 field and wrong for this
     one. The bpm field's BOX is flush at 28px; its digits are centred inside a 6ch box, so
     the ink starts 20px further in than the edge it is supposed to touch. The a4 field never
     had the problem because a LABEL precedes it — the label is the flush mark there, and the
     field is interior, so centring its digits is invisible to the datum.
     So the rule is not "fields are left-aligned", it is: THE FIRST THING IN A FLUSH GROUP
     READS FROM THE EDGE. Here that is the field; in the tuner it is the `a4` label.
     `padding-left:0` with it because `.f input` carries `padding:8px 0` — stated anyway so a
     future change to that shared rule cannot silently reintroduce the 20px. */
  /* AND THE FIELD IS AS WIDE AS ITS VALUE (user nit, 2026-08-05: "176 bpm line reads weird
     now with empty space after the number"). Flush-left alone was half a fix: the box stayed a
     fixed 6ch, so "96" left 40px of dead air before the word `bpm` and the line read as two
     things with a hole between them rather than one phrase. `field-sizing:content` sizes the
     box to the digits, which is what a flush mark needs — the value's own edge, not the widest
     value's edge.
     `min-width:3ch` is the part that matters for feel: the tempo runs 20–320, so the field
     would otherwise WIDEN as you scrub past 99 and shove `bpm` and `tap` sideways mid-drag.
     At 3ch it is the width of the longest tempo from the start, so nothing reflows — measured
     at 20 / 96 / 176 / 320, `bpm` stays at x 802 and `tap` at 861 for all four, and 176 fills
     the box exactly. That is the same reflow lesson `.tbtn.fixw` already records for the
     start/stop word.
     THE COST, stated: the field's tap target goes 60x45 to 30x45. Over WCAG 2.5.8's 24px and
     the numeral was never the drag handle anyway — `bpm` is (chooser metrotuner-scrub-target,
     pick 03), and it keeps its own 46x44. */
  .mt-bpm input{text-align:left;padding-left:0;field-sizing:content;min-width:3ch;width:auto}
  .mt-a4 input::-webkit-outer-spin-button, .mt-a4 input::-webkit-inner-spin-button,
  .mt-bpm input::-webkit-outer-spin-button, .mt-bpm input::-webkit-inner-spin-button{
    -webkit-appearance:none;margin:0}

  /* The foot: dots centre (phone only — on the wide screen both pages are already
     on screen and an indicator would point at nothing), the word out under them. */
  /* The foot holds only the page dots now, which are a phone device — on desktop
     the whole band collapses and the cases keep the height. */
  .mt-foot{display:none;flex:none;flex-direction:column;align-items:center;
    gap:4px;padding:0 var(--gutter) var(--lead)}
  /* ── FIVE WORDS DO NOT FIT ONE LINE ON A PHONE, so the row wraps and is centred.
     MEASURED at 390px before this rule: the row is a `nowrap` flex, so five words plus their
     separators set 414px in a 390px viewport and the row CENTRED ITSELF OUT OF THE SCREEN —
     `tuner` began at x −12 and `the loop` ended at 402. Both end words were clipped by the
     viewport, which is worse than wrapping: the row looked deliberate and two of the five
     pages had no reachable label. (The document did not scroll, so nothing announced it.)
     `wrap` + `justify-content:center` is the whole fix: two centred lines at 390px, one line
     from ~430px up. The foot's reserved row grows with it rather than the words leaving the
     screen — which is the trade named in the markup comment: naming five pages costs a second
     line on a phone, and five unlabelled discs would cost the reader the names. */
  /* ── THE ROW HOLDS GLYPHS NOW, so it fits one line and the wrap above is history.
     MEASURED at 390px: five 16px glyphs plus their 1.5ch gaps set to 148px, against the
     568px the five words needed. `align-items:center` rather than `baseline` — a glyph has
     no baseline to share, and baseline alignment on an svg row hangs it off the box bottom.
     The `flex-wrap` and the reserved second line are kept for a queue longer than today's
     five: at 16px + 1.5ch each, the row holds ~19 instruments at 390px before it wraps, so
     this is insurance rather than a layout anyone sees. */
  .mt-dots{display:flex;gap:1.5ch;align-items:center;
    flex-wrap:wrap;justify-content:center;max-width:100%}
  /* THE GLYPH DOT. 44px target via padding + matching negative margins (the device every
     control on this screen uses), so the 16px drawing keeps a thumb-sized hit area without
     the row growing. Current page = ink, the rest = faint: the same outline-vs-fill signal
     the words carried, stated in weight of colour rather than in an underline. */
  /* `:global()` for the same reason as the order rows: the dots are written by this file's
     script, so Astro's scope attribute never reaches them and a compiled `.pgdot{…}` matched
     nothing. The symptom was a 16px tap target where the padding should have made 44. */
  /* THE TARGET GROWS VERTICALLY ONLY. `padding:14px 6px` with matching negative margins gave
     a 28×44 target — but the horizontal pair pulls each dot 6px OUTSIDE the row's own box, so
     the content spanned 140px inside a 134px row and the first and last glyph hung past its
     edge (`scrollWidth > clientWidth`, measured). The row's `gap` is 1.5ch = 13.5px, which is
     already more than a thumb needs between marks, so the horizontal padding was buying
     nothing and leaking geometry. Vertical padding only: the target is 16×44, the gap does the
     horizontal separating, and the row's box contains its contents. */
  #mt-dots :global(.pgdot){background:transparent;border:0;padding:14px 0;margin:-14px 0;
    cursor:pointer;color:var(--faint);display:inline-flex;align-items:center;
    border-radius:0;transition:color var(--dur-fast) var(--ease)}
  #mt-dots :global(.pgdot svg){display:block}
  #mt-dots :global(.pgdot.cur){color:var(--ink);cursor:default}
  #mt-dots :global(.pgdot:not(.cur):hover){color:var(--accent)}
  #mt-dots :global(.pgdot:focus-visible){outline:1px solid var(--accent);outline-offset:2px}
  /* ── THE FOOT IS PHONE-ONLY AGAIN, and on one route (his annotation, 2026-08-12: "this bar is no
     longer needd dleete form desktop, maybe leave for cnosle mobile where we need app switching").
     It went to every width when the room was a queue and the pages continued off-screen. They do
     not any more: on the desktop console all three instruments are on screen at once, so a page
     indicator points at nothing — which is exactly the argument that made it phone-only the first
     time. `display:none` is the base rule 50 lines up; this is the one place it comes back.
     `.cur` IS MEASURED, NOT COUNTED. `scrollLeft / clientWidth` as a page index is true here (a
     phone page IS the viewport) and was wrong everywhere else it was used — the chord dealer lit
     the DRONE's mark on the desktop — so the geometric test stayed. */
  @media (max-width: 759px){
    #mt-app[data-page="console"] .mt-foot{display:flex}
  }
  /* The page words (user nit 2026-08-04, the dots were unclear): current = ink, no
     underline (a fact); the other = faint, underlined (an offer) — the segment
     idiom. 44px targets via padding. */
  .pgword{font:inherit;background:transparent;border:0;padding:10px 0;margin:-10px 0;
    border-radius:0;cursor:pointer;color:var(--faint);
    text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:4px;
    transition:color var(--dur-fast) var(--ease)}
  .pgword.cur{color:var(--ink);text-decoration:none;cursor:default}
  .pgword:not(.cur):hover{color:var(--accent)}
  .pgword:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;
    clip:rect(0 0 0 0);white-space:nowrap}

  @media (prefers-reduced-motion: reduce){
    #mt-needle{transition:none}
    .mrn{transition:none}
    /* THE SNAP BECOMES A FLASH, not nothing. `transition:none` alone would leave the
       ring jumping to 1.9x and back with no tween, which is a harsher motion than the
       eased one — the opposite of the request. So the scale is dropped entirely and
       the stroke carries the strike instead: no movement, still a per-strike response.
       A reduced-motion user who taps a tempo still needs to know the tap registered. */
    .mom .tk{transition:none}
    .mom.hit .tk{transform:none}
    .mom.hit .tk circle{stroke:var(--accent);stroke-width:2.4}
  }
</style>

<script>
  import { detectPitch } from '../lib/practice-room/pitch';
  import { freqToReading, midiToFreq, A4_DEFAULT, A4_MIN, A4_MAX } from '../lib/practice-room/notes';
  import { TUNINGS, DEFAULT_TUNING_ID, getTuning, beatRate } from '../lib/practice-room/tuning';
  // THE ONE NAMING MODULE. `nameOf` for a pitch on its own (the root, the tuner's readout) and
  // `nameInChord` for a pitch heard AS AN INTERVAL above the root — which is a different
  // question with a different answer: a minor third above E♭ is G♭, not F♯.
  import { nameOf, pitchClassOf, nameInChord, spellVoicing } from '../lib/practice-room/naming';
  import type { ChordTone } from '../lib/practice-room/naming';
  import { Scheduler, clampBpm, type Tick } from '../lib/practice-room/metronome';
  import { createTapTempo } from '../lib/practice-room/tap';
  // THE ROOM'S ARITHMETIC. What is left of it: the measured demands, the room's own padding and
  // gap, the three things and how a console splits its page. The QUEUE's functions — fitRoom,
  // fitThings, normalizeOrder, normalizeThings, moveTo, nudge, settleTo — are deleted, not merely
  // unimported: a pure function that nothing calls still reads as the mechanism, and the next
  // person to open this file would find a room that fits by demand and reorders on drag.
  import {
    INSTRUMENTS, BY_KEY, PAD, GAP, glyphSvg, THINGS, splitThing,
  } from '../lib/practice-room/room';

  // ONE AudioContext for tuner, tone and metronome, created on the first gesture —
  // browsers refuse both getUserMedia and audio playback without one.
  let ctx: AudioContext | null = null;
  const audio = (): AudioContext => {
    if (!ctx) ctx = new AudioContext();
    if (ctx.state === 'suspended') ctx.resume();
    return ctx;
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  // E2E HOOK, inert in normal use: `?e2e` makes the page record what it did.
  const E2E = new URLSearchParams(location.search).has('e2e');
  // `a4` and `bpm` are GETTERS, not fields: they read the live bindings, so a test can
  // assert the calibration actually moved rather than that the input's text changed.
  // A scrub that updates the field but not the value would otherwise pass.
  const hook: { ticks: Tick[]; reading: unknown; toneHz: number | null;
                sounds: { at: number; voice: string }[];
                // Every reading the tuner PAINTED, stamped on the audio clock. The bleed
                // test's core assertion is an exact invariant rather than a statistic:
                // no paint may fall inside a span the speaker was sounding in. That holds
                // whatever frequency the click smears to, which a note-name assertion
                // does not — a real mic's noise floor moves the click 25-46 cents.
                renders: { at: number; note: string }[];
                bleed: GainNode | null; gated: number; belowFloor: number;
                readonly a4: number; readonly bpm: number;
                // EVERY RANK'S SET FREQUENCY, read off the live oscillators. `toneHz` alone
                // could not answer the question the fifth raises — whether the interval is
                // JUST (3:2) or the tempered 2^(7/12), two cents narrow — and a test that
                // re-derives the ratio from the source instead of the graph would pass on a
                // page that sounds the wrong one.
                readonly droneRanks: number[];
                readonly droneVoice: string | null;
                readonly droneStack: number[];
                droneHz: () => Promise<number | null>;
                readonly droneOut: GainNode | null;
                readonly droneSources: { want: number; sample: string; srcHz: number; rate: number; sounds: number }[];
                // THE INDEX, for the room harness — one entry per PAGE, in the order they sit,
                // written by layoutRoom(). A DOM assertion cannot tell a correct layout from a
                // lucky one: the rendered column widths ARE the layout's output, so reading them
                // back is reading the mechanism rather than a symptom of it. `settled` stays
                // because it proves a DELETED mechanism is still deleted — it must never leave
                // null now that the browser does the snapping.
                roomPages: Array<{ id: string; keys: string[]; w: number }>;
                settled: number | null;
                readonly ctx: AudioContext | null; readonly mic: AudioNode | null } = {
    // `sounds` is the SPEAKER's log — every ping() scheduled, minus lookahead
    // clicks later cancelled. The smoothness harness asserts spacing on it.
    ticks: [], reading: null, toneHz: null, sounds: [], renders: [],
    // THE ROOM, for the bleed test. Headless Chrome's fake microphone plays a WAV; it
    // cannot hear the page's speaker, so the acoustic path that causes the bug does
    // not exist in CI. Set `bleed` to a GainNode and every ping() also routes into it
    // — the TEST then connects that node to the analyser, at a chosen attenuation.
    // The topology lives in the test; the page only offers the tap. `gated` counts
    // frames the tuner disowned, so a green can be told from a gate that never fired.
    bleed: null, gated: 0, belowFloor: 0,
    // the index's own state, written by layoutRoom()
    roomPages: [], settled: null,
    get a4() { return a4; },
    get bpm() { return bpm; },
    // ONE ENTRY PER SOUNDING NOTE, in pitch order: the root, then each switched interval.
    // It was three named oscillator handles, which cannot work now for two reasons — the
    // stack is up to seventeen notes, and the SECTION voice starts no oscillators at all
    // (buffer sources), so the old getter reported an empty stack while a cello section was
    // audibly sounding. `rankHz` is what startTone() actually scheduled.
    get droneRanks() { return rankHz.slice(); },
    // WHAT IS ACTUALLY SOUNDING, which is not always what is selected: `section` falls back
    // to the organ until its samples arrive (and permanently if the fetch fails). A test
    // asserting the sampled voice has to be able to tell those apart.
    get droneVoice() { return toneGain ? activeVoice() : null; },
    get droneStack() { return [...stack].sort((x, y) => x - y); },
    // ── THE PITCH THAT IS ACTUALLY COMING OUT, measured off an analyser on the drone's own
    // gain node. This exists because of the octave bug: `toneHz` reports the frequency the code
    // INTENDED, and the ratio assertions compare ranks to each other, so a voice playing an
    // octave high with perfectly just intervals satisfied every check while sounding wrong.
    // Only an absolute measurement of the SIGNAL can catch a transposition — for the sampled
    // voices especially, where the pitch is a buffer's content times a playback rate and
    // nothing in the graph states it.
    // Autocorrelation rather than an FFT bin: at 220 Hz a 2048-bin FFT over 48 kHz has 23 Hz
    // buckets, which is 170 cents — too coarse to tell A3 from A♯3, let alone to check cents.
    droneHz(): Promise<number | null> {
      if (!toneGain || !ctx) return Promise.resolve(null);
      const ac = ctx;
      const an = ac.createAnalyser();
      an.fftSize = 16384;
      toneGain.connect(an);
      return new Promise((resolve) => {
        setTimeout(() => {
          const buf = new Float32Array(an.fftSize);
          an.getFloatTimeDomainData(buf);
          try { toneGain?.disconnect(an); } catch {}
          const sr = ac.sampleRate;
          let mean = 0;
          for (let i = 0; i < buf.length; i++) mean += buf[i];
          mean /= buf.length;
          const w = Array.from(buf, (v) => v - mean);

          // SPECTRAL-PEAK SEARCH, and the algorithm choice is load-bearing. This hook first
          // used an NSDF lag peak with parabolic interpolation, which is biased up to 11.4
          // cents and swings with frequency — it read 221.0 Hz for the organ voice's exact
          // 220.000 Hz oscillators. That plausible-looking wrong number is what let a 30-cent
          // sample "correction" ship: the instrument was lying and its reading looked fine.
          // Maximising summed harmonic magnitude has no lag quantisation and no integer
          // ambiguity, so there is no mechanism for that bias. Verified to 0.000¢ against
          // synthetic tones in scripts/build-cello-samples.py's self_check().
          const power = (f: number) => {
            let total = 0;
            for (let h = 1; h <= 3; h++) {
              const om = (2 * Math.PI * f * h) / sr;
              let re = 0, im = 0;
              for (let i = 0; i < w.length; i += 2) {
                const win = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (w.length - 1));
                const v = w[i] * win;
                re += v * Math.cos(om * i);
                im -= v * Math.sin(om * i);
              }
              total += Math.hypot(re, im) / h;
            }
            return total;
          };
          // ── THE PLAIN SWEEP IS CORRECT, and the subharmonic preference that used to sit
          // here is deleted. It was written to fix an octave the audio never had: a probe that
          // left its own analyser connected to this same gain node changed what the NEXT
          // measurement saw, and I read the artefact as a 1204-cent error in the instrument.
          // The trace that settled it (`__mt.droneSources`) shows all three sampled sources
          // playing the A2 loop at rate 1.0023, sounding 219.99999 Hz — exactly the A3 asked
          // for — while a clean `droneHz()` reads 220.35 on five consecutive fresh runs.
          // THE LESSON, for the third time in this session: measure ONCE, with one tap, and
          // suspect the instrument before the thing it measures. Two "bugs" in the audio were
          // both bugs in how I was listening.
          let seed = 220, bestP = -1;
          for (let m = 24; m <= 96; m++) {
            const f = 440 * Math.pow(2, (m - 69) / 12);
            const pw = power(f);
            if (pw > bestP) { bestP = pw; seed = f; }
          }
          let lo = seed * Math.pow(2, -1 / 12), hi = seed * Math.pow(2, 1 / 12);
          for (let k = 0; k < 40; k++) {
            const m1 = lo + (hi - lo) / 3;
            const m2 = hi - (hi - lo) / 3;
            if (power(m1) < power(m2)) lo = m1; else hi = m2;
          }
          resolve((lo + hi) / 2);
        }, 260);
      });
    },
    // THE BLEED SUITE BUILDS ITS OWN TOPOLOGY off these two: the page offers the taps and the
    // test wires them (see the note on `bleed`). They were briefly deleted by an edit that
    // replaced `droneHz` and took the two getters after it — which failed 5 bleed tests with
    // `createGain of undefined`, nothing to do with the drone. Kept last, and kept together.
    get ctx() { return ctx; },
    get mic() { return analyser; },
    // the drone's own output node, so a probe can tap exactly what `droneHz` taps
    get droneOut() { return toneGain; },
    // WHAT EACH SAMPLED SOURCE IS DOING — the buffer it holds, the rate it plays at, and
    // therefore the pitch it sounds. Added while tracing an octave that the rank list said was
    // not there: `droneRanks` reports the pitch the code INTENDED per note, and for a sampled
    // voice the pitch is the buffer's content times a rate, which nothing else states.
    get droneSources() { return sampleDebug.slice(); },
    // ── WHAT THE CHORD GRADER HAS ACTUALLY ACCEPTED ────────────────────────────────────
    // The pitch classes `arpeggiate` has landed, and the ones the dealt chord contains. Both,
    // because the DOM cannot tell them apart: `paintArp()` renders only the chord's own notes,
    // so a non-member accepted into the landed set is INVISIBLE on the page. That double guard
    // made a real sabotage (deleting the grader's membership test entirely) pass all three
    // arpeggio tests — the assertion was measuring the painter, not the grader.
    // Exposed rather than inferred, for the same reason `droneSources` exists: the state a
    // check depends on has to be readable, or the check is about something else.
    get arpLanded() { return arpHook.landed(); },
    get arpWanted() { return arpHook.wanted(); },
  };
  // Filled in by the chord case below; null-safe so the hook works before that block runs.
  const arpHook: { landed: () => number[]; wanted: () => number[] } = {
    landed: () => [], wanted: () => [],
  };
  if (E2E) (window as any).__mt = hook;

  const store = {
    get(k: string): string | null { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
  };

  // TRACK GRAMMAR plumbing: every latch keeps its word in a .w span so setting
  // the label can't wipe the track SVG out of the button.
  /* Still used by the ref-note / drone-note scrub control, whose VALUE is its word.
     The three transports no longer have a `.w` at all (chooser treatment 05: the control is
     one mark, no label), so calling this on them is a no-op — the `if (w)` guard is what
     makes that safe, and the calls are gone rather than left to rot. What carries transport
     state now: `aria-pressed` for assistive tech, `aria-label` for the verb, and the dot's
     position plus accent for the eye. */
  const setWord = (btn: HTMLElement, s: string) => {
    const w = btn.querySelector('.w');
    if (w) w.textContent = s;
  };
  let a4 = Number(store.get('mt:a4')) || A4_DEFAULT;
  a4 = Math.min(A4_MAX, Math.max(A4_MIN, a4));
  // ── ONE CALIBRATION, TWO FIELDS (the user's refinement on the drone-box chooser's Q4:
  // "it makes sense for both to have a pitch calibration but they're synced?").
  // Calibration is what the whole ROOM means by a note, so the case that READS pitch and
  // the case that SOUNDS pitch each carry the field — and there is exactly one number
  // behind them. Every write goes through setA4(), which paints every field, so the two
  // cannot disagree. The alternative was one owner, and both versions of that were worse:
  // a4 on the tuner alone leaves the drone's pitch set on another case, and a4 following
  // the sound takes it off the case whose reading it defines.
  const a4Fields = Array.from(
    document.querySelectorAll<HTMLInputElement>('#mt-a4, #mt-a4-drone'),
  );
  // PAINT BOTH FIELDS, UNCONDITIONALLY. The first version skipped the focused one, meaning
  // to protect a half-typed number — and that guard was both unnecessary and a bug:
  //   · Unnecessary, because these fields only commit on `change` (blur or Enter), never on
  //     `input`. Nothing repaints while a number is being typed, so there is nothing to
  //     protect against.
  //   · A bug, because a scrub leaves focus on the handle INSIDE one case, and skipping
  //     "the focused field" then left the other case's number stale: measured a4=440 with
  //     the two inputs reading 450 and 440. Two fields showing different numbers is the
  //     exact failure "synced" exists to prevent.
  const paintA4 = () => {
    for (const f of a4Fields) f.value = String(a4);
  };
  const setA4 = (v: number) => {
    if (!Number.isFinite(v)) return;
    a4 = Math.min(A4_MAX, Math.max(A4_MIN, v));
    store.set('mt:a4', String(a4));
    paintA4();
    // The drone follows the calibration too — a4 is what the whole ROOM means by a note.
    // `droning()` is a hoisted function declaration for exactly this: setA4 is defined
    // above the drone block and still has to ask whether the drone is running.
    if (droning()) retune();
  };
  for (const f of a4Fields) {
    f.value = String(a4);
    // setA4() clamps and then paints BOTH fields, so an out-of-range entry is corrected in
    // place — no separate write-back needed here.
    f.addEventListener('change', () => setA4(Number(f.value)));
  }

  // ── SCRUB ON THE UNIT, TYPE IN THE FIELD ────────────────────────────────────
  // One helper for all of it (chooser metrotuner-scrub-target, pick 03). It used to
  // be two near-identical blocks wired to the two wrappers, which is what made the
  // bpm and A4 gestures able to drift apart; now there is one definition and each
  // control names its handles.
  //
  // The handle is a LABEL, not the input, so `pointermove` is ours — the old comment
  // "an <input> eats pointermove for text selection" was the reason the drag sat on
  // the wrapper, and moving it to the unit removes that constraint rather than
  // working around it.
  //
  // No click-suppression needed either, and that deletion is the point: the old code
  // had to swallow the post-drag click and `blur()` the input, because the drag ended
  // on the same pixels that focus a text field. The handle cannot focus anything, so
  // there is nothing to undo.
  function wireScrub(opts: {
    handles: HTMLElement[];
    host: HTMLElement;
    get: () => number;
    set: (v: number) => void;
    min: number;
    max: number;
    perPx?: number;
  }) {
    const per = opts.perPx ?? 4;
    for (const h of opts.handles) {
      let dragX: number | null = null;
      let dragStart = 0;
      h.addEventListener('pointerdown', (e) => {
        dragX = e.clientX; dragStart = opts.get();
        opts.host.classList.add('scrubbing');
        h.classList.add('hot');
        h.setPointerCapture(e.pointerId);
        e.preventDefault();          // no text selection of the label while dragging
      });
      h.addEventListener('pointermove', (e) => {
        if (dragX === null) return;
        const d = Math.round((e.clientX - dragX) / per);
        const v = Math.min(opts.max, Math.max(opts.min, dragStart + d));
        if (v !== opts.get()) opts.set(v);
      });
      const end = () => {
        dragX = null;
        opts.host.classList.remove('scrubbing');
        h.classList.remove('hot');
      };
      h.addEventListener('pointerup', end);
      h.addEventListener('pointercancel', end);
      // A handle is a control, so it answers the arrows. `tabindex` is set here rather
      // than in the markup so a handle is only focusable when its behaviour is wired.
      h.tabIndex = 0;
      h.setAttribute('role', 'slider');
      h.setAttribute('aria-valuemin', String(opts.min));
      h.setAttribute('aria-valuemax', String(opts.max));
      h.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' || e.key === 'ArrowUp' ? 1
          : e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        opts.set(Math.min(opts.max, Math.max(opts.min, opts.get() + step)));
      });
    }
  }

  {
    // BOTH cases' calibration fields are scrubbable, and both report the same value —
    // there is one binding, so a drag on the drone's `hz` moves the tuner's number too.
    // The handles are collected across both hosts; `host` (the class that paints the
    // scrubbing state) is resolved per handle from its own wrapper rather than passed in,
    // because there are two wrappers now.
    const hosts = Array.from(document.querySelectorAll<HTMLElement>('#mt-a4-scrub, #mt-a4-scrub-drone'));
    const allHandles = hosts.flatMap((h) => Array.from(h.querySelectorAll<HTMLElement>('.mt-hd')));
    // `aria-valuenow` has to track the value or a screen reader reads the start state
    // forever. Declared BEFORE wireScrub so the setter closes over a real binding —
    // a `var` after the call would hoist and work by luck, only because the setter
    // does not run until a drag.
    const syncA4Handles = () => {
      for (const h of allHandles) {
        h.setAttribute('aria-valuenow', String(a4));
        h.setAttribute('aria-valuetext', `A4 = ${a4} hertz`);
      }
    };
    for (const host of hosts) {
      wireScrub({
        host,
        handles: Array.from(host.querySelectorAll<HTMLElement>('.mt-hd')),
        get: () => a4,
        // paintA4() writes BOTH fields; the handle sync covers both sets of labels. A
        // scrub on either case therefore moves the whole room's calibration, which is
        // what "synced" has to mean to be worth having twice.
        set: (v) => { setA4(v); syncA4Handles(); },
        min: A4_MIN, max: A4_MAX,
      });
    }
    syncA4Handles();
  }

  // ── WHICH CASES THIS ROUTE RENDERS ───────────────────────────────────────────────────────
  // Four routes share this script (see the component header), so every subsystem's WIRING has to
  // be gated: without this, `/changes/` threw on `micBtn.addEventListener` at the first tuner
  // statement and lost the entire rest of the file — the dealer's own block included. A dead page
  // with no error visible to a user.
  //
  // WHY A GATE AND NOT A NULL-OBJECT `$`. Returning a detached element for a missing id would make
  // the whole script route-safe in one line, and it would also make a MISTYPED id silently do
  // nothing forever. The `!` at least crashed loudly. So the lookups stay honest and the wiring
  // asks first.
  //
  // WHAT IS NOT GATED, deliberately: every `let`/`function` declaration. They are read across
  // cases — the metronome's `ping()` writes the bleed log the tuner reads, `setA4()` calls the
  // drone's `droning()`, the dealer's arp borrows the tuner's `analyser` — and a `let` inside a
  // block would leave those reads in TDZ. Declarations always evaluate; only the wiring is
  // conditional.
  const HAS = (k: string) => !!document.querySelector(`[data-mt-key="${k}"]`);
  const HAS_TUNER = HAS('tuner');
  const HAS_DRONE = HAS('drone');
  const HAS_METRO = HAS('metronome');

  // ── tuner ─────────────────────────────────────────────────────────────────
  const noteEl = $('mt-note');
  const centsEl = $('mt-cents');
  const hzEl = $('mt-hz');
  const srEl = $('mt-sr');
  const needle = document.getElementById('mt-needle')!;
  const micBtn = $('mt-mic') as unknown as HTMLButtonElement;
  const hintEl = $('mt-hint');

  let micStream: MediaStream | null = null;
  let analyser: AnalyserNode | null = null;
  let tunerTimer: number | null = null;
  const buf = new Float32Array(2048);

  // THE READ CADENCE. 33 ms, halved from 66 (measured 2026-08-06,
  // work/understand/practice-room-cadence/ — the real detector in a real browser).
  //
  // What the measurement said, because the obvious reason is the wrong one. Reading twice
  // as often does NOT recover more of a vibrato: the analyser window is 2048 samples =
  // 46 ms of audio, so every read is already an estimate fitted to that whole span, and
  // the detector reports the same ±52¢ of a real ±58¢ at every cadence from 66 ms down to
  // 5 ms. The peak it misses is the window averaging, and no hop fixes that.
  //
  // What 33 ms actually buys is that the DRAWING stops lying. The trace joins samples
  // with straight lines, and at 66 ms a 6 Hz vibrato gets 2.5 samples per cycle — so a
  // worst-phase peak is drawn up to 22¢ away from where it happened, which is larger than
  // the intonation errors this instrument exists to show. At 33 ms that is 3¢. Going
  // further is not free and buys ~1¢: 8 ms costs 81% of one core and each read shares 83%
  // of its samples with the previous one, and 5 ms needs 130% of a core — it cannot hold
  // its own schedule (measured: 70–84% of reads completed).
  //
  // Cost here, measured on this window: 20% duty cycle on a 12-core desktop, and the real
  // loop held 99.9% of its reads with +0.0 ms drift. A phone is several times slower, so
  // treat that as a floor rather than a promise.
  //
  // EVERYTHING TIMED IN FRAMES BELOW IS DERIVED FROM THIS, not hardcoded — the median
  // ring, the silence hold, and the tuner's own smoothing are all durations that would
  // have silently halved when the hop halved.
  const READ_MS = 33;

  // Median smoothing: one bad window (a chair scrape) can't kick the reading. Held at
  // ~165 ms of audio, which is what median-of-5 meant at the old 66 ms cadence — the
  // point is the DURATION the median covers, so the count scales with the cadence.
  const MEDIAN_MS = 165;
  const MEDIAN_N = Math.max(3, Math.round(MEDIAN_MS / READ_MS) | 1); // odd: a median needs one
  const recent: number[] = [];

  // A breath between notes is not silence. Held at ~400 ms, which is what six frames
  // meant at 66 ms; as a frame count it would now clear the readout in 200 ms and make
  // the note name flicker between bow changes.
  const SILENCE_HOLD_MS = 400;
  const SILENCE_FRAMES = Math.max(2, Math.round(SILENCE_HOLD_MS / READ_MS));
  let quietFrames = 0;

  const IN_TUNE_CENTS = 3;

  // The lowest frequency this window can honestly resolve — see the note at the read loop.
  // B1 is 61.7 Hz, so 62 admits every note from C2 up and rejects the rumble below it.
  const TUNER_FMIN_HZ = 62;

  // THE METRONOME IS NOT AN INSTRUMENT (user report 2026-08-05: "when metronome is
  // playing it triggers tuner"). The click is a pure sine at a known frequency, the
  // mic hears it out of the speaker, and the tuner reads the metronome. Measured, not
  // assumed: handed a synthesized click buffer shaped exactly as ping() shapes one,
  // detectPitch returns that click's own frequency to within 0.1 cents — at full
  // level and at a tenth of it. It only falls under the clarity gate at 0.05.
  //
  // So between notes the readout shows C6, G6 and G5 on the beat; and from 140 bpm up
  // it never clears, because returning the dash needs six consecutive silent frames
  // and a beat at 140 leaves five. The instrument reads as broken while it clicks.
  //
  // The page knows what its own speaker is doing, so the gate is TIME: drop any read
  // whose analyser window overlaps a click this page scheduled.
  //
  // The first version of this also required the detected frequency to be within 30
  // cents of that click's, on the theory that a time-only gate throws away good frames.
  // The frequency half was WRONG, and testing the deployed page is what caught it — the
  // live tuner still printed G♯5 (816 Hz) and C4 (261 Hz) with the metronome running,
  // 51 cents and an octave-and-a-half off any click voice. Measured on synthesized
  // buffers afterwards: with ANY other content in the window — a hum, a room tone, the
  // string still ringing — a click reads as a smear up to 978 cents off its own
  // frequency, or as a subharmonic (f/2, f/3, f/4; C4 is 784/3). The mix moves the
  // period the NSDF locks onto, so there is no cents window that contains the answer.
  // A gate that must guess the frequency cannot work; the TIME is exact.
  //
  // The cost, stated because it is real: while the metronome runs the tuner is blind for
  // ~150ms per tick (click 90ms + room tail 60ms, plus the analyser window that overlaps
  // it). At 120bpm with no subdivisions that is a third of the WALL CLOCK; the rest is
  // 15+ reads a second at the 33 ms cadence, and a held note updates continuously. The
  // honest limit is fast subdivisions: at 200bpm in sixteenths a tick sounds every 75ms
  // and the gate covers everything, so the readout HOLDS its last value rather than
  // tracking. That is why a gated frame renders nothing instead of showing silence —
  // holding the last real reading is the correct failure, and a musician tuning against a
  // click that fast is not reading cents off the screen anyway.
  //
  // NOTE ON THE 2026-08-06 CADENCE CHANGE: the blind SPAN is unchanged, because it is
  // measured in audio-clock seconds and not in frames. What changed is that the same span
  // now costs twice as many reads — which is why nothing here is expressed as a frame
  // count. The gate was always a time gate; that is the property that made it survive.
  const BLEED_TAIL = 0.06;    // seconds of room after the click's own envelope ends

  // What the speaker is sounding, by audio-clock span. ping() fills it; a cancelled
  // lookahead click must be removed, or it gates a window it never sounded in.
  const sounding: { from: number; to: number }[] = [];

  function ownClick(now: number, sampleRate: number): boolean {
    const winFrom = now - buf.length / sampleRate;
    while (sounding.length && sounding[0].to < winFrom) sounding.shift();
    for (const s of sounding) if (s.from <= now && s.to >= winFrom) return true;
    return false;
  }

  function renderReading(freq: number) {
    // the readout belongs to the tuner's case; the dealer's arp grader reads the same analyser
    // without it, so this is reachable on a page that has nothing to print to
    if (!HAS_TUNER) return;
    const r = freqToReading(freq, a4);
    if (!r) return renderSilence();
    quietFrames = 0;
    noteEl.textContent = `${r.name}${r.octave}`;
    const c = r.cents;
    centsEl.textContent = `${c >= 0 ? '+' : '−'}${Math.abs(c).toFixed(1)}`;
    // WHILE IT IS RUNNING, THE DEVIATION IS THE READING (annotation 2026-08-07: "in play
    // mode dont need boh the abs pitch and the diff put just the diff like -4.1"). The Hz
    // was a third number for a fact the note name and the cents already carry between them,
    // and it is the one nobody tunes by — you tune by the sign and the size of the error.
    // It is BLANKED rather than deleted: the element keeps its slot, so the row's right edge
    // does not move when the mic starts, and the idle state can still show it.
    // The note NAME stays. A deviation with nothing to deviate from is not a reading, and
    // this row is where you learn you are on the wrong string. The screen-reader copy below
    // was already note-plus-cents only, so nothing was lost there.
    hzEl.textContent = '';
    const deg = Math.max(-50, Math.min(50, c)) * (60 / 50);
    needle.style.transform = `rotate(${deg}deg)`;
    const tuned = Math.abs(c) <= IN_TUNE_CENTS;
    needle.classList.remove('rest');
    needle.classList.add('live');
    noteEl.classList.toggle('intune', tuned);
    if (E2E) {
      hook.reading = { ...r };
      hook.renders.push({ at: audio().currentTime, note: `${r.name}${r.octave}` });
      if (hook.renders.length > 512) hook.renders.shift();
    }
  }

  function renderSilence() {
    // A couple of empty windows is a breath between notes; hold briefly.
    if (++quietFrames < SILENCE_FRAMES) return;
    // NOTHING TO RENDER WITHOUT THE TUNER, and `pagehide` reaches here through stopTuner() on
    // every route — the readout, the needle and the screen-reader line are all this case's.
    if (!HAS_TUNER) { if (E2E) hook.reading = null; return; }
    noteEl.textContent = '—';
    noteEl.classList.remove('intune');
    centsEl.textContent = '–';
    hzEl.textContent = '';
    needle.style.transform = 'rotate(0deg)';
    needle.classList.add('rest');
    needle.classList.remove('live');
    if (E2E) hook.reading = null;
  }

  // The spoken copy of the reading, at most once a second. NOT REGISTERED WITHOUT THE TUNER: it
  // wrote to `#mt-note`/`#mt-sr` unconditionally, so on a route without them it threw once a
  // second, forever, in a page that otherwise looked fine.
  if (HAS_TUNER) setInterval(() => {
    const t = noteEl.textContent;
    srEl.textContent = t === '—' ? '' : `${t}, ${centsEl.textContent} cents`;
  }, 1000);

  // THE PERMISSION RACE: a stop click during a pending prompt must not leave the
  // resolved stream's tracks live. Request ids invalidate a stale resolution; a
  // stream that arrives for a dead request is stopped on sight.
  let micRequest = 0;

  async function startTuner() {
    const req = ++micRequest;
    const ac = audio();
    let stream: MediaStream;
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false,
        },
      });
    } catch (err) {
      // THE MOBILE MIC BUG (user report, 2026-08-04: "not sure how to accept the
      // listening on mobile"). Two real causes were hiding in this catch:
      // (1) the old hint said "allow it in the address bar" — desktop-Chrome
      //     guidance; iOS has no address-bar permission UI at all, so the message
      //     described a control that does not exist on the phone;
      // (2) iOS Safari NEVER re-prompts after a denial — getUserMedia rejects
      //     NotAllowedError instantly with no dialog, so tapping again looks like
      //     the button silently failing. The way back is the aA menu → Website
      //     Settings → Microphone (or Settings → Safari).
      // So the message is now derived from the error NAME and the platform.
      if (req === micRequest) {
        const touch = matchMedia('(hover: none)').matches;
        const name = (err as DOMException)?.name ?? '';
        if (hintEl) hintEl.textContent =
          name === 'NotFoundError' ? 'no microphone found on this device'
          : name === 'NotReadableError' ? 'the microphone is busy in another app — close it and try again'
          : touch ? 'microphone blocked — open the aA (or ⋯) menu → website settings → allow microphone, then reload'
          : 'microphone refused — allow it in the address bar and try again';
      }
      return;
    }
    if (req !== micRequest || micStream) {
      stream.getTracks().forEach((t) => t.stop());
      return;
    }
    micStream = stream;
    store.set('mt:tuneron', '1');
    const src = ac.createMediaStreamSource(micStream);
    analyser = ac.createAnalyser();
    analyser.fftSize = 2048;

    // ── PUT BACK THE HIGH-PASS THE THREE getUserMedia FLAGS TOOK AWAY ───────────────
    // Reported 2026-08-07: sitting in a quiet office playing nothing produced 24 note
    // panels, clustered at F♯1–A♯1 (46–58 Hz) with scattered mid-range hits. Measured on
    // this very detector: synthesized office noise (brown rumble + 50 Hz hum, RMS inside
    // the existing gate) reported a pitch in 42 of 400 frames, and EVERY ONE was under
    // 100 Hz.
    //
    // THE PROXIMATE CAUSE IS THREE LINES ABOVE, in the constraints this page asks for.
    // `echoCancellation:false, noiseSuppression:false, autoGainControl:false` are set so
    // the browser cannot mangle the pitch — correct, and staying. But read Chromium:
    // `NeedWebrtcAudioProcessing()` returns false when all three are off, so no audio
    // processing module is constructed at all; and WebRTC's `HighPassFilter.enabled`
    // defaults to false, existing only as a side-effect of AEC's
    // `enforce_high_pass_filtering` or of the noise suppressor. So turning those three off
    // also silently deleted an 87 Hz high-pass that was attenuating 46 Hz by ~104 dB. The
    // regression was never in this file's logic; it was in a filter we did not know we had.
    //
    // 45 Hz and not 87: the browser's corner is aggressive enough to cost a bass guitar's
    // open E (41.2 Hz) its fundamental. Two cascaded biquads at 45 Hz measure −5.6 dB at
    // 46 Hz, −4.4 dB at 50 Hz, and −1.8 dB at a cello's C2 — enough to stop rumble
    // WINNING the NSDF's maximum, which is the actual failure, while leaving real low
    // notes audible to the detector.
    //
    // Q IS IN dB FOR highpass, NOT LINEAR — the one trap here. Per the Web Audio spec's
    // filter characteristics, `highpass` uses α = sin(ω₀)/(2·10^(Q/20)), and the DEFAULT
    // Q of 1 is 1 dB, which is RESONANT: measured, two default-Q nodes at 45 Hz would
    // BOOST 50 Hz mains hum by +3.4 dB. Butterworth is Q = 20·log10(1/√2) = −3.01 dB.
    const HP_HZ = 45;
    const HP_Q_DB = -3.01;      // Butterworth. NOT 0.7071 — see above.
    const hp1 = ac.createBiquadFilter();
    const hp2 = ac.createBiquadFilter();
    for (const f of [hp1, hp2]) {
      f.type = 'highpass';
      f.frequency.value = HP_HZ;
      f.Q.value = HP_Q_DB;
    }
    // The RMS gate is measured on what comes OUT of the filter, because it reads the
    // analyser — which is downstream. That ordering matters: a high-pass alone measured
    // upstream is WORSE than none (it strips the energy the gate was catching while the
    // NSDF, being scale-invariant, still finds a peak in the residue).
    src.connect(hp1);
    hp1.connect(hp2);
    hp2.connect(analyser);
    // `?.` for the same reason stopTuner's are: the dealer's arpeggiator starts this mic on a page
    // with no tuner markup, and it must not die between `getUserMedia` resolving and the stream
    // being wired to something that can stop it.
    micBtn?.setAttribute('aria-label', 'stop the tuner');
    micBtn?.setAttribute('aria-pressed', 'true');
    if (hintEl) hintEl.textContent = '';
    tunerTimer = window.setInterval(() => {
      analyser!.getFloatTimeDomainData(buf);
      const f = detectPitch(buf, ac.sampleRate);
      // OUR OWN CLICK IS NOT A READING. Drop the frame whole: it must not enter the
      // median ring (one gated frame would poison the next five) and must not count
      // as silence either (six of those and a held note flips to the dash). Nothing
      // renders, so the last real reading stands — which is what a musician wants
      // from the beat that interrupted their note.
      // Checked BEFORE the pitch is examined: what disqualifies the frame is when it
      // was taken, not what it happens to say.
      if (ownClick(ac.currentTime, ac.sampleRate)) { if (E2E) hook.gated++; return; }
      // ── A PITCH BELOW THE WINDOW'S OWN FLOOR IS NOT A PITCH ──────────────────────
      // Measured: this removes 40 of the 42 false readings a synthesized quiet office
      // produced in 400 frames, and it is the single largest win available here.
      //
      // The number is not a preference, it is a property of the window already chosen.
      // Praat documents the coupling: a pitch floor REQUIRES a window of three of its
      // longest periods, so a 2048-sample window at 48 kHz (42.7 ms) already declares a
      // floor of 3/0.0427 ≈ 70 Hz. Everything below that was outside the range the DSP
      // could support, and reporting it was the bug.
      //
      // WHY THE DETECTOR IS CONFIDENT DOWN THERE, which is why no clarity threshold can
      // replace this: the NSDF sums only W−τ terms, so at long lags the estimate is built
      // from fewer samples and its variance grows — and MPM then takes the MAXIMUM of that
      // noisier function. Measured on this detector: pure noise reaches clarity 0.983 at
      // 46 Hz, above any gate that would not also destroy real notes. And k is inert
      // there: a 46 Hz candidate has exactly ONE key maximum in the window, so
      // "first within 10% of the highest" has nothing to choose between.
      //
      // 62 and not 65: the floor must sit BELOW the lowest note supported, not on it.
      // Measured, a real C2 at 65.41 Hz keeps 78.5% of its frames at a 62 Hz floor, 65% at
      // 65, and 19.5% at 66 — a floor placed on the note eats the note.
      // THE COST, stated: this makes the tuner useless below B1. Bass guitar's open E
      // (41.2 Hz) and a 5-string's B0 are out of range now — honestly out, rather than
      // reported as the F♯1s that started this. Supporting them needs a longer window,
      // not a lower floor, because the floor and the window are one decision.
      if (f > 0 && f < TUNER_FMIN_HZ) { if (E2E) hook.belowFloor++; return; }
      if (f > 0) {
        recent.push(f);
        if (recent.length > MEDIAN_N) recent.shift();
        const sorted = [...recent].sort((a, b) => a - b);
        renderReading(sorted[Math.floor(sorted.length / 2)]);
      } else {
        recent.length = 0;
        renderSilence();
      }
    }, READ_MS);
  }

  // `remember=false` is the pagehide path: the mic must stop, but the reader did
  // not choose to stop — so the flag survives and the tuner resumes on return.
  function stopTuner(remember = true) {
    micRequest++; // invalidate any getUserMedia still waiting on the prompt
    if (remember) store.set('mt:tuneron', '0');
    if (tunerTimer !== null) { clearInterval(tunerTimer); tunerTimer = null; }
    micStream?.getTracks().forEach((t) => t.stop());
    micStream = null;
    analyser = null;
    recent.length = 0;
    quietFrames = 99;
    renderSilence();
    // `?.` AND NOT A GATE: stopTuner runs from `pagehide` on every route, and startTuner runs
    // from the DEALER's arpeggiator, which borrows this mic — so both reach here on a page with no
    // tuner markup. The audit found the sharper version of this: without the guard, startTuner
    // threw AFTER `getUserMedia` resolved and after `micStream` was assigned, leaving a live mic
    // with no wired stop button and a recording indicator for a control that does not exist.
    micBtn?.setAttribute('aria-label', 'start the tuner');
    micBtn?.setAttribute('aria-pressed', 'false');
    if (hintEl) hintEl.textContent = ''; // errors only — a stop clears any denial guidance
  }

  if (HAS_TUNER) micBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // inside .mt-mid, which is itself a start/stop target
    micStream ? stopTuner() : startTuner();
  });

  // THE FIGURE IS THE SWITCH TOO (annotations 2026-08-04: "a click/tap anywhere
  // around the tuner/metronome center should start/stop it"). The dial and the
  // pendulum are the biggest things on screen; making them the transport gives the
  // phone a target you cannot miss. The buttons remain — the figure is a shortcut,
  // not a replacement, and it is presentation-only markup so it stays aria-hidden
  // (the named buttons carry the accessible contract).
  document.getElementById('mt-dial')?.closest('.mt-mid')?.addEventListener('click', () => {
    micStream ? stopTuner() : startTuner();
  });

  // OPEN STARTED (user ask, 2026-08-03). Two conditions, both required: the tuner
  // was running when the reader left, AND the browser will grant the mic silently.
  // Never auto-start into a permission prompt — a dialog nobody asked for is the
  // hostile version of convenient. Chrome allows the AudioContext to run when
  // audio capture is active, so no gesture is needed once the stream is granted.
  // The metronome stays off on arrival: sound on load without a gesture is blocked
  // by autoplay policy, and would be wrong anyway.
  try {
    if (store.get('mt:tuneron') === '1' && navigator.permissions?.query) {
      navigator.permissions
        .query({ name: 'microphone' as PermissionName })
        .then((p) => { if (p.state === 'granted' && !micStream) startTuner(); })
        .catch(() => {});
    }
  } catch {}

  // ── the drone ─────────────────────────────────────────────────────────────
  // WAS THE REFERENCE TONE, and the change is more than a rename (chooser
  // metrotuner-drone-box): it has its own case now, so the verb it answers to is the
  // caption `start` under its own figure rather than `play tone` on the tuner's foot.
  // The engine is the same two-rank organ plus one new rank, the fifth.
  const toneBtn = $('mt-drone') as unknown as HTMLButtonElement;
  const droneCase = document.querySelector('.mt-drone') as HTMLElement;
  // THE FIGURE IS THE NOTE CONTROL — same element as `dNoteEl` now (the 72px letter), where
  // it used to be a separate small button on the foot line. Kept as two names because the two
  // ROLES are still distinct (one is the value's control, one is the case's figure) and the
  // code below reads better for it, but they resolve to one node: a single place to paint.
  const refNoteEl = $('mt-dnote');
  const dNoteEl = refNoteEl;        // the same node; see the note on refNoteEl
  // A3 IS THE DEFAULT (user, 2026-08-07: "can the default be a3"). 57, not A4's 69 — the
  // register a cello actually drones in, and the pitch of the samples' own A. A4 was inherited
  // from when this was the tuner's reference PIP, where concert A is the obvious default; a
  // drone you play against for twenty minutes is a different instrument with a different one.
  let refMidi = Number(store.get('mt:ref')) || 57;
  if (!Number.isInteger(refMidi) || refMidi < 36 || refMidi > 96) refMidi = 57;
  // ── THE STACK, AND THE VOICE ────────────────────────────────────────────────
  // Two changes from the single `fifth` latch, both from chooser `practice-room-drone-stack`
  // (picked 2026-08-07): the stack is every interval up to a major 10th, switched
  // independently (Q1/06 the chromatic strip, Q2/02 both qualities), and the VOICE is a
  // setting with three values rather than one hardcoded timbre (the user's refinement on
  // Q3: "i like 05 the section. but also the organ pair maybe it can be a setting?").
  //
  // `nameOf` and `nameInChord` are imported — see the note on the import. `el` builds one node
  // from markup so the strip's cells are written as markup rather than as six imperative
  // property assignments each.
  const el = (h: string) => {
    const t = document.createElement('template');
    t.innerHTML = h.trim();
    return t.content.firstElementChild as HTMLElement;
  };

  // WHICH DEGREES THE STACK CAN SWITCH, and the label the strip prints for each — semitones
  // up to a major 10th. Frequencies are NOT here: tuning.ts derives them per named system.
  const JUST: Record<number, { d: string }> = {
    1:  { d: '♭2' },  2:  { d: '2'  },  3:  { d: '♭3' },  4:  { d: '3'  },
    5:  { d: '4'  },  6:  { d: '♯4' },  7:  { d: '5'  },  8:  { d: '♭6' },
    9:  { d: '6'  },  10: { d: '♭7' },  11: { d: '7'  },  12: { d: '8'  },
    13: { d: '♭9' },  14: { d: '9'  },  15: { d: '♭10'},  16: { d: '10' },
  };
  const SEMIS = Object.keys(JUST).map(Number).sort((a, b) => a - b);   // 1..16

  // THE STACK'S STATE, persisted like every other set-once value here: a semitone set.
  // Stored as a comma list rather than a bitmask so a stale localStorage value from a
  // future version is readable and a bad one is discardable member by member.
  const stack = new Set<number>();

  // WHICH SYSTEM IS SOUNDING. Persisted like every other set-once value here, and validated
  // on read: an id from a future version, or a typo, falls back to the default rather than
  // throwing inside the audio path.
  let tuningId = DEFAULT_TUNING_ID;
  {
    const saved = store.get('mt:tuning');
    if (saved && TUNINGS.some((t) => t.id === saved)) tuningId = saved;
  }
  (store.get('mt:stack') ?? '7').split(',').forEach((t) => {
    const n = Number(t);
    if (Number.isInteger(n) && JUST[n]) stack.add(n);
  });

  // THE VOICE. `section` is the default because it is what the chooser's sound question was
  // asking about and what a drone is for; `organ` is the two-rank pair that shipped before
  // and is kept, per the user, as a setting rather than deleted.
  type Voice = 'organ' | 'cello' | 'section';
  const VOICES_D: Voice[] = ['organ', 'cello', 'section'];
  let voice: Voice = (store.get('mt:voice') as Voice) ?? 'section';
  if (!VOICES_D.includes(voice)) voice = 'section';
  const voiceWrap = $('mt-voice');
  const stripEl = $('mt-strip');
  const chordEl = $('mt-chord');

  // THE SOUNDING GRAPH. `droneNodes` is everything started (so stop() can reach it) and
  // `rankHz` holds only the intended pitch per rank — the e2e hook reads ratios off that,
  // and a partial or a bow-noise source in the list would corrupt it.
  let toneGain: GainNode | null = null;
  let droneNodes: AudioScheduledSourceNode[] = [];
  let rankHz: number[] = [];                   // one entry per SOUNDING NOTE, in pitch order
  let droneWet: GainNode | null = null;
  let sampleDebug: { want: number; sample: string; srcHz: number; rate: number; sounds: number }[] = [];

  // ONE function writes every place the drone's note appears: the scrub control, the
  // 72px figure and the exact reading. Three copies of one value is three chances to
  // drift, and the figure is the one a reader trusts from across the room.
  // ONE PLACE, ONE VALUE (user, 2026-08-07: "can you not repeat a3 3 times"). This wrote the
  // note to two elements at two precisions — the figure got the bare letter, the foot control
  // got letter+octave. Both are now the same node, so writing twice would have the second
  // write silently win: the figure would have shown `A` where the label promised `A3`.
  // THE FIGURE CARRIES THE OCTAVE. `A` alone cannot be acted on — a cellist tuning to a drone
  // needs to know which A — and now that the figure is also the control, the thing you drag
  // has to state the value you are setting.
  function refLabel() {
    // the 72px letter IS the drone's figure, so there is nothing to label without that case
    if (refNoteEl) refNoteEl.textContent = nameOf(refMidi);
  }
  refLabel();

  // ── THE STRIP IS BUILT ONCE AND PAINTED, never re-rendered. A cell is a toggle whose
  // state is an attribute; rebuilding the row on every click would drop focus mid-stack and
  // is the sort of thing that makes a keyboard user's place vanish.
  // THE ROOT CELL IS NOT A BUTTON: the root always sounds, so a control that cannot be
  // switched must not look switchable (the same rule the ledger's root row obeys).
  function buildStrip() {
    if (!stripEl) return;
    stripEl.appendChild(el('<span class="mt-cell mt-cell-root" aria-hidden="true"></span>'));
    SEMIS.forEach((n) => {
      const b = el(`<button type="button" class="mt-cell" data-semi="${n}" data-testid="semi-${n}"
        aria-pressed="false"></button>`) as HTMLButtonElement;
      stripEl.appendChild(b);
    });
    // ── THE MARKS NAME THE LANDMARKS, they do not count cells ──────────────────────
    // They used to fall on every 5th cell — 0, 5, 10, 15 — which is a counting grid and
    // musically arbitrary. The user's question was the whole review: "what do the lil vertical
    // lines under notes mean?" A mark whose meaning has to be asked is not doing its job, and
    // the honest reading is that it had none: position 5 is a fourth, position 10 a minor
    // seventh, position 15 a minor tenth — no set a player thinks in.
    // NOW THEY MARK THE PERFECT INTERVALS the user named: the 4th, the 5th and the octave (and
    // the octave above that, 12 + 4 and 12 + 7 being the compound 11th and 12th). Those are the
    // consonances a string player tunes without deciding anything — the same three the chooser's
    // option 05 was built from — so the strip now reads as a fingerboard rather than a ruler:
    // you find the fifth by looking, not by counting seven cells.
    // ONE MARK IS TALLER: the octave. It is the strongest landmark on the strip and the one
    // that halves it, so it gets a longer stroke — the same hierarchy the metronome's beats rule
    // draws with its downbeat tick.
    const LANDMARKS: Record<number, 'octave' | 'perfect'> = {
      5: 'perfect', 7: 'perfect', 12: 'octave', 17: 'perfect', 19: 'perfect',
    };
    const MARK_NAME: Record<number, string> = {
      5: 'the fourth', 7: 'the fifth', 12: 'the octave',
    };
    const sc = el('<span class="mt-scale"></span>');
    for (let i = 0; i <= 16; i++) {
      const kind = LANDMARKS[i];
      const t = MARK_NAME[i];
      sc.appendChild(el(`<i class="${kind ? 'tk-' + kind : ''}"${t ? ` title="${t}"` : ''}></i>`));
    }
    stripEl.parentElement?.insertBefore(sc, stripEl.nextSibling);
  }

  // ONE FUNCTION PAINTS THE WHOLE STACK: the cells' state, their labels, and the chord
  // readout. The labels carry the NAMES the strip's geometry drops — `5 — E3`, so nothing has
  // to be counted — and they must be rewritten when the root moves, not only when a cell is
  // clicked, or the strip announces intervals above a note that is no longer the root.
  // EVERY NAME HERE IS AN INTERVAL ABOVE THE ROOT, so it goes through `nameInChord` and not
  // `nameOf` (user, 2026-08-07: "E♭4 F♯4 should actually read like eb gb, so for chords can u
  // spell based on the implied key of the root?"). The root itself has no context above it, so
  // it keeps the context-free spelling — which is what the user asked for too: "the root notes
  // are fine spelled this way".
  function paintStack() {
    const names: string[] = [nameOf(refMidi)];
    stripEl?.querySelectorAll<HTMLButtonElement>('[data-semi]').forEach((b) => {
      const n = Number(b.dataset.semi);
      const on = stack.has(n);
      const nm = nameInChord(refMidi, n);
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('on', on);
      b.setAttribute('aria-label', `${JUST[n].d} — ${nm}`);
      b.title = `${JUST[n].d}  ${nm}`;
      if (on) names.push(nm);
    });
    // THE CHORD IS THE STRIP'S CAPTION — what is sounding, by name, in pitch order. It says
    // the one thing the 72px letter cannot: the rest of the notes. (The exact reading deleted
    // from the read row stated the root a third time; this does not.)
    // THE SEPARATOR IS GONE, and that is the fix rather than a third attempt at placing it.
    // A wrapping list cannot keep an interpunct tidy: `' · '` broke AFTER the dot
    // (`A4 · C5 ·` / `E5 · C♯6`), binding it forward broke BEFORE it (`· E5 · C♯6`), and
    // binding it back still left a dot at the end of line one. Three placements, three
    // dangling marks — the mark itself was the problem.
    // In a monospace face at this size the space IS the separator: `A4 C5 E5 C♯6` reads as a
    // list with nothing to dangle, at any wrap point. (The foot's page words keep their dots
    // because that row never wraps — one line, three fixed words.)
    if (chordEl) chordEl.textContent = names.join('  ');
  }

  function paintVoice() {
    voiceWrap?.querySelectorAll<HTMLButtonElement>('[data-voice]').forEach((b) => {
      const on = b.dataset.voice === voice;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('on', on);
    });
  }
  // ── THE TUNING COMPARER'S BEHAVIOUR ───────────────────────────────────────────────
  // Buttons are BUILT FROM THE REGISTRY, not typed here, so adding a system to tuning.ts
  // adds it to the comparer and there is no second list to forget.
  const tuneWrap = $('mt-tune');
  const tuneBtns = $('mt-tune-btns');
  const tuneBeat = $('mt-tune-beat');

  // THE COMPARER'S BUTTONS ARE THE DRONE'S. Building them on a route without it appended into
  // nothing and threw on the first `appendChild`, which cost the whole rest of the script.
  if (HAS_DRONE) TUNINGS.forEach((t) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'vbtn';                      // the voice row's own control vocabulary
    b.dataset.tuning = t.id;
    b.dataset.testid = `tuning-${t.id}`;
    b.setAttribute('data-testid', `tuning-${t.id}`);
    // The cost is on the TITLE rather than on screen: five costs printed at once is an
    // essay, and this row has to stay a row.
    b.title = `${t.mechanism}\n\nCost: ${t.cost}`;
    b.textContent = t.name.replace(/^just, /, '');   // "stack-relative", not "just, stack-…"
    tuneBtns.appendChild(b);
  });

  // THE BEAT RATE IS COMPUTED FROM WHAT IS SOUNDING, every repaint — the whole point of a
  // comparer is that the number moves when the choice does. Worst pair in the stack, because
  // one bad interval is what you hear.
  function paintTuning() {
    if (!HAS_DRONE) return;
    tuneBtns.querySelectorAll<HTMLButtonElement>('[data-tuning]').forEach((b) => {
      const on = b.dataset.tuning === tuningId;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('on', on);
    });
    const hz = stackHz();
    let worst = 0;
    for (let i = 0; i < hz.length; i++) {
      for (let j = i + 1; j < hz.length; j++) worst = Math.max(worst, beatRate(hz[i], hz[j]));
    }
    // LOWERCASE `hz`, because this is a control label and the page's rule is that every
    // `.mt-lb` is lowercase — asserted in accent.spec, which caught "0.00 Hz" here. The a4
    // field beside it already writes `hz` for the same reason, so the SI capital would have
    // been the odd one out on its own row as well as a test failure.
    tuneBeat.textContent = hz.length < 2
      ? 'add a note to compare'
      : `worst beat ${worst.toFixed(2)} hz`;
  }

  if (HAS_DRONE) tuneBtns.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tuning]');
    if (!b) return;
    tuningId = b.dataset.tuning!;
    store.set('mt:tuning', tuningId);
    paintTuning();
    // Re-voice a SOUNDING drone in place, so the comparison happens under the note you are
    // holding rather than after a stop and a start. `retune()` no-ops when silent.
    retune();
  });

  // ── ONE TOGGLE, TWO WAYS IN. `set` on the drone's foot line is the way anyone finds it (his
  // pick: "hide really complicated settings like drone intonation behind a set type control"); ⌥T
  // stays because it was the way in for a week, it is in the site's own vocabulary beside ⌥G, and
  // deleting a shortcut someone may have learned buys nothing. Both call the same function, so the
  // word's `aria-expanded` and the panel's `hidden` cannot disagree — which they would the first
  // time one path was updated and the other was not.
  const setBtn = document.getElementById('mt-set') as HTMLButtonElement | null;
  const setBack = document.getElementById('mt-set-back') as HTMLButtonElement | null;
  function showTuning(open: boolean) {
    if (!tuneWrap) return;
    tuneWrap.hidden = !open;
    setBtn?.setAttribute('aria-expanded', String(open));
    // THREE THINGS, ONE FUNCTION: the panel, the word that opens it, the arrow that leaves it. `set`
    // goes away while you are inside, because a control that opens what you are already in is a
    // control doing nothing. Every path — the word, the arrow, ⌥T — comes through here, for the
    // reason the two-path version needed asserting: one of them always gets updated and the other
    // does not.
    if (setBtn) setBtn.hidden = open;
    if (setBack) setBack.hidden = !open;
    if (open) paintTuning();
  }
  setBtn?.addEventListener('click', (e) => {
    e.stopPropagation();   // the rail sits inside no click-to-start target, but the strip does
    showTuning(!!tuneWrap?.hidden);
  });
  setBack?.addEventListener('click', (e) => { e.stopPropagation(); showTuning(false); });

  // ⌥T matches ⌥G's grid overlay: the same modifier, the same "off until someone who knows asks".
  // Skips inputs so typing a4 in the calibration field cannot toggle it.
  window.addEventListener('keydown', (e) => {
    if (!e.altKey || e.metaKey || e.ctrlKey) return;
    if ((e.key || '').toLowerCase() !== 't') return;
    const el = document.activeElement as HTMLElement | null;
    if (el && /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
    if (!tuneWrap) return;   // the comparer is the drone's; ⌥T is a window listener on every route
    e.preventDefault();
    showTuning(!!tuneWrap.hidden);
  });

  buildStrip();
  paintStack();
  paintVoice();
  paintTuning();

  // THE FIGURE IS THE CONTROL (user, 2026-08-07). One element, four inputs:
  // horizontal drag scrubs · click +1 · shift-click −1 · ArrowUp/Down when focused. A drag
  // suppresses the click that follows it (pointerup fires click), else every scrub also steps.
  //
  // 14px PER SEMITONE, not the 8px the small foot control used. The gesture moved onto a 72px
  // glyph, and a target that big invites a bigger sweep: at 8px a casual drag across the letter
  // crossed nine semitones, which is uncontrollable. 14px puts the case's full 156px of width at
  // about eleven semitones — a range you can land on a note inside. The other scrub handles keep
  // their own numbers; this one's is set by the size of the thing you are dragging.
  //
  // AND IT MUST NOT START THE DRONE. The figure sits inside `.mt-mid`, which is itself a
  // click-to-start target (the same shortcut the dial and the pendulum carry). Without
  // stopPropagation every pitch step would also toggle the sound — the exact double-fire the
  // caption latch already guards against. `pointerdown` is stopped too, or a drag on the letter
  // would start the drone before the drag was even recognised as a drag.
  if (HAS_DRONE) {
    let dragX: number | null = null;
    let dragStart = 0;
    let dragged = false;
    refNoteEl.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      dragX = e.clientX; dragStart = refMidi; dragged = false;
      refNoteEl.classList.add('scrubbing');
      (refNoteEl as HTMLElement).setPointerCapture(e.pointerId);
    });
    refNoteEl.addEventListener('pointermove', (e) => {
      if (dragX === null) return;
      const d = Math.round((e.clientX - dragX) / 14);
      if (d !== 0) dragged = true;
      const m = Math.min(96, Math.max(36, dragStart + d));
      if (m !== refMidi) {
        refMidi = m; store.set('mt:ref', String(refMidi)); refLabel(); paintStack();
        if (droning()) retune();
      }
    });
    refNoteEl.addEventListener('pointerup', () => { dragX = null; refNoteEl.classList.remove('scrubbing'); });
    refNoteEl.addEventListener('click', (e) => {
      e.stopPropagation();                 // `.mt-mid` is a start/stop target — see above
      if (dragged) { dragged = false; return; }
      stepRef(e.shiftKey ? -1 : 1);
    });
    refNoteEl.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') { e.preventDefault(); stepRef(1); }
      if (e.key === 'ArrowDown') { e.preventDefault(); stepRef(-1); }
    });
  }

  // ── THE CELLO SAMPLES, fetched ONCE and only if wanted ──────────────────────
  // A cello SECTION playing sustained vibrato (VSCO-2 Community Edition, CC0), looped with
  // an equal-power crossfade — see scripts/build-cello-samples.py for the recipe and why a
  // section beats a soloist (many players' vibrato beating against each other is most of
  // what makes a cello drone lush).
  // LAZY, AND THAT IS THE POINT: 258 kB must not land on every visitor who opens the tuner.
  // It is fetched on the first press of a cello voice, so the default page weight is
  // unchanged and a tuner-only user never pays for it.
  // RAW int16 IN ONE BLOB, not three wavs and not decodeAudioData: one request, no header
  // parsing, and no async decode — a decode would make the first press arrive late, and
  // "the drone starts a beat after you press it" reads as a broken instrument.
  type Cello = { rate: number; bufs: { midi: number; cents: number; name: string; buf: AudioBuffer }[] };
  let cello: Cello | null = null;
  let celloLoad: Promise<Cello | null> | null = null;
  function loadCello(): Promise<Cello | null> {
    if (celloLoad) return celloLoad;
    const base = '/practice-room';
    celloLoad = (async () => {
      try {
        const [meta, bin] = await Promise.all([
          fetch(`${base}/cello.json`).then((r) => r.json()),
          fetch(`${base}/cello.bin`).then((r) => r.arrayBuffer()),
        ]);
        const ac = audio();
        const bufs = meta.notes.map(
          (n: { midi: number; cents?: number; name: string; byteOffset: number; frames: number }) => {
            const pcm = new Int16Array(bin, n.byteOffset, n.frames);
            const buf = ac.createBuffer(1, n.frames, meta.rate);
            const d = buf.getChannelData(0);
            for (let i = 0; i < n.frames; i++) d[i] = pcm[i] / 32768;
            return { midi: n.midi, cents: n.cents ?? 0, name: n.name, buf };
          });
        cello = { rate: meta.rate, bufs };
        return cello;
      } catch {
        // A FAILED FETCH FALLS BACK TO THE ORGAN rather than going silent. A drone that makes
        // no sound because a file 404'd is indistinguishable from a broken button.
        return null;
      }
    })();
    return celloLoad;
  }
  // Pick the sample needing the SMALLEST shift, counting whole octaves as free: minimise
  // |target − (sample + 12k)|. Three samples a fifth apart then keep every pitch within 3
  // semitones of a real recording, and the remaining distance is octaves — which a sustained
  // bowed string tolerates and a 5-semitone stretch does not.
  function nearestSample(midi: number) {
    let best = cello!.bufs[0], bestD = Infinity;
    for (const c of cello!.bufs) {
      const k = Math.round((midi - c.midi) / 12);
      const d = Math.abs(midi - (c.midi + 12 * k));
      if (d < bestD) { bestD = d; best = c; }
    }
    return best;
  }

  // A HALL, SYNTHESISED: exponentially decaying noise through a one-pole lowpass. No impulse
  // file (that would be another 300 kB for a thing ten lines can do). The lowpass is what
  // stops it sounding like a spring — a real room absorbs treble faster than bass.
  let hallIR: AudioBuffer | null = null;
  function hall() {
    if (hallIR) return hallIR;
    const ac = audio();
    const n = Math.floor(ac.sampleRate * 2.6);
    hallIR = ac.createBuffer(2, n, ac.sampleRate);
    for (let ch = 0; ch < 2; ch++) {
      const d = hallIR.getChannelData(ch);
      for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, 2.4);
      let y = 0;
      for (let i = 0; i < n; i++) { y += 0.42 * (d[i] - y); d[i] = y; }
    }
    return hallIR;
  }

  // ── THE THREE VOICES. Each builds ONE note at a given frequency and level onto `out`,
  // and returns the nodes it started. The stack calls one of these per sounding note.
  //
  // A bowed cello's partial amplitudes, roughly — NOT 1/n, which is a sawtooth and reads as
  // a buzz. A cello dips at the 2nd partial and bumps around the 3rd-5th, and that bump is
  // most of what makes an ear say "cello" instead of "organ".
  const CELLO_PARTIALS = [1, 0.42, 0.62, 0.48, 0.35, 0.19, 0.14, 0.09, 0.06, 0.04];
  function voiceOrgan(f: number, lvl: number, out: GainNode) {
    // THE ORGAN PAIR, unchanged from what shipped: fundamental plus one octave at −12 dB.
    const ac = audio();
    const out2: OscillatorNode[] = [];
    for (const [mult, amp] of [[1, 1], [2, 0.25]] as const) {
      const o = ac.createOscillator();
      o.type = 'sine';
      o.frequency.value = f * mult;
      const g = ac.createGain();
      g.gain.value = lvl * amp;
      o.connect(g).connect(out);
      o.start();
      out2.push(o);
    }
    return out2;
  }
  function voiceCello(f: number, lvl: number, out: GainNode) {
    // ADDITIVE, with each rank detuned and vibrating at its own rate so the ranks DRIFT.
    // Ranks locked in phase are exactly what makes additive synthesis sound like a church
    // organ rather than a string.
    const ac = audio();
    const nodes: AudioScheduledSourceNode[] = [];
    CELLO_PARTIALS.forEach((amp, i) => {
      const h = i + 1;
      if (f * h > 12000) return;
      const o = ac.createOscillator();
      o.type = 'sine';
      o.frequency.value = f * h;
      o.detune.value = (i % 2 ? 1 : -1) * (1.5 + i * 0.4);
      const g = ac.createGain();
      g.gain.value = lvl * amp * 0.5;
      o.connect(g).connect(out);
      const lfo = ac.createOscillator();
      lfo.frequency.value = 4.5 + i * 0.11;
      const la = ac.createGain();
      la.gain.value = 9 + i * 0.7;          // cents
      lfo.connect(la).connect(o.detune);
      lfo.start();
      o.start();
      nodes.push(o, lfo);
    });
    return nodes;
  }
  function voiceSection(f: number, lvl: number, out: GainNode) {
    // THREE SAMPLED SOURCES PER NOTE, and all three differences matter: the DETUNE stops
    // them being one player at three volumes, the loop OFFSET decorrelates their vibrato
    // (the same recording started at the same place three times is just one player louder),
    // and the PAN gives the beating somewhere to happen.
    const ac = audio();
    const nodes: AudioScheduledSourceNode[] = [];
    const midi = 69 + 12 * Math.log2(f / a4);
    const s = nearestSample(midi);
    for (const [cents, offset, pan] of [[-5, 0.02, -0.55], [0, 0.71, 0.1], [4, 1.33, 0.6]] as const) {
      const src = ac.createBufferSource();
      src.buffer = s.buf;
      src.loop = true;
      // playbackRate FROM THE FREQUENCY RATIO, never from a semitone count: the intervals
      // are just, so the target is root × 5/4 and not root × 2^(4/12). A rate derived from
      // semitones would quietly temper the whole stack.
      // THE RECORDING'S OWN DETUNE IS DIVIDED OUT. `s.cents` is how far this loop sits from the
      // note it is named — measured on every build (see build-cello-samples.py), and for the B3
      // sample it is −27.5¢, a quarter of a semitone flat. Without this the drone inherits the
      // players' tuning on the day, and a drone a player TUNES TO cannot be a quarter-semitone
      // off: the spread of the recording must not become the pitch of the instrument.
      // Dividing the ratio (rather than adding to `detune`) keeps the correction in the same
      // place as the pitch it corrects, so a sample and its offset cannot be applied apart.
      const srcHz = midiToFreq(s.midi, a4) * Math.pow(2, (s.cents || 0) / 1200);
      src.playbackRate.value = f / srcHz;
      if (E2E) sampleDebug.push({ want: f, sample: s.name, srcHz, rate: src.playbackRate.value,
                                  sounds: srcHz * src.playbackRate.value });
      if (src.detune) src.detune.value = cents;
      const g = ac.createGain();
      g.gain.value = lvl * 0.55;
      if (ac.createStereoPanner) {
        const p = ac.createStereoPanner();
        p.pan.value = pan;
        src.connect(g).connect(p).connect(out);
      } else {
        src.connect(g).connect(out);
      }
      src.start(ac.currentTime, offset);
      nodes.push(src);
    }
    return nodes;
  }

  // The voice actually usable right now: `section` needs its samples, and until they arrive
  // (or if they never do) the organ stands in. Stated as one function so no caller has to
  // remember the fallback.
  function activeVoice(): Voice {
    if (voice === 'section' && !cello) return 'organ';
    return voice;
  }

  // EVERY SOUNDING PITCH, in order: the root always, plus each switched interval as a JUST
  // ratio of it. One function, so the audio and the readout cannot disagree about what is on.
  // THE TUNING SYSTEM IS SWITCHABLE (2026-08-07). The ratios above were correct and stay
  // as the interval NAMES — `JUST[n].d` is what the strip prints. What moved is how the
  // FREQUENCY is derived: `src/lib/practice-room/tuning.ts` holds five named systems, each
  // with its ratios and its cost written down, and the default is now `just-chain` — sheet
  // option 07, "just, stack-relative", picked by ear off a playable proof sheet
  // (work/understand/practice-room-thirds/).
  //
  // WHAT CHANGED AUDIBLY, and it is deliberately almost nothing: for a triad, chain-relative
  // and root-relative are IDENTICAL (root × 5:4 is the third, and that × 6:5 is 3:2, the
  // same fifth — asserted in tests/unit/tuning.test.ts). The two part company only in
  // stacks of four and up, which is exactly where root-relative leaves 41-cent wolves
  // BETWEEN upper members while every note is perfect against the root. A major third under
  // a minor sixth was 32:25 apart — 427 cents where a just third is 386. Now it is 5:4.
  function stackHz() {
    const f0 = midiToFreq(refMidi, a4);
    const on = SEMIS.filter((n) => stack.has(n));
    const t = getTuning(tuningId);
    return [f0, ...on.map((n) => t.hz(f0, n, on))];
  }

  // ONE function owns the hook's copy of what is sounding.
  function publishRanks() {
    if (!E2E) return;
    hook.toneHz = toneGain ? rankHz[0] : null;
  }

  // A retune REBUILDS rather than sliding every node's frequency: with three voices and up
  // to seventeen notes, "set the frequency of the right node" is a different operation per
  // voice (an oscillator's `frequency` vs a buffer's `playbackRate`), and a sampled note
  // cannot be retuned without a rate change anyway. The rebuild crossfades, so it is not
  // audible as a gap — see revoice().
  function retune() {
    if (!toneGain) { publishRanks(); return; }
    revoice();
  }

  function startTone(attackSec?: number) {
    const ac = audio();
    const v = activeVoice();
    // The samples are fetched on the first press of a cello voice; when they land, re-voice
    // so the note the user asked for is what they end up hearing.
    // Same hazard as the voice selector's (see the note there): only re-voice if the samples
    // were NOT already in hand, or a cached load resolves into a stack that is already correct
    // and rebuilds it for nothing — which is how two stacks end up overlapping.
    if (voice === 'section' && !cello) {
      loadCello().then((c) => { if (c && toneGain && activeVoice() !== 'section') revoice(); });
    }

    toneGain = ac.createGain();
    toneGain.gain.setValueAtTime(0.0001, ac.currentTime);

    // THE SECTION GOES THROUGH A HALL, the other two do not. The reverb is what makes a
    // sampled section sound like a room rather than a sample, and it is wrong on the organ
    // (a reference pitch wants to be dry).
    if (v === 'section') {
      const conv = ac.createConvolver();
      conv.buffer = hall();
      droneWet = ac.createGain();
      droneWet.gain.value = 0.6;
      const dry = ac.createGain();
      dry.gain.value = 0.72;
      toneGain.connect(dry).connect(ac.destination);
      toneGain.connect(conv).connect(droneWet).connect(ac.destination);
    } else {
      toneGain.connect(ac.destination);
    }

    if (E2E) sampleDebug = [];
    rankHz = stackHz();
    // LEVEL FALLS AS 1/√n, not 1/n. Decorrelated voices sum in POWER, so 1/n makes a full
    // stack quieter than a single note and 1/1 clips it. Measured on the chooser's analyser
    // across every voice with all sixteen intervals on.
    const base = v === 'organ' ? 0.22 : v === 'cello' ? 0.26 : 0.38;
    const lvl = base / Math.sqrt(rankHz.length);
    const build = v === 'organ' ? voiceOrgan : v === 'cello' ? voiceCello : voiceSection;
    droneNodes = [];
    rankHz.forEach((f) => { droneNodes = droneNodes.concat(build(f, lvl, toneGain!)); });

    // A BOW TAKES TIME, and how long depends on the voice: a section swells, an organ does
    // not. Exponential rather than linear because loudness is logarithmic — a linear fade-in
    // on a drone sounds like it arrives at once and then waits.
    const atk = attackSec ?? (v === 'section' ? 1.2 : v === 'cello' ? 0.3 : 0.06);
    toneGain.gain.exponentialRampToValueAtTime(v === 'organ' ? 0.12 : 0.95, ac.currentTime + atk);

    toneBtn.setAttribute('aria-pressed', 'true');
    toneBtn.setAttribute('aria-label', 'stop the drone');
    // The figure carries the running state (the letter goes accent) — the drone's one
    // state, and the only thing on this screen the accent means here.
    if (droneCase) droneCase.dataset.sounding = 'true';
    publishRanks();
  }

  // RE-VOICE WITHOUT A HOLE. A cell toggled mid-drone changes the chord, and stopping and
  // restarting would leave a gap plus a fresh 1.2 s swell — which would make the strip feel
  // broken to use. The old stack fades over 50 ms while the new one comes up over 90, so the
  // change is heard as the chord moving rather than as the drone restarting.
  let revoicing = false;
  function revoice() {
    if (!toneGain) return;
    // NOT RE-ENTRANT. Two revoices in the same tick each capture `droneNodes`, but the second
    // captures what the first's `startTone()` already replaced — so the first stack's sources
    // never get stopped and two chords sound at once. The flag is belt-and-braces next to the
    // caller fixes above: any future path that manages to call this twice fails safe.
    if (revoicing) return;
    revoicing = true;
    const ac = audio();
    const old = toneGain;
    const oldNodes = droneNodes;
    old.gain.cancelScheduledValues(ac.currentTime);
    old.gain.setTargetAtTime(0.0001, ac.currentTime, 0.05);
    oldNodes.forEach((o) => { try { o.stop(ac.currentTime + 0.4); } catch {} });
    setTimeout(() => { try { old.disconnect(); } catch {} }, 700);
    toneGain = null;
    startTone(0.09);
    revoicing = false;
  }

  function stopTone() {
    if (!toneGain) return;
    const ac = audio();
    // GATE FIRST, THEN STOP. The gain ramps down over ~30 ms and every source is stopped a
    // fifth of a second later, so a stack of up to fifty nodes releases together instead of
    // cutting — a hard stop on seventeen sampled notes is an audible thump.
    toneGain.gain.cancelScheduledValues(ac.currentTime);
    toneGain.gain.setTargetAtTime(0.0001, ac.currentTime, 0.03);
    droneNodes.forEach((o) => { try { o.stop(ac.currentTime + 0.25); } catch {} });
    const dead = toneGain;
    setTimeout(() => { try { dead.disconnect(); } catch {} }, 600);
    droneNodes = [];
    rankHz = [];
    toneGain = null;
    droneWet = null;
    toneBtn.setAttribute('aria-pressed', 'false');
    toneBtn.setAttribute('aria-label', 'start the drone');
    if (droneCase) delete droneCase.dataset.sounding;
    if (E2E) hook.toneHz = null;
  }

  // `toneGain` IS THE RUNNING FLAG. The section voice starts no oscillators at all — it is
  // buffer sources — so an oscillator-handle test would have read "not running" while a
  // cello section was sounding, and the transport would have started a second stack on top.
  // NAMED `droning`, not `sounding`: this file already has a `sounding[]` — the bleed gate's
  // list of spans the speaker was busy in (round 21) — and the build caught the collision.
  function droning() { return !!toneGain; }

  if (HAS_DRONE) toneBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // inside .mt-mid, which is itself a start/stop target
    droning() ? stopTone() : startTone();
  });

  // THE FIGURE IS THE SWITCH HERE TOO — the same shortcut the dial and the pendulum
  // carry, so all three cases answer a tap in the middle. The foot line's controls sit
  // OUTSIDE `.mt-mid`, so they cannot double-fire through it; the caption latch is inside
  // it and stops propagation, exactly as the other two cases' do.
  // THE MIDDLE IS STILL THE SWITCH, but the FIGURE inside it is no longer part of that target:
  // the letter is the pitch control now, and its own handlers stopPropagation so a step or a
  // drag cannot toggle the sound. What is left of `.mt-mid` — the air around the letter — keeps
  // answering a tap, which is the shortcut the dial and the pendulum also carry.
  droneCase?.querySelector('.mt-mid')?.addEventListener('click', () => {
    droning() ? stopTone() : startTone();
  });

  // ── THE STRIP'S CLICKS, delegated on the row. One listener for sixteen cells, and it
  // re-voices a sounding drone rather than restarting it: toggling an interval must change
  // the chord you are hearing, in place.
  stripEl?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-semi]');
    if (!b) return;
    e.stopPropagation();
    const n = Number(b.dataset.semi);
    stack.has(n) ? stack.delete(n) : stack.add(n);
    store.set('mt:stack', [...stack].sort((x, y) => x - y).join(','));
    paintStack();
    if (droning()) revoice();
  });

  // ── THE VOICE SELECTOR. Changing voice mid-drone re-voices, which is the whole point of
  // it being a setting: you compare the organ against the section by clicking between them
  // while the same chord sounds.
  voiceWrap?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-voice]');
    if (!b) return;
    e.stopPropagation();
    voice = b.dataset.voice as Voice;
    store.set('mt:voice', voice);
    paintVoice();
    // ── ONE REVOICE PER SWITCH, and this was a real bug: TWO overlapping stacks.
    // It read `loadCello().then(revoice)` AND `revoice()` — so switching to a cello voice
    // re-voiced twice, and when the samples were already cached the promise resolved on the
    // NEXT microtask, i.e. between the synchronous revoice's `startTone()` and its scheduled
    // node stops. `startTone()` reassigns `droneNodes`, so the second revoice took the fade of
    // the list the first one had just replaced and left the first stack's sources running.
    // MEASURED, on the live page: `cello → section` read 440.21 Hz where A3 is 220 — the cello
    // voice's octave partial still sounding over the section's fundamental, which reads as a
    // perfect octave. `organ → section` was clean, and so was a fresh page, which is why the
    // sequence mattered and a single-voice test never caught it.
    // The samples are needed before a cello voice can sound as itself, so the await comes
    // FIRST and there is exactly one revoice after it. `loadCello()` is memoised, so a
    // second switch costs nothing.
    if (!droning()) {
      if (voice !== 'organ') loadCello();          // warm it for the next start
      return;
    }
    if (voice === 'organ' || cello) revoice();
    else loadCello().then(() => { if (droning()) revoice(); });
  });

  const stepRef = (d: number) => {
    refMidi = Math.min(96, Math.max(36, refMidi + d)); // C2..C7
    store.set('mt:ref', String(refMidi));
    refLabel();
    paintStack();          // the strip's labels name intervals ABOVE THE ROOT — they move with it
    if (droning()) retune();
  };


  // ── metronome ─────────────────────────────────────────────────────────────
  const runBtn = $('mt-run') as unknown as HTMLButtonElement;
  const bpmInput = $('mt-bpm') as unknown as HTMLInputElement;
  const pend = document.getElementById('mt-pend')!;

  // Persisted values are VALIDATED, not trusted: localStorage outlives the code
  // that wrote it.
  let bpm = clampBpm(Number(store.get('mt:bpm')) || 96);
  let beatsPerBar = Number(store.get('mt:beats'));
  if (!Number.isInteger(beatsPerBar) || beatsPerBar < 1 || beatsPerBar > 7) beatsPerBar = 4;
  // Subdivision runs 1–7 now (the string device made septuplets free — the engine's
  // tickAt never had a ceiling; only the old four-glyph selector did).
  let subdivision = Number(store.get('mt:sub'));
  if (!Number.isInteger(subdivision) || subdivision < 1 || subdivision > 7) subdivision = 1;
  if (HAS_METRO) bpmInput.value = String(bpm);   // the field is this case's

  // THE VOICES. Three sine pings — G6 opens the bar, C6 marks the beat, G5 sits
  // under the subdivisions at half the level.
  const VOICES = {
    down: { freq: 1568.0, gain: 0.5, dur: 0.09 },
    beat: { freq: 1046.5, gain: 0.4, dur: 0.07 },
    sub:  { freq: 784.0,  gain: 0.18, dur: 0.05 },
  } as const;

  const pending: Tick[] = [];

  // THE ACCENT SETTING. Off, the downbeat is demoted to an ordinary beat — in the
  // click voice AND in the strike weight — one flag read at the two places the
  // downbeat is special, so sound and drawing can't disagree.
  let accentOn = store.get('mt:accent') !== '0';
  // THE RULE IS THE SWITCH (round15 Q1/06): #mt-accent wraps the beats rule; its
  // state is drawn BY the rule — the downbeat tick's height and the digit 1's
  // weight. restoreBeats (defined with the meters, below) reads accentOn; clicks
  // happen long after evaluation, so the forward reference is safe.
  // TWO TARGETS, ONE STATE ("i want to control the accent by clicking it"). The mark
  // shipped as a bare <svg>: the state was drawn where the eye goes while the control
  // was the rule below it, so the one thing that looks like the accent was the one
  // thing that did not toggle it. Both are buttons now and both drive `accentOn`.
  //
  // An ARRAY, not two handlers. Two copies of "flip the flag, persist it, repaint"
  // is how the two targets would drift out of agreement — one of them getting a
  // fix the other doesn't is the shape of that bug.
  const accBtns = [$('mt-acc'), $('mt-accent')] as unknown as HTMLButtonElement[];
  /** The two ruled segments' repaint handles, assigned by the metronome's wiring block below. */
  let restoreBeats: (v: number) => void = () => {};
  let restoreSub: (v: number) => void = () => {};
  function paintAccent() {
    if (!HAS_METRO) return;
    for (const b of accBtns) b.setAttribute('aria-pressed', accentOn ? 'true' : 'false');
    restoreBeats(beatsPerBar);
  }
  if (HAS_METRO) for (const b of accBtns) {
    b.addEventListener('click', (e) => {
      // The mark button sits INSIDE `#mt-beats-seg`, whose delegated click handler
      // reads `data-beats` off the closest button to set the bar length. This button
      // has no `data-beats`, so wireRuled() already ignores it — but stopping
      // propagation makes that independent of wireRuled's internals rather than
      // relying on them. Without it, adding a data- attribute here later would
      // silently start changing the meter.
      e.stopPropagation();
      accentOn = !accentOn;
      store.set('mt:accent', accentOn ? '1' : '0');
      paintAccent();
      // AUDITION THE VOICE YOU JUST CHOSE (chooser metrotuner-accent-clarity, pick
      // Q2/02). The accent was already audible — the downbeat's G6 is demoted to the
      // beat's C6 when off — but only once the metronome was running and only when the
      // bar came round, so setting the switch while stopped told you nothing. Now the
      // toggle plays the tick it changes: G6 on, C6 off. Not a new sound; the
      // instrument's own downbeat, previewed.
      // `ping` is a function DECLARATION further down, so it is hoisted and this
      // forward reference is safe — the click cannot fire before evaluation finishes.
      // audio() resumes a suspended context, and a click is the gesture that permits
      // that, so the first toggle on a cold page sounds like every later one.
      ping(accentOn ? 'down' : 'beat', audio().currentTime + 0.01);
    });
  }
  const effVoice = (t: Tick) => (t.voice === 'down' && !accentOn ? 'beat' : t.voice);

  // ONE VOICE, ONE DEFINITION. Extracted from click() so the accent audition plays the
  // instrument's actual downbeat rather than a second copy of the synth that could drift
  // from it — a re-tuned tick that only re-tuned in one of two places is the bug this
  // avoids. `ping` is the sound; `click` is the sound PLUS the scheduler's bookkeeping
  // (the pending queue and the ?e2e tick log), which an audition must not touch: a
  // toggle's preview is not a tick, and logging it would corrupt the tick assertions.
  function ping(voice: keyof typeof VOICES, at: number) {
    const ac = audio();
    const v = VOICES[voice];
    const osc = ac.createOscillator();
    const g = ac.createGain();
    osc.type = 'sine';
    osc.frequency.value = v.freq;
    g.gain.setValueAtTime(v.gain, at);
    g.gain.exponentialRampToValueAtTime(0.0001, at + v.dur);
    osc.connect(g).connect(ac.destination);
    if (E2E && hook.bleed) g.connect(hook.bleed); // the test's synthetic room
    osc.start(at);
    osc.stop(at + v.dur + 0.02);
    lastSoundAt = Math.max(lastSoundAt, at);
    // Tell the tuner what the speaker is about to do, so it can disown the sound.
    // Registered here rather than in click() because EVERY ping reaches the room —
    // the scheduler's clicks, a tap's strike, the accent audition.
    sounding.push({ from: at, to: at + v.dur + BLEED_TAIL });
    if (sounding.length > 64) sounding.shift();
    if (E2E) { hook.sounds.push({ at, voice }); if (hook.sounds.length > 512) hook.sounds.shift(); }
    return { osc, g };
  }
  let lastSoundAt = 0;

  // Clicks scheduled into the lookahead but not yet PLAYED. scheduler.stop()
  // cannot silence them — the oscillators are already started against the audio
  // clock — so anything that stops the metronome mid-lookahead must cancel these
  // or up to 100ms of orphaned clicks play over whatever comes next. That WAS
  // the "weird double tap": the tap's own ping plus a doomed lookahead click.
  const liveClicks: { at: number; osc: OscillatorNode; g: GainNode }[] = [];
  function cancelFutureClicks() {
    const now = audio().currentTime;
    for (const h of liveClicks) {
      if (h.at > now) {
        try {
          h.g.gain.cancelScheduledValues(0);
          h.g.gain.setValueAtTime(0.0001, now);
          h.osc.stop();
        } catch {}
        if (E2E) hook.sounds = hook.sounds.filter((x) => x.at !== h.at);
        // A click that never sounds must not gate the tuner's window either.
        const i = sounding.findIndex((s) => s.from === h.at);
        if (i >= 0) sounding.splice(i, 1);
      }
    }
    liveClicks.length = 0;
  }

  function click(t: Tick) {
    const h = ping(effVoice(t), t.time);
    liveClicks.push({ at: t.time, osc: h.osc, g: h.g });
    if (liveClicks.length > 32) liveClicks.splice(0, liveClicks.length - 32);
    pending.push(t);
    if (E2E) { hook.ticks.push(t); if (hook.ticks.length > 512) hook.ticks.shift(); }
  }

  const scheduler = new Scheduler(
    { bpm, beatsPerBar, subdivision },
    { now: () => audio().currentTime, play: click },
  );

  // THE SWING (chooser metrotuner-pendulum, Q1/02). The pendulum sweeps the arc
  // once per BEAT, synchronized to the scheduler's own tick times: the animation
  // reads the last played beat's audio-clock time and phase-locks a cosine to it,
  // so the bob strikes an end exactly when the click sounds — the sound and the
  // drawing share one clock, not two approximations of one.
  // Odd/even beats alternate direction; the end tick fattens on the strike, and
  // the DOWNBEAT's strike fattens more — bar position lives in the strike now that
  // the ring row is gone.
  // THE REST IS AN END, NOT THE CENTRE (user nit 1, 2026-08-04): a real pendulum
  // parks against its stop. Idle = leaning at the LEFT end; the first beat sweeps
  // away from it, and stopping lets the current sweep FINISH into whichever end it
  // was headed for, then rests there. No snap at start, no mid-air freeze at stop.
  const SWEEP_DEG = 54;
  const PARK_LEFT = -SWEEP_DEG;
  let lastBeat: Tick | null = null;   // the beat tick most recently PLAYED (clock-passed)
  // THE DIRECTION IS A COUNTER (glitch fix, 2026-08-05). It used to be derived
  // from Math.round(lastBeat.time / secPerBeat) against a first-beat anchor —
  // clock arithmetic at the CURRENT tempo, so any mid-run tempo change (typed,
  // scrubbed, tapped) re-derived the parity of old timestamps under a new beat
  // length and the strike flashes stuttered or fired the same side twice.
  // Now: flip once per beat as it PLAYS. Nothing else can move it.
  let sweepDir = 1;                   // +1 = sweeping left→right
  // THE IN-FLIGHT SWEEP KEEPS THE TEMPO IT STARTED AT (2026-08-05). sweepAt divided
  // `now - lastBeat.time` by the CURRENT 60/bpm, so changing tempo mid-sweep re-scaled a
  // beat that had already begun: same anchor, new denominator, so the phase jumped and the
  // arm teleported. Measured on the deployed page — the arm ran 48.8 → 51.7 → 25.1 → 54,
  // a one-frame snap backwards 27° and then a return to the same end, i.e. it hit that end
  // twice. Pre-existing (reproduced 3/3 on the commit before the end ticks were deleted);
  // the old flash test could not see it because a flash lasts many frames and hides a
  // one-frame jump. Captured per beat instead, so a tempo change takes effect on the NEXT
  // sweep — which is also what the scheduler does with the click.
  let sweepSec = 0.5;                 // seconds per sweep, frozen at the beat that started it
  // THE ARM'S DRAWN ANGLE IS THE STATE OF RECORD (2026-08-05). Direction used to be a
  // counter that flipped once per beat, which is only continuous if the arm is exactly at
  // the end the previous sweep aimed at. It often is not — a tap lands mid-arc, a comeback
  // seeds from a dir that has already been flipped, a completed sweep starts the next one
  // from the far end. Every one of those drew a ~108° snap (measured; present on the commit
  // before this too, at 6/6 under an 8-tap load — the old end-tick flash hid it because a
  // flash lasts many frames and cannot show a one-frame jump).
  // A sweep with direction d runs from -d·54 to +d·54, so the sweep that CONTINUES from
  // the arm's current angle is d = -sign(deg). One expression, used by every path.
  let lastDeg = PARK_LEFT;            // the angle last painted
  const dirFrom = (deg: number) => (deg >= 0 ? -1 : 1);
  let raf = 0;

  function sweepAt(now: number): { deg: number; dir: number; phase: number } | null {
    if (!lastBeat) return null;
    // sweepSec, not 60/bpm: the sweep under way is measured against the tempo it began at.
    const phase = Math.min(1, Math.max(0, (now - lastBeat.time) / sweepSec));
    const deg = -sweepDir * Math.cos(phase * Math.PI) * SWEEP_DEG;
    return { deg, dir: sweepDir, phase };
  }

  function swing() {
    if (!scheduler.running) return;
    const now = audio().currentTime;
    while (pending.length && pending[0].time <= now) {
      const t = pending.shift()!;
      if (t.voice !== 'sub') {
        sweepDir = dirFrom(lastDeg);
        lastBeat = t;
        sweepSec = 60 / bpm;   // this sweep's duration, fixed now
      }
    }
    const s = sweepAt(now);
    if (s) { lastDeg = s.deg; pend.style.transform = `rotate(${s.deg}deg)`; }
    raf = requestAnimationFrame(swing);
  }

  // Stop: finish the sweep under way (wall-clock continuation of the same cosine —
  // the AudioContext keeps ticking after scheduler.stop(), so the phase math holds),
  // land on the end it was headed for, rest there.
  function finishSweep() {
    const s = sweepAt(audio().currentTime);
    if (!s || s.phase >= 1) { restPendulum(s ? s.dir * SWEEP_DEG : PARK_LEFT); return; }
    const settle = () => {
      const cur = sweepAt(audio().currentTime);
      if (!cur || cur.phase >= 1) { restPendulum((s.dir) * SWEEP_DEG); return; }
      lastDeg = cur.deg;
      pend.style.transform = `rotate(${cur.deg}deg)`;
      raf = requestAnimationFrame(settle);
    };
    raf = requestAnimationFrame(settle);
  }

  function restPendulum(deg: number) {
    cancelAnimationFrame(raf);
    lastDeg = deg;
    // the pendulum IS the metronome's figure — and `pagehide` parks it through stopMetro() on
    // every route, which is how a page with no metronome ended up throwing on its way out
    if (!pend) return;
    pend.style.transform = `rotate(${deg}deg)`;
    pend.classList.add('rest');
    pend.classList.remove('live');
  }
  restPendulum(PARK_LEFT);

  // Reduced motion: the pendulum parks and the end ticks alone carry the beat —
  // a stroke-width change is a state, not a motion.
  const stillPend = window.matchMedia('(prefers-reduced-motion: reduce)');

  function startMetro() {
    audio();
    pending.length = 0;
    lastBeat = null;
    scheduler.start();
    runBtn?.setAttribute('aria-label', 'stop the metronome');
    runBtn?.setAttribute('aria-pressed', 'true');
    pend?.classList.remove('rest');
    pend?.classList.add('live');
    if (stillPend.matches) {
      // REDUCED MOTION STEPS THE BOB, it doesn't flash a tick. The arm jumps end to end
      // once per beat and holds there — no sweep, no tween (the CSS kills the transition
      // in this mode), so there is no travel to track, which is what "reduce" asks for.
      // It used to fatten a tick at each end while the bob stayed parked; deleting the
      // ticks would have left this mode with no beat at all, so the position carries it.
      // Same figure as the animated mode, sampled at the beat instead of every frame.
      const stepOnly = () => {
        if (!scheduler.running) return;
        const now = audio().currentTime;
        while (pending.length && pending[0].time <= now) {
          const t = pending.shift()!;
          if (t.voice !== 'sub') {
            sweepDir = dirFrom(lastDeg);
            lastBeat = t;
            sweepSec = 60 / bpm;
            lastDeg = sweepDir * SWEEP_DEG;
            pend.style.transform = `rotate(${lastDeg}deg)`;
          }
        }
        raf = requestAnimationFrame(stepOnly);
      };
      raf = requestAnimationFrame(stepOnly);
    } else {
      raf = requestAnimationFrame(swing);
    }
  }

  function stopMetro() {
    // stopping mid-takeover cancels the comeback — stop means stop
    conducting = false;
    if (resumeTimer !== null) { clearTimeout(resumeTimer); resumeTimer = null; }
    scheduler.stop();
    cancelFutureClicks(); // the lookahead tail must not play over the silence
    pending.length = 0;
    cancelAnimationFrame(raf);
    if (stillPend.matches) {
      restPendulum(PARK_LEFT);
    } else {
      // nit 1: the sweep under way completes into its end. lastBeat is NOT nulled
      // here — finishSweep's frames read it after this returns; startMetro resets it.
      finishSweep();
    }
    // reached from `pagehide` on every route — see restPendulum
    runBtn?.setAttribute('aria-label', 'start the metronome');
    runBtn?.setAttribute('aria-pressed', 'false');
  }

  if (HAS_METRO) runBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // inside .mt-mid, which is itself a start/stop target
    (scheduler.running || conducting) ? stopMetro() : startMetro();
  });
  document.getElementById('mt-metro-fig')?.closest('.mt-mid')?.addEventListener('click', () => {
    (scheduler.running || conducting) ? stopMetro() : startMetro();
  });

  function applySpec() {
    scheduler.setSpec({ bpm, beatsPerBar, subdivision });
    store.set('mt:bpm', String(bpm));
    store.set('mt:beats', String(beatsPerBar));
    store.set('mt:sub', String(subdivision));
  }

  const setBpm = (v: number) => {
    bpm = clampBpm(v);
    bpmInput.value = String(bpm);
    applySpec();
  };
  if (HAS_METRO) bpmInput.addEventListener('change', () => setBpm(Number(bpmInput.value)));

  // THE SCRUB VALUE (Q2/02), on the UNIT (metrotuner-scrub-target pick 03): "bpm" is
  // the handle at 1 bpm per 4px, the numeral is a field that types. Same wireScrub()
  // the A4 control uses — one definition, so the two gestures cannot drift.
  if (HAS_METRO) {
    const host = document.getElementById('mt-bpm-scrub')!;
    const syncBpmHandles = () => {
      for (const h of host.querySelectorAll('.mt-hd')) {
        h.setAttribute('aria-valuenow', String(bpm));
        h.setAttribute('aria-valuetext', `${bpm} beats per minute`);
      }
    };
    wireScrub({
      host,
      handles: Array.from(host.querySelectorAll<HTMLElement>('.mt-hd')),
      get: () => bpm,
      set: (v) => { bpm = v; bpmInput.value = String(bpm); applySpec(); syncBpmHandles(); },
      min: 20, max: 320,
    });
    syncBpmHandles();
    bpmInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') { e.preventDefault(); setBpm(bpm + 1); }
      if (e.key === 'ArrowDown') { e.preventDefault(); setBpm(bpm - 1); }
    });
  }

  const tap = createTapTempo();
  const tapBtn = $('mt-tap');
  // THE TAKEOVER (tap chooser round 2, pick 02). Tapping over a RUNNING metronome
  // hands you the beat: the scheduler stops (its clicks would fight your hand —
  // the round-1 sheet reproduced the tear), each tap SOUNDS the beat voice and
  // strikes the pendulum, and one tapped interval after your last tap the
  // metronome returns at your tempo — the comeback click is the DOWNBEAT, so
  // your last tap phase-anchors the bar. You tapped the count-in; it plays the
  // top. While stopped, tap is plain tap-tempo (sets the field, no takeover).
  let conducting = false;
  let resumeTimer: number | null = null;
  const applyTap = (t: number | null) => {
    if (!scheduler.running && !conducting) {
      if (t !== null) setBpm(t);
      return;
    }
    if (!conducting) {
      conducting = true;
      scheduler.stop();          // your hand owns the clock now
      cancelFutureClicks();      // …and the lookahead's clicks die with it
      pending.length = 0;
      cancelAnimationFrame(raf);
    }
    if (t !== null) setBpm(t);
    const now = audio().currentTime;
    // this tap IS a beat: sound it and strike the pendulum through the same
    // path a scheduled beat takes (lastBeat + the swing cosine), alternating
    // direction per tap so the arm swings hand-to-hand.
    ping(effVoice({ voice: 'beat' } as Tick), now + 0.005);
    const secPerBeat = 60 / bpm;
    // THE TAP'S DIRECTION COMES FROM WHERE THE ARM IS, not from flipping the last one.
    // A new sweep is drawn from -dir·54, so a blind flip is only continuous if the arm
    // happens to be sitting at that end — and it may not be: a tap can land mid-arc.
    // (It used to be masked. The tap changes tempo first, and while the in-flight sweep
    // was measured against the CURRENT bpm, a faster tempo clamped its phase to 1, which
    // parked the arm at an end before the flip. Freezing sweepSec per sweep removed that
    // accident and turned it into a visible 107° snap, caught by the tear assertion.)
    // Reading the drawn angle gives continuity AND the hand-to-hand alternation the
    // takeover wants: at +54 the next sweep runs +54 → −54, so dir = −sign(deg).
    // Continuity means the new sweep STARTS where the arm now IS. A sweep with direction d
    // starts at -d·54, so the arm sitting at deg wants d = -sign(deg). Read the drawn angle,
    // don't flip blindly: a tap can land anywhere in the arc, and at the moment a sweep has
    // just completed the previous direction is NOT the one to invert — that was the 107°
    // snap (dir stayed +1 while the arm sat at +54, so the next frame drew -54).
    sweepDir = dirFrom(lastDeg);
    lastBeat = { n: 0, time: now, voice: 'beat', beatInBar: 0 };
    sweepSec = secPerBeat;   // the hand's interval owns the sweep it just struck
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(conductSwing);
    // the handover: one tapped interval of silence, then the downbeat. The
    // comeback's first sweep CONTINUES the hand's alternation — the bob is at
    // the end the last tap sent it to, so the seed is the opposite direction.
    if (resumeTimer !== null) clearTimeout(resumeTimer);
    resumeTimer = window.setTimeout(() => {
      resumeTimer = null;
      if (!conducting) return;
      conducting = false;
      startMetro();              // nextN = 0 → the first click IS the downbeat
    }, secPerBeat * 1000);
  };
  // the conductor's swing: same cosine as swing(), but no scheduler queue —
  // lastBeat is written by the taps themselves.
  function conductSwing() {
    if (!conducting) return;
    const s = sweepAt(audio().currentTime);
    if (s) { lastDeg = s.deg; pend.style.transform = `rotate(${s.deg}deg)`; }
    raf = requestAnimationFrame(conductSwing);
  }
  // THE SNAP: .hit scales the ring to 1.9x instantly (transition:none), removing it
  // lets it settle back on --dur/--ease. The response overshoots the input and then
  // resolves, which is the mechanic a real key has (chooser metrotuner-meter-tap,
  // pick 02). 90ms held, not the old 60: at 60 the settle began before the eye had
  // registered the peak, so the overshoot was there and unreadable.
  // TAP FIRES ON PRESS (convention audit, 2026-08-04): hardware switches close on
  // press and touch apps listen on touchstart — measuring on click/up folds each
  // press's duration (50–150ms, variable) into the intervals being averaged.
  //
  // THE CAP IS THE BEAT, not a constant. At 320 bpm a strike lands every 188ms, so a
  // 90ms hold plus a 220ms settle would still be settling when the next press
  // arrives — the ring would never return and the overshoot would stop reading as
  // one. Held for the shorter of 90ms and a third of the current interval.
  const strike = () => {
    const held = Math.min(90, Math.max(24, (60000 / bpm) / 3));
    tapBtn.classList.add('hit');
    setTimeout(() => tapBtn.classList.remove('hit'), held);
  };
  if (HAS_METRO) tapBtn.addEventListener('pointerdown', () => {
    strike();
    const t = tap.tap(performance.now());
    if (t !== null) applyTap(t);
  });
  // Keyboard taps arrive as click with detail 0 (no pointer); they are the one
  // path that must still count — a pointer's own click has detail ≥ 1 and already
  // counted on the press.
  if (HAS_METRO) tapBtn.addEventListener('click', (e) => {
    if (e.detail !== 0) return;
    strike();                            // a keyboard tap gets the snap too
    const t = tap.tap(performance.now());
    if (t !== null) applyTap(t);
  });

  // THE RULED MEASURE, round-15 form. Digits are the buttons; the hairline under
  // them is the value. BEATS: the rule grows to digit N, and its downbeat tick is
  // the accent's state — tall ink when accented, a flush faint stub when equal
  // (Q1/06: the rule is the switch; the digit 1 carries weight 500 too). SUBDIVIDE:
  // the rule grows to digit N exactly like beats but is CUT into n dashes — one
  // under each counted digit; solid = positions in the bar, dashed = divisions of
  // the beat (Q3/04: the dashed extent).
  const PITCH = 20; // one digit cell, px — matches .rbtn width
  const wireRuled = (segId: string, attr: string, kind: 'grow' | 'dashext', apply: (v: number) => void) => {
    const seg = document.getElementById(segId)!;
    const rule = seg.querySelector('.rm-rule')!;
    const paint = (v: number) => {
      seg.querySelectorAll('button[' + attr + ']').forEach((x) => {
        const n = Number(x.getAttribute(attr));
        x.setAttribute('aria-pressed', n === v ? 'true' : 'false');
        x.classList.toggle('on', n <= v);
      });
      // The `>` mark states the accent. The digit-1 weight bump is gone with the tick:
      // three signals for one boolean was two too many, and the two subtle ones were
      // carrying it while the obvious one did not exist.
      if (kind === 'grow') {
        document.getElementById('mt-acc-mark')?.classList.toggle('on', accentOn);
      }
      const xe = (v - 1) * PITCH + 10; // the rule's terminus, under digit N
      let h = '';
      if (kind === 'grow') {
        // JUST A STRAIGHT LINE ("can the line under beats be just a straight line").
        // The left tick is DELETED. It once carried the accent state as a 3px height
        // change; the `>` took that job, which left the tick drawing nothing — a
        // vestigial stub kept because it used to mean something. The rule's extent
        // already states the bar length, and its left end is where it starts.
        h = `<line x1="1" y1="4.5" x2="${xe}" y2="4.5" stroke="var(--ink)" stroke-width="1.5"/>`;
      } else {
        if (v === 1) {
          h = `<line x1="1" y1="4.5" x2="10" y2="4.5" stroke="var(--ink)" stroke-width="1.5"/>`;
        } else {
          const gap = 3;
          const segw = (xe - 1 - (v - 1) * gap) / v;
          for (let k = 0; k < v; k++) {
            const x = 1 + k * (segw + gap);
            h += `<line x1="${x}" y1="4.5" x2="${x + segw}" y2="4.5" stroke="var(--ink)" stroke-width="1.5"/>`;
          }
        }
      }
      rule.innerHTML = h;
    };
    seg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b || !seg.contains(b)) return;
      const v = Number(b.getAttribute(attr));
      if (!v) return; // the rule-switch button lands here — it has its own handler
      paint(v);
      apply(v);
    });
    return paint;
  };
  // THE TWO RULED SEGMENTS ARE THE METRONOME'S SPEC ROW. `wireRuled` asserts its host exists
  // (`getElementById(segId)!` then `.querySelector('.rm-rule')!`), so this is the block that took
  // the whole script down on /changes and /loop — four statements, one gate.
  //
  // AND THE HANDLES ARE ASSIGNED, NOT DECLARED, HERE. `paintAccent()` calls `restoreBeats` from
  // above (the forward reference the comment up there explains), so a `const` inside this block
  // would put it out of scope and turn one guarded throw into a ReferenceError from a click. The
  // bindings live outside; only the wiring is conditional — the same rule as everywhere else in
  // this pass.
  if (HAS_METRO) {
    restoreBeats = wireRuled('mt-beats-seg', 'data-beats', 'grow', (v) => { beatsPerBar = v; applySpec(); });
    restoreSub = wireRuled('mt-sub-seg', 'data-sub', 'dashext', (v) => { subdivision = v; applySpec(); });
    paintAccent(); // draws the beats rule too (restoreBeats inside), with the persisted accent state
    restoreSub(subdivision);
  }

  // ══════════════════════════════════════════════════════════════════════════════════════
  // THE CHANGES — the chord dealer (chooser practice-room-apps Q1/02, grading Q3/02)
  // ══════════════════════════════════════════════════════════════════════════════════════
  // It sounds a voicing; you name it; you press the symbol to reveal what it was. The symbol
  // IS the answer, so the case's whole mechanic is that it reads `?` until asked.
  //
  // THE DECK IS DATA, and each note carries BOTH the semitones it sounds and the DEGREE the
  // symbol calls it. The pair travels together because either alone spells something wrong:
  // semitones without the degree print B♯ for a ♭5 (the letter comes from the conventional
  // size of six semitones, which is an augmented 4th), and a degree without the semitones
  // cannot say whether a fifth is flat, natural or sharp. That is the finding this case
  // forced into `naming.ts` — `nameInChord(root, semis, degree)`, measured against a deck
  // where 3 of 11 chords disagreed with their own symbol.
  interface Deal { sym: string; root: number; tones: ChordTone[] }
  const DECKS: Record<string, Deal[]> = {
    // Root pitch classes, not MIDI: the voicing is placed in a register at deal time.
    triads: [
      { sym: 'C',      root: 0,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }] },
      { sym: 'Am',     root: 9,  tones: [{ semis: 0, degree: 1 }, { semis: 3, degree: 3 }, { semis: 7, degree: 5 }] },
      { sym: 'F',      root: 5,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }] },
      { sym: 'B°',     root: 11, tones: [{ semis: 0, degree: 1 }, { semis: 3, degree: 3 }, { semis: 6, degree: 5 }] },
      { sym: 'E♭',     root: 3,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }] },
      { sym: 'F♯m',    root: 6,  tones: [{ semis: 0, degree: 1 }, { semis: 3, degree: 3 }, { semis: 7, degree: 5 }] },
    ],
    sevenths: [
      { sym: 'Dm7',    root: 2,  tones: [{ semis: 0, degree: 1 }, { semis: 3, degree: 3 }, { semis: 7, degree: 5 }, { semis: 10, degree: 7 }] },
      { sym: 'G7',     root: 7,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }, { semis: 10, degree: 7 }] },
      { sym: 'Cmaj7',  root: 0,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }, { semis: 11, degree: 7 }] },
      { sym: 'F♯m7♭5', root: 6,  tones: [{ semis: 0, degree: 1 }, { semis: 3, degree: 3 }, { semis: 6, degree: 5 }, { semis: 10, degree: 7 }] },
      { sym: 'B♭maj7', root: 10, tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }, { semis: 11, degree: 7 }] },
      { sym: 'E7',     root: 4,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 7, degree: 5 }, { semis: 10, degree: 7 }] },
      { sym: 'A°7',    root: 9,  tones: [{ semis: 0, degree: 1 }, { semis: 3, degree: 3 }, { semis: 6, degree: 5 }, { semis: 9, degree: 7 }] },
    ],
    altered: [
      { sym: 'G7♯9',   root: 7,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 10, degree: 7 }, { semis: 15, degree: 9 }] },
      { sym: 'A7♭13',  root: 9,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 10, degree: 7 }, { semis: 20, degree: 13 }] },
      { sym: 'C7♭9',   root: 0,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 10, degree: 7 }, { semis: 13, degree: 9 }] },
      { sym: 'B♭13',   root: 10, tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 10, degree: 7 }, { semis: 21, degree: 13 }] },
      { sym: 'E7♯11',  root: 4,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 10, degree: 7 }, { semis: 18, degree: 11 }] },
      { sym: 'Fmaj7♯5',root: 5,  tones: [{ semis: 0, degree: 1 }, { semis: 4, degree: 3 }, { semis: 8, degree: 5 }, { semis: 11, degree: 7 }] },
    ],
  };
  type DeckName = keyof typeof DECKS;

  const symEl = document.getElementById('mt-sym');
  const answerEl = document.getElementById('mt-answer');
  const changesCase = symEl?.closest('.mt-changes') as HTMLElement | null;
  const chordBtn = document.getElementById('mt-chordrun');
  const dealBtn = document.getElementById('mt-deal');
  const arpBtn = document.getElementById('mt-arp');

  if (symEl && answerEl && chordBtn && dealBtn && arpBtn && changesCase) {
    let deck: DeckName = 'sevenths';
    {
      const saved = store.get('mt:deck');
      if (saved && saved in DECKS) deck = saved as DeckName;
    }
    let deal: Deal = DECKS[deck][0];
    let revealed = false;
    // THE ROOT'S REGISTER. C3 upward: low enough that a drop-2 seventh does not scream and
    // high enough that the fundamental is well above the room's own noise floor.
    const ROOT_MIDI = 48;
    const dealMidis = (d: Deal) => d.tones.map((t) => ROOT_MIDI + d.root + t.semis);
    const dealNames = (d: Deal) => spellVoicing(ROOT_MIDI + d.root, d.tones);

    // ── the chord's own voice ────────────────────────────────────────────────────────
    // Three partials per note, like the drone's organ rank, so a four-note voicing has body
    // without turning into mud. NOT the cello samples: a chord trainer must state its notes
    // cleanly, and a 1.2s section swell would blur the attack you are trying to hear.
    let chordGain: GainNode | null = null;
    let chordNodes: OscillatorNode[] = [];
    function chordSounding() { return !!chordGain; }
    function stopChord() {
      if (!chordGain) return;
      const ac = audio();
      chordGain.gain.cancelScheduledValues(ac.currentTime);
      chordGain.gain.setTargetAtTime(0.0001, ac.currentTime, 0.04);
      chordNodes.forEach((o) => { try { o.stop(ac.currentTime + 0.3); } catch {} });
      const dead = chordGain;
      setTimeout(() => { try { dead.disconnect(); } catch {} }, 600);
      chordGain = null;
      chordNodes = [];
      chordBtn!.setAttribute('aria-pressed', 'false');
      chordBtn!.setAttribute('aria-label', 'sound the chord');
      delete changesCase!.dataset.sounding;
    }
    function startChord() {
      // ONE SOUND SOURCE AT A TIME. The drone and this case would otherwise both hold the
      // speaker, and two sustained stacks in different keys is not a practice tool. The
      // metronome is left alone deliberately — a click over a chord is a legitimate thing
      // to want, and it is percussive rather than sustained.
      if (droning()) stopTone();
      const ac = audio();
      chordGain = ac.createGain();
      chordGain.gain.setValueAtTime(0.0001, ac.currentTime);
      chordGain.connect(ac.destination);
      for (const m of dealMidis(deal)) {
        const f = midiToFreq(m, a4);
        [1, 2, 3].forEach((h, i) => {
          const o = ac.createOscillator();
          const g = ac.createGain();
          o.type = 'sine';
          o.frequency.value = f * h;
          g.gain.value = [0.6, 0.2, 0.09][i] / deal.tones.length;
          o.connect(g); g.connect(chordGain!); o.start();
          chordNodes.push(o);
        });
      }
      chordGain.gain.exponentialRampToValueAtTime(0.5, ac.currentTime + 0.05);
      chordBtn!.setAttribute('aria-pressed', 'true');
      chordBtn!.setAttribute('aria-label', 'stop the chord');
      changesCase!.dataset.sounding = 'true';
    }

    // ── what the answer line says ────────────────────────────────────────────────────
    // Three states, and they are genuinely different sentences: nothing yet, the spelled
    // notes once revealed, and — while arpeggiating — which of them you have landed.
    function paintAnswer() {
      if (arpOn) { paintArp(); return; }
      answerEl!.innerHTML = revealed
        ? dealNames(deal).map((n) => `<b>${n}</b>`).join('  ')
        : '';
    }
    function paintSymbol() {
      symEl!.textContent = revealed ? deal.sym : '?';
      symEl!.dataset.revealed = String(revealed);
      symEl!.setAttribute('aria-label', revealed
        ? `${deal.sym} — press to hear it again`
        : 'Chord — press to hear it, press again to reveal what it is');
    }
    function nextDeal() {
      // A NEW CHORD, NEVER THE SAME ONE TWICE RUNNING. A dealer that repeats reads as broken
      // even when it is honest randomness, and with six or seven cards a repeat is common.
      const cards = DECKS[deck];
      let next = deal;
      if (cards.length > 1) {
        while (next === deal) next = cards[Math.floor(Math.random() * cards.length)];
      } else next = cards[0];
      deal = next;
      revealed = false;
      arpLanded.clear();
      paintSymbol();
      paintAnswer();
    }

    symEl.addEventListener('click', () => {
      if (!revealed) { revealed = true; paintSymbol(); paintAnswer(); }
      stopChord();
      startChord();
    });
    chordBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      chordSounding() ? stopChord() : startChord();
    });
    dealBtn.addEventListener('click', () => {
      const wasSounding = chordSounding();
      stopChord();
      nextDeal();
      if (wasSounding) startChord();
      // the momentary's snap — the same overshoot-and-settle the tap ring uses
      dealBtn!.classList.add('hit');
      setTimeout(() => dealBtn!.classList.remove('hit'), 90);
    });

    // ── the deck selector ───────────────────────────────────────────────────────────
    changesCase.querySelectorAll<HTMLButtonElement>('[data-deck]').forEach((b) => {
      b.addEventListener('click', () => {
        deck = b.dataset.deck as DeckName;
        store.set('mt:deck', deck);
        changesCase!.querySelectorAll<HTMLButtonElement>('[data-deck]').forEach((o) => {
          const on = o === b;
          o.setAttribute('aria-pressed', String(on));
          o.classList.toggle('on', on);
        });
        const wasSounding = chordSounding();
        stopChord();
        deal = DECKS[deck][0];
        nextDeal();
        if (wasSounding) startChord();
      });
    });
    changesCase.querySelectorAll<HTMLButtonElement>('[data-deck]').forEach((o) => {
      const on = o.dataset.deck === deck;
      o.setAttribute('aria-pressed', String(on));
      o.classList.toggle('on', on);
    });

    // ── ARPEGGIATED GRADING (chooser Q3/02) ─────────────────────────────────────────
    // WHY ONE NOTE AT A TIME, stated here because it looks like a limitation and is in fact
    // the only honest option the room has: `detectPitch` is the McLeod Pitch Method and finds
    // ONE period. Measured against synthesized plucked voicings — a strummed Dm7 reads as NO
    // PITCH (below the 0.6 clarity gate), and a bare fifth reads exactly an octave low
    // (D3+A3 → D2, ÷2) because a fifth's two notes are periodic at half the lower pitch.
    // Played one note at a time it is the detector's home ground: 0.35 cents, C2 to C7,
    // asserted in pitch.test.ts.
    //
    // IT REUSES THE TUNER'S ANALYSER rather than opening a second stream. One mechanism, one
    // permission prompt, one recording indicator — and `startTuner()` already owns the
    // high-pass, the three capture flags and the permission race.
    let arpOn = false;
    const arpLanded = new Set<number>();   // pitch classes landed on this chord
    let arpTimer: number | null = null;
    // the e2e hook reads the grader's own state — see the note on `hook.arpLanded`
    arpHook.landed = () => [...arpLanded].sort((x, y) => x - y);
    arpHook.wanted = () => deal.tones
      .map((t) => (ROOT_MIDI + deal.root + t.semis) % 12).sort((x, y) => x - y);

    function paintArp() {
      const want = deal.tones.map((t) => (ROOT_MIDI + deal.root + t.semis) % 12);
      const names = dealNames(deal);
      answerEl!.innerHTML = names.map((n, i) => {
        const pc = want[i];
        // landed reads ACCENT — "this is happening" — and the rest stay faint until then.
        return arpLanded.has(pc) ? `<i>${n}</i>` : n;
      }).join('  ');
    }
    function stopArp() {
      arpOn = false;
      if (arpTimer !== null) { clearInterval(arpTimer); arpTimer = null; }
      arpBtn!.setAttribute('aria-pressed', 'false');
      arpBtn!.setAttribute('aria-label', 'listen — arpeggiate the chord one note at a time');
      paintAnswer();
    }
    async function startArp() {
      // The tuner owns the stream. If it is not running, start it — and say so rather than
      // silently borrowing it, because a mic turning on is not something to do quietly.
      if (!micStream) await startTuner();
      if (!micStream) { stopArp(); return; }     // denied or failed — startTuner reported why
      arpOn = true;
      arpLanded.clear();
      // REVEAL WHEN LISTENING. Grading a chord you have not been told is a memory test, not a
      // chord test — and the note names are what you are checking your fingers against.
      revealed = true;
      paintSymbol();
      arpBtn!.setAttribute('aria-pressed', 'true');
      arpBtn!.setAttribute('aria-label', 'stop listening');
      paintArp();
      arpTimer = window.setInterval(() => {
        if (!analyser) return;
        const buf = new Float32Array(analyser.fftSize);
        analyser.getFloatTimeDomainData(buf);
        const hz = detectPitch(buf, audio().sampleRate);
        if (hz <= 0) return;
        const r = freqToReading(hz, a4);
        if (!r) return;
        // WITHIN 35 CENTS COUNTS AS THE NOTE. Not the tuner's ±3: this case asks whether you
        // played the right NOTE, not whether it was in tune, and a guitar fretted cleanly
        // still lands tens of cents off. The tuner is one case away if intonation is the
        // question.
        if (Math.abs(r.cents) > 35) return;
        const pc = ((r.midi % 12) + 12) % 12;
        const want = deal.tones.map((t) => (ROOT_MIDI + deal.root + t.semis) % 12);
        if (want.includes(pc) && !arpLanded.has(pc)) { arpLanded.add(pc); paintArp(); }
      }, 60);
    }
    arpBtn.addEventListener('click', () => { arpOn ? stopArp() : startArp(); });

    paintSymbol();
    paintAnswer();
  }

  // ══════════════════════════════════════════════════════════════════════════════════════
  // THE LOOP — the transcriber's part selector (chooser Q1/03, source Q4/02)
  // ══════════════════════════════════════════════════════════════════════════════════════
  // Two carets cut a span; four words set the speed; it loops that span forever.
  //
  // THE IFRAME IS NOT CREATED UNTIL A URL IS PASTED. Nothing is requested and no cookie is
  // set by opening the practice room — the same promise the tuner makes about the microphone,
  // kept the same way: by not starting the thing until it is asked for. This is the first
  // case in the room that talks to another origin at all, which is the stated cost of Q4/02.
  const tlEl = document.getElementById('mt-tl');
  const tlA = document.getElementById('mt-tl-a');
  const tlB = document.getElementById('mt-tl-b');
  const tlSpan = document.getElementById('mt-tl-span');
  const tlHead = document.getElementById('mt-tl-head');
  const tlRead = document.getElementById('mt-tl-read');
  const tlLen = document.getElementById('mt-tl-len');
  const srcEl = document.getElementById('mt-src') as HTMLInputElement | null;
  const loopBtn = document.getElementById('mt-loop-run');
  const loopState = document.getElementById('mt-loopstate');
  const ytHost = document.getElementById('mt-yt');
  const loopCase = tlEl?.closest('.mt-loop') as HTMLElement | null;

  if (tlEl && tlA && tlB && tlSpan && tlRead && srcEl && loopBtn && loopState && ytHost && loopCase) {
    // Fractions of the take, so the carets survive a duration that arrives late.
    let a = 0.10, b = 0.22, rate = 1, duration = 0;
    let player: any = null;                  // the YT.Player, once the API has loaded
    let apiReady: Promise<void> | null = null;

    const clock = (f: number) => {
      if (!duration) return '—';
      const s = Math.round(f * duration);
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };
    function paintTl() {
      if (b < a) { const t = a; a = b; b = t; }
      tlA!.style.left = `${a * 100}%`;
      tlB!.style.left = `${b * 100}%`;
      tlSpan!.style.left = `${a * 100}%`;
      tlSpan!.style.width = `${(b - a) * 100}%`;
      tlRead!.textContent = duration ? `${clock(a)} – ${clock(b)}` : '—';
      // THE LENGTH IS MEASURED, not a bar count: this case does not know the tempo and never
      // asks for one, so printing bars would be inventing a number. (The proof sheet shipped
      // a derived bar count and it was the one number on it I could not defend.)
      tlLen!.textContent = duration ? `${((b - a) * duration).toFixed(1)}s` : '';
    }
    const SIXTEENTH = 1 / 16;
    function nudge(which: 'a' | 'b', dir: number) {
      // The tick grid is sixteenths OF THE SPAN the ticks are drawn across — the whole take —
      // so a nudge lands on a mark the reader can see.
      if (which === 'a') a = Math.min(b, Math.max(0, a + dir * SIXTEENTH));
      else b = Math.max(a, Math.min(1, b + dir * SIXTEENTH));
      paintTl();
      applyLoop();
    }

    // ── dragging ────────────────────────────────────────────────────────────────────
    let dragging: 'a' | 'b' | null = null;
    function fracFrom(clientX: number) {
      const r = tlEl!.getBoundingClientRect();
      return Math.min(1, Math.max(0, (clientX - r.left) / r.width));
    }
    tlEl.addEventListener('pointerdown', (e) => {
      const f = fracFrom(e.clientX);
      dragging = Math.abs(f - a) <= Math.abs(f - b) ? 'a' : 'b';
      (dragging === 'a' ? tlA! : tlB!).classList.add('hot');
      tlEl!.setPointerCapture(e.pointerId);
      if (dragging === 'a') a = f; else b = f;
      paintTl();
    });
    tlEl.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      if (dragging === 'a') a = fracFrom(e.clientX); else b = fracFrom(e.clientX);
      paintTl();
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = null;
      tlA!.classList.remove('hot');
      tlB!.classList.remove('hot');
      applyLoop();          // commit on release, so a drag does not seek on every frame
    };
    tlEl.addEventListener('pointerup', endDrag);
    tlEl.addEventListener('pointercancel', endDrag);
    tlEl.addEventListener('keydown', (e) => {
      // shift picks the LEFT caret, matching the drone figure's shift-click-for-down idiom:
      // unmodified is the common case, shift is the other one.
      const which = e.shiftKey ? 'a' : 'b';
      if (e.key === 'ArrowLeft') { e.preventDefault(); nudge(which, -1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); nudge(which, +1); }
    });

    // ── the speed row ───────────────────────────────────────────────────────────────
    loopCase.querySelectorAll<HTMLButtonElement>('[data-rate]').forEach((btn) => {
      btn.addEventListener('click', () => {
        rate = Number(btn.dataset.rate);
        loopCase!.querySelectorAll<HTMLButtonElement>('[data-rate]').forEach((o) => {
          const on = o === btn;
          o.setAttribute('aria-pressed', String(on));
          o.classList.toggle('on', on);
        });
        // PITCH IS HELD BY THE PLAYER, not by us. The iframe API preserves pitch across
        // playbackRate — which is the whole reason Q4/02's embed beats the buffer path the
        // drone's samples use, where the same slowdown drops it an octave.
        try { player?.setPlaybackRate?.(rate); } catch {}
      });
      btn.classList.toggle('on', Number(btn.dataset.rate) === rate);
    });

    // ── the source ──────────────────────────────────────────────────────────────────
    // A URL, not an id: nobody has the id to hand. Both the watch and the short form.
    function videoId(url: string): string | null {
      const m = url.match(/(?:v=|youtu\.be\/|\/embed\/|\/shorts\/)([\w-]{11})/);
      return m ? m[1] : (/^[\w-]{11}$/.test(url.trim()) ? url.trim() : null);
    }
    function loadApi(): Promise<void> {
      if (apiReady) return apiReady;
      apiReady = new Promise<void>((resolve, reject) => {
        if ((window as any).YT?.Player) { resolve(); return; }
        (window as any).onYouTubeIframeAPIReady = () => resolve();
        const sc = document.createElement('script');
        sc.src = 'https://www.youtube.com/iframe_api';
        // A network the room has never needed before can fail, and a case that just sits
        // there is worse than one that says so.
        sc.onerror = () => reject(new Error('the youtube api did not load'));
        document.head.appendChild(sc);
      });
      return apiReady;
    }
    let pollTimer: number | null = null;
    function applyLoop() {
      if (!player || !duration) return;
      try {
        const from = a * duration;
        const t = player.getCurrentTime?.() ?? 0;
        if (t < from || t > b * duration) player.seekTo(from, true);
      } catch {}
    }
    async function loadSource(url: string) {
      const id = videoId(url);
      if (!id) { loopState!.textContent = 'that is not a youtube url'; return; }
      loopState!.textContent = 'loading…';
      try { await loadApi(); } catch (err) {
        loopState!.textContent = 'the youtube player did not load — check the network';
        return;
      }
      // One player, re-pointed. Building a second iframe per paste would leak both the node
      // and its audio.
      if (player) { try { player.loadVideoById(id); } catch {} return; }
      ytHost!.innerHTML = '<div id="mt-yt-player"></div>';
      player = new (window as any).YT.Player('mt-yt-player', {
        videoId: id,
        width: 1, height: 1,
        playerVars: { controls: 0, disablekb: 1, modestbranding: 1, playsinline: 1, rel: 0 },
        events: {
          onReady: () => {
            duration = player.getDuration?.() || 0;
            loopState!.textContent = duration
              ? 'drag the carets — arrows nudge by a sixteenth'
              : 'loaded, but this video reports no duration';
            try { player.setPlaybackRate?.(rate); } catch {}
            paintTl();
          },
          onError: () => { loopState!.textContent = 'that video cannot be embedded'; },
          onStateChange: (ev: any) => {
            // 0 = ENDED. A take that runs off the end of the span is the loop's whole job.
            if (ev.data === 0) applyLoop();
          },
        },
      });
    }
    srcEl.addEventListener('change', () => { if (srcEl!.value.trim()) loadSource(srcEl!.value); });

    // ── the transport ───────────────────────────────────────────────────────────────
    function stopLoop() {
      if (pollTimer !== null) { clearInterval(pollTimer); pollTimer = null; }
      try { player?.pauseVideo?.(); } catch {}
      loopBtn!.setAttribute('aria-pressed', 'false');
      loopBtn!.setAttribute('aria-label', 'loop the span');
      delete loopCase!.dataset.sounding;
      if (tlHead) tlHead.style.left = '0%';
    }
    function startLoop() {
      if (!player || !duration) {
        loopState!.textContent = srcEl!.value.trim() ? 'still loading…' : 'paste a url to begin';
        return;
      }
      // ONE SOURCE AT A TIME, like the chord case: a drone under a transcription is not a
      // thing anyone wants, and two sustained sources would make both unusable.
      if (droning()) stopTone();
      try {
        player.seekTo(a * duration, true);
        player.setPlaybackRate?.(rate);
        player.playVideo();
      } catch {}
      loopBtn!.setAttribute('aria-pressed', 'true');
      loopBtn!.setAttribute('aria-label', 'stop the loop');
      loopCase!.dataset.sounding = 'true';
      // THE LOOP IS A POLL, and it has to be: the iframe API has no "play this range" call
      // and no time-update event, so the only way to know we have run past the caret is to
      // ask. 100ms is the granularity of the wrap — audible as a tight loop, and cheap.
      pollTimer = window.setInterval(() => {
        if (!player || !duration) return;
        let t = 0;
        try { t = player.getCurrentTime?.() ?? 0; } catch { return; }
        if (tlHead) tlHead.style.left = `${Math.min(100, (t / duration) * 100)}%`;
        if (t >= b * duration || t < a * duration - 0.25) {
          try { player.seekTo(a * duration, true); } catch {}
        }
      }, 100);
    }
    loopBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      loopBtn!.getAttribute('aria-pressed') === 'true' ? stopLoop() : startLoop();
    });
    paintTl();
  }

  // ══ WHAT THE ROUTES DELETED (2026-08-12) ════════════════════════════════════════════════
  // Everything the room used to need at runtime is gone, because a URL does it instead:
  //   layoutRoom()   wrote `--mt-cols` per width. The columns are CSS again — `170fr 170fr 196fr`
  //                  is the console's measured demands as ratios, which is what splitThing()
  //                  computed. One route, one thing, no arithmetic.
  //   drawPlan()     built the room's boxes from THINGS on every layout. They are built at BUILD
  //                  time now, so the index renders with JS off.
  //   goTo/deepLinked/syncHash  scrolled to a page, read `#console` from the hash and wrote it
  //                  back on scroll. All three were a URL bar made of JavaScript; the address bar
  //                  is better at it, and `← the room` is an ordinary link.
  //   opened, snapPad, onScreen, data-snap, the ResizeObserver, the room's own dot — each existed
  //                  to keep a scroller honest, and only the console on a phone still scrolls.
  // The one thing kept is the DOT ROW, which is that scroller's page indicator.
  const pages = document.getElementById('mt-pages');
  const dots = document.getElementById('mt-dots');

  /**
   * Every case on THIS page, by key, in the order it sits.
   *
   * KEYED OFF THE MARKUP, NOT OFF POSITION. It used to walk `INSTRUMENTS` and take
   * `pages.children[idx]` — which agreed with the DOM only while one page held all five cases in
   * that exact order. On any route it is silently wrong rather than broken: `/changes/` keyed the
   * dealer as `tuner`, and the console keyed its drone as `metronome` (THINGS lists the console
   * tuner-drone-metronome, INSTRUMENTS lists tuner-metronome-drone). Every consumer then read the
   * wrong element and reported success. `data-mt-key` is written in the markup beside the case it
   * names, so there is nothing to agree with.
   */
  const caseEls = new Map<string, HTMLElement>();
  pages?.querySelectorAll<HTMLElement>('[data-mt-key]').forEach((el) => {
    caseEls.set(el.dataset.mtKey!, el);
  });

  // ── THE DOTS: THE CONSOLE'S PAGES, ON A PHONE ────────────────────────────────────────
  // One 16px generated mark per case ON THIS PAGE — so three on the console and none anywhere
  // else, because the row only exists there (his annotation: "delete from desktop, maybe leave
  // for console mobile where we need app switching"). Built from the same GLYPHS map the room's
  // boxes read, so the two cannot disagree about what an instrument's mark is.
  //
  // IT IS BUILT FROM THE DOM, not from THINGS. Iterating the model drew five dead buttons on a
  // three-case page: `caseEls.get()` returned null for the absent ones, `goTo(null)` early-returned
  // and nothing threw, so the row rendered four marks that did nothing and none of them lit.
  function drawDots() {
    if (!dots || !pages) return;
    dots.replaceChildren();
    for (const [key, el] of caseEls) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pgdot';
      // THE SHIPPED TESTIDS ARE KEPT VERBATIM, including the metronome's abbreviation: deriving
      // them from the key would quietly rename `dot-metro` and break tests that ask nothing about
      // the dots' drawing. A test id is a contract with the suite.
      b.dataset.testid = `dot-${key === 'metronome' ? 'metro' : key}`;
      b.setAttribute('aria-label', BY_KEY[key].name);
      b.innerHTML = glyphSvg(key);
      b.addEventListener('click', () => {
        // the page IS the viewport here, so its offset is its index times the width — and this is
        // the only place in the file that arithmetic is true
        pages.scrollTo({ left: el.offsetLeft, behavior: still.matches ? 'auto' : 'smooth' });
      });
      dots.append(b);
    }
    paintDots();
  }

  /**
   * WHICH DOT IS IN INK — measured, not counted. `round(scrollLeft / clientWidth)` is correct on
   * this one remaining scroller (a phone page is the viewport) and it was wrong everywhere else it
   * was used, so the geometric test stays: more than half the case inside the scrollport.
   */
  function paintDots() {
    if (!dots || !pages) return;
    const p = pages.getBoundingClientRect();
    Array.from(dots.children).forEach((b, i) => {
      const el = [...caseEls.values()][i];
      const r = el?.getBoundingClientRect();
      const on = !!r && Math.min(p.right, r.right) - Math.max(p.left, r.left) > r.width / 2;
      b.classList.toggle('cur', on);
    });
  }

  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (dots && pages) {
    let scrollRaf = 0;
    pages.addEventListener('scroll', () => {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(() => { scrollRaf = 0; paintDots(); });
    }, { passive: true });
    drawDots();
    new ResizeObserver(paintDots).observe(pages);
  }

  // Leaving the page: stop everything. A tab that keeps a mic open after
  // navigation shows a recording indicator for a page that no longer exists.
  // `stopTuner(false)`: the mic stops, the resume flag survives — see OPEN STARTED.
  addEventListener('pagehide', () => { stopTuner(false); stopMetro(); stopTone(); });
</script>
