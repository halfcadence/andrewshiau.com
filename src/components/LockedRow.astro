---
// THE LOCKED INDEX ROW — the gate IS the row (chooser: andrewshiau-gate-options, option 05,
// "the index row, opened in place"). Clicking the row doesn't leave the index: the row opens
// under itself and the ask happens inside the object that was clicked.
//
// Two call sites, one device, which is why this is a component and not markup in two pages:
// - `src/pages/index.astro` — the row in the Work list, closed until clicked.
// - `src/pages/gate.astro` — the same row, already open. nginx serves that page AT
//   /work/stores-designer/ (error_page 401), so a reader who lands on the URL directly, or
//   comes back with a stale cookie, meets the row they would have clicked rather than a
//   different page wearing different clothes.
//
// It emits TWO siblings of `.matrix`, not one nested element, and that is forced: `.entry` is
// an `<a>`, and a `<form>` inside an anchor is invalid HTML that browsers un-nest — the form
// would be lifted out of the row at parse time. So the gate is the row's next sibling, and it
// takes the row's own grid tracks (see `.egaterow` in global.css) so its content still starts
// on the title's left edge in all four of the row's breakpoints.
//
// Keeping the row a real `<a href>` is also the no-JS answer: without JavaScript the click
// navigates, nginx answers 401, and the reader gets the gate page — the same row, open. What
// no-JS cannot do is submit the gate; `<noscript>` on that page says so plainly.
import type { Entry } from '../data/experiments';
import SideDot from './SideDot.astro';
import GateForm from './GateForm.astro';
interface Props { x: Entry; open?: boolean }
const { x, open = false } = Astro.props;
const id = 'gate-' + x.n;
// The row is a LINK on the index (it goes somewhere) and a heading-shaped div on the gate
// page (you are already there — a link to the page you are on is a link that does nothing,
// the same reason `Mark home={false}` exists on the index).
const Row = open ? 'div' : 'a';
---

<Row class:list={['entry', { accent: x.accent, open }]}
     href={open ? undefined : x.href}
     aria-controls={open ? undefined : id}>
  <span class="en">{x.n}</span>
  {/* No lock mark and no `Password` marker. Both were added on the theory that the row had to
      advertise being shut before the click, and on the page they read as a warning label on
      the one row in the list that most wants opening — two extra marks in a matrix whose
      whole device is one arrow per row. The gate itself is the disclosure: clicking opens the
      ask in place, immediately, under the row that was clicked, so nothing is hidden and no
      promise is broken. The row keeps the arrow every other row has. */}
  <span class="eh">{x.title}</span>
  <span class="ends"></span>
  <span class="em">
    <SideDot side={x.side} />
    <span class="smeta">{x.meta}</span>
  </span>
  {/* The blurb, same as every other Work row (chooser: andrewshiau-decisions, Q1/02). This row is
      Work 01 and it is the one a hiring manager reads first, so it cannot be the one row in the
      section with no sentence. It also does the job the gate's own copy can't: the ask inside the
      expanded cell is only visible AFTER the click, and this is visible before. */}
  <span class="ed">{x.blurb}</span>
</Row>

<div class:list={['egaterow', { open }]} id={id} hidden={!open}>
  <div class="egate">
    <GateForm href={x.href} />
  </div>
</div>

<script>
  // The row opens in place. One listener per locked row, bound to the anchor, and the default
  // navigation is prevented ONLY once this script has run — so if it never runs, the link is
  // still a link (see the note at the top of this file).
  // Unconditional, not wrapped in `{!open && …}`: Astro hoists <script> at build time whether
  // the expression around it is truthy or not, so a conditional would be a lie about when it
  // ships. The selector is the condition instead — on the gate page the row is a `div` with no
  // `aria-controls`, so this matches nothing there.
  document.querySelectorAll('a.entry[aria-controls]').forEach((row) => {
    const cell = document.getElementById(row.getAttribute('aria-controls'));
    if (!cell) return;
    const field = cell.querySelector('input');
    // Set here, not in the markup: an `aria-expanded="false"` that shipped without this
    // script would promise a disclosure to a screen reader and then navigate instead.
    row.setAttribute('aria-expanded', 'false');

    const set = (isOpen) => {
      row.setAttribute('aria-expanded', String(isOpen));
      row.classList.toggle('open', isOpen);
      cell.classList.toggle('open', isOpen);
      cell.hidden = !isOpen;
      // Focus goes to the field, because the click WAS the request to open it — asking the
      // reader to then find the one input on a page of eight rows is the friction the whole
      // option exists to remove.
      if (isOpen && field instanceof HTMLInputElement) field.focus();
    };

    row.addEventListener('click', (e) => {
      // A modified click is the reader asking for a new tab; let the browser have it.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      set(row.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and hands focus back to the row, so a keyboard reader who opened it by
    // mistake isn't left inside a field with no way out but Tab.
    cell.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      set(false);
      row.focus();
    });

    // BACK BUTTON: THE ROW CLOSES TOO. Follow-up to the field/message reset in GateForm.astro —
    // "seems better should the password field maybe close too?" Yes, and for the same reason: the
    // reader has been to the gated page and come back, so an open row is a question already
    // answered. Clearing the field but leaving the disclosure open is a half-reset, which reads
    // as a form waiting for a second attempt.
    // `set(false)` rather than touching `hidden` here — it owns `aria-expanded`, both `open`
    // classes and `hidden` together, and a second place setting three of the four is how those
    // drift apart.
    // NO `row.focus()`, unlike Escape: that close was a keyboard action mid-page, so focus had to
    // go somewhere sensible. This one happens during a navigation the reader did not aim at any
    // element, and stealing focus to a row they did not ask for would scroll the page to it.
    // `pageshow`, not `load` — `load` does not fire on a bfcache restore, which is the path that
    // brings the row back open in the first place. Same reasoning as the GateForm handler; the two
    // are deliberately separate listeners because each component owns its own state.
    window.addEventListener('pageshow', () => set(false));
  });
</script>
